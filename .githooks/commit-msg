#!/usr/bin/env bash
# .githooks/commit-msg
#
# Validates commit message format (Conventional Commits).
# Git passes the commit message file path as $1.
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Bypass in emergency:
#   git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

err()  { echo -e "${RED}[commit-msg] ERROR: $*${RESET}" >&2; }
warn() { echo -e "${YELLOW}[commit-msg] WARN:  $*${RESET}" >&2; }
info() { echo -e "${CYAN}[commit-msg] $*${RESET}" >&2; }

COMMIT_MSG_FILE="${1:-}"

if [[ -z "$COMMIT_MSG_FILE" || ! -f "$COMMIT_MSG_FILE" ]]; then
    warn "Commit message file not found — skipping format check."
    exit 0
fi

FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE" | sed 's/^[[:space:]]*//')

if echo "$FIRST_LINE" | grep -qE "^Merge"; then
    info "Merge commit detected — skipping format check."
    exit 0
fi

if [[ -z "$FIRST_LINE" ]]; then
    err "Empty commit message."
    exit 1
fi

if ! echo "$FIRST_LINE" | grep -qE "^(fix:|feat:|add:|chore:|refactor:|docs:|test:|perf:|security:)"; then
    err "Commit message must start with a valid prefix:"
    err "  fix: | feat: | add: | chore: | refactor: | docs: | test: | perf: | security:"
    err "  Got: $FIRST_LINE"
    exit 1
fi

exit 0
