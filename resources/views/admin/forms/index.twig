{% extends "admin/layout.twig" %}
{% import "admin/partials/_row_actions.twig" as actions %}
{% import "admin/partials/_table.twig" as table %}

{% block title %}{{ __('Forms') }}{% endblock %}

{% block content %}
{% set allIds = forms|map(f => f.id) %}
<div x-data="dataTable({perPage: 20})">
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 dark:text-white">{{ __('Forms') }}</h1>
    <a href="{{ url('/admin/forms/create') }}" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors">+ {{ __('New Form') }}</a>
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    {{ table.search(__('Search') ~ '…') }}
    <div class="flex-1"></div>
    {% if multi_language_content %}
    <form method="get" action="{{ url('/admin/forms') }}">
        <select name="language" onchange="this.form.submit()" class="rounded-lg border-gray-300 dark:border-gray-700 text-sm bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
            <option value="">{{ __('All Languages') }}</option>
            {% for code, name in supported_locales %}
                <option value="{{ code }}" {{ filters.language|default('') == code ? 'selected' }}>{{ locale_name(code) }}</option>
            {% endfor %}
        </select>
    </form>
    {% endif %}
    {{ table.columnsToggle() }}
</div>

<div class="overflow-x-auto rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800/50 dark:bg-gray-800/50">
            <tr>
                {{ table.th_checkbox(allIds) }}
                {{ table.th(__('Name'), 'name') }}
                {% if multi_language_content %}{{ table.th(__('Lang'), 'language') }}{% endif %}
                {{ table.th(__('Status'), 'status') }}
                {{ table.th(__('Fields'), 'fields', 'center', {cellClass: 'px-3'}) }}
                {{ table.th(__('Submissions'), 'submissions', 'center', {cellClass: 'px-3'}) }}
                {{ table.th(__('Created'), 'created_at') }}
                {{ table.th(__('Updated'), 'updated_at') }}
                {{ table.th_static(__('Actions'), 'right') }}
            </tr>
        </thead>
        <tbody x-ref="items" class="divide-y divide-gray-200 dark:divide-gray-700">
            {% for f in forms %}
            <tr data-row-id="{{ f.id }}" class="hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800/50 transition-colors" data-sort="{{ {name: f.name, slug: f.slug, language: f.language ?? '', fields: f.fields|length, submissions: f.submissionCount, status: f.enabled ? '1' : '0', created_at: f.createdAt ? f.createdAt.format('Y-m-d H:i:s') : '', updated_at: f.updatedAt ? f.updatedAt.format('Y-m-d H:i:s') : ''}|json_encode|e('html_attr') }}">
                {{ table.td_checkbox(f.id) }}
                <td class="px-6 py-4">
                    <a href="{{ url('/admin/forms/' ~ f.id ~ '/edit') }}" class="text-sm font-medium text-gray-900 dark:text-gray-100 hover:underline">{{ f.name }}</a>
                    <p class="text-xs text-gray-400">/{{ f.slug }}</p>
                </td>
                {% if multi_language_content %}
                <td class="whitespace-nowrap px-6 py-4 text-center">
                    <span class="rounded-sm bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 text-xs font-bold uppercase" title="{{ locale_name(f.language) }}">
                        {{ f.language }}
                    </span>
                </td>
                {% endif %}
                <td class="whitespace-nowrap px-6 py-4">
                    <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium {{ f.enabled ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 dark:text-gray-400' }}">
                        {{ f.enabled ? __('Active') : __('Inactive') }}
                    </span>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-center text-sm tabular-nums text-gray-500 dark:text-gray-400 dark:text-gray-400">{{ f.fields|length }}</td>
                <td class="whitespace-nowrap px-3 py-4 text-center text-sm tabular-nums text-gray-500 dark:text-gray-400 dark:text-gray-400">
                    <a href="{{ url('/admin/forms/' ~ f.id ~ '/submissions') }}" class="hover:underline" title="{{ __('View submissions') }}">{{ f.submissionCount }}</a>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400 dark:text-gray-400">{{ f.createdAt ? f.createdAt|local_date('medium') : '—' }}</td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400 dark:text-gray-400">{{ f.updatedAt ? f.updatedAt|local_date('medium') : '—' }}</td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                    <div class="inline-flex items-center justify-end gap-1.5">
                        {{ actions.link(absolute_url(url('/form/' ~ f.slug)), 'eye', __('View'), 'neutral', {external: true}) }}
                        {{ actions.link(url('/admin/forms/' ~ f.id ~ '/submissions'), 'inbox', __('Submissions')) }}
                        {{ actions.link(url('/admin/forms/' ~ f.id ~ '/edit'), 'pencil', __('Edit')) }}
                        <form method="POST" action="{{ url('/admin/forms/' ~ f.id ~ '/clone') }}" class="inline-flex">
                            {{ csrf_field() }}
                            {{ actions.submit('duplicate', __('Clone'), 'info') }}
                        </form>
                        <form method="POST" action="{{ url('/admin/forms/' ~ f.id ~ '') }}" class="inline-flex"
                              onsubmit="return confirm('{{ __('Delete this form?')|e('js') }}')">
                            {{ csrf_field() }}<input type="hidden" name="_METHOD" value="DELETE">
                            {{ actions.submit('trash', __('Delete'), 'danger') }}
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="{{ multi_language_content ? 9 : 8 }}" class="px-6 py-12 text-center text-sm text-gray-400 dark:text-gray-500">{{ __('No forms yet. Create one!') }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{{ table.pagination() }}
{% include 'admin/partials/_bulk_bar.twig' with {action: 'forms', extraActions: [
    {label: __('Activate'), action: 'activate', class: 'bg-green-600/10 text-green-700 dark:text-green-400 hover:bg-green-600/20'},
    {label: __('Deactivate'), action: 'deactivate', class: 'bg-red-600/10 text-red-700 dark:text-red-400 hover:bg-red-600/20'},
]} %}
</div>
{% endblock %}
