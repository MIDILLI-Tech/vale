{% extends "admin/layout.twig" %}
{% import "admin/partials/_table.twig" as table %}

{% block title %}Submissions{{ seo_title_separator }}{{ form.name }}{% endblock %}

{% block content %}
{% set allIds = submissions|map(s => s.id) %}
<div x-data="dataTable({perPage: 20})">

<div class="mb-6 flex items-center gap-3">
    <a href="{{ url('/admin/forms') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">← {{ __('Forms') }}</a>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Submissions') }}: {{ form.name }}</h1>
    <span class="text-sm text-gray-400 dark:text-gray-500"><span x-text="visibleCount"></span> total</span>
</div>

{% if multi_language_content and group_forms|length > 1 %}
<div class="border-b border-gray-200 dark:border-gray-700 mb-6">
    <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <a href="{{ url('/admin/forms/' ~ form.id ~ '/submissions', [], {lang: 'all'}) }}"
           class="{{ selected_lang == 'all' ? 'border-gray-900 dark:border-gray-100 text-gray-900 dark:text-gray-100 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }} whitespace-nowrap py-4 px-1 border-b-2 text-sm">
            {{ __('All Languages') }}
            <span class="ml-2 rounded-full px-2.5 py-0.5 text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                {{ counts.all }}
            </span>
        </a>
        {% for gf in group_forms %}
        <a href="{{ url('/admin/forms/' ~ form.id ~ '/submissions', [], {lang: gf.language}) }}"
           class="{{ selected_lang == gf.language ? 'border-gray-900 dark:border-gray-100 text-gray-900 dark:text-gray-100 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }} whitespace-nowrap py-4 px-1 border-b-2 text-sm">
            {{ locale_name(gf.language) }} ({{ gf.language|upper }})
            <span class="ml-2 rounded-full px-2.5 py-0.5 text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                {{ counts[gf.language]|default(0) }}
            </span>
        </a>
        {% endfor %}
    </nav>
</div>
{% endif %}

<div class="mb-4 flex flex-wrap items-center gap-3">
    {{ table.search(__('Search submissions…')) }}
    {{ table.columnsToggle() }}
</div>

<div class="overflow-x-auto rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
            <tr>
                {{ table.th_checkbox(allIds) }}
                {{ table.th(__('Data'), 'data') }}
                {{ table.th(__('Date'), 'created_at', 'right') }}
                {{ table.th(__('IP Address'), 'ip', 'left', {defaultHidden: true}) }}
                {{ table.th_static(__('Actions'), 'right') }}
            </tr>
        </thead>
        <tbody x-ref="items" class="divide-y divide-gray-200 dark:divide-gray-700">
            {% for s in submissions %}
            {% set dataPreview = s.data|slice(0, 3) %}
            {% set dataSearch = s.data|map(v => v is iterable ? v|json_encode : v)|join(' ') %}
            <tr data-row-id="{{ s.id }}"
                data-search="{{ dataSearch|e('html_attr') }}"
                data-sort="{{ {data: dataPreview|first|last|default(''), created_at: s.createdAt ? s.createdAt.format('Y-m-d H:i:s') : '', ip: s.ipAddress ?? ''}|json_encode|e('html_attr') }}"
                class="{{ not s.isRead ? 'bg-blue-50 dark:bg-blue-900/5' : 'hover:bg-gray-50 dark:hover:bg-gray-800/50' }} transition-colors">
                {{ table.td_checkbox(s.id) }}
                <td class="px-6 py-4 max-w-[400px]">
                    <div class="flex items-start gap-3">
                        {% if not s.isRead %}
                        <span class="mt-0.5 flex h-2 w-2 shrink-0 rounded-full bg-blue-600" title="{{ __('New') }}"></span>
                        {% endif %}
                        <div class="min-w-0 flex-1">
                            {% if multi_language_content and selected_lang == 'all' %}
                            {% set subForm = form_map[s.formId]|default(null) %}
                            {% if subForm %}
                            <span class="inline-flex items-center gap-1 rounded-sm bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 text-[10px] font-bold uppercase mb-2" title="{{ locale_name(subForm.language) }}">
                                {{ subForm.language }}
                            </span>
                            {% endif %}
                            {% endif %}
                            <dl class="space-y-1">
                                {% for key, value in dataPreview %}
                                <div class="flex gap-2 text-sm">
                                    <dt class="shrink-0 font-medium text-gray-500 dark:text-gray-400">{{ key|replace({'_': ' '})|capitalize }}:</dt>
                                    <dd class="text-gray-900 dark:text-gray-100 break-words">{{ value is iterable ? value|join(', ') : value }}</dd>
                                </div>
                                {% else %}
                                <span class="text-sm text-gray-400">—</span>
                                {% endfor %}
                                {% if s.data|length > 3 %}
                                <p class="text-xs text-gray-400 mt-1">{{ __('+:count more fields', {':count': s.data|length - 3}) }}</p>
                                {% endif %}
                            </dl>
                        </div>
                    </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm text-gray-500 dark:text-gray-400">
                    {{ s.createdAt ? s.createdAt.format('M j, Y H:i') : '—' }}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400 font-mono">
                    {{ s.ipAddress ?? '—' }}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                    <form method="POST" action="{{ url('/admin/forms/' ~ form.id ~ '/submissions/' ~ s.id) }}"
                          onsubmit="return confirm('{{ __('Delete this submission?')|e('js') }}')">
                        {{ csrf_field() }}<input type="hidden" name="_METHOD" value="DELETE">
                        <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">{{ __('Delete') }}</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-400">{{ __('No submissions yet.') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{{ table.pagination() }}
{% include 'admin/partials/_bulk_bar.twig' with {action: 'submissions', deleteMsg: __('Delete selected submissions?')} %}
</div>
{% endblock %}