{#
    Configuration notices banner (Dashboard).

    Rendered only when there is at least one notice — a clean installation
    shows nothing at all instead of a permanently green strip. The first
    message is shown collapsed so a long list never pushes the dashboard
    content below the fold; the full list expands on demand.
#}
{% set _status_items = status|default([]) %}
{% if _status_items|length > 0 %}
{% set _status_count = _status_items|length %}
{% set _status_first = _status_items|first %}
<div class="mb-6 overflow-hidden rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-800/80 dark:bg-amber-950/30"
     x-data="{ open: false }">
    <button type="button" @click="open = !open"
            :aria-expanded="open ? 'true' : 'false'"
            :title="open ? '{{ __('Collapse')|e('html_attr') }}' : '{{ __('Expand')|e('html_attr') }}'"
            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-amber-100/60 dark:hover:bg-amber-900/20">
        <svg class="h-5 w-5 shrink-0 text-amber-500 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <span class="flex min-w-0 items-center gap-2.5">
            <span class="inline-flex shrink-0 items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
                {{ _status_count }} {{ _status_count == 1 ? __('notice') : __('notices') }}
            </span>
            <span class="truncate text-sm font-medium text-amber-900 dark:text-amber-200">{{ _status_first.message }}</span>
        </span>
        <svg x-show="!open" class="ml-auto h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <svg x-show="open" x-cloak class="ml-auto h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>
    <div x-show="open" x-collapse x-cloak
         class="space-y-2 border-t border-amber-200 px-4 py-3 dark:border-amber-800/80">
        {% for item in _status_items %}
        <div class="flex items-start gap-3 rounded-lg border px-4 py-3 text-sm
            {{ item.type == 'warning' ? 'border-amber-200/80 bg-white/70 text-amber-900 dark:border-amber-800/80 dark:bg-amber-950/30 dark:text-amber-200' : '' }}
            {{ item.type == 'info' ? 'border-blue-300/90 bg-white text-blue-900 dark:border-blue-700 dark:bg-blue-950/50 dark:text-blue-100' : '' }}
            {{ item.type == 'error' ? 'border-red-200/80 bg-white/70 text-red-900 dark:border-red-800/80 dark:bg-red-950/30 dark:text-red-200' : '' }}">
            <svg class="mt-0.5 h-4 w-4 shrink-0
                {{ item.type == 'warning' ? 'text-amber-500 dark:text-amber-400' : '' }}
                {{ item.type == 'info' ? 'text-blue-500 dark:text-blue-400' : '' }}
                {{ item.type == 'error' ? 'text-red-500 dark:text-red-400' : '' }}"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                {% if item.type == 'warning' %}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                {% elseif item.type == 'info' %}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                {% else %}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                {% endif %}
            </svg>
            <span>{{ item.message }}
                {% if item.link is defined %}
                <a href="{{ url(item.link) }}" class="font-medium underline hover:opacity-80">{{ item.linkText }}</a>
                {% endif %}
            </span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
