{#
 # Bulk action bar — appears when items are selected via $store.bulk.
 # Renders as a compact floating pill near the last selected item.
 #}
{% set deleteMsg = deleteMsg|default(__('Are you sure you want to delete the selected items?')) %}
{% set formAction = formAction|default(url('/admin/bulk/' ~ action)) %}
<div x-data="{
    top: 0, left: 0, isCentered: true,
    updatePos() {
        if ($store.bulk.count === 0) return;
        if (window.innerWidth < 640) {
            this.isCentered = true;
            return;
        }
        if ($store.bulk.selectAll || $store.bulk.selectAllVisible) {
            const selectAllCb = $store.bulk.getVisibleSelectAllCheckbox();
            if (selectAllCb) {
                const r = selectAllCb.getBoundingClientRect();
                this.top = r.bottom + 8;
                this.left = r.left;
                this.isCentered = false;
            } else {
                this.isCentered = true;
            }
            if (this.top < 10 || this.left < 20) this.isCentered = true;
            return;
        }
        const lastId = $store.bulk.lastSelectedId;
        const cb = lastId ? $store.bulk.getVisibleCheckbox(lastId) : null;
        if (!cb) {
            this.isCentered = true;
            return;
        }
        const rect = cb.getBoundingClientRect();
        this.top = rect.top - 70;
        this.left = rect.left + 40;
        this.isCentered = false;
        if (this.top < 10 || this.left < 20) {
            this.isCentered = true;
            return;
        }
        if (this.left + 350 > window.innerWidth) this.left = window.innerWidth - 370;
    }
}"
x-init="$watch('$store.bulk.updateTrigger', () => { $nextTick(() => updatePos()); }); window.addEventListener('scroll', () => updatePos()); window.addEventListener('resize', () => updatePos())"
x-show="$store.bulk.count > 0"
x-cloak
class="fixed z-40 pointer-events-none flex items-center justify-center max-w-[calc(100vw-1rem)] sm:max-w-none"
:style="isCentered ? 'bottom: 20px; left: 50%; transform: translateX(-50%);' : 'top: ' + top + 'px; left: ' + left + 'px;'">

    <div x-show="$store.bulk.count > 0"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="scale-90 opacity-0"
         x-transition:enter-end="scale-100 opacity-100"
         class="pointer-events-auto flex flex-wrap items-center justify-center gap-2 sm:gap-4 rounded-xl border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 shadow-[0_20px_50px_rgba(0,0,0,0.5)] px-3 py-2 sm:px-4 ring-4 ring-black/5 dark:ring-white/5 opacity-100! max-w-full"
         style="opacity: 1 !important;">

        <div class="flex items-center gap-2 sm:gap-3 border-r pr-2 sm:pr-4 border-gray-200 dark:border-gray-700 shrink-0">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gray-900 dark:bg-gray-100 text-[10px] font-bold text-white dark:text-gray-900" x-text="$store.bulk.count"></span>
            <button type="button" @click="$store.bulk.selectAllItems()"
                    class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:underline whitespace-nowrap"
                    x-text="$store.bulk.selectAll ? '{{ __('Deselect All') }}' : '{{ __('Select All') }}'">
            </button>
        </div>

        <div class="flex flex-wrap items-center gap-2 justify-center">
            <button @click="$store.bulk.clear()" type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 mr-1 shrink-0" title="{{ __('Cancel') }}">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <form method="post" action="{{ formAction }}" class="flex flex-wrap items-center gap-2 justify-center">
                {{ csrf_field() }}
                <input type="hidden" name="ids" :value="$store.bulk.selected.join(',')">
                <input type="hidden" name="select_all" :value="$store.bulk.selectAll ? '1' : '0'">

                {% for extra in extraActions|default([]) %}
                <button type="submit"
                        name="{{ extra.name|default('action') }}"
                        value="{{ extra.value|default(extra.action) }}"
                        {% if extra.formaction is defined %}formaction="{{ extra.formaction }}"{% endif %}
                        {% if extra.click is defined %}@click="{{ extra.click }}"{% endif %}
                        {{ extra.attributes|default('')|raw }}
                        class="rounded-lg {{ extra.class|default('bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600') }} px-2.5 py-1.5 sm:px-3 text-xs font-bold transition-colors shadow-xs whitespace-nowrap">
                    {{ extra.label }}
                </button>
                {% endfor %}

                {% if showDelete is not defined or showDelete %}
                <button type="submit" name="action" value="delete"
                        {% if deleteFormaction is defined and deleteFormaction %}formaction="{{ deleteFormaction }}"{% endif %}
                        @click="if (!confirm($store.bulk.count + ' {{ __('item(s) selected')|e('js') }}\n\n{{ deleteMsg|e('js') }}')) $event.preventDefault()"
                        class="rounded-lg bg-red-600 dark:bg-red-700 px-2.5 py-1.5 sm:px-3 text-xs font-bold text-white hover:bg-red-700 dark:hover:bg-red-800 transition-colors shadow-xs whitespace-nowrap">
                    {{ __('Delete') }}
                </button>
                {% endif %}
            </form>
        </div>
    </div>
</div>
<style>
    .dark .fixed.z-40 > div { background-color: #1f2937 !important; }
</style>
