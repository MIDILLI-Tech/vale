{#
    Needs Attention (Dashboard) — operational queue.

    Shows work that is waiting on the current user: comments to moderate,
    orders to fulfil, drafts to finish, scheduled posts to preview. Rows are
    filtered by feature flags + permissions so a user only sees queues they
    can actually act on. When nothing is left, a single green line is shown.
#}
{% set _can_content = (_po_can|default(false) and (blog_enabled|default(false) or custom_content_types_enabled|default(false)))
                      or (_p_can|default(false) and pages_enabled|default(false)) %}
{% set _visible = {
    comments:  _po_can|default(false) and (blog_enabled|default(false) or custom_content_types_enabled|default(false)),
    orders:    _o_can|default(false),
    drafts:    _can_content,
    scheduled: _can_content,
} %}

{% set _rows = [] %}
{% for item in attention|default([]) %}
    {% if _visible[item.id]|default(false) %}
        {% set _rows = _rows|merge([item]) %}
    {% endif %}
{% endfor %}

<section class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-gray-700 dark:bg-gray-800 overflow-hidden"
         x-data="{ collapsed: localStorage.getItem('vl_dash_needs_attention_collapsed') === '1' }">
    <header class="px-5 py-4 flex items-center justify-between gap-3">
        <div class="flex min-w-0 flex-wrap items-center gap-2">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ __('Needs Attention') }}</h2>
            {% if _rows|length > 0 %}
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                {{ _rows|length }}
            </span>
            {% endif %}
        </div>
        <button type="button" @click="collapsed = !collapsed; localStorage.setItem('vl_dash_needs_attention_collapsed', collapsed ? '1' : '0')"
                class="text-gray-400 transition-colors hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"
                :title="collapsed ? '{{ __('Expand')|e('html_attr') }}' : '{{ __('Collapse')|e('html_attr') }}'">
            <svg x-show="!collapsed" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
            <svg x-show="collapsed" x-cloak class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
    </header>
    <div x-show="!collapsed" x-collapse x-cloak class="px-5 pb-5">

    {% if _rows|length > 0 %}
    <div class="space-y-2">
        {% for item in _rows %}
        <a href="{{ url(item.link) }}"
           class="group flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 transition-colors hover:border-amber-300 hover:bg-amber-50 dark:border-gray-700 dark:hover:border-amber-700 dark:hover:bg-amber-950/30">
            <span class="inline-flex h-8 min-w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 px-2 text-sm font-semibold text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                {{ item.count }}
            </span>
            <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-800 dark:text-gray-200">{{ item.message }}</span>
            <span class="shrink-0 text-xs font-medium text-gray-500 transition-colors group-hover:text-amber-700 dark:text-gray-400 dark:group-hover:text-amber-300">{{ item.linkText }}</span>
            <svg class="h-4 w-4 shrink-0 text-gray-400 transition-colors group-hover:text-amber-600 dark:text-gray-500 dark:group-hover:text-amber-400"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </a>
        {% endfor %}
    </div>
    {% else %}
    <div class="flex items-center gap-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 dark:border-green-800/80 dark:bg-green-950/30">
        <svg class="h-5 w-5 shrink-0 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <p class="text-sm text-green-800 dark:text-green-200">{{ __('Nothing needs attention right now.') }}</p>
    </div>
    {% endif %}
    </div>
</section>
