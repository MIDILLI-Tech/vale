{#
 # Icon-only row actions for admin list tables.
 #
 # Usage:
 #   {% import "admin/partials/_row_actions.twig" as actions %}
 #
 #   {{ actions.link(url('/admin/pages/1/edit'), 'pencil', __('Edit')) }}
 #   <form method="post" action="…" class="inline-flex">
 #       {{ csrf_field() }}
 #       {{ actions.submit('trash', __('Delete'), 'danger') }}
 #   </form>
 #   <button type="button" @click="openEdit()" title="{{ __('Edit') }}"
 #           aria-label="{{ __('Edit') }}" class="{{ actions.classes() }}">
 #       {{ icons.icon('pencil') }}
 #   </button>
 #
 # Tones: neutral | danger | success | warning | info | muted
 # Sizes: md (32px) | sm (28px)
 #
 # Every button keeps its translated label as both the hover title and the
 # accessible name; the glyph itself is aria-hidden.
 #}
{% macro classes(tone = 'neutral', size = 'md') %}
    {%- set base = 'inline-flex shrink-0 items-center justify-center rounded-md ring-1 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-1 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900' -%}
    {%- set box = size == 'sm' ? 'h-7 w-7' : 'h-8 w-8' -%}
    {%- set tones = {
        neutral: 'text-gray-600 ring-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-100',
        danger: 'text-red-600 ring-red-300 hover:bg-red-50 dark:text-red-400 dark:ring-red-700 dark:hover:bg-red-950/40',
        success: 'text-green-700 ring-green-300 hover:bg-green-50 dark:text-green-400 dark:ring-green-700 dark:hover:bg-green-950/40',
        warning: 'text-amber-700 ring-amber-300 hover:bg-amber-50 dark:text-amber-400 dark:ring-amber-700 dark:hover:bg-amber-950/40',
        info: 'text-blue-700 ring-blue-300 hover:bg-blue-50 dark:text-blue-400 dark:ring-blue-700 dark:hover:bg-blue-950/40',
        muted: 'cursor-not-allowed text-gray-400 ring-gray-200 dark:text-gray-500 dark:ring-gray-700',
    } -%}
    {{- base ~ ' ' ~ box ~ ' ' ~ (tones[tone]|default(tones.neutral)) -}}
{% endmacro %}

{% macro link(href, icon, label, tone = 'neutral', opts = {}) %}
{% import "admin/partials/_icons.twig" as icons %}
<a href="{{ href }}"
   title="{{ label }}"
   aria-label="{{ label }}"
   {%- if opts.external|default(false) %} target="_blank" rel="noopener"{% endif %}
   class="{{ _self.classes(tone, opts.size|default('md')) }}">
    {{ icons.icon(icon, opts.size|default('md') == 'sm' ? 'h-3.5 w-3.5' : 'h-4 w-4') }}
</a>
{% endmacro %}

{% macro submit(icon, label, tone = 'neutral', opts = {}) %}
{% import "admin/partials/_icons.twig" as icons %}
<button type="submit"
        title="{{ label }}"
        aria-label="{{ label }}"
        class="{{ _self.classes(tone, opts.size|default('md')) }}">
    {{ icons.icon(icon, opts.size|default('md') == 'sm' ? 'h-3.5 w-3.5' : 'h-4 w-4') }}
</button>
{% endmacro %}
