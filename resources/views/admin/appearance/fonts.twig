{% extends "admin/layout.twig" %}

{% block title %}{{ __('Fonts') }}{% endblock %}

{% block content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Fonts') }}</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ __('Choose the primary font for your website frontend.') }}</p>
</div>

<form method="post" action="{{ url('/admin/appearance/fonts') }}">
    {{ csrf_field() }}

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% for font in fonts %}
        <label class="relative cursor-pointer">
            <input type="radio" name="font" value="{{ font.id }}" class="peer sr-only" {{ font.id == current_font ? 'checked' : '' }}>

            <div class="h-full rounded-xl border-2 bg-white p-5 shadow-xs transition-all peer-checked:border-gray-900 dark:bg-gray-900 dark:peer-checked:border-gray-100 dark:border-gray-800">
                <div class="flex flex-col h-full">
                    <div class="mb-4">
                        <span class="block text-lg font-bold text-gray-900 dark:text-gray-100">{{ font.name }}</span>
                    </div>

                    <div class="mb-6 grow">
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">{{ font.description }}</p>
                        <div class="rounded-lg bg-gray-50 p-4 dark:bg-gray-800/50">
                            <div class="{{ font.class }} space-y-2">
                                <p class="text-xl font-bold text-gray-900 dark:text-gray-100">Abc 123</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">The quick brown fox jumps over the lazy dog.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto pt-4 flex items-center justify-between">
                        <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">{{ __('Preview') }}</span>
                        <div class="opacity-0 transition-opacity peer-checked:opacity-100 text-gray-900 dark:text-gray-100">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="absolute inset-0 rounded-xl ring-2 ring-gray-900 ring-offset-2 opacity-0 transition-opacity peer-checked:opacity-100 dark:ring-gray-100 dark:ring-offset-gray-950 pointer-events-none"></div>
        </label>
        {% endfor %}
    </div>

    <div class="mt-8 flex justify-end">
        <button type="submit" class="rounded-lg bg-gray-900 px-6 py-2.5 text-sm font-bold text-white hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
            {{ __('Save Font Settings') }}
        </button>
    </div>
</form>

<style>
    .font-roboto { font-family: 'Roboto', sans-serif; }
    .font-open-sans { font-family: 'Open Sans', sans-serif; }
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-playfair { font-family: 'Playfair Display', serif; }
    /* Inter is default sans */
</style>
{% endblock %}
