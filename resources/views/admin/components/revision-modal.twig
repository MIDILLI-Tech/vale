{% set rp = revision_url_prefix|default('/admin/posts/') %}
<div x-data="revisionHistory({
    postId: {{ post.id }},
    jsonUrl: '{{ url(rp ~ post.id ~ '/revisions/json') }}',
    detailUrl: '{{ url(rp ~ post.id ~ '/revisions/__REV_ID__') }}',
    diffUrl: '{{ url(rp ~ post.id ~ '/revisions/__REV_ID__/diff/__TYPE__') }}',
    restoreUrl: '{{ url(rp ~ post.id ~ '/revisions/__REV_ID__/restore') }}',
    deleteUrl: '{{ url(rp ~ post.id ~ '/revisions/__REV_ID__/delete') }}',
    csrfToken: '{{ csrf_token() }}',
})">
    <button type="button" @click="open()"
            class="mt-3 flex items-center justify-center gap-1 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50">
        &#128214; {{ __('Revision History') }} <span x-text="count ? '(' + count + ')' : ''"></span>
    </button>

    <div x-show="show" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
         @keydown.escape.window="close()">
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col mx-4">

            <div class="flex items-center justify-between px-6 py-4 border-b shrink-0">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">&#128214; {{ __('Revision History') }}</h2>
                <button type="button" @click="close()" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 text-2xl leading-none">&times;</button>
            </div>

            <div class="flex-1 overflow-y-auto p-6" x-show="!selected" x-cloak>
                <template x-if="!loading && revisions.length === 0">
                    <p class="text-gray-500 dark:text-gray-400 text-center py-8">{{ __('No revisions yet.') }}</p>
                </template>
                <template x-if="loading">
                    <p class="text-gray-500 dark:text-gray-400 text-center py-8"><span class="vl-icon-refresh vl-icon-spin"></span> {{ __('Loading...') }}</p>
                </template>
                <template x-if="!loading && revisions.length > 0">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700/50">
                                <th class="pb-3 pl-4 pr-4 font-medium">{{ __('Revision') }}</th>
                                <th class="pb-3 pr-4 font-medium">{{ __('Date') }}</th>
                                <th class="pb-3 pr-4 font-medium">{{ __('Author') }}</th>
                                <th class="pb-3 pr-4 text-right font-medium">{{ __('Actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="rev in revisions" :key="rev.id">
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 dark:border-gray-700/40 dark:hover:bg-white/5 transition-colors">
                                    <td class="py-3.5 pl-4 pr-4 text-gray-900 dark:text-gray-100 font-mono text-xs" x-text="'#' + rev.revision_number"></td>
                                    <td class="py-3.5 pr-4 text-gray-600 dark:text-gray-400" x-text="rev.created_at"></td>
                                    <td class="py-3.5 pr-4 text-gray-600 dark:text-gray-400" x-text="rev.author_name"></td>
                                    <td class="py-3.5 pr-4 text-right">
                                        <div class="inline-flex items-center justify-end gap-2">
                                            <button type="button" @click="select(rev)"
                                                    class="rounded-sm px-3 py-1.5 text-xs font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50 dark:bg-transparent dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700/50">{{ __('View') }}</button>
                                            <button type="button" @click="confirmRestore(rev)"
                                                    class="rounded-sm px-3 py-1.5 text-xs font-medium text-green-700 ring-1 ring-green-300 hover:bg-green-50 dark:text-green-400 dark:ring-green-700 dark:hover:bg-green-900/50">{{ __('Restore') }}</button>
                                            <button type="button" @click="confirmDelete(rev)"
                                                    class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-gray-700 hover:bg-red-50 dark:hover:bg-red-900/20">{{ __('Delete') }}</button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </template>
            </div>

            <div class="flex-1 overflow-y-auto p-6" x-show="selected" x-cloak>
                <button type="button" @click="selected = null" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 mb-4">&larr; {{ __('Back to list') }}</button>

                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100" x-text="selected ? '{{ __('Revision') }} #' + selected.revision_number : ''"></h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" x-text="selected ? selected.created_at + ' {{ __('by') }} ' + selected.author_name : ''"></p>

                <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mt-4 mb-2">{{ __('Title') }}</h4>
                <div class="bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700/60 rounded-lg p-3 text-sm font-mono overflow-x-auto text-gray-900 dark:text-gray-100" x-html="selected ? selected.title_diff : ''"></div>

                <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mt-4 mb-2">{{ __('Content') }}</h4>

                <div x-show="!detailLoading && !detailError" class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-sm max-h-80 overflow-y-auto whitespace-pre-wrap font-mono text-xs leading-relaxed text-yellow-800" x-text="selected ? (selected.bodyReadable || selected.body || '') : ''"></div>
                <div x-show="detailLoading" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 py-4">
                    <span class="vl-icon-refresh vl-icon-spin"></span> {{ __('Loading...') }}
                </div>
                <div x-show="detailError" class="text-red-600 dark:text-red-400 py-4 text-sm">
                    {{ __('Failed to load revision content.') }}
                </div>

                <div class="flex gap-2 mt-4">
                    <button type="button" @click="showDiff('current')"
                            :class="activeDiff === 'current' ? 'bg-gray-900 dark:bg-gray-700 text-white' : 'border border-gray-300 dark:border-gray-700 text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50'"
                            class="rounded-lg px-3 py-1.5 text-xs font-medium transition-colors">
                        {{ __('Compare changes with latest version') }}
                    </button>
                    <button type="button" @click="showDiff('previous')" x-show="selected && selected.prev_revision_number"
                            :class="activeDiff === 'previous' ? 'bg-gray-900 dark:bg-gray-700 text-white' : 'border border-gray-300 dark:border-gray-700 text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50'"
                            class="rounded-lg px-3 py-1.5 text-xs font-medium transition-colors"
                            x-text="selected ? '{{ __('Compare changes with Revision') }} #' + selected.prev_revision_number : ''">
                    </button>
                </div>

                <div x-show="diffLoading" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 py-4">
                    <span class="vl-icon-refresh vl-icon-spin"></span> {{ __('Loading diff...') }}
                </div>
                <div x-show="diffError" class="text-red-600 dark:text-red-400 py-4 text-sm">
                    {{ __('Failed to load diff.') }}
                </div>
                <div x-show="!diffLoading && !diffError && activeDiff" class="mt-2">
                    <div class="flex gap-4 mb-2 text-xs text-gray-500 dark:text-gray-400">
                        <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm vl-diff-swatch-del"></span> <span x-text="activeDiff === 'current' ? '{{ __('Latest version') }}' : (selected ? '{{ __('Revision') }} #' + selected.prev_revision_number : '')"></span></span>
                        <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm vl-diff-swatch-add"></span> <span x-text="selected ? '{{ __('Revision') }} #' + selected.revision_number : ''"></span></span>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700/60 rounded-lg p-3 text-sm max-h-96 overflow-y-auto" x-html="diffCache[activeDiff]"></div>
                </div>
                <div x-show="!diffLoading && !diffError && !activeDiff" class="text-gray-400 dark:text-gray-500 text-sm py-4">
                    {{ __('Click a button above to see the changes.') }}
                </div>

                <div class="mt-6 flex gap-3">
                    <button type="button" @click="confirmRestore(selected)"
                            class="rounded-lg bg-red-600 dark:bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 dark:hover:bg-red-800">
                        &#8635; {{ __('Restore this Revision') }}
                    </button>
                    <button type="button" @click="confirmDelete(selected)"
                            class="rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-red-600 hover:border-red-300 dark:hover:text-red-400 dark:hover:border-red-700">
                        &#128465; {{ __('Delete this Revision') }}
                    </button>
                </div>
            </div>

            <div x-show="restoreConfirm" x-cloak class="fixed inset-0 z-60 flex items-center justify-center bg-black/40"
                 @keydown.escape.window="restoreConfirm = null">
                <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl p-6 max-w-md mx-4">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Restore Revision?') }}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{{ __('The current state will be saved as a new revision before restoring.') }}</p>
                    <div class="flex justify-end gap-3">
                        <button type="button" @click="restoreConfirm = null" class="rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50">{{ __('Cancel') }}</button>
                        <button type="button" @click="doRestore()" class="rounded-lg bg-red-600 dark:bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 dark:hover:bg-red-800">{{ __('Restore') }}</button>
                    </div>
                </div>
            </div>

            <div x-show="deleteConfirm" x-cloak class="fixed inset-0 z-60 flex items-center justify-center bg-black/40"
                 @keydown.escape.window="deleteConfirm = null">
                <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl p-6 max-w-md mx-4">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Delete Revision?') }}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{{ __('This action cannot be undone.') }}</p>
                    <div class="flex justify-end gap-3">
                        <button type="button" @click="deleteConfirm = null" class="rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50">{{ __('Cancel') }}</button>
                        <button type="button" @click="doDelete()" class="rounded-lg bg-red-600 dark:bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 dark:hover:bg-red-800">{{ __('Delete') }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
