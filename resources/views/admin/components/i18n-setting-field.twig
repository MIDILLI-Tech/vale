{# Translatable settings field with optional per-locale tabs (redirects pattern). #}
<div{% if i18n_fields %} x-data="{ activeLang: '{{ default_lang }}' }"{% endif %}
     {% if vl_tab is defined %}
     data-vl-setting
     data-vl-tab="{{ vl_tab }}"
     data-vl-label="{{ label|e('html_attr') }}"
     {% if field|default('') %}data-vl-key="{{ field|e('html_attr') }}"{% endif %}
     {% if vl_subtab|default('') %}data-vl-subtab="{{ vl_subtab|e('html_attr') }}"{% endif %}
     {% if vl_section|default('') %}data-vl-section="{{ vl_section|e('html_attr') }}"{% endif %}
     {% if vl_keywords|default('') %}data-vl-keywords="{{ vl_keywords|e('html_attr') }}"{% endif %}
     {% endif %}>
    <div class="flex flex-wrap items-center justify-between gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ label }}</label>
        {% if i18n_fields %}
        <div class="flex w-fit gap-1 rounded-lg bg-gray-100 p-1 dark:bg-gray-800">
            {% for code, name in active_locales %}
            <button type="button"
                    @click="activeLang = '{{ code }}'"
                    :class="activeLang === '{{ code }}' ? 'bg-white shadow-xs text-gray-900 dark:bg-gray-600 dark:text-white dark:shadow-sm dark:ring-1 dark:ring-gray-500' : 'text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'"
                    class="rounded-md px-3 py-1 text-xs font-medium transition-all">
                {{ locale_name(code) }} ({{ code|upper }})
            </button>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {% for code, name in field_locales %}
    {% set suffix = (code == default_lang ? '' : '_' ~ code) %}
    {% set field_name = field ~ suffix %}
    {% set field_value = settings[field_name]|default('') %}
    <div{% if i18n_fields %} x-show="activeLang === '{{ code }}'" x-cloak{% endif %} class="mt-1">
        {% if type|default('text') == 'textarea' %}
        <textarea name="{{ field_name }}" rows="{{ rows|default(3) }}"
                  class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm"
                  {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}>{{ field_value }}</textarea>
        {% else %}
        <input type="text" name="{{ field_name }}" value="{{ field_value }}"
               class="w-full rounded-lg border-gray-300 dark:border-gray-700"
               {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}>
        {% endif %}
        {% if i18n_fields and code != default_lang %}
        <p class="mt-1 text-xs text-gray-400">{{ __('Leave empty to use the default language value.') }}</p>
        {% endif %}
    </div>
    {% endfor %}

    {% if hint is defined %}
    <p class="mt-1 text-xs text-gray-400">{{ hint|raw }}</p>
    {% endif %}
</div>
