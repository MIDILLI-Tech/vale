                </div>
                <div x-show="carrier === 'other'" x-cloak>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">{{ __('Tracking URL') }} <span class="text-red-500 dark:text-red-400">*</span></label>
                    <input type="url" name="tracking_url"
                           value="{{ order.carrier == 'other' ? order.trackingNumber|default('') : '' }}"
