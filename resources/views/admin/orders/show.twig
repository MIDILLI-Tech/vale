                                    <button type="submit"
                                            class="rounded-sm border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-2 py-0.5 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">{{ __('Update') }}</button>
                                </form>
                                {% if dl.revoked %}<span class="text-red-500 dark:text-red-400 font-semibold">{{ __('REVOKED') }}</span>{% endif %}
