{% extends "admin/layout.twig" %}

{% block title %}Order {{ order.orderNumber }}{% endblock %}

{% block content %}
{% set status_labels = {
    'pending':    'Pending Payment',
    'processing': 'Paid & Processing',
    'on-hold':    'On Hold',
    'shipped':    'Shipped',
    'completed':  'Completed',
    'refund_requested': 'Refund Requested',
    'refund_rejected': 'Refund Rejected',
    'refunded':   'Refunded',
    'cancelled':  'Cancelled'
} %}
{% set status_colors = {
    'pending':    'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300',
    'processing': 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
    'on-hold':    'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300',
    'shipped':    'bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
    'completed':  'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
    'refund_requested': 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    'refund_rejected': 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
    'refunded':   'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300',
    'cancelled':  'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300'
} %}

<div class="mb-6 flex items-center gap-3 flex-wrap">
    <a href="{{ url('/admin/orders') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700">← Orders</a>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Order {{ order.orderNumber }}</h1>
    <span data-clean-badge class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">✓ {{ __('Saved') }}</span>
    <span data-dirty-badge class="hidden px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">● {{ __('Unsaved changes') }}</span>
    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold {{ status_colors[order.status]|default('bg-gray-100 text-gray-700') }}">
        {{ status_labels[order.status]|default(order.status|capitalize) }}
    </span>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

    {# LEFT COLUMN #}
    <div class="xl:col-span-2 space-y-6">

        {# Items #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 shadow-xs overflow-x-auto">
            <div class="px-6 py-4 border-b bg-gray-50 dark:bg-gray-800/50 font-semibold text-sm text-gray-700">Order Items</div>
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-800/50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Product</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('SKU') }}</th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Qty</th>
                        <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('Price') }}</th>
                        <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {% for item in order.items %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900 dark:text-gray-100">
                            {% if item.product_id %}
                            <a href="{{ url('/admin/products/' ~ item.product_id ~ '/edit') }}" class="text-gray-900 dark:text-gray-100 hover:underline">{{ item.name|default('—') }}</a>
                            {% else %}
                            {{ item.name|default('—') }}
                            {% endif %}
                            {% if item.variation_data|default({})|length > 0 %}
                            <div class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                                {% for attr, val in item.variation_data %}{% if val %}{{ attr }}: {{ val }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
                            </div>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-xs text-gray-500 dark:text-gray-400 font-mono">{{ item.sku|default('—') }}</td>
                        <td class="px-6 py-4 text-sm text-center text-gray-700">{{ item.quantity|default(item.qty)|default(1) }}</td>
                        <td class="px-6 py-4 text-sm text-right text-gray-700">
                            {{ item.price|price(order.currency) }}
                            {% if item.tax_amount is defined and item.tax_amount is not null %}
                            <span class="block text-xs text-gray-400 dark:text-gray-500">{{ __('Included VAT') }} {{ item.tax_amount|price(order.currency) }}{% if item.tax_rate %} ({{ item.tax_rate|num(2) }}%){% endif %}</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-right font-medium text-gray-900 dark:text-gray-100">{{ item.subtotal|default(item.price * item.quantity)|price(order.currency) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="bg-gray-50 dark:bg-gray-800/50 border-t">
                    {% set _taxRate = null %}
                    {% for item in order.items %}
                        {% if _taxRate is null and item.tax_rate is defined and item.tax_rate %}
                            {% set _taxRate = item.tax_rate %}
                        {% endif %}
                    {% endfor %}
                    {% if _taxRate is null and invoice_snapshot is defined and invoice_snapshot %}
                        {% set _taxRate = invoice_snapshot.tax_rate|default(null) %}
                    {% endif %}
                    <tr>
                        <td colspan="4" class="px-6 py-3 text-right text-sm text-gray-500 dark:text-gray-400">Subtotal</td>
                        <td class="px-6 py-3 text-right text-sm font-medium text-gray-900 dark:text-gray-100">{{ order.subtotal|price(order.currency) }}</td>
                    </tr>
                    {% if order.shipping > 0 %}
                    <tr>
                        <td colspan="4" class="px-6 py-2 text-right text-sm text-gray-500 dark:text-gray-400">Shipping</td>
                        <td class="px-6 py-2 text-right text-sm text-gray-700">{{ order.shipping|price(order.currency) }}</td>
                    </tr>
                    {% endif %}
                    {% if order.discount > 0 %}
                    <tr>
                        <td colspan="4" class="px-6 py-2 text-right text-sm text-gray-500 dark:text-gray-400">Discount{% if order.couponCode %} ({{ order.couponCode }}){% endif %}</td>
                        <td class="px-6 py-2 text-right text-sm text-green-700">− {{ order.discount|price(order.currency) }}</td>
                    </tr>
                    {% endif %}
                    {% if order.tax > 0 %}
                    <tr>
                        <td colspan="4" class="px-6 py-2 text-right text-sm text-gray-500 dark:text-gray-400">
                            {{ __('Included VAT') }}{% if _taxRate %} ({{ _taxRate|num(2) }}%){% endif %}
                        </td>
                        <td class="px-6 py-2 text-right text-sm text-gray-700">{{ order.tax|price(order.currency) }}</td>
                    </tr>
                    {% endif %}
                    <tr class="border-t">
                        <td colspan="4" class="px-6 py-3 text-right text-sm font-bold text-gray-800 dark:text-gray-100">{{ __('Total') }}</td>
                        <td class="px-6 py-3 text-right text-sm font-bold text-gray-900 dark:text-gray-100">{{ order.total|price(order.currency) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# Billing #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Billing Details</h3>
            {% set b = order.billing %}
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/billing') }}" class="space-y-3">
                {{ csrf_field() }}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">First name</label>
                        <input type="text" name="first_name" required value="{{ b.first_name|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Last name</label>
                        <input type="text" name="last_name" value="{{ b.last_name|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">{{ __('Email') }}</label>
                        <input type="email" name="email" required value="{{ b.email|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Phone</label>
                        <input type="text" name="phone" value="{{ b.phone|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Address 1</label>
                        <input type="text" name="address_1" value="{{ b.address_1|default(b.address)|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Address 2</label>
                        <input type="text" name="address_2" value="{{ b.address_2|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">City</label>
                        <input type="text" name="city" value="{{ b.city|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">State / Region</label>
                        <input type="text" name="state" value="{{ b.state|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Postcode</label>
                        <input type="text" name="postcode" value="{{ b.postcode|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Country</label>
                        <select name="country"
                                x-data="{
                                    regionNames: (typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
                                        ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' })
                                        : null,
                                    init() {
                                        var sel = this.$el, val = sel.value, items = [];
                                        for (var i = 1; i < sel.options.length; i++) {
                                            var code = sel.options[i].value;
                                            if (!code) continue;
                                            var name = code;
                                            if (this.regionNames) {
                                                try { name = this.regionNames.of(code) || code; } catch(e) {}
                                            }
                                            items.push({ code: code, name: name });
                                        }
                                        if (!items.length) return;
                                        items.sort(function(a, b) { return a.name.localeCompare(b.name, navigator.language || 'en'); });
                                        while (sel.options.length > 1) { sel.remove(1); }
                                        items.forEach(function(item) {
                                            var opt = document.createElement('option');
                                            opt.value = item.code;
                                            opt.textContent = item.name + ' (' + item.code + ')';
                                            if (item.code === val) opt.selected = true;
                                            sel.appendChild(opt);
                                        });
                                    }
                                }"
                                class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="">— {{ __('Select') }} —</option>
                            {% for code in country_codes|default([]) %}
                            <option value="{{ code }}" {{ code == b.country|default('') ? 'selected' : '' }}>{{ code }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <button type="submit" class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    Save Billing Details
                </button>
            </form>

            {% if b.checkout_form is defined and b.checkout_form.fields is defined and b.checkout_form.fields|length > 0 %}
            <div class="mt-5 border-t pt-4">
                <h4 class="text-sm font-semibold text-gray-800 mb-2">{{ b.checkout_form.form_name|default('Checkout Form') }}</h4>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    {% for key, val in b.checkout_form.fields %}
                    <dt class="text-gray-500 dark:text-gray-400">{{ key|replace({'_': ' '})|title }}</dt>
                    <dd>
                        {% if val is iterable %}
                            {{ val|join(', ') }}
                        {% elseif val is same as(true) %}
                            Yes
                        {% elseif val is same as(false) %}
                            No
                        {% else %}
                            {{ val }}
                        {% endif %}
                    </dd>
                    {% endfor %}
                </dl>
            </div>
            {% endif %}
        </div>

        {# Shipping #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Shipping Details</h3>
            {% set s = order.shippingAddress %}
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/shipping') }}" class="space-y-3">
                {{ csrf_field() }}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">First name</label>
                        <input type="text" name="shipping_first_name" value="{{ s.first_name|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Last name</label>
                        <input type="text" name="shipping_last_name" value="{{ s.last_name|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Company</label>
                        <input type="text" name="shipping_company" value="{{ s.company|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Address 1</label>
                        <input type="text" name="shipping_address_1" value="{{ s.address_1|default(s.address)|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Address 2</label>
                        <input type="text" name="shipping_address_2" value="{{ s.address_2|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">City</label>
                        <input type="text" name="shipping_city" value="{{ s.city|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">State / Region</label>
                        <input type="text" name="shipping_state" value="{{ s.state|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Postcode</label>
                        <input type="text" name="shipping_postcode" value="{{ s.postcode|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Country</label>
                        <select name="shipping_country"
                                x-data="{
                                    regionNames: (typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
                                        ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' })
                                        : null,
                                    init() {
                                        var sel = this.$el, val = sel.value, items = [];
                                        for (var i = 1; i < sel.options.length; i++) {
                                            var code = sel.options[i].value;
                                            if (!code) continue;
                                            var name = code;
                                            if (this.regionNames) {
                                                try { name = this.regionNames.of(code) || code; } catch(e) {}
                                            }
                                            items.push({ code: code, name: name });
                                        }
                                        if (!items.length) return;
                                        items.sort(function(a, b) { return a.name.localeCompare(b.name, navigator.language || 'en'); });
                                        while (sel.options.length > 1) { sel.remove(1); }
                                        items.forEach(function(item) {
                                            var opt = document.createElement('option');
                                            opt.value = item.code;
                                            opt.textContent = item.name + ' (' + item.code + ')';
                                            if (item.code === val) opt.selected = true;
                                            sel.appendChild(opt);
                                        });
                                    }
                                }"
                                class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="">— {{ __('Select') }} —</option>
                            {% for code in country_codes|default([]) %}
                            <option value="{{ code }}" {{ code == s.country|default('') ? 'selected' : '' }}>{{ code }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Phone</label>
                        <input type="text" name="shipping_phone" value="{{ s.phone|default('') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                    </div>
                </div>
                <button type="submit" class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    Save Shipping Details
                </button>
            </form>
        </div>

        {# Activity Log #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 shadow-xs overflow-x-auto">
            <div class="px-6 py-4 border-b bg-gray-50 dark:bg-gray-800/50 font-semibold text-sm text-gray-700">Activity Log</div>
            {% if logs is empty %}
                <p class="px-6 py-5 text-sm text-gray-400 italic">No activity recorded yet.</p>
            {% else %}
                <ul class="divide-y divide-gray-100">
                    {# Human labels for technical event keys; anything unmapped falls
                       back to the auto title-case transform. #}
                    {% set log_event_labels = {
                        'null_mail': __('Mail Not Configured'),
                        'mail_not_configured': __('Mail Not Configured')
                    } %}
                    {% for log in logs %}
                    {% set dot_color = log.type == 'note' ? 'bg-amber-400' : (log.type == 'email' ? 'bg-sky-400' : 'bg-indigo-400') %}
                    <li class="px-6 py-3 flex items-start gap-3">
                        <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full {{ dot_color }}"></span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-800">
                                {{ log_event_labels[log.event]|default(log.event|replace({'_': ' '})|title) }}
                            </p>
                            {% if log.event in ['invoice_issued', 'invoice_reissued'] and invoice_version_map is defined and invoice_version_map[log.id] is defined %}
                            {% set _v = invoice_version_map[log.id] %}
                            <p class="text-xs text-gray-600 mt-0.5">
                                {{ _v.snapshot.invoice_number|default('') }} &middot;
                                {{ _v.snapshot.total|default(0)|number_format(2, '.', ',') }} {{ _v.snapshot.currency|default('') }}
                                &middot; <a href="{{ url('/admin/orders/' ~ order.id ~ '/invoice?log=' ~ log.id) }}" target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline">{{ __('View version') }}</a>
                            </p>
                            {% elseif log.note %}
                            <p class="text-xs text-gray-600 mt-0.5 whitespace-pre-line">{{ log.note }}</p>
                            {% endif %}
                            <p class="text-xs text-gray-400 mt-0.5">
                                {{ log.createdAt|date('Y-m-d H:i:s') }}
                                {% if log.addedBy %} &middot; {{ log.addedBy }}{% endif %}
                            </p>
                        </div>
                        {% if log.type == 'note' %}
                        <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/logs/' ~ log.id ~ '/delete') }}"
                              onsubmit="return confirm('Delete this note?')" class="shrink-0">
                            {{ csrf_field() }}
                            <button type="submit"
                                    class="text-xs text-red-400 hover:text-red-600 px-1 py-0.5 rounded-sm hover:bg-red-50"
                                    title="Delete note">✕</button>
                        </form>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {% if order.customerNote %}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-2">Customer Note</h3>
            <p class="text-sm text-gray-700 whitespace-pre-line">{{ order.customerNote }}</p>
        </div>
        {% endif %}
        {# Add Internal Note #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Add Internal Note</h3>
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/note') }}" class="space-y-3">
                {{ csrf_field() }}
                <textarea name="note" rows="4"
                          class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm resize-y"
                          placeholder="Internal note (not visible to the customer)…" required></textarea>
                <button type="submit"
                        class="w-full rounded-lg bg-amber-500 dark:bg-amber-700 px-4 py-2 text-sm font-medium text-white hover:bg-amber-600 dark:hover:bg-amber-800">
                    Add Note
                </button>
            </form>
        </div>

        {% if downloads is defined and downloads|length > 0 %}
        {# Digital Downloads #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 shadow-xs overflow-x-auto">
            <div class="px-6 py-4 border-b bg-gray-50 dark:bg-gray-800/50 font-semibold text-sm text-gray-700 flex items-center gap-2">
                ⬇️ Downloads
            </div>
            <ul class="divide-y divide-gray-100">
                {% for dl in downloads %}
                <li class="px-6 py-4 text-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-gray-800 truncate">{{ dl.product_name }}</p>
                            <code class="block text-xs text-gray-400 font-mono break-all mt-0.5">{{ site_url }}/downloads/{{ dl.token }}</code>
                            <div class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-gray-500 dark:text-gray-400 items-center">
                                <span>Type: <strong>{{ dl.source_type }}</strong></span>
                                <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/downloads/' ~ dl.id ~ '/update-meta') }}" class="inline-flex items-center gap-1 flex-wrap">
                                    {{ csrf_field() }}
                                    <span>Downloads:</span>
                                    <input type="number" name="download_count" value="{{ dl.download_count }}" min="0"
                                           class="w-14 rounded-sm border-gray-300 dark:border-gray-700 text-xs text-center py-0.5">
                                    <span>/</span>
                                    <input type="number" name="download_limit" value="{{ dl.download_limit }}" min="0"
                                           class="w-14 rounded-sm border-gray-300 dark:border-gray-700 text-xs text-center py-0.5">
                                    <span>Expires:</span>
                                    <input type="date" name="expires_at" value="{{ dl.expires_at ? dl.expires_at|date('Y-m-d') : '' }}"
                                           class="w-36 rounded-sm border-gray-300 dark:border-gray-700 text-xs py-0.5">
                                    <button type="submit"
                                            class="rounded-sm px-1.5 py-0.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-800 hover:bg-gray-100">
                                        Update
                                    </button>
                                </form>
                                {% if dl.revoked %}<span class="text-red-500 font-semibold">REVOKED</span>{% endif %}
                            </div>
                        </div>
                        <div class="shrink-0 flex items-center gap-2">
                            {% include 'admin/components/_copy_button.twig' with {
                                text: site_url ~ '/downloads/' ~ dl.token,
                                label: __('Copy Link'),
                                size: 'h-3.5 w-3.5',
                                class: 'inline-flex items-center rounded-sm border border-gray-200 bg-gray-50 dark:bg-gray-800/50 px-3 py-1 text-xs font-medium text-gray-600 hover:bg-gray-100'
                            } %}
                            <span class="text-gray-300">|</span>
                            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/downloads/' ~ dl.id ~ '/regenerate') }}"
                                  onsubmit="return confirm('Regenerate token? Old link will stop working.')">
                                {{ csrf_field() }}
                                <button type="submit"
                                        class="rounded-sm px-3 py-1 text-xs font-medium bg-gray-50 dark:bg-gray-800/50 text-gray-600 hover:bg-gray-100 border border-gray-200">
                                    New Link
                                </button>
                            </form>
                            <span class="text-gray-300">|</span>
                            {% if not dl.revoked %}
                            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/downloads/' ~ dl.id ~ '/revoke') }}"
                                  onsubmit="return confirm('Revoke this download link?')">
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="revoke">
                                <button type="submit"
                                        class="rounded-sm px-3 py-1 text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100 border border-red-200">
                                    Revoke
                                </button>
                            </form>
                            {% else %}
                            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/downloads/' ~ dl.id ~ '/revoke') }}">
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="unrevoke">
                                <button type="submit"
                                        class="rounded-sm px-3 py-1 text-xs font-medium bg-green-50 text-green-600 hover:bg-green-100 border border-green-200">
                                    Restore
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>

    {# RIGHT COLUMN #}
    <div class="space-y-6">

        {# Update Status #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Update Status</h3>
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/status') }}" class="space-y-3">
                {{ csrf_field() }}
                <select name="status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                    {% for value, label in status_labels %}
                    <option value="{{ value }}" {{ order.status == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <button type="submit"
                        class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    Update Status
                </button>
            </form>
        </div>

        {# Update Payment Method #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Update Payment Method</h3>
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/payment-method') }}" class="space-y-3">
                {{ csrf_field() }}
                <select name="payment_method" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                    {% for value, label in payment_methods %}
                    <option value="{{ value }}" {{ order.paymentMethod == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <p class="text-xs text-gray-500 dark:text-gray-400">Online gateways generate a payment link; Bank Transfer generates an instructions link with your account details.</p>
                <button type="submit"
                        class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    Update Payment Method
                </button>
            </form>
        </div>

        {% if order.status == 'refund_requested' %}
        <div class="rounded-xl border border-amber-200 bg-white dark:bg-gray-900 p-6 shadow-xs space-y-3">
            <h3 class="font-semibold text-amber-800">Refund Request Review</h3>
            <p class="text-xs text-gray-600">Customer requested cancellation/refund. Enter refund amount, approve to process, or reject with a reason.</p>

            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/refund/approve') }}" class="space-y-2">
                {{ csrf_field() }}
                <textarea name="admin_note" rows="2" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm" placeholder="Optional note to customer"></textarea>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1" for="refund-amount">Refund Amount ({{ order.currency }})</label>
                    <input type="number" id="refund-amount" name="refund_amount" min="0.01" step="0.01" value="{{ order.total|number_format(2, '.', '') }}" required
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm" placeholder="0.00">
                </div>
                <button type="submit"
                        class="w-full rounded-lg bg-green-600 dark:bg-green-700 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 dark:hover:bg-green-800">
                    Approve Request ({{ order.paymentMethod in ['paypal','stripe','mollie','twocheckout','checkoutcom'] ? 'Refund via ' ~ (order.paymentMethod|replace({'checkoutcom':'Checkout.com','twocheckout':'2Checkout'})|title) : 'Cancel Order' }})
                </button>
            </form>

            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/refund/reject') }}" class="space-y-2">
                {{ csrf_field() }}
                <textarea name="reject_reason" rows="3" required class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm" placeholder="Required rejection reason (e.g. custom-made product, digital product consumed)"></textarea>
                <button type="submit"
                        class="w-full rounded-lg bg-red-600 dark:bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 dark:hover:bg-red-800">
                    Reject Request
                </button>
            </form>
        </div>
        {% endif %}

        {# Order Info #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs text-sm text-gray-600 space-y-1.5">
            <h3 class="font-semibold text-gray-800 mb-3">Order Info</h3>
            <p><span class="text-gray-500 dark:text-gray-400">Order #:</span> {{ order.orderNumber }}</p>
            <p><span class="text-gray-500 dark:text-gray-400">Payment:</span> {{ order.paymentMethod|default('—')|replace({'_': ' '})|title }}</p>
            {% if order.transactionId %}
            <p><span class="text-gray-500 dark:text-gray-400">Transaction:</span> <code class="font-mono text-xs">{{ order.transactionId }}</code></p>
            {% endif %}
            {% if refund_id %}
            <p><span class="text-gray-500 dark:text-gray-400">Refund ID:</span> <code class="font-mono text-xs">{{ refund_id }}</code></p>
            {% endif %}
            <p><span class="text-gray-500 dark:text-gray-400">Currency:</span> {{ order.currency }}</p>
            {% if order.paidAt %}
            <p><span class="text-gray-500 dark:text-gray-400">Paid:</span> {{ order.paidAt|date('Y-m-d H:i') }}</p>
            {% endif %}
            <p><span class="text-gray-500 dark:text-gray-400">Created:</span> {{ order.createdAt|date('Y-m-d H:i') }}</p>
            <p><span class="text-gray-500 dark:text-gray-400">Updated:</span> {{ order.updatedAt|date('Y-m-d H:i') }}</p>
        </div>

        {# Shipping & Tracking #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Shipping &amp; Tracking</h3>
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/tracking') }}" class="space-y-3" x-data="trackingPreview({{ shipping_carriers|json_encode|e('html_attr') }})">
                {{ csrf_field() }}
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Carrier</label>
                    <select name="carrier" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm" @change="carrier = $event.target.value; updatePreview()">
                        <option value="">— Select Carrier —</option>
                        {% for c in shipping_carriers %}
                        <option value="{{ c.value }}" {{ order.carrier == c.value ? 'selected' }}>{{ c.label }}</option>
                        {% endfor %}
                        <option value="other" {{ order.carrier == 'other' ? 'selected' }}>Other</option>
                    </select>
                </div>
                <div x-show="carrier !== 'other'">
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tracking Number <span class="text-red-500">*</span></label>
                    <input type="text" name="tracking_number"
                           value="{{ order.trackingNumber|default('') }}"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                           placeholder="e.g. 1Z999AA10123456784" @input="syncNumber(); updatePreview()">
                </div>
                <div x-show="carrier === 'other'" x-cloak>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tracking URL <span class="text-red-500">*</span></label>
                    <input type="url" name="tracking_url"
                           value="{{ order.carrier == 'other' ? order.trackingNumber|default('') : '' }}"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                           placeholder="https://example.com/track?code=ABC123" @input="syncNumber(); updatePreview()">
                </div>
                <template x-if="previewUrl">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tracking URL (auto-generated)</label>
                        <div class="flex gap-2">
                            <input type="text" readonly x-model="previewUrl"
                                   class="flex-1 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-3 py-2 text-xs font-mono text-gray-700">
                            <button type="button" @click="copyUrl()"
                                    class="rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-xs text-gray-600 hover:bg-gray-100 whitespace-nowrap"
                                    x-text="copied ? 'Copied!' : 'Copy'"></button>
                        </div>
                    </div>
                </template>
                <div class="flex gap-2">
                    <button type="submit" name="notify" value="0"
                            class="flex-1 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                        Save
                    </button>
                    <button type="submit" name="notify" value="1"
                            class="flex-1 rounded-lg bg-sky-600 dark:bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700 dark:hover:bg-sky-800"
                            onclick="return confirm('{{ __('Send tracking notification to the customer?') }}')">
                        Save &amp; Notify
                    </button>
                </div>
            </form>
        </div>

        <script>
        function trackingPreview(carriers) {
            return {
                carriers: carriers,
                copied: false,
                previewUrl: '',
                carrier: '',
                init() {
                    var carrierSelect = this.$el.querySelector('select[name="carrier"]');
                    if (carrierSelect) {
                        this.carrier = carrierSelect.value;
                    }
                    this.updatePreview();
                },
                syncNumber() {
                    var visibleInput = this.$el.querySelector('input[name="tracking_number"]:not([x-cloak])');
                    if (!visibleInput) {
                        var inputs = this.$el.querySelectorAll('input[name="tracking_number"]');
                        for (var i = 0; i < inputs.length; i++) {
                            if (inputs[i].offsetParent !== null) {
                                visibleInput = inputs[i];
                                break;
                            }
                        }
                    }
                },
                updatePreview() {
                    var numberInputs = this.$el.querySelectorAll('input[name="tracking_number"]');
                    var number = '';
                    for (var i = 0; i < numberInputs.length; i++) {
                        if (numberInputs[i].offsetParent !== null) {
                            number = numberInputs[i].value;
                            break;
                        }
                    }
                    if (!this.carrier || !number) {
                        this.previewUrl = '';
                        return;
                    }
                    if (this.carrier === 'other') {
                        this.previewUrl = number;
                        return;
                    }
                    var c = this.carriers.find(function(c) { return c.value === this.carrier; }.bind(this));
                    if (!c || !c.url_template) {
                        this.previewUrl = '';
                        return;
                    }
                    this.previewUrl = c.url_template.replace('{tracking_number}', encodeURIComponent(number));
                },
                copyUrl() {
                    var self = this;
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(this.previewUrl).then(function() {
                            self.copied = true;
                            setTimeout(function() { self.copied = false; }, 1500);
                        });
                    }
                }
            };
        }
        </script>

        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-3">{{ __('Invoice') }}</h3>
            {% if invoice_versions is defined and invoice_versions|length > 0 %}
