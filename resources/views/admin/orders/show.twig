                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-sm">
                    <div class="flex items-center justify-between gap-2">
                        <span class="font-medium text-gray-800 dark:text-gray-100">{{ v.snapshot.invoice_number|default('') }}</span>
                        <span class="text-gray-600 dark:text-gray-300">{{ v.snapshot.total|default(0)|number_format(2, '.', ',') }} {{ v.snapshot.currency|default('') }}</span>
                    </div>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{{ __('Issued: :date', {':date': v.snapshot.issued_at|default('')}) }}{% if v.revision > 1 %} &middot; {{ __('Revision R:rev', {':rev': v.revision}) }}{% endif %}</p>
                    <div class="mt-2 flex gap-2">
                        <a href="{{ url('/admin/orders/' ~ order.id ~ '/invoice?log=' ~ v.log_id) }}" target="_blank"
                           class="flex-1 rounded-lg border border-gray-300 dark:border-gray-700 px-2 py-1.5 text-center text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800">
                            {{ __('View') }}
                        </a>
                        <a href="{{ url('/admin/orders/' ~ order.id ~ '/invoice/pdf?log=' ~ v.log_id) }}"
                           class="flex-1 rounded-lg border border-gray-300 dark:border-gray-700 px-2 py-1.5 text-center text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800">
                            PDF
                        </a>
                        <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/invoice/send?log=' ~ v.log_id) }}" class="flex-1">
                            {{ csrf_field() }}
                            <button type="submit" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-2 py-1.5 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800">
                                {{ __('Send') }}
                            </button>
                        </form>
                    </div>
                </div>
                {% endfor %}
                <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/invoice/issue') }}">
                    {{ csrf_field() }}
                    <button type="submit" class="w-full vl-btn vl-btn-secondary">
                        {{ __('Reissue Invoice') }}
                    </button>
                </form>
            </div>
            {% elseif invoice_snapshot %}
            <div class="space-y-2">
                <p class="text-xs text-gray-500 dark:text-gray-400">{{ __('Issued: :date', {':date': invoice_snapshot.issued_at|default('')}) }}</p>
                <a href="{{ url('/admin/orders/' ~ order.id ~ '/invoice') }}" target="_blank"
                   class="w-full vl-btn vl-btn-secondary">
                    {{ __('View Invoice') }}
                </a>
                <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/invoice/send') }}">
                    {{ csrf_field() }}
                    <button type="submit" class="w-full vl-btn vl-btn-primary">
                        {{ __('Send To Customer') }}
                    </button>
                </form>
                <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/invoice/issue') }}">
                    {{ csrf_field() }}
                    <button type="submit" class="w-full vl-btn vl-btn-secondary">
                        {{ __('Reissue Invoice') }}
                    </button>
                </form>
            </div>
            {% else %}
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/invoice/issue') }}">
                {{ csrf_field() }}
                <button type="submit" class="w-full vl-btn vl-btn-primary">
                    {{ __('Issue Invoice') }}
                </button>
            </form>
            {% endif %}
        </div>

        {# Payment Link / Bank Transfer Instructions #}
        {% if order.status not in ['processing','completed','shipped','refunded','cancelled'] or order.paymentToken %}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            {% if is_bank_transfer %}
            {% set bt_configured = bank_details and bank_details.banktransfer_iban %}
            <h3 class="font-semibold text-gray-800 mb-3">Bank Transfer Instructions</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Share your account details with the customer, or send a one-click instructions link. Regenerating invalidates the previous link.</p>

            {% if bt_configured %}
            <div class="mb-4 rounded-lg bg-amber-50 dark:bg-yellow-900/30 border border-amber-200 dark:border-yellow-800 p-3 text-sm space-y-1">
                {% set due_date = order.createdAt|date('U') + (bank_details.banktransfer_max_days * 86400) %}
                {% if bank_details.banktransfer_bank %}
                <div class="flex justify-between gap-2"><span class="text-gray-500 dark:text-gray-400">{{ __('Bank') }}:</span><span class="font-medium text-right text-gray-900 dark:text-gray-100">{{ bank_details.banktransfer_bank }}</span></div>
                {% endif %}
                {% if bank_details.banktransfer_holder %}
                <div class="flex justify-between gap-2"><span class="text-gray-500 dark:text-gray-400">{{ __('Account Holder') }}:</span><span class="font-medium text-right text-gray-900 dark:text-gray-100">{{ bank_details.banktransfer_holder }}</span></div>
                {% endif %}
                <div class="flex justify-between gap-2 items-center">
                    <span class="text-gray-500 dark:text-gray-400">{{ __('IBAN') }}:</span>
                    <span class="flex items-center gap-1">
                        <span class="font-mono font-bold text-gray-900 dark:text-white">{{ bank_details.banktransfer_iban }}</span>
                        {% include 'admin/components/_copy_button.twig' with { text: bank_details.banktransfer_iban, title: __('Copy'), size: 'h-3.5 w-3.5' } %}
                    </span>
                </div>
                {% if bank_details.banktransfer_swift %}
                <div class="flex justify-between gap-2"><span class="text-gray-500 dark:text-gray-400">{{ __('SWIFT') }}:</span><span class="font-mono font-medium text-gray-900 dark:text-gray-100">{{ bank_details.banktransfer_swift }}</span></div>
                {% endif %}
                {% if bank_details.banktransfer_routing %}
                <div class="flex justify-between gap-2"><span class="text-gray-500 dark:text-gray-400">{{ __('Routing (ABA)') }}:</span><span class="font-mono font-medium text-gray-900 dark:text-gray-100">{{ bank_details.banktransfer_routing }}</span></div>
                {% endif %}
                {% if bank_details.banktransfer_branch %}
                <div class="flex justify-between gap-2"><span class="text-gray-500 dark:text-gray-400">{{ __('Branch') }}:</span><span class="font-medium text-right text-gray-900 dark:text-gray-100">{{ bank_details.banktransfer_branch }}</span></div>
                {% endif %}
                <div class="pt-1.5 mt-1.5 border-t border-amber-200 dark:border-yellow-800 text-xs text-gray-500 dark:text-gray-400">
                    {{ __('Please complete your transfer within :days days (by :date).', {':days': bank_details.banktransfer_max_days, ':date': due_date|date('M j, Y')}) }}
                </div>
            </div>
            {% else %}
            <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 p-3 text-xs text-red-700 dark:text-red-300">
                {{ __('Bank transfer details are not configured yet. Set them under Settings → Payment → Bank Transfer.') }}
            </div>
            {% endif %}
            {% else %}
            <h3 class="font-semibold text-gray-800 mb-3">{{ __('Payment Link') }}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">{{ __('Generate a one-click payment link to send to the customer. Regenerating invalidates the previous link.') }}</p>
            {% endif %}

            {% if payment_link %}
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-600 mb-1">{{ is_bank_transfer ? __('Instructions link (copy and send to customer)') : __('Link (copy and send to customer)') }}</label>
                <div class="flex gap-2">
                    <input type="text" id="payment-link-field" readonly value="{{ payment_link }}"
                           class="flex-1 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-3 py-2 text-xs font-mono text-gray-700 focus:outline-hidden">
                    {% include 'admin/components/_copy_button.twig' with {
                        expr: 'this.previousElementSibling.value',
                        label: __('Copy'),
                        size: 'h-3.5 w-3.5',
                        class: 'inline-flex items-center rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-xs text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 whitespace-nowrap'
                    } %}
                </div>
                <p id="copy-confirm" class="mt-1 text-xs text-green-600 hidden">Copied!</p>
            </div>
            {% elseif order.paymentToken %}
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-600 mb-1">{{ __('Existing link') }}</label>
                <div class="flex gap-2">
                    <input type="text" id="payment-link-field" readonly
                           value="{{ site_url ~ '/pay/' ~ order.paymentToken }}"
                           class="flex-1 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-3 py-2 text-xs font-mono text-gray-700 focus:outline-hidden">
                    {% include 'admin/components/_copy_button.twig' with {
                        expr: 'this.previousElementSibling.value',
                        label: __('Copy'),
                        size: 'h-3.5 w-3.5',
                        class: 'inline-flex items-center rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-xs text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 whitespace-nowrap'
                    } %}
                </div>
                <p id="copy-confirm" class="mt-1 text-xs text-green-600 hidden">Copied!</p>
            </div>
            {% endif %}

            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/payment-link') }}">
                {{ csrf_field() }}
                <button type="submit"
                        class="w-full vl-btn {% if order.paymentToken %}bg-amber-500 dark:bg-amber-700 hover:bg-amber-600 dark:hover:bg-amber-800 text-white{% else %}vl-btn-primary{% endif %}">
                    {% if is_bank_transfer %}
                        {{ order.paymentToken ? __('Regenerate Instruction Link') : __('Generate Instruction Link') }}
                    {% else %}
                        {{ order.paymentToken ? __('Regenerate Link') : __('Generate Payment Link') }}
                    {% endif %}
                </button>
            </form>
        </div>
        {% endif %}

        {# Send Email to Customer #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-gray-800 mb-4">Send Email to Customer</h3>
            {% set customer_email = order.billing.email|default('') %}
            {% if customer_email %}
            <div x-data="{ emailType: 'custom' }">
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/send-email') }}" class="space-y-3">
                {{ csrf_field() }}
                <input type="hidden" name="email_type" x-model="emailType">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">To</label>
                    <p class="text-sm text-gray-700 bg-gray-50 dark:bg-gray-800/50 rounded-sm px-3 py-2 border border-gray-200">{{ customer_email }}</p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Email Type</label>
                    <select x-model="emailType"
                            class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                        <option value="custom">Custom Message</option>
                        <option value="order_confirmation">Send Order Confirmation</option>
                        <option value="payment_received">Send Payment Received</option>
                        <option value="payment_link">{{ is_bank_transfer ? 'Send Bank Transfer Instructions' : 'Send Payment Link' }}</option>
                        <option value="invoice">Send Invoice</option>
                    </select>
                </div>
                <div x-show="emailType === 'custom'" x-cloak>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1" for="email-subject">Subject</label>
                            <input type="text" id="email-subject" name="subject"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                   placeholder="Re: Order #{{ order.orderNumber }}" :required="emailType === 'custom'">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1" for="email-message">Message</label>
                            <textarea id="email-message" name="message" rows="5"
                                      class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm resize-y"
                                      placeholder="Your message to the customer…" :required="emailType === 'custom'"></textarea>
                        </div>
                    </div>
                </div>
                <button type="submit"
                        class="w-full rounded-lg bg-sky-600 dark:bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700 dark:hover:bg-sky-800">
                    <span x-text="{
                        'custom': 'Send Email',
                        'order_confirmation': 'Send Order Confirmation',
                        'payment_received': 'Send Payment Received',
                        'payment_link': {{ is_bank_transfer ? "'Send Bank Transfer Instructions'" : "'Send Payment Link'" }},
                        'invoice': 'Send Invoice',
                    }[emailType] || 'Send Email'"></span>
                </button>
            </form>
            </div>
            {% else %}
            <p class="text-sm text-gray-400 italic">No customer email address on this order.</p>
            {% endif %}
        </div>

        {# Danger zone #}
        <div class="rounded-xl border border-red-200 bg-white dark:bg-gray-900 p-6 shadow-xs">
            <h3 class="font-semibold text-red-700 mb-3">Danger Zone</h3>
            <form method="POST" action="{{ url('/admin/orders/' ~ order.id ~ '/delete') }}"
                  onsubmit="return confirm('Delete order {{ order.orderNumber }}? This cannot be undone.')">
                {{ csrf_field() }}
                <button type="submit"
                        class="w-full rounded-lg border border-red-300 dark:border-red-700 px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20">
                    Delete Order
                </button>
            </form>
        </div>

    </div>
</div>

<script>
vlDirtyGuard();
</script>
{% endblock %}
