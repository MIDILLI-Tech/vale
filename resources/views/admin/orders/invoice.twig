<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ __('Invoice') }} {{ invoice.invoice_number|default('') }}</title>
    {% if assets_use_cdn %}
    <script nonce="{{ csp_nonce }}" src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    {% else %}
    {% include 'partials/_build_assets.twig' with { include_js: false, load_alt_fonts: false, load_display_fonts: false } %}
    {% endif %}
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: #fff !important; }
            .invoice-sheet { box-shadow: none !important; border-color: #d1d5db !important; }
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-900 dark:text-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="no-print mb-6 flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Invoice') }} {{ invoice.invoice_number|default('') }}</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400">{{ __('Issued: :date', {':date': invoice.issued_at|default('')}) }}</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="window.print()" class="rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm hover:bg-gray-50 dark:bg-gray-800/50">{{ __('Print / Save PDF') }}</button>
                {% if pdf_available|default(false) %}
                <a href="{{ url('/admin/orders/' ~ order.id ~ '/invoice/pdf') }}" class="rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm hover:bg-gray-50 dark:bg-gray-800/50">{{ __('Download PDF') }}</a>
                {% endif %}
                <a href="{{ url('/admin/orders/' ~ order.id) }}" class="rounded-lg bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-800">{{ __('Back To Order') }}</a>
            </div>
        </div>

        <div class="invoice-sheet rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs space-y-6">
            {% if logo_data_uri|default('') %}
            <div class="flex justify-end">
                <img src="{{ logo_data_uri }}" alt="{{ invoice.shop.company_name|default('') }}"
                     style="max-height:56px;max-width:220px;width:auto;object-fit:contain;">
            </div>
            {% endif %}
            {% if is_latest is defined and not is_latest and latest_invoice is defined and latest_invoice %}
            <div class="rounded-lg border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
                {{ __('Note: this version was superseded by :number (issued :date).', {':number': latest_invoice.invoice_number|default(''), ':date': latest_invoice.issued_at|default('')}) }}
            </div>
            {% endif %}
            {% if invoice.revision|default(1) > 1 %}
            <div class="rounded-lg border border-sky-300 dark:border-sky-700 bg-sky-50 dark:bg-sky-900/30 px-4 py-3 text-sm text-sky-800 dark:text-sky-200">
                {{ __('Revision R:rev — supersedes :prev.', {':rev': invoice.revision, ':prev': prev_number|default('')}) }}
            </div>
            {% endif %}
            <div class="flex flex-col gap-1 border-b border-gray-200 pb-4 text-sm sm:items-end">
                <p><span class="font-semibold text-gray-700">{{ __('Invoice Number') }}:</span> {{ invoice.invoice_number|default('') }}</p>
                <p><span class="font-semibold text-gray-700">{{ __('Invoice Date') }}:</span> {{ invoice.issued_at|default('') ? (invoice.issued_at|date('Y-m-d')) : '' }}</p>
                <p><span class="font-semibold text-gray-700">{{ __('Order Number') }}:</span> {{ invoice.order_number|default(order.orderNumber) }}</p>
                {% if invoice.delivery_date|default('') %}
                <p><span class="font-semibold text-gray-700">{{ __('Delivery date') }}:</span> {{ invoice.delivery_date }}{% if invoice.delivery_date_estimated|default(false) %} <span class="text-xs text-gray-500 dark:text-gray-400">({{ __('estimated') }})</span>{% endif %}</p>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
                <div>
                    <h2 class="font-semibold text-gray-800 mb-2">{{ __('From') }}</h2>
                    <p>{{ invoice.shop.company_name|default('') }}</p>
                    <p>{{ invoice.shop.address_1|default('') }}</p>
                    {% if invoice.shop.address_2 %}<p>{{ invoice.shop.address_2 }}</p>{% endif %}
                    <p>{{ invoice.shop.city|default('') }} {{ invoice.shop.postcode|default('') }}</p>
                    <p>{{ invoice.shop.state|default('') }} {{ invoice.shop.country|default('') }}</p>
                    {% if invoice.shop.phone %}<p>{{ __('Phone') }}: {{ invoice.shop.phone }}</p>{% endif %}
                    {% if invoice.shop.email %}<p>{{ __('Email') }}: {{ invoice.shop.email }}</p>{% endif %}
                    {% if invoice.shop.vat_number %}<p>{{ __('VAT') }}: {{ invoice.shop.vat_number }}</p>{% endif %}
                    {% if invoice.shop.tax_number|default('') %}<p>{{ __('Tax number') }}: {{ invoice.shop.tax_number }}</p>{% endif %}
                </div>
                <div>
                    <h2 class="font-semibold text-gray-800 mb-2">{{ __('Bill To') }}</h2>
                    {% if invoice.billing.company_name|default('') %}<p class="font-semibold">{{ invoice.billing.company_name }}</p>{% endif %}
                    <p>{{ invoice.billing.first_name|default('') }} {{ invoice.billing.last_name|default('') }}</p>
                    {% if invoice.billing.vat_number|default('') %}<p>{{ (invoice.billing.country|default('')|upper) in eu_countries ? __('VAT ID') : __('Tax ID') }}: {{ invoice.billing.vat_number }}</p>{% endif %}
                    <p>{{ invoice.billing.address_1|default(invoice.billing.address|default('')) }}</p>
                    {% if invoice.billing.address_2 %}<p>{{ invoice.billing.address_2 }}</p>{% endif %}
                    <p>{{ invoice.billing.city|default('') }} {{ invoice.billing.postcode|default('') }}</p>
                    <p>{{ invoice.billing.state|default('') }} {{ invoice.billing.country|default('') }}</p>
                    <p>{{ invoice.billing.email|default('') }}</p>
                    {% if invoice.billing.phone %}<p>{{ invoice.billing.phone }}</p>{% endif %}
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm border-collapse">
                    <thead>
                        <tr class="border-b">
                            <th class="text-left py-2">{{ __('Item') }}</th>
                            <th class="text-right py-2">{{ __('Qty') }}</th>
                            <th class="text-right py-2">{{ __('Price') }}</th>
                            <th class="text-right py-2">{{ __('Total') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in invoice.items|default([]) %}
                        {% set qty = item.quantity|default(1) %}
                        {% set unit = item.price|default(0) %}
                        <tr class="border-b border-gray-100">
                            <td class="py-2">
                                {{ item.name|default('Item') }}
                                {% if item.variation_data|default({})|length > 0 %}
                                <div class="text-xs text-gray-500 dark:text-gray-400">
                                    {% for attr, val in item.variation_data %}{% if val %}{{ attr }}: {{ val }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
                                </div>
                                {% endif %}
                            </td>
                            <td class="py-2 text-right">{{ qty }}</td>
                            <td class="py-2 text-right">{{ unit|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
                            <td class="py-2 text-right">{{ (unit * qty)|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="ml-auto w-full md:w-80 text-sm space-y-1">
                <div class="flex justify-between"><span>{{ __('Subtotal') }}</span><span>{{ invoice.subtotal|number_format(2, '.', ',') }} {{ invoice.currency }}</span></div>
                <div class="flex justify-between"><span>{{ __('Shipping') }}</span><span>{{ invoice.shipping|number_format(2, '.', ',') }} {{ invoice.currency }}</span></div>
                {% if invoice.reverse_charge|default(false) %}
                <div class="flex justify-between"><span>{{ __('VAT (reverse charge)') }}</span><span>0.00 {{ invoice.currency }}</span></div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{ __('Reverse charge — VAT not charged (Article 196, EU Directive 2006/112/EC).') }}</div>
                {% else %}
                {% set _vatRows = invoice.vat_breakdown|default([]) %}
                {% if _vatRows|length > 1 %}
                <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
                    <table class="w-full text-xs">
                        <thead class="bg-gray-50 dark:bg-gray-800/60">
                            <tr>
                                <th class="px-2 py-1 text-left">{{ __('VAT rate') }}</th>
                                <th class="px-2 py-1 text-right">{{ __('Net') }}</th>
                                <th class="px-2 py-1 text-right">{{ __('VAT') }}</th>
                                <th class="px-2 py-1 text-right">{{ __('Gross') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in _vatRows %}
                            <tr class="border-t border-gray-100 dark:border-gray-800">
                                <td class="px-2 py-1">{{ row.rate|number_format(1, '.', ',') }}%</td>
                                <td class="px-2 py-1 text-right">{{ row.net|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
                                <td class="px-2 py-1 text-right">{{ row.tax|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
                                <td class="px-2 py-1 text-right">{{ (row.net + row.tax)|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="flex justify-between">
                    <span>
                        {{ __('Included VAT') }}
                        {% if invoice.tax_regime|default('normal_vat') == 'normal_vat' %}
                        ({{ invoice.tax_rate|default(0)|number_format(2, '.', ',') }}%)
                        {% endif %}
                    </span>
                    <span>{{ invoice.tax|number_format(2, '.', ',') }} {{ invoice.currency }}</span>
                </div>
                {% endif %}
                {% if invoice.tax_regime|default('normal_vat') != 'normal_vat' and invoice.tax_zero_reason|default('') != '' %}
                <div class="text-xs text-gray-500 dark:text-gray-400">{{ invoice.tax_zero_reason }}</div>
                {% endif %}
                {% endif %}
                {% if invoice.discount|default(0) > 0 %}
                <div class="flex justify-between text-green-700"><span>{{ __('Discount') }}</span><span>-{{ invoice.discount|number_format(2, '.', ',') }} {{ invoice.currency }}</span></div>
                {% endif %}
                <div class="flex justify-between font-semibold border-t pt-2"><span>{{ order.status in ['processing','completed','shipped'] ? __('Paid Total') : __('Total') }}</span><span>{{ invoice.total|number_format(2, '.', ',') }} {{ invoice.currency }}</span></div>
                {% if invoice.refunds|default([])|length > 0 %}
                    {% for ref in invoice.refunds %}
                    <div class="flex justify-between text-amber-700"><span>{{ __('Refund') }} {{ ref.refund_id ? '(' ~ ref.refund_id ~ ')' : '' }}</span><span>-{{ ref.amount|number_format(2, '.', ',') }} {{ ref.currency }}</span></div>
                    {% endfor %}
                    <div class="flex justify-between font-bold border-t pt-2"><span>{{ __('Net Paid') }}</span><span>{{ invoice.net_paid|number_format(2, '.', ',') }} {{ invoice.currency }}</span></div>
                {% endif %}
            </div>

            {% set _ageConfirmed = invoice.age_confirmed_at|default('') ?: (order.ageConfirmedAt ? order.ageConfirmedAt|date('Y-m-d H:i') : '') %}
            {% if _ageConfirmed %}
            <p class="border-t border-gray-200 pt-3 text-xs text-gray-500 dark:text-gray-400">
                {{ __('Age confirmation') }}: {{ _ageConfirmed }}
            </p>
            {% endif %}
        </div>
    </div>
</body>
</html>
