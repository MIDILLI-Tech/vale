{# General › Site #}
{% import 'admin/macros/vl-setting.twig' as vl %}
{% set default_lang = settings.default_locale|default('en') %}
{% set content_lang_codes = settings.content_languages|default(default_lang)|split(',')|filter(c => c) %}
{% set active_locales = supported_locales|filter((name, code) => code in content_lang_codes) %}
{% if active_locales is empty %}
    {% set active_locales = supported_locales|filter((name, code) => code == default_lang) %}
{% endif %}
{% set i18n_fields = settings.multi_language_content|default('0') == '1' and active_locales|length > 1 %}
{% set field_locales = i18n_fields ? active_locales : active_locales|filter((name, code) => code == default_lang) %}

<div id="general-tab-site" class="general-tab-panel">
    <form method="post" action="{{ url('/admin/settings') }}" class="space-y-5 rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
        {{ csrf_field() }}
        <input type="hidden" name="_METHOD" value="PUT">
        <input type="hidden" name="_group" value="general">
        <input type="hidden" name="_subtab" value="site">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ __('Site Identity') }}</p>

        {% if i18n_fields %}
        <p class="text-xs text-gray-500 dark:text-gray-400">{{ __('Multi-language content is enabled. Use the language tabs to provide translations for visitor-facing text.') }}</p>
        {% endif %}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {% include 'admin/components/i18n-setting-field.twig' with {
                vl_tab: 'general',
                vl_subtab: 'site',
                vl_section: __('Site Identity'),
                field: 'site_name',
                label: __('Site Name'),
                settings: settings,
                active_locales: active_locales,
                field_locales: field_locales,
                default_lang: default_lang,
                i18n_fields: i18n_fields,
            } %}

            {% include 'admin/components/i18n-setting-field.twig' with {
                vl_tab: 'general',
                vl_subtab: 'site',
                vl_section: __('Site Identity'),
                field: 'site_tagline',
                label: __('Tagline'),
                settings: settings,
                active_locales: active_locales,
                field_locales: field_locales,
                default_lang: default_lang,
                i18n_fields: i18n_fields,
                hint: __('Site subtitle / slogan. Use') ~ ' <code>{{ site_tagline }}</code> ' ~ __('in your template to display it.'),
            } %}
        </div>

        <hr class="border-gray-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ __('Site Logo & Icon') }}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {# Logo #}
            <div {{ vl.attrs('general', __('Logo'), 'site_logo', 'site', __('Site Logo & Icon'), 'favicon icon brand') }} x-data="siteLogoPicker('{{ settings.site_logo|default('')|e('js') }}')">
                <input type="hidden" name="site_logo" :value="logoUrl">
                <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Logo') }}</label>
                <div class="flex items-center gap-3">
                    <div class="h-12 w-12 shrink-0 overflow-hidden rounded-lg border bg-gray-50 dark:bg-gray-800/50 flex items-center justify-center text-xl text-gray-300">
                        <img x-show="logoUrl" :src="logoUrl" class="h-full w-full object-contain">
                        <span x-show="!logoUrl">🖼</span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <button type="button" @click="openBrowser()" class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{{ __('Select Logo') }}</button>
                        <button type="button" @click="removeLogo()" x-show="logoUrl" class="text-sm text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors">{{ __('Remove') }}</button>
                    </div>
                </div>
                <p class="mt-1.5 text-xs text-gray-400">{{ __('Square image (48×48 px min). Used as favicon and site icon.') }}</p>
                {% include 'admin/components/media-browser-modal.twig' %}
            </div>

            {# Social Preview Image #}
            {% if seo_enabled %}
            <div {{ vl.attrs('general', __('Social Preview Image'), 'social_preview_image', 'site', __('Site Logo & Icon'), 'og open graph facebook share') }} x-data="featuredImage({{ settings.social_preview_image|default(0) }})">
                <input type="hidden" name="social_preview_image" :value="imageId || ''">
                <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Social Preview Image') }}</label>
                <div class="flex items-center gap-3">
                    <div class="h-12 w-20 shrink-0 overflow-hidden rounded-lg border bg-gray-50 dark:bg-gray-800/50 flex items-center justify-center text-xl text-gray-300">
                        <img x-show="imageId > 0" :src="thumbnailUrl" class="h-full w-full object-cover">
                        <span x-show="!imageId">🖼</span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <button type="button" @click="openBrowser()" class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{{ __('Select Image') }}</button>
                        <button type="button" @click="removeImage()" x-show="imageId > 0" class="text-sm text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors">{{ __('Remove') }}</button>
                    </div>
                </div>
                <p class="mt-1.5 text-xs text-gray-400">{{ __('Default OG image (1200×630 px). Shown when site is shared on social media.') }}</p>
                {% include 'admin/components/media-browser-modal.twig' %}
            </div>
            {% endif %}
        </div>

        <hr class="border-gray-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ __('Homepage') }}</p>
        <div x-data="{ showOnFront: '{{ settings.show_on_front|default('posts')|e('js') }}' }">
            <div {{ vl.attrs('general', __('Homepage displays'), 'show_on_front', 'site', __('Homepage'), 'front page home') }}>
                <label class="block text-sm font-medium text-gray-700">{{ __('Homepage displays') }}</label>
                <div class="mt-1 flex flex-wrap items-center gap-3">
                    <select id="show-on-front" name="show_on_front" x-model="showOnFront"
                            class="w-auto min-w-48 shrink-0 rounded-lg border-gray-300 dark:border-gray-700">
                        <option value="posts" {% if not blog_enabled %}disabled{% endif %} {{ settings.show_on_front|default('posts') == 'posts' ? 'selected' }}>{{ __('Latest posts') }}{% if not blog_enabled %} ({{ __('blog disabled') }}){% endif %}</option>
                        <option value="shop"  {% if not shop_enabled %}disabled{% endif %} {{ settings.show_on_front|default('posts') == 'shop'  ? 'selected' }}>{{ __('Shop') }}{% if not shop_enabled %} ({{ __('shop disabled') }}){% endif %}</option>
                        <option value="page"  {% if not pages_enabled %}disabled{% endif %} {{ settings.show_on_front|default('posts') == 'page'  ? 'selected' }}>{{ __('A static page') }}{% if not pages_enabled %} ({{ __('pages disabled') }}){% endif %}</option>
                    </select>
                    <div id="homepage-page-picker"
                         x-show="showOnFront === 'page'"
                         x-cloak
                         {{ vl.attrs('general', __('Homepage'), 'homepage_page_id', 'site', __('Homepage'), 'static page front') }}
                         class="w-full min-w-[12rem] flex-1 sm:max-w-xs">
                        <span class="sr-only">{{ __('Homepage') }}</span>
                        {% set homepage_seed = pagePickerSeeds.homepage|default(null) %}
                        {% include 'admin/components/page-async-select.twig' with {
                            name: 'homepage_page_id',
                            value_field: 'id',
                            initial_value: homepage_seed ? homepage_seed.value : settings.homepage_page_id|default(''),
                            initial_label: homepage_seed ? homepage_seed.label : '',
                            placeholder: __('Search pages…'),
                        } %}
                    </div>
                </div>
            </div>
        </div>

        <hr class="border-gray-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ __('Communications') }}</p>
        <div {{ vl.attrs('general', __('Admin Email'), 'admin_email', 'site', __('Communications'), 'email contact administrator') }}>
            <label class="block text-sm font-medium text-gray-700">{{ __('Admin Email') }}</label>
            <input type="email" name="admin_email" value="{{ settings.admin_email|default('') }}"
                   class="mt-1 w-full rounded-lg border-gray-300 dark:border-gray-700">
        </div>

        {% include 'admin/components/i18n-setting-field.twig' with {
            vl_tab: 'general',
            vl_subtab: 'site',
            vl_section: __('Communications'),
            field: 'footer_copyright',
            label: __('Footer Copyright'),
            settings: settings,
            active_locales: active_locales,
            field_locales: field_locales,
            default_lang: default_lang,
            i18n_fields: i18n_fields,
            placeholder: '© ' ~ ('now'|date('Y')) ~ ' ' ~ (settings.site_name|default(site_name)) ~ '. All rights reserved.',
            hint: __('Leave empty to auto-generate from site name.'),
        } %}

        <div {{ vl.attrs('general', __('Disable Vale News refresh'), 'dashboard_news_disabled', 'site', __('Communications'), 'news dashboard feed refresh disable') }}>
            <label class="flex items-center gap-3">
                <input type="hidden" name="dashboard_news_disabled" value="0">
                <input type="checkbox" name="dashboard_news_disabled" value="1"
                       {{ settings.dashboard_news_disabled|default('0') == '1' ? 'checked' }}
                       class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500">
                <span>
                    <span class="block text-sm font-medium text-gray-700">{{ __('Disable Vale News refresh') }}</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('Stops the Vale News feed on the admin dashboard from loading and refreshing.') }}</span>
                </span>
            </label>
        </div>

        <hr class="border-gray-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ __('Localization') }}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div {{ vl.attrs('general', __('Default Site and Admin Language'), 'locale', 'site', __('Localization'), 'language locale admin interface') }}>
                <label class="block text-sm font-medium text-gray-700">{{ __('Default Site and Admin Language') }}</label>
                <select name="locale" class="mt-1 w-auto rounded-lg border-gray-300 dark:border-gray-700">
                    {% set adminLocale = settings.locale ?? settings.default_locale ?? 'en' %}
                    {% for code, name in supported_locales %}
                    <option value="{{ code }}" {{ adminLocale == code ? 'selected' }}>{{ locale_name(code) }}</option>
                    {% endfor %}
                </select>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ __('Also used as the default content language.') }}</p>
            </div>
            <div {{ vl.attrs('general', __('Timezone'), 'timezone', 'site', __('Localization'), 'timezone utc gmt clock date time zone') }}>
                <label class="block text-sm font-medium text-gray-700">{{ __('Timezone') }}</label>
                <select name="timezone" class="mt-1 w-auto rounded-lg border-gray-300 dark:border-gray-700">
                    {% for tz, label in supported_timezones %}
                    <option value="{{ tz }}" {{ (settings.timezone|default('UTC')) == tz ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ __('Used for scheduled tasks, timestamps, and log entries.') }}</p>
                <label class="mt-2 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                    <input type="hidden" name="show_visitor_timezone" value="0">
                    <input type="checkbox" name="show_visitor_timezone" value="1"
                           {{ settings.show_visitor_timezone|default('1') == '1' ? 'checked' }}
                           class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                    {{ __('Display dates in visitor\'s own timezone') }}
                </label>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ __('When enabled, frontend dates are shown in each visitor\'s own timezone (requires JavaScript; otherwise the timezone above is used). The admin panel always uses the timezone above.') }}</p>
            </div>
        </div>

        <hr class="border-gray-200">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {# Maintenance #}
            <div x-data="{ maintenanceEnabled: {{ settings.maintenance_mode|default('0') == '1' ? 'true' : 'false' }} }">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">{{ __('Maintenance') }}</p>
                <div {{ vl.attrs('general', __('Maintenance Mode'), 'maintenance_mode', 'site', __('Maintenance'), 'offline downtime') }} class="rounded-lg border border-yellow-200 bg-yellow-50 p-4">
                    <label class="flex items-center gap-3">
                        <input type="hidden" name="maintenance_mode" value="0">
                        <input type="checkbox" name="maintenance_mode" value="1"
                               {{ settings.maintenance_mode|default('0') == '1' ? 'checked' }}
                               x-model="maintenanceEnabled"
                               class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-yellow-600 focus:ring-yellow-500">
                        <span>
                            <span class="block text-sm font-medium text-gray-700">{{ __('Maintenance Mode') }}</span>
                            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('Show a maintenance page to visitors.') }}</span>
                        </span>
                    </label>
                </div>
                <div x-show="maintenanceEnabled" x-cloak class="mt-3">
                    {% include 'admin/components/i18n-setting-field.twig' with {
                        vl_tab: 'general',
                        vl_subtab: 'site',
                        vl_section: __('Maintenance'),
                        field: 'maintenance_mode_message',
                        label: __('Message'),
                        type: 'textarea',
                        settings: settings,
                        active_locales: active_locales,
                        field_locales: field_locales,
                        default_lang: default_lang,
                        i18n_fields: i18n_fields,
                        placeholder: __("We're currently performing scheduled maintenance. Please check back in a little while."),
                    } %}
                </div>
            </div>

            {# Cookies #}
            <div x-data="{ cookieWarningEnabled: {{ settings.cookie_warning_enabled|default('0') == '1' ? 'true' : 'false' }} }">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">{{ __('Cookies') }}</p>
                <div {{ vl.attrs('general', __('Display Cookie Warning'), 'cookie_warning_enabled', 'site', __('Cookies'), 'consent gdpr banner') }} class="rounded-lg border border-blue-200 bg-blue-50 p-4">
                    <label class="flex items-center gap-3">
                        <input type="hidden" name="cookie_warning_enabled" value="0">
                        <input type="checkbox" name="cookie_warning_enabled" value="1"
                               {{ settings.cookie_warning_enabled|default('0') == '1' ? 'checked' }}
                               x-model="cookieWarningEnabled"
                               class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500">
                        <span>
                            <span class="block text-sm font-medium text-gray-700">{{ __('Display Cookie Warning') }}</span>
                            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('Show a cookie consent banner to visitors.') }}</span>
                        </span>
                    </label>
                </div>
                <div x-show="cookieWarningEnabled" x-cloak class="mt-3">
                    {% include 'admin/components/i18n-setting-field.twig' with {
                        vl_tab: 'general',
                        vl_subtab: 'site',
                        vl_section: __('Cookies'),
                        field: 'cookie_warning_text',
                        label: __('Warning Text'),
                        type: 'textarea',
                        settings: settings,
                        active_locales: active_locales,
                        field_locales: field_locales,
                        default_lang: default_lang,
                        i18n_fields: i18n_fields,
                        placeholder: __("We use essential cookies to ensure you get the best experience on our website. Only necessary cookies are used."),
                    } %}
                </div>
            </div>
        </div>

    </form>
</div>