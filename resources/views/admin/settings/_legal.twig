    {# ══ Legal & Compliance ══ #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    {% set legal_status_badges = {
        configured:  { label: __('Configured'),   class: 'bg-green-50 text-green-700 ring-green-200 dark:bg-green-900/30 dark:text-green-300 dark:ring-green-800' },
        partial:     { label: __('Partial'),      class: 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-900/30 dark:text-amber-200 dark:ring-amber-800' },
        missing:     { label: __('Missing'),      class: 'bg-red-50 text-red-700 ring-red-200 dark:bg-red-900/30 dark:text-red-300 dark:ring-red-800' },
        unavailable:  { label: __('Not in Vale yet'), class: 'bg-gray-100 text-gray-600 ring-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700' },
        acknowledged: { label: __('Handled outside Vale'), class: 'bg-blue-50 text-blue-700 ring-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:ring-blue-800' },
    } %}
    {% set legal_item_labels = {
        imprint:    __('Imprint'),
        privacy:    __('Privacy Policy'),
        terms:      __('Terms & Conditions'),
        returns:    __('Return Policy'),
        withdrawal: __('Withdrawal'),
        consent:    __('Cookie Consent'),
        us_optout:      __('Do Not Sell or Share (US)'),
        digital_waiver: __('Digital withdrawal waiver'),
        price_history:  __('Lowest price in the last 30 days'),
        verified_reviews: __('Verified reviews'),
    } %}
    {% set legal_item_notes = {
        imprint:    __('Business name, address, contact details and registration number on a dedicated page.'),
        withdrawal: __('Adds a public withdrawal page where customers can declare a withdrawal online and receive a confirmation by email.'),
        consent:    __('Consent is only recorded while the cookie consent banner is on.'),
        us_optout:  __('Adds a "Do Not Sell or Share" action and honours Global Privacy Control signals.'),
        verified_reviews: __('Only buyers who purchased the product can review it, and the review form says so. The EU Omnibus, the UK DMCCA and the US FTC review rule expect verified reviews and a clear disclosure.'),
    } %}
    {% set legal_other_region = legal_regions.other|default({ label: '', consent_model: 'opt-in', items: [] }) %}
    {% set legal_link_texts = {
        verified_reviews: __('Review settings'),
    } %}
    {% set legal_region_labels = {
        eu:   __('European Union / EEA'),
        de_at: __('Germany / Austria'),
        uk:   __('United Kingdom'),
        us:   __('United States'),
        ca:   __('Canada'),
        anz:  __('Australia / New Zealand'),
        other: __('No specific profile'),
    } %}
    <div id="tab-legal" class="tab-panel hidden">
    <form method="post" action="{{ url('/admin/settings') }}" class="space-y-6">
        {{ csrf_field() }}
        <input type="hidden" name="_METHOD" value="PUT">
        <input type="hidden" name="_group" value="legal">

        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs space-y-5">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 border-b pb-3">{{ __('Legal & Compliance Profile') }}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ __('Pick the country where you operate. The list below shows the documents and settings that are commonly expected there. It is a checklist, not legal advice, and it never changes a setting on its own.') }}</p>

            <div class="sm:max-w-md">
                <label for="legal-profile-country" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Country of operation') }}</label>
                <select id="legal-profile-country" name="legal_profile_country" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm dark:bg-gray-800 dark:text-gray-100">
                    <option value=""
                            data-region-label="{{ __('No country selected') }}"
                            data-consent-label="{{ __('Opt-in (EU/UK style)') }}"
                            data-items="{{ legal_other_region.items|join(',') }}"
                            {{ legal_profile.key == 'other' and settings.legal_profile_country|default('') == '' ? 'selected' }}>{{ __('Not set') }}</option>
                    {% for code in country_codes|default([]) %}
                        {% set region_key = attribute(legal_country_regions, code)|default('other') %}
                        {% set region = attribute(legal_regions, region_key)|default(legal_other_region) %}
                        <option value="{{ code }}"
                                data-region-label="{{ attribute(legal_region_labels, region_key)|default(region.label)|e('html_attr') }}"
                                data-consent-label="{{ region.consent_model == 'opt-out' ? __('Opt-out (US style)') : __('Opt-in (EU/UK style)') }}"
                                data-items="{{ region.items|join(',') }}"
                                {{ settings.legal_profile_country|default('') == code ? 'selected' }}>{{ country_name(code) }} ({{ code }})</option>
                    {% endfor %}
                </select>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-3">
                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{{ __('Suggested region') }}</p>
                    <p id="legal-profile-region" class="mt-1 text-sm font-medium text-gray-900 dark:text-gray-100">{{ attribute(legal_region_labels, legal_profile.key)|default(legal_profile.label) }}</p>
                </div>
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-3">
                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{{ __('Suggested banner model') }}</p>
                    <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
                        <p id="legal-profile-consent-model" class="text-sm font-medium text-gray-900 dark:text-gray-100">{{ legal_profile.consent_model == 'opt-out' ? __('Opt-out (US style)') : __('Opt-in (EU/UK style)') }}</p>
                        <button type="submit" name="apply_consent_model" value="1"
                                class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white transition-colors">
                            {{ __('Use this banner model') }}
                        </button>
                    </div>
                    <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">{{ __('Turns the cookie consent banner on and sets the US opt-out control to match this region.') }}</p>
                </div>
            </div>

            {% if legal_findings|default([])|length > 0 %}
            <div class="rounded-lg border border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 p-4">
                <h4 class="text-sm font-semibold text-amber-900 dark:text-amber-200">{{ __('Open items for this profile') }}</h4>
                <ul class="mt-2 space-y-1.5 text-xs text-amber-800 dark:text-amber-200 list-disc list-inside">
                    {% for finding in legal_findings %}
                    <li>
                        {{ finding.message }}
                        {% if finding.link is not empty %}
                        <a href="{{ url(finding.link) }}" class="font-medium underline">{{ finding.link_text }}</a>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <ul class="space-y-2">
                {% for item in legal_checklist|default([]) %}
                    {% set badge = attribute(legal_status_badges, item.status)|default(legal_status_badges.missing) %}
                    <li data-legal-req="{{ item.key }}" class="flex flex-col gap-2 rounded-lg border border-gray-200 dark:border-gray-700 p-3 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-gray-900 dark:text-gray-100">{{ attribute(legal_item_labels, item.key)|default(item.key) }}</p>
                            {% set item_note = attribute(legal_item_notes, item.key)|default('') %}
                            {% if item_note is not empty %}
                            <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{{ item_note }}</p>
                            {% endif %}
                            {% if item.link is not empty %}
                            <a href="{{ url(item.link) }}" class="mt-1 inline-block text-xs font-medium underline text-gray-700 dark:text-gray-300">{{ attribute(legal_link_texts, item.key)|default(item.link_text|default(__('Configure'))) }}</a>
                            {% endif %}
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                            <div class="flex items-center gap-2">
                                <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{ item.level == 'required' ? 'bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900' : 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300' }}">{{ item.level == 'required' ? __('Required') : __('Recommended') }}</span>
                                <span class="rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 {{ badge.class }}">{{ badge.label }}</span>
                            </div>
                            <label class="inline-flex items-center gap-1.5 text-[11px] text-gray-500 dark:text-gray-400">
                                <input type="hidden" name="legal_ack_{{ item.key }}" value="0">
                                <input type="checkbox" name="legal_ack_{{ item.key }}" value="1"
                                       class="rounded border-gray-300 text-gray-900 dark:border-gray-600"
                                       {{ item.acknowledged ? 'checked' }}>
                                {{ __('I handled this myself') }}
                            </label>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            {% if shop_enabled|default('1') == '1' %}
            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                <label class="flex items-start gap-3">
                    <input type="hidden" name="compliance_digital_waiver" value="0">
                    <input type="checkbox" name="compliance_digital_waiver" value="1"
                           {{ settings.compliance_digital_waiver|default('0') == '1' ? 'checked' }}
                           class="mt-0.5 rounded border-gray-300 dark:border-gray-600">
                    <span>
                        <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Digital withdrawal waiver') }}</span>
                        <span class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Adds a per-product switch for digital content whose purchase waives the withdrawal right. The period comes from Cancellation & Refund Settings.') }}</span>
                    </span>
                </label>
            </div>

            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                <label class="flex items-start gap-3">
                    <input type="hidden" name="compliance_withdrawal_function" value="0">
                    <input type="checkbox" name="compliance_withdrawal_function" value="1"
                           {{ settings.compliance_withdrawal_function|default('0') == '1' ? 'checked' }}
                           class="mt-0.5 rounded border-gray-300 dark:border-gray-600">
                    <span>
                        <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Online withdrawal function') }}</span>
                        <span class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Publishes a withdrawal page for customers, emails a dated confirmation and lists every declaration under Orders → Withdrawals. Required for online shops selling to consumers in the EU since 19 June 2026.') }}</span>
                    </span>
                </label>
                <p class="mt-2 pl-7 text-xs text-gray-500 dark:text-gray-400">
                    <a href="{{ url('/withdrawal') }}" target="_blank" rel="noopener" class="underline">{{ __('Open the withdrawal page') }}</a>
                </p>
            </div>

            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                <label for="return-shipping-payer" class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Who pays the return shipping?') }}</label>
                <select id="return-shipping-payer" name="return_shipping_payer" class="mt-2 w-full max-w-xs rounded-lg border-gray-300 dark:border-gray-700 text-sm dark:bg-gray-800 dark:text-gray-100">
                    <option value="customer" {{ settings.return_shipping_payer|default('customer') == 'customer' ? 'selected' }}>{{ __('The customer pays the return shipping') }}</option>
                    <option value="shop" {{ settings.return_shipping_payer|default('customer') == 'shop' ? 'selected' }}>{{ __('The shop pays the return shipping') }}</option>
                </select>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ __('Shown on the checkout and withdrawal pages. EU consumer law requires telling customers before they order who pays for returning the goods.') }}</p>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                    <label class="flex items-start gap-3">
                        <input type="hidden" name="compliance_grundpreis" value="0">
                        <input type="checkbox" name="compliance_grundpreis" value="1"
                               {{ settings.compliance_grundpreis|default('1') == '1' ? 'checked' }}
                               class="mt-0.5 rounded border-gray-300 dark:border-gray-600">
                        <span>
                            <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Unit price') }}</span>
                            <span class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Shows the price per kg, litre or square metre below the product price, using the content amount. Products sold by the piece never show it.') }}</span>
                        </span>
                    </label>
                </div>
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                    <label class="flex items-start gap-3">
                        <input type="hidden" name="compliance_price_history" value="0">
                        <input type="checkbox" name="compliance_price_history" value="1"
                               {{ settings.compliance_price_history|default('1') == '1' ? 'checked' }}
                               class="mt-0.5 rounded border-gray-300 dark:border-gray-600">
                        <span>
                            <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Lowest price in the last 30 days') }}</span>
                            <span class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Records price changes and shows the lowest price of the last 30 days while a product is on sale (EU Omnibus).') }}</span>
                        </span>
                    </label>
                </div>
            </div>
            {% endif %}

        </div>

        {% set footer_menu = legal_footer|default({ menu_id: null, menu_name: '', has_heading: false, links: 0 }) %}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs space-y-5">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 border-b pb-3">{{ __('Legal Pages') }}</h3>
            <div x-data="{ open: false }" class="rounded-lg bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700 text-sm text-amber-800 dark:text-amber-200">
                <button type="button" @click="open = !open" class="w-full flex items-center justify-between p-3.5 font-medium text-amber-900 dark:text-amber-200 focus:outline-hidden text-left cursor-pointer">
                    <span class="flex items-center gap-2">
                        <svg class="h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 110 20A10 10 0 0112 2z"/>
                        </svg>
                        <span>{{ __('Legal Requirements Notice') }}</span>
                    </span>
                    <svg x-show="open" class="h-4 w-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                    <svg x-show="!open" x-cloak class="h-4 w-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
                <div x-show="open" x-cloak class="px-4 pb-4 border-t border-amber-200/60 dark:border-amber-700 pt-3 space-y-2 text-amber-800 dark:text-amber-200">
                    <p>{{ __('You need to check your local regulations to comply with legal requirements for online stores. The four pages below — Return Policy, Privacy Policy, Terms & Conditions and Imprint — are the documents most commonly required.') }}</p>
                </div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ __('Select existing pages to link as policy documents. Privacy, terms and returns appear on the checkout page and in order confirmation emails; the imprint is linked from the site footer.') }}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
                {% set legal_fields = [
                    { key: 'policy_page_privacy', label: __('Privacy Policy Page'), seed: pagePickerSeeds.policy_privacy|default(null), attrs_key: 'policy_page_privacy', keywords: 'privacy gdpr policy' },
                    { key: 'policy_page_terms', label: __('Terms & Conditions Page'), seed: pagePickerSeeds.policy_terms|default(null), attrs_key: 'policy_page_terms', keywords: 'terms conditions tos' },
                    { key: 'policy_page_imprint', label: __('Imprint Page'), seed: pagePickerSeeds.policy_imprint|default(null), attrs_key: 'policy_page_imprint', keywords: 'imprint impressum legal notice' },
                ] %}
                {% if shop_enabled|default('1') == '1' %}
                {% set legal_fields = legal_fields|merge([
                    { key: 'policy_page_returns', label: __('Return Policy Page'), seed: pagePickerSeeds.policy_returns|default(null), attrs_key: 'policy_page_returns', keywords: 'returns refund policy' },
                ]) %}
                {% endif %}
                {% for field in legal_fields %}
                <div {{ vl.attrs('legal', field.label, field.attrs_key, '', __('Legal Pages'), field.keywords) }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ field.label }}</label>
                    {% include 'admin/components/page-async-select.twig' with {
                        name: field.key,
                        value_field: 'slug',
                        initial_value: field.seed ? field.seed.value : attribute(settings, field.key)|default(''),
                        initial_label: field.seed ? field.seed.label : '',
                        placeholder: __('Search pages…'),
                    } %}
                </div>
                {% endfor %}
            </div>
            <div class="pt-2">
                <a href="{{ url('/admin/pages/create') }}" target="_blank"
                   class="inline-flex items-center gap-1.5 text-sm text-gray-900 dark:text-gray-100 hover:text-gray-800 dark:hover:text-gray-300 transition-colors font-medium">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ __('Create a new page') }} →
                </a>
            </div>

            <div class="border-t dark:border-gray-700 pt-4">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">{{ __('Footer menu') }}</p>
                        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                            {% if footer_menu.menu_id %}
                                {% if footer_menu.has_heading %}
                                    {{ __(':menu is the footer menu. The Legal column has :count links.', {':menu': footer_menu.menu_name, ':count': footer_menu.links}) }}
                                {% else %}
                                    {{ __(':menu is the footer menu, but it has no Legal column yet.', {':menu': footer_menu.menu_name}) }}
                                {% endif %}
                            {% else %}
                                {{ __('No footer menu is defined yet. The links above are printed as a plain row in the footer until a menu is created.') }}
                            {% endif %}
                        </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        {% if footer_menu.menu_id %}
                        <a href="{{ url('/admin/menus') }}" class="rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800">{{ __('Open menu builder') }}</a>
                        {% endif %}
                        <button type="submit" form="legal-footer-form" class="rounded-lg bg-gray-900 px-3 py-2 text-xs font-medium text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white transition-colors">
                            {{ footer_menu.menu_id ? __('Add Legal section') : __('Create footer menu') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </form>

    <form id="legal-footer-form" method="post" action="{{ url('/admin/settings/legal-footer') }}" class="hidden">
        {{ csrf_field() }}
    </form>
    </div>{# /tab-legal #}
<script nonce="{{ csp_nonce }}">
(function () {
    var select = document.getElementById('legal-profile-country');
    if (!select) {
        return;
    }

    var regionLabel = document.getElementById('legal-profile-region');
    var consentLabel = document.getElementById('legal-profile-consent-model');
    var rows = document.querySelectorAll('[data-legal-req]');

    function render() {
        var option = select.options[select.selectedIndex];
        if (!option) {
            return;
        }

        var keys = (option.getAttribute('data-items') || '').split(',').filter(Boolean);

        rows.forEach(function (row) {
            row.style.display = keys.indexOf(row.getAttribute('data-legal-req')) === -1 ? 'none' : '';
        });

        if (regionLabel) {
            regionLabel.textContent = option.getAttribute('data-region-label') || '';
        }
        if (consentLabel) {
            consentLabel.textContent = option.getAttribute('data-consent-label') || '';
        }
    }

    select.addEventListener('change', render);
    render();
})();
</script>
