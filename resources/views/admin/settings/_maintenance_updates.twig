    {# ══ Maintenance Updates sub-panel ══ #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    <div id="maintenance-tab-updates" class="maintenance-tab-panel">
    {# ── Software Updates ────────────────────────────────────────── #}
    <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs space-y-5"
         x-data="{
             enabled: {{ cronConfig.updates_enabled|default('true') != 'false' ? 'true' : 'false' }},
             autoCheck: {{ cronConfig.update_auto_check|default('true') != 'false' ? 'true' : 'false' }},
             autoApply: {{ cronConfig.update_auto_apply|default('false') == 'true' ? 'true' : 'false' }}
         }">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ __('Software Updates') }}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ __('Vale can automatically check for new releases via the cron job (every 24 hours).') }}</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
                <a href="{{ url('/admin/update/backups') }}"
                   class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    {{ __('Backups') }}
                </a>
                <a href="{{ url('/admin/update') }}"
                   class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    {{ __('Go to Updates') }}
                    {% if update_available_version is defined and update_available_version %}
                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 dark:bg-green-900/30 px-3 py-1 text-xs font-semibold text-green-800 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/50 transition-colors">v{{ update_available_version }}</span>
                    {% endif %}
                </a>
            </div>
        </div>
        <form method="post" action="{{ url('/admin/settings') }}">
            {{ csrf_field() }}
            <input type="hidden" name="_METHOD" value="PUT">
            <input type="hidden" name="_group" value="cron">
            <label class="flex items-start gap-3 cursor-pointer pb-2 mb-1 border-b border-gray-100 dark:border-gray-800" {{ vl.attrs('maintenance', __('Enable software updates'), 'updates_enabled', 'updates', __('Software Updates'), 'enable updates master switch') }}>
                <input type="hidden" name="updates_enabled" value="false">
                <input type="checkbox" name="updates_enabled" value="true"
                       x-model="enabled"
                       {{ cronConfig.updates_enabled|default('true') != 'false' ? 'checked' }}
                       class="mt-0.5 h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                <span>
                    <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Enable software updates') }}</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('Master switch for the update system. When off, cron will never check for or install updates. Manual checks from the Updates page remain available.') }}</span>
                </span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer"
                   :class="!enabled ? 'opacity-50 cursor-not-allowed' : ''" {{ vl.attrs('maintenance', __('Automatic update checks'), 'update_auto_check', 'updates', __('Software Updates'), 'auto update cron releases') }}>
                <input type="hidden" name="update_auto_check" value="false">
                <input type="checkbox" name="update_auto_check" value="true"
                       x-model="autoCheck"
                       :disabled="!enabled"
                       @change="if (!enabled) autoCheck = false"
                       {{ cronConfig.update_auto_check|default('true') != 'false' ? 'checked' }}
                       class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 disabled:cursor-not-allowed">
                <span>
                    <span class="block text-sm font-medium text-gray-700">{{ __('Automatic update checks') }}</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('When cron runs, check for new Vale releases and plugin updates every 24 hours.') }}</span>
                </span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer mt-3" {{ vl.attrs('maintenance', __('Automatically apply updates'), 'update_auto_apply', 'updates', __('Software Updates'), 'auto install update') }}
                   :class="(!enabled || !autoCheck) ? 'opacity-50 cursor-not-allowed' : ''">
                <input type="hidden" name="update_auto_apply" value="false">
                <input type="checkbox" name="update_auto_apply" value="true"
                       x-model="autoApply"
                       :disabled="!enabled || !autoCheck"
                       @change="if (!enabled || !autoCheck) autoApply = false"
                       {{ cronConfig.update_auto_apply|default('false') == 'true' ? 'checked' }}
                       class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 disabled:cursor-not-allowed">
                <span>
                    <span class="block text-sm font-medium text-gray-700">{{ __('Automatically apply updates') }}</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ __('When a Vale update is available, install it automatically during the next cron run. A backup will be created first. Plugin updates are never applied automatically.') }}</span>
                </span>
            </label>
            <div x-show="!enabled" x-cloak
                 class="mt-3 flex items-start gap-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-3 py-2.5 text-xs text-gray-600 dark:text-gray-400">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
                <span>{{ __('Software updates are disabled. Cron will not check for or install updates.') }}</span>
            </div>
            <div x-show="!autoCheck && autoApply" x-cloak
                 class="mt-3 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2.5 text-xs text-red-800">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
                <span>{{ __('Automatic update checks are disabled. Auto-apply requires update checks to be enabled — it will not run without them.') }}</span>
            </div>
            <div x-show="autoCheck && autoApply" x-cloak
                 class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs text-amber-800">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
                <span>{{ __('Auto-apply will overwrite files and run migrations automatically. A full backup is created automatically before each update and can be rolled back if anything goes wrong.') }}</span>
            </div>
            {% if cronConfig.cron_mode|default('none') == 'none' %}
            <div x-show="autoCheck" x-cloak
                 class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs text-amber-800">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
                <span>{{ __('Cron is currently disabled. Enable a cron mode in the Scheduled Tasks section below for automatic update checks to run.') }}</span>
            </div>
            {% endif %}
        </form>
    </div>
    </div>
