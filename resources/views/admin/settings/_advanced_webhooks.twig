    {# ══ Webhooks sub-panel ══ #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    {#  — prepare bootstrap state for Alpine when returning from a failed form submit — #}
    {%- set _whHasOld  = webhookFormOld is not empty -%}
    {%- set _whIsEdit  = _whHasOld and webhookFormOld._id is defined -%}
    {%- set _whOldHdrs = [] -%}
    {%- if _whHasOld -%}
        {%- for _r in (webhookFormOld.headers ?? []) -%}
            {%- set _whOldHdrs = _whOldHdrs|merge([{'key': _r.key|default(''), 'value': _r.value|default('')}]) -%}
        {%- endfor -%}
    {%- endif -%}
    {%- set _whOldEvents = webhookFormOld.events ?? [] -%}
    {%- set _whOldActive = not _whHasOld or (webhookFormOld.is_active|default('0') == '1') -%}
    {%- set _whOldMethod = _whHasOld ? (webhookFormOld.method|default('POST')|upper) : 'POST' -%}
    {%- set _whOldBody   = _whHasOld ? (webhookFormOld.body_template|default('')) : '' -%}

    <div id="advanced-tab-webhooks" class="advanced-tab-panel hidden"
         x-data="{
             open:          {{ _whHasOld ? 'true' : 'false' }},
             editing:       {{ _whIsEdit ? webhookFormOld._id : 'null' }},
             formName:      '{{ _whHasOld ? (webhookFormOld.name|default('')|e('js')) : '' }}',
             formUrl:       '{{ _whHasOld ? (webhookFormOld.url|default('')|e('js')) : '' }}',
             formMethod:    '{{ _whOldMethod|e('js') }}',
             bodyTemplate:  '{{ _whOldBody|e('js') }}',
             isActive:      {{ _whOldActive ? 'true' : 'false' }},
             secret:        '',
             showSecret:    false,
             headers:       {{ _whOldHdrs|json_encode }},
             checkedEvents: {{ _whOldEvents ? _whOldEvents|json_encode : '[]' }},
             testLoading:   false,
             testResult:    null,
             get hasBody()  { return ['POST','PUT','PATCH'].includes(this.formMethod); },
             addHeader()    { this.headers.push({key:'',value:''}); },
             removeHeader(i){ this.headers.splice(i,1); },
             generateSecret(){
                 this.secret = Array.from(crypto.getRandomValues(new Uint8Array(24))).map(b=>b.toString(16).padStart(2,'0')).join('');
                 this.showSecret = true;
             },
             openNew(){
                 this.editing = null;
                 this.formName = ''; this.formUrl = ''; this.formMethod = 'POST'; this.bodyTemplate = '';
                 this.isActive = true; this.secret = ''; this.showSecret = false; this.headers = [];
                 this.checkedEvents = {{ available_events|keys|json_encode }};
                 this.testLoading = false; this.testResult = null;
                 this.open = true;
             },
             openEdit(id,name,url,method,bodyTpl,hasSecret,headers,events,active){
                 this.editing = id;
                 this.formName = name; this.formUrl = url; this.formMethod = method; this.bodyTemplate = bodyTpl;
                 this.isActive = active;
                 this.secret = hasSecret ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' : '';
                 this.showSecret = false;
                 this.headers = Object.entries(headers).map(([k,v])=>({key:k,value:v}));
                 this.checkedEvents = events;
                 this.testLoading = false; this.testResult = null;
                 this.open = true;
             },
             runTest(){
                 if(!this.formUrl) { this.testResult = {ok:false,error:'Enter a URL first'}; return; }
                 this.testLoading = true; this.testResult = null;
                 fetch('{{ url('/admin/webhooks/test-preview') }}', {
                     method: 'POST',
                     headers: {
                         'Content-Type': 'application/json',
                         'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content ?? ''
                     },
                     body: JSON.stringify({
                         url:           this.formUrl,
                         method:        this.formMethod,
                         body_template: this.bodyTemplate,
                         secret:        this.secret,
                         editing_id:    this.editing,
                         headers:       this.headers,
                         events:        this.checkedEvents
                     })
                 })
                 .then(r=>r.json())
                 .then(d=>{ this.testResult = d; this.testLoading = false; })
                 .catch(()=>{ this.testResult = {ok:false,error:'Request failed'}; this.testLoading = false; });
             },
             showVars:      false,
             isEventChecked(ev){ return this.checkedEvents.includes(ev); },
             toggleEvent(ev){
                 const i = this.checkedEvents.indexOf(ev);
                 if(i===-1) this.checkedEvents.push(ev); else this.checkedEvents.splice(i,1);
             },
             allEvents: {{ available_events|keys|json_encode }},
             selectAllEvents(){ this.checkedEvents = [...this.allEvents]; },
             selectNoneEvents(){ this.checkedEvents = []; },
             insertPlaceholder(tag){
                 const ta = this.$refs.bodyTpl;
                 if (!ta) { this.bodyTemplate += tag; return; }
                 const s = ta.selectionStart ?? this.bodyTemplate.length;
                 const e = ta.selectionEnd   ?? this.bodyTemplate.length;
                 this.bodyTemplate = this.bodyTemplate.substring(0,s) + tag + this.bodyTemplate.substring(e);
                 this.$nextTick(() => { ta.selectionStart = ta.selectionEnd = s + tag.length; ta.focus(); });
             }
         }">

        {# ── Panel header ── #}
        <div class="mb-4 flex items-start justify-between gap-4">
            <div>
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ __('Outbound Webhooks') }}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ __('Send signed HTTP POST notifications when orders are placed or status changes.') }}</p>
            </div>
            <button type="button" @click="openNew()"
                    class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-xs hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                {{ __('Add Webhook') }}
            </button>
        </div>

        {# ── Webhook list ── #}
        {% if webhooks is empty %}
            <div class="rounded-xl border border-dashed border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-12 text-center">
                <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <p class="mt-3 text-sm font-medium text-gray-700">{{ __('No webhooks configured yet') }}</p>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ __('Add a webhook to receive real-time order notifications in external systems.') }}</p>
                <button type="button" @click="openNew()"
                        class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                    {{ __('Add your first webhook') }}
                </button>
            </div>
        {% else %}
            <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white dark:bg-gray-900 shadow-xs">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-800/50">
                        <tr>
                            <th class="px-4 py-3 text-left font-medium text-gray-500 dark:text-gray-400">{{ __('Name') }}</th>
                            <th class="px-4 py-3 text-left font-medium text-gray-500 dark:text-gray-400">URL</th>
                            <th class="px-4 py-3 text-left font-medium text-gray-500 dark:text-gray-400">{{ __('Events') }}</th>
                            <th class="px-4 py-3 text-left font-medium text-gray-500 dark:text-gray-400">{{ __('Last Delivery') }}</th>
                            <th class="px-4 py-3 text-center font-medium text-gray-500 dark:text-gray-400">{{ __('Active') }}</th>
                            <th class="px-4 py-3 text-right font-medium text-gray-500 dark:text-gray-400">{{ __('Actions') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for wh in webhooks %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 align-top transition-colors" x-data="{ testLoading: false, testResult: null }">
                            <td class="px-4 py-3 font-medium">
                                <button type="button"
                                        @click="openEdit(
                                            {{ wh.getId() }},
                                            '{{ wh.getName()|e('js') }}',
                                            '{{ wh.getUrl()|e('js') }}',
                                            '{{ wh.getMethod()|e('js') }}',
                                            '{{ (wh.getBodyTemplate() ?? '')|e('js') }}',
                                            {{ wh.getSecret() ? 'true' : 'false' }},
                                            {{ wh.getHeaders()|json_encode }},
                                            {{ wh.getEvents()|json_encode }},
                                            {{ wh.isActive() ? 'true' : 'false' }}
                                        )"
                                        class="text-gray-900 dark:text-gray-100 hover:underline hover:text-gray-700 dark:hover:text-gray-300 transition-colors">{{ wh.getName() }}</button>
                            </td>
                            <td class="max-w-xs px-4 py-3">
                                <span class="block truncate font-mono text-xs text-gray-600" title="{{ wh.getUrl() }}">{{ wh.getUrl() }}</span>
                            </td>
                            <td class="w-48 px-4 py-3">
                                <div class="flex flex-wrap gap-1">
                                    {% for ev in wh.getEvents() %}
                                        <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-gray-200">{{ ev }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
                                {% if wh.getLastDeliveryAt() %}
                                    <span class="inline-flex items-center gap-1">
                                        {% if wh.getLastDeliveryStatus() == 'ok' %}
                                            <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                                            <span class="text-green-700">OK</span>
                                        {% else %}
                                            <span class="inline-block h-2 w-2 rounded-full bg-red-500"></span>
                                            <span class="text-red-600">{{ __('Error') }}</span>
                                        {% endif %}
                                        &mdash; {{ wh.getLastDeliveryAt()|date('Y-m-d H:i') }}
                                        {% if wh.getLastDeliveryMs() %}<span class="text-gray-400">({{ wh.getLastDeliveryMs() }}ms)</span>{% endif %}
                                    </span>
                                {% else %}
                                    <span class="italic text-gray-400">{{ __('Never') }}</span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-center">
                                {% if wh.isActive() %}
                                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500"></span>
                                {% else %}
                                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-gray-300"></span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right">
                                <div class="inline-flex items-center justify-end gap-2">
                                    {# Test button #}
                                    <button type="button"
                                            :disabled="testLoading"
                                            @click="
                                                testLoading = true; testResult = null;
                                                fetch('{{ url('/admin/webhooks/' ~ wh.getId() ~ '/test') }}', {
                                                    method: 'POST',
                                                    headers: {'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content ?? ''}
                                                })
                                                .then(r=>r.json())
                                                .then(d=>{ testResult=d; testLoading=false; })
                                                .catch(()=>{ testResult={ok:false,error:'Request failed'}; testLoading=false; })
                                            "
                                            class="rounded-sm px-3 py-1.5 text-xs font-medium text-indigo-600 ring-1 ring-indigo-300 hover:bg-indigo-50 dark:text-indigo-300 dark:ring-indigo-700 dark:hover:bg-indigo-900/50 transition-colors">
                                        <span x-show="!testLoading">{{ __('Test') }}</span>
                                        <span x-show="testLoading" x-cloak>{{ __('Testing...') }}</span>
                                    </button>
                                    <template x-if="testResult !== null">
                                        <span class="inline-flex flex-wrap items-center gap-1"
                                              :class="testResult.ok ? 'text-green-700 dark:text-green-300' : 'text-red-600 dark:text-red-300'">
                                            <template x-for="r in (testResult.results ?? [{
                                                event: '',
                                                result: testResult,
                                            }])" :key="r.event">
                                                <span :class="r.result.ok ? 'bg-green-100 text-green-700 border border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-700' : 'bg-red-100 text-red-600 border border-red-200 dark:bg-red-900/30 dark:text-red-300 dark:border-red-700'"
                                                      class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium"
                                                      x-text="(r.event ? r.event + ' ' : '') + (r.result.ok ? '✓ HTTP ' + (r.result.status ?? '') : '✗ ' + (r.result.error ?? 'Error'))"></span>
                                            </template>
                                        </span>
                                    </template>
                                    {# Edit button #}
                                    <button type="button"
                                            @click="openEdit(
                                                {{ wh.getId() }},
                                                '{{ wh.getName()|e('js') }}',
                                                '{{ wh.getUrl()|e('js') }}',
                                                '{{ wh.getMethod()|e('js') }}',
                                                '{{ (wh.getBodyTemplate() ?? '')|e('js') }}',
                                                {{ wh.getSecret() ? 'true' : 'false' }},
                                                {{ wh.getHeaders()|json_encode }},
                                                {{ wh.getEvents()|json_encode }},
                                                {{ wh.isActive() ? 'true' : 'false' }}
                                            )"
                                            class="rounded-sm px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-gray-300 dark:ring-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{{ __('Edit') }}</button>
                                    {# Delete form #}
                                    <form method="post" action="{{ url('/admin/webhooks/' ~ wh.getId() ~ '/delete') }}"
                                          onsubmit="return confirm('{{ __('Delete this webhook?')|e('js') }}')">
                                        {{ csrf_field()|raw }}
                                        <button type="submit"
                                                class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">{{ __('Delete') }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="mt-4 rounded-lg border border-blue-100 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/50 px-4 py-3 text-sm text-blue-800 dark:text-blue-200">
                <strong>{{ __('Verifying payloads:') }}</strong>
                {{ __('If you set a secret, each request includes') }}
                <code class="rounded-sm bg-blue-100 dark:bg-blue-900 px-1 font-mono text-xs dark:text-blue-200">X-VL-Signature: sha256=&lt;hex&gt;</code>.
                {{ __('Verify with') }} <code class="rounded-sm bg-blue-100 dark:bg-blue-900 px-1 font-mono text-xs dark:text-blue-200">hash_hmac('sha256', $rawBody, $secret)</code>.
            </div>
            
        {% endif %}

        {# ══════════════════════════════════════════════════════════════ #}
        {# ══ Add / Edit Modal                                         ══ #}
        {# ══════════════════════════════════════════════════════════════ #}
        <div x-show="open" x-cloak
             class="fixed inset-0 z-[60] flex items-center justify-center p-2 sm:p-4"
             @keydown.escape.window="open = false">
            <div class="absolute inset-0 bg-black/40" @click="open = false"></div>
            <div class="relative z-10 flex max-h-[calc(100dvh-2rem)] sm:max-h-[85vh] w-full max-w-2xl flex-col overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-2xl">

                {# Modal header — title + Active toggle + close #}
                <div class="flex shrink-0 items-center justify-between gap-4 border-b border-gray-100 px-6 py-4 dark:border-gray-700">
                    <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100"
                        x-text="editing ? '{{ __('Edit Webhook')|e('js') }}' : '{{ __('Add Webhook')|e('js') }}'"></h2>
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                            <input type="hidden" name="is_active" form="wh_form" value="0">
                            <input type="checkbox" id="wh_modal_active" name="is_active" form="wh_form" value="1"
                                   :checked="isActive"
                                   @change="isActive = $event.target.checked"
                                   class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                            <label for="wh_modal_active" class="cursor-pointer text-sm font-medium text-gray-700 dark:text-gray-300" {{ vl.attrs('advanced', __('Active — deliver events to this endpoint'), 'is_active', 'webhooks', __('Outbound Webhooks'), 'webhook active enable') }}>{{ __('Active — deliver events to this endpoint') }}</label>
                        </div>
                        <button type="button" @click="open = false"
                                class="rounded-sm p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </div>

                {# Modal form #}
                <form method="post" id="wh_form"
                      :action="editing ? '{{ url('/admin/webhooks') }}/' + editing : '{{ url('/admin/webhooks') }}'"
                      class="flex min-h-0 flex-1 flex-col">
                    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-5">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="_method" :value="editing ? 'PUT' : 'POST'">

                    {# Validation errors #}
                    {% if webhookFormErrors is not empty %}
                        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3">
                            <p class="text-sm font-medium text-red-700">{{ __('Please fix the following errors:') }}</p>
                            <ul class="mt-1 list-inside list-disc text-sm text-red-600">
                                {% for err in webhookFormErrors %}
                                    <li>{{ err }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {# Name #}
                    <div>
                        <div {{ vl.attrs('advanced', __('Name'), 'name', 'webhooks', __('Outbound Webhooks'), 'webhook name label') }}>
                        <label class="block text-sm font-medium text-gray-700">{{ __('Name') }} <span class="text-red-500">*</span></label>
                        <p class="mt-0.5 text-xs text-gray-400">{{ __('A short label for your reference (e.g. "Order notifications → Zapier")') }}</p>
                        <input type="text" name="name" x-model="formName" required autocomplete="off"
                               class="mt-1.5 block w-full rounded-lg border px-3 py-2 text-sm shadow-xs focus:outline-hidden focus:ring-1 focus:ring-gray-500 {{ webhookFormErrors.name is defined ? 'border-red-400 focus:border-red-400' : 'border-gray-300 dark:border-gray-700 focus:border-gray-600' }}">
                        {% if webhookFormErrors.name is defined %}
                            <p class="mt-1 text-xs text-red-500 dark:text-red-400">{{ webhookFormErrors.name }}</p>
                        {% endif %}
                        </div>
                    </div>

                    {# URL + Method (side by side) #}
                    <div class="grid grid-cols-[1fr_auto] gap-3 items-start">
                        <div>
                            <div {{ vl.attrs('advanced', __('Endpoint URL'), 'url', 'webhooks', __('Outbound Webhooks'), 'webhook url endpoint') }}>
                            <label class="block text-sm font-medium text-gray-700">{{ __('Endpoint URL') }} <span class="text-red-500">*</span></label>
                            <p class="mt-0.5 text-xs text-gray-400">{{ __('Vale will send a request to this URL. Must be a public HTTPS (or HTTP) address.') }}</p>
                            <input type="url" name="url" x-model="formUrl" required
                                   placeholder="https://example.com/hooks/vale"
                                   class="mt-1.5 block w-full rounded-lg border px-3 py-2 font-mono text-sm shadow-xs focus:outline-hidden focus:ring-1 focus:ring-gray-500 {{ webhookFormErrors.url is defined ? 'border-red-400 focus:border-red-400' : 'border-gray-300 dark:border-gray-700 focus:border-gray-600' }}">
                            {% if webhookFormErrors.url is defined %}
                                <p class="mt-1 text-xs text-red-500 dark:text-red-400">{{ webhookFormErrors.url }}</p>
                            {% endif %}
                            <p class="mt-1 text-xs text-gray-400">{{ __('Free services for testing:') }}
                                {% for svc in services_list.webhook_test %}
                                    <a href="{{ svc.url }}" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 dark:text-gray-100 hover:underline">{{ svc.name }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                            </div>
                        </div>
                        <div class="pt-5">
                            <div {{ vl.attrs('advanced', __('Method'), 'method', 'webhooks', __('Outbound Webhooks'), 'http method post put') }}>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">{{ __('Method') }}</label>
                            <select name="method" x-model="formMethod"
                                    class="block rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono shadow-xs focus:border-gray-600 focus:outline-hidden focus:ring-1 focus:ring-gray-500">
                                <option value="POST">POST</option>
                                <option value="GET">GET</option>
                                <option value="PUT">PUT</option>
                                <option value="PATCH">PATCH</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                            </div>
                        </div>
                    </div>

                    {# Body template — only for methods that carry a body #}
                    <div x-show="hasBody" x-cloak>
                        <label class="block text-sm font-medium text-gray-700">
                            {{ __('Body Template') }} <span class="font-normal text-gray-400">({{ __('optional') }})</span>
                        </label>
                        <p class="mt-0.5 text-xs text-gray-400">{{ __('Custom JSON body sent instead of the default envelope. Leave blank to use the default Vale envelope.') }}</p>

                        {# Collapsible placeholder reference #}
                        <div class="mt-1.5 mb-2">
                            <button type="button" @click="showVars = !showVars"
                                    class="flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-medium select-none dark:text-blue-300 dark:hover:text-blue-100 transition-colors">
                                <svg :class="showVars ? 'rotate-90' : ''" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                                {{ __('Available placeholders') }}
                            </button>
                            <div x-show="showVars" x-cloak class="mt-1 rounded-lg bg-blue-50 dark:bg-blue-900/50 p-3 text-xs text-blue-700 dark:text-blue-200 space-y-1.5">
                                <p class="text-blue-500 dark:text-blue-300 italic">{{ __('Click any placeholder to insert it at cursor position.') }}</p>

                                <p class="font-semibold">{{ __('Order events') }} <span class="font-normal text-blue-500 dark:text-blue-300">(order.paid, order.status_changed)</span></p>
                                <p class="flex flex-wrap gap-x-1.5 gap-y-1">
                                    <code data-tag="{{ '{{order_id}}' }}"       @mousedown.prevent @click="insertPlaceholder($el.dataset.tag)" title="{{ __('Click to insert') }}" class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded-sm cursor-pointer hover:bg-blue-200 dark:hover:bg-blue-800/40 text-blue-700 dark:text-blue-200">{{ '{{order_id}}' }}</code>
