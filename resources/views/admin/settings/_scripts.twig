    // Default first subtab for grouped tabs
    activateGeneralTab('site');
    activateEcTab('shop');
    activateAdvancedTab('api-tokens');
    activateMailTab('notifications');
    document.querySelectorAll('.mail-tab-btn').forEach(function(btn){
        btn.addEventListener('click',function(){ activateMailTab(btn.dataset.subtab); refreshFloatingSaveBar(); });
    });
    document.querySelectorAll('.seo-tab-btn').forEach(function(btn){
