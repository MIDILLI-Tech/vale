            '<div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl w-full max-w-2xl max-h-[calc(100dvh-2rem)] sm:max-h-[80vh] flex flex-col mx-4" onclick="event.stopPropagation()">' +
            '<div class="flex items-center justify-between border-b px-5 py-3">' +
            '<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Browse Google Categories</h3>' +
            '<button type="button" onclick="closeGmcBrowser()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 text-lg">&times;</button>' +
            '</div>' +
            '<div class="px-5 py-3 border-b">' +
            '<input type="text" id="gmc-browse-search" placeholder="Search categories..." class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm" oninput="gmcSearch(this.value)">' +
            '</div>' +
            '<div id="gmc-browse-list" class="flex-1 overflow-y-auto text-sm"><div class="p-4 text-center text-gray-400">Loading…</div></div>' +
            '<div id="gmc-browse-pagination" class="border-t px-5 py-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400"></div>' +
            '</div></div>';
        document.body.appendChild(modal);
    }
    modal._targetId = targetInputId;
