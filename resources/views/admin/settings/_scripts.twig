    // ── Lazy maintenance counters ─────────────────────────────────────
    // The settings page opens without heavy counts; each "Count" button fetches
    // only its own stat so a slow counter cannot hang the whole page.
    (function initMaintenanceStats() {
        var statsUrl = document.querySelector('[data-maintenance-stats-url]');
        var endpoint = statsUrl ? statsUrl.getAttribute('data-maintenance-stats-url') : '';
        if (!endpoint) { return; }

        function fmtBytes(bytes) {
            if (bytes === null || bytes === undefined) { return ''; }
            var units = ['B', 'KB', 'MB', 'GB'];
            var i = bytes === 0 ? 0 : Math.floor(Math.log(bytes) / Math.log(1024));
            i = Math.min(i, units.length - 1);
            return (Math.round(bytes / Math.pow(1024, i) * 100) / 100) + ' ' + units[i];
        }

        function applyStats(stats) {
            function setText(key, value) {
                document.querySelectorAll('[data-maintenance-stats="' + key + '"]').forEach(function (el) {
                    var textEl = el.querySelector('[data-stat-text]') || el;
                    textEl.textContent = value;
                });
            }
            function setSub(key, value) {
                document.querySelectorAll('[data-maintenance-stats="' + key + '"]').forEach(function (el) {
                    var sub = el.querySelector('[data-stat-sub]');
                    if (sub) { sub.textContent = value; }
                });
            }
            if (stats.revision_count !== undefined && stats.revision_count !== null) {
                var label = stats.revision_count + ' revisions';
                setText('revision', label);
                var prune = stats.revision_prunable > 0
                    ? stats.revision_prunable + ' can be pruned (keep latest 10).'
                    : '';
                setSub('revision', prune);
                setSub('revision-prunable', prune);
            }
            if (stats.spam_comment_count !== undefined && stats.spam_comment_count !== null) {
                setText('spam', '(' + stats.spam_comment_count + ')');
            }
            if (stats.trash_comment_count !== undefined && stats.trash_comment_count !== null) {
                setText('trash', '(' + stats.trash_comment_count + ')');
            }
            if (stats.orphaned_meta_count !== undefined && stats.orphaned_meta_count !== null) {
                setText('orphaned-meta', '(' + stats.orphaned_meta_count + ')');
            }
            if (stats.orphaned_media_file_count !== undefined && stats.orphaned_media_file_count !== null) {
                setText('orphaned-media-files', '(' + stats.orphaned_media_file_count + ')');
            }
            if (stats.orphaned_media_unused_count !== undefined && stats.orphaned_media_unused_count !== null) {
                setText('orphaned-media-unused', '(' + stats.orphaned_media_unused_count + ')');
            }
            if (stats.page_cache_count !== undefined && stats.page_cache_count !== null) {
                var total = (stats.page_cache_count || 0) + (stats.data_cache_count || 0) + (stats.views_cache_count || 0);
                setText('cache', total + ' files');
                var size = (stats.page_cache_size || 0) + (stats.data_cache_size || 0) + (stats.views_cache_size || 0);
                setSub('cache', fmtBytes(size));
            }
            if (stats.redirect_count !== undefined && stats.redirect_count !== null) {
                setText('redirects', '(' + stats.redirect_count + ')');
            }
        }

        document.querySelectorAll('[data-count-btn]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var key = btn.getAttribute('data-count-btn');
                btn.disabled = true;
                var original = btn.textContent;
                btn.textContent = '…';
                fetch(endpoint + '?only=' + encodeURIComponent(key), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.stats) { applyStats(data.stats); }
                        // Hide the button that was just counted.
                        if (btn.parentElement && btn.parentElement.hasAttribute('data-maintenance-stats')) {
                            btn.remove();
                        } else {
                            btn.textContent = original;
                            btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        btn.textContent = original;
                        btn.disabled = false;
                    });
            });
        });
    })();
});

function openGmcCategoryBrowser(targetInputId) {
