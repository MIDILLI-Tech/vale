<script>
window.VL_COUNTRY_CODES = {{ country_codes|default([])|json_encode|raw }};
window.VL_COUNTRY_TAX_RATES_DATA = {
    initial: {{ countryTaxRates|map(r => ({country_code: r.countryCode, regime: r.regime, rate: r.rate, zero_reason: r.zeroReason, fallback: r.isFallback, _id: r.id}))|default([])|json_encode|raw }},
    codes: (function() {
        var raw = '{{ settings.shipping_countries|default('')|e('js') }}';
        var codes = raw ? raw.split(',').map(function(c) { return c.trim().toUpperCase(); }).filter(Boolean) : [];
        if (codes.length === 0) return window.VL_COUNTRY_CODES || [];
        return codes.filter(function(c) { return (window.VL_COUNTRY_CODES || []).indexOf(c) !== -1; });
    })(),
};

window.VL_SHIPPING_RATES_DATA = (function() {
    try {
        var raw = '{{ settings.shipping_country_rates|default('{}')|e('js') }}';
        var obj = JSON.parse(raw);
        return Object.entries(obj).map(function(e) {
            var val = e[1];
            if (typeof val === 'object' && val !== null) {
                return {
                    code: String(e[0] || '').toUpperCase(),
                    rate: String(val.rate ?? ''),
                    shipping_time_min: val.shipping_time_min ?? '',
                    shipping_time_max: val.shipping_time_max ?? ''
                };
            }
            return {code:String(e[0] || '').toUpperCase(),rate:String(val ?? ''),shipping_time_min:'',shipping_time_max:''};
        });
    } catch(ex) {
        return [];
    }
})();

window.VL_SHIPPING_COUNTRY_OPTIONS = (function() {
    var rawAllowed = '{{ settings.checkout_allowed_countries|default('')|e('js') }}';
    var rawShipping = '{{ settings.shipping_countries|default('')|e('js') }}';
    var rawBlocked = '{{ settings.checkout_blocked_countries|default('')|e('js') }}';
    var allowed = rawAllowed ? rawAllowed.split(',').map(function(c) { return c.trim().toUpperCase(); }).filter(Boolean) : [];
    var shipping = rawShipping ? rawShipping.split(',').map(function(c) { return c.trim().toUpperCase(); }).filter(Boolean) : [];
    var blocked = rawBlocked ? rawBlocked.split(',').map(function(c) { return c.trim().toUpperCase(); }).filter(Boolean) : [];
    var company = '{{ settings.shop_country|default('')|e('js') }}';
    var all = window.VL_COUNTRY_CODES || [];

    // Base: checkout_allowed if set, otherwise company country only.
    var pool = allowed.length > 0 ? allowed : (company ? [company] : []);

    // Intersect with shipping_countries if set (only show selected shipping countries).
    if (shipping.length > 0) {
        pool = pool.filter(function(c) { return shipping.indexOf(c) !== -1; });
    }

    // Remove blocked countries.
    pool = pool.filter(function(c) { return blocked.indexOf(c) === -1; });

    // Always include company country.
    if (company && pool.indexOf(company) === -1) pool.unshift(company);

    return pool.filter(function(c) { return (all.indexOf(c) !== -1); });
})();

window.VL_SHIPPING_COUNTRY_OPTIONS_EX_COMPANY = (function() {
    var company = '{{ settings.shop_country|default('')|e('js') }}';
    return (window.VL_SHIPPING_COUNTRY_OPTIONS || []).filter(function(c) { return c !== company; });
})();

window.VL_COUNTRY_CODES_EX_COMPANY = (function() {
    var company = '{{ settings.shop_country|default('')|e('js') }}';
    return (window.VL_COUNTRY_CODES || []).filter(function(c) { return c !== company; });
})();

function tokenMultiSelect(config) {
    var opts = Array.isArray(config && config.options) ? config.options : [];
    var initial = String((config && config.initial) || '');
    var placeholder = String((config && config.placeholder) || 'Select...');
    var kind = String((config && config.kind) || '');
    var labelMap = (config && typeof config.labelMap === 'object' && config.labelMap !== null)
        ? config.labelMap
        : {};
    var regionNames = (kind === 'country' && typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
        ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' })
        : null;
    var currencyNames = (kind === 'currency' && typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
        ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'currency' })
        : null;

    var normalizedOpts = opts
        .map(function (v) { return String(v || '').trim().toUpperCase(); })
        .filter(function (v) { return v !== ''; });

    return {
        placeholder: placeholder,
        selected: '',
        items: initial.split(',')
            .map(function (v) { return v.trim().toUpperCase(); })
            .filter(function (v) { return v !== ''; })
            .filter(function (v, i, arr) { return arr.indexOf(v) === i; }),
        options: normalizedOpts,
        kind: kind,
        labelMap: labelMap,
        regionNames: regionNames,
        currencyNames: currencyNames,

        displayLabel: function (code) {
            var normalized = String(code || '').trim().toUpperCase();
            if (normalized === '') {
                return '';
            }

            if (this.kind === 'currency' && this.currencyNames) {
                var currencyName = this.currencyNames.of(normalized);
                if (currencyName) {
                    var symbol = Object.prototype.hasOwnProperty.call(this.labelMap, normalized) ? this.labelMap[normalized] : '';
                    return currencyName + ' (' + symbol + ' — ' + normalized + ')';
                }
            }

            if (Object.prototype.hasOwnProperty.call(this.labelMap, normalized)) {
                var fallback = this.labelMap[normalized];
                return fallback + ' — ' + normalized;
            }

            if (this.kind === 'country' && this.regionNames) {
                var countryName = this.regionNames.of(normalized);
                if (countryName) {
                    return countryName + ' (' + normalized + ')';
                }
            }

            return normalized;
        },

        availableOptions: function () {
            var self = this;
            return self.options.filter(function (opt) { return self.items.indexOf(opt) === -1; });
        },

        addSelected: function () {
            var code = String(this.selected || '').trim().toUpperCase();
            if (code === '') {
                return;
            }
            if (this.options.indexOf(code) === -1) {
                return;
            }
            if (this.items.indexOf(code) !== -1) {
                return;
            }
            this.items.push(code);
            this.selected = '';
        },

        remove: function (code) {
            this.items = this.items.filter(function (item) { return item !== code; });
        },
    };
}

function mailTemplates() {
    return {
        selected: '',
        content: '',
        defaultContent: '',
        selectedLabel: '',
        isCustom: false,
        showSaved: false,
        saveTimer: null,
        loading: false,
        isFullscreen: false,
        jar: null,
        useThemeColors: {{ (mailConfig.mail_use_theme_colors ?? '1') != '0' ? 'true' : 'false' }},
        showSwatchesFor: '',

        placeholders: {
            'layout': { common: ['site_name', 'site_url'], template: ['title', 'body'] },
            'welcome': { common: ['site_name', 'site_url'], template: ['name', 'login_url'] },
            'password-reset': { common: ['site_name', 'site_url'], template: ['name', 'reset_url'] },
            'order-confirmation': { common: ['site_name', 'site_url'], template: ['order', 'downloads', 'policy_links'] },
            'order-status-update': { common: ['site_name', 'site_url'], template: ['order', 'old_status', 'new_status'] },
            'order-note': { common: ['site_name', 'site_url'], template: ['order', 'subject', 'message'] },
            'payment-received': { common: ['site_name', 'site_url'], template: ['order', 'is_admin', 'transaction_id', 'payment_method', 'downloads', 'policy_links'] },
            'newsletter-confirmation': { common: ['site_name', 'site_url'], template: ['confirm_url'] },
        },

        get currentPlaceholders() {
            if (!this.selected || !this.placeholders[this.selected]) return null;
            return this.placeholders[this.selected];
        },

        initJar() {
            if (!this.jar && window.initTwigEditor && this.$refs.editor) {
                const wrapper = this.$refs.editor.parentElement;
                if (!document.documentElement.classList.contains('dark')) {
                    wrapper.classList.add('light-theme');
                } else {
                    wrapper.classList.remove('light-theme');
                }
                this.jar = window.initTwigEditor(this.$refs.editor);
            }
        },

        loadTemplate(name) {
            if (!name) {
                this.content = '';
                if (this.jar) this.jar.updateCode('');
                this.$nextTick(() => this.resetDirtyBaseline());
                return;
            }
            this.loading = true;
            fetch('{{ url('/admin/mail/template') }}/' + name)
                .then(r => r.json())
                .then(data => {
                    if (!data.ok) return;
                    this.selected = data.name;
                    this.selectedLabel = data.label;
                    this.defaultContent = data.default;
                    this.content = data.custom || data.default;
                    this.isCustom = data.custom !== null;
                    this.$nextTick(() => {
                        this.initJar();
                        if (this.jar) {
                            this.jar.updateCode(this.content || '');
                        }
                        // Selecting a template is navigation, not an edit — re-snapshot
                        // the form so the page is not flagged as having unsaved changes.
                        this.resetDirtyBaseline();
                    });
                })
                .finally(() => { this.loading = false; });
        },

        // Re-baselines the template save form after a programmatic value change
        // (template_name/template_content). Runs twice because Alpine's x-model
        // writes the hidden inputs on the next flush.
        resetDirtyBaseline() {
            const snap = () => {
                const el = document.querySelector('#mail-tab-templates input[name="template_content"]');
                const host = el ? el.closest('form') : null;
                if (host && typeof host.vlEstablishBaseline === 'function') {
                    host.vlEstablishBaseline();
                }
            };
            snap();
            setTimeout(snap, 80);
        },

        syncContent() {
            if (this.jar) {
                this.content = this.jar.toString();
            }
        },

        toggleFullscreen() {
            this.isFullscreen = !this.isFullscreen;
        },

        onKeyDown(e) {
            if (this.isFullscreen && e.key === 'Escape') {
                this.isFullscreen = false;
                return;
            }
            if (this.selected && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                e.preventDefault();
                this.syncContent();
                const form = this.$refs.editor ? this.$refs.editor.closest('form') : null;
                if (form) form.requestSubmit();
            }
        },

        insertPlaceholder(ph) {
            if (!this.$refs.editor) return;
            const text = '{{ '{{' }} ' + ph + ' {{ '}}' }}';
            if (this.jar) {
                if (typeof this.jar.insertAtCursor === 'function') {
                    this.jar.insertAtCursor(text);
                } else {
                    this.content = (this.jar.toString() || '') + text;
                    this.jar.updateCode(this.content);
                }
                this.syncContent();
            }
        },

        phDisplay(ph) {
            return '{{ '{{' }} ' + ph + ' {{ '}}' }}';
        },

        resetToDefault(name) {
            if (!confirm('{{ __('Reset this template to its default content?') }}')) return;
            fetch('{{ url('/admin/mail/template/reset') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '_csrf_token={{ csrf_token() }}&template_name=' + name
            }).then(() => {
                this.loadTemplate(name);
            });
        },

        previewOpen: false,
        previewUrl: '',
        previewName: '',
        previewLoading: false,

        openPreview() {
            if (!this.selected) return;
            this.previewUrl = '{{ url('/admin/mail/preview') }}/' + this.selected;
            this.previewName = this.selected;
            this.previewLoading = true;
            this.previewOpen = true;
        },

        pickThemeColor(settingKey, value) {
            const textInput = document.querySelector('[name="' + settingKey + '"]');
            if (!textInput) return;
            textInput.value = value;
            const colorInput = textInput.nextElementSibling;
            if (colorInput && colorInput.type === 'color') {
                colorInput.value = value;
                colorInput.blur();
            }
            this.showSwatchesFor = '';
        },

        openNativePicker(settingKey) {
            // Palette and OS picker are anchored to the same swatch, so close the
            // palette before handing over to the native color picker.
            this.showSwatchesFor = '';
            const textInput = document.querySelector('[name="' + settingKey + '"]');
            const colorInput = textInput ? textInput.nextElementSibling : null;
            if (!colorInput || colorInput.type !== 'color') return;
            if (typeof colorInput.showPicker === 'function') {
                try {
                    colorInput.showPicker();
                    return;
                } catch (e) {
                    // Not user-activated — fall through to click().
                }
            }
            colorInput.click();
        },

        emailColorValue(settingKey) {
            const el = document.querySelector('[name="' + settingKey + '"]');
            return el ? el.value || '' : '';
        },

        resetEmailColor(settingKey, defaultValue) {
            const textInput = document.querySelector('[name="' + settingKey + '"]');
            if (!textInput) return;
            this.applyEmailColor(textInput, defaultValue);
        },

        // Resets every custom email color back to its theme default. Applied in
        // place so the change is visible; the dirty poll then enables the Save bar.
        resetAllEmailColors() {
            document.querySelectorAll('#mail-tab-templates input[data-color-default]').forEach((textInput) => {
                this.applyEmailColor(textInput, textInput.dataset.colorDefault || '');
            });
        },

        // Keeps the visible swatch and the hex text input in sync.
        applyEmailColor(textInput, value) {
            textInput.value = value;
            const colorInput = textInput.nextElementSibling;
            if (colorInput && colorInput.type === 'color') {
                colorInput.value = value;
                colorInput.blur();
            }
        }
    };
}

document.addEventListener('DOMContentLoaded',function(){
    function activateSubTab(btnSelector, panelPrefix, name, attr) {
        document.querySelectorAll(btnSelector).forEach(function(t){
            t.classList.remove('border-blue-600','text-blue-600','dark:border-blue-400','dark:text-blue-400','border-gray-900','text-gray-900','dark:text-gray-100');
            t.classList.add('border-transparent','text-gray-500','dark:text-gray-400');
        });
        document.querySelectorAll('[id^="' + panelPrefix + '"]').forEach(function(p){
            p.classList.add('hidden');
        });
        var btn=document.querySelector(btnSelector + '[' + attr + '="' + name + '"]');
        var panel=document.getElementById(panelPrefix + name);
        if(btn){
            btn.classList.add('border-blue-600','text-blue-600','dark:border-blue-400','dark:text-blue-400');
            btn.classList.remove('border-transparent','text-gray-500','dark:text-gray-400','border-gray-900','text-gray-900','dark:text-gray-100');
        }
        if(panel){panel.classList.remove('hidden');}
    }

    // Active top-level tab; kept in sync whenever activateTab runs.
    var currentTab = 'general';

    // Media is always the first Content tab and the guaranteed fallback.
    function firstVisibleContentTab() {
        return 'media';
    }

    // Gated sub-tabs (blog/mlc/ads) are read from the feature store — the
    // source of truth — so visibility is correct even before Alpine applies an
    // x-show to the (possibly hidden #tab-content) buttons. Media is always shown.
    function isContentSubTabVisible(name) {
        if (name === 'media') return true;
        var store = null;
        try { store = Alpine.store('vlFeatures'); } catch (e) {}
        if (store && name in store) return !!store[name];
        // Last resort: fall back to DOM visibility.
        var btn = document.querySelector('.content-tab-btn[data-subtab="' + name + '"]');
        return btn && btn.offsetParent !== null;
    }

    function ensureVisibleContentTab() {
        var visiblePanel = document.querySelector('#tab-content .content-tab-panel:not(.hidden)');
        var current = visiblePanel ? visiblePanel.id.slice('content-tab-'.length) : null;
        if (!current || !isContentSubTabVisible(current)) {
            activateContentTab(firstVisibleContentTab());
        }
    }

    function activateTab(tabName) {
        if (tabName === 'cache') tabName = 'maintenance';
        // Skip tabs whose button is hidden by a feature toggle.
        var btn = document.querySelector('.tab-btn[data-tab="' + tabName + '"]');
        if (btn && btn.offsetParent === null) {
            tabName = 'general';
        }
        currentTab = tabName;
        activateSubTab('.tab-btn', 'tab-', tabName, 'data-tab');
        if (tabName === 'content') {
            ensureVisibleContentTab();
        }
    }

    // Floating save bar element refs (restored from pre-refactor state).
    var floatingBar = document.getElementById('floating-save-bar');
    var floatingBtn = document.getElementById('floating-save-btn');
    var floatingCategory = document.getElementById('floating-save-category');

    function tabLabel(name) {
        var btn = document.querySelector('.tab-btn[data-tab="' + name + '"]');
        return btn ? btn.textContent.trim() : name;
    }

    // The currently active sub-tab button for the open top-level tab group.
    function activeSubTabButton() {
        var selector = currentTab === 'general' ? '.general-tab-btn'
            : currentTab === 'content' ? '.content-tab-btn'
            : currentTab === 'ecommerce' ? '.ec-tab-btn'
            : currentTab === 'mail' ? '.mail-tab-btn'
            : currentTab === 'seo' ? '.seo-tab-btn'
            : currentTab === 'privacy' ? '.privacy-tab-btn'
            : currentTab === 'advanced' ? '.advanced-tab-btn'
            : currentTab === 'maintenance' ? '.maintenance-tab-btn'
            : null;
        if (!selector) return null;
        return document.querySelector(selector + '.border-blue-600, ' + selector + '.border-gray-900');
    }

    // The form in the visible (sub-)panel that actually saves settings.
    // Only forms carrying a _group or _subtab hidden input count; panels like
    // Payment/Import/API tokens/Webhooks only have action forms and no settings save.
    function getSettingsForm() {
        var panel = document.querySelector('.tab-panel:not(.hidden)');
        if (!panel) return null;
        var sub = panel.querySelector(
            '.general-tab-panel:not(.hidden),' +
            '.content-tab-panel:not(.hidden),' +
            '.ec-tab-panel:not(.hidden),' +
            '.mail-tab-panel:not(.hidden),' +
            '.seo-tab-panel:not(.hidden),' +
            '.privacy-tab-panel:not(.hidden),' +
            '.advanced-tab-panel:not(.hidden),' +
            '.maintenance-tab-panel:not(.hidden)'
        );
        var root = sub || panel;
        var forms = root.querySelectorAll('form');
        for (var i = 0; i < forms.length; i++) {
            if (forms[i].querySelector('input[name="_group"], input[name="_subtab"]')) {
                return forms[i];
            }
        }
        return null;
    }

    // True when any real settings form has unsaved changes.
    var anyDirty = false;
    function syncAnyDirty() {
        var dirty = false;
        document.querySelectorAll('.tab-panel form').forEach(function(f) {
            if (f.dataset.vlDirtyWired === '1' && f.dataset.vlDirty === '1') dirty = true;
        });
        anyDirty = dirty;
        return dirty;
    }
    window.addEventListener('beforeunload', function (e) {
        if (anyDirty) {
            e.preventDefault();
            e.returnValue = '';
            // Runs only if the user cancels the leave — if they really leave,
            // the page is torn down and this timer never fires.
            setTimeout(jumpToFirstDirtyTab, 0);
        }
    });

    // Hash a string (FNV-1a, 32-bit) so dirty baselines never persist
    // sensitive values (API keys, SMTP passwords, …) in DOM attributes,
    // where they would leak into console output and page snapshots.
    function hashString(str) {
        var h = 0x811c9dc5;
        for (var i = 0; i < str.length; i++) {
            h ^= str.charCodeAt(i);
            h = (h * 0x01000193) >>> 0;
        }
        return ('0000000' + h.toString(16)).slice(-8);
    }

    // Serialize a form to a canonical string so any change (including
    // editor/checkbox/token fields that may not fire input events) is caught.
    function serializeForm(form) {
        var els = form.querySelectorAll('input, select, textarea');
        var out = [];
        for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (el.disabled) continue;
            // Action UI embedded inside settings forms (e.g. captcha test
            // widgets) is not a setting: provider scripts inject response
            // fields asynchronously after the dirty baseline is taken, which
            // would otherwise flag the form dirty on a clean page load.
            if (el.closest && el.closest('[data-vl-noserialize]')) continue;
            var name = el.name;
            if (!name) continue;
            if (el.type === 'radio') {
                if (el.checked) out.push(name + '=' + encodeURIComponent(el.value));
            } else if (el.type === 'checkbox') {
                out.push(name + '=' + (el.checked ? '1' : '0'));
            } else {
                out.push(name + '=' + encodeURIComponent(el.value));
            }
        }
        out.sort();
        return out.join('&');
    }

    // Per-form dirty wiring: snapshot an initial baseline and compare on changes.
    // Only real settings forms (_group/_subtab) are wired so action forms
    // (payment toggles, imports, webhooks) never trigger a beforeunload warning.
    var wiredForms = {};
    function wireDirtyTracking() {
        document.querySelectorAll('.tab-panel form').forEach(function(form) {
            if (!form.querySelector('input[name="_group"], input[name="_subtab"]')) return;
            var key = form.dataset.vlFormId || (form.dataset.vlFormId = String(Math.random().toString(36).slice(2)));
            if (wiredForms[key]) return;
            wiredForms[key] = true;
            form.dataset.vlDirtyWired = '1';
            form.dataset.vlDirty = '0';

            var establishBaseline = function() {
                form.dataset.vlBaseline = hashString(serializeForm(form));
                form.dataset.vlDirty = '0';
                syncAnyDirty();
                updateFloatingSaveBar();
            };
            // Exposed so pages can re-snapshot after a programmatic (non-edit)
            // value change, e.g. loading a different mail template into the editor.
            form.vlEstablishBaseline = establishBaseline;

            var checkDirty = function() {
                if (!form.dataset.vlBaseline) return;
                // Once submitted, stop re-evaluating — the page is navigating.
                if (form.dataset.vlSubmitting === '1') return;
                var changed = hashString(serializeForm(form)) !== form.dataset.vlBaseline;
                if (changed && form.dataset.vlDirty !== '1') { form.dataset.vlDirty = '1'; syncAnyDirty(); updateFloatingSaveBar(); }
                if (!changed && form.dataset.vlDirty !== '0') { form.dataset.vlDirty = '0'; syncAnyDirty(); updateFloatingSaveBar(); }
            };

            form.querySelectorAll('input, select, textarea').forEach(function(el) {
                el.addEventListener('input', checkDirty);
                el.addEventListener('change', checkDirty);
            });
            // Debounced polling catches editor/token changes that skip events.
            setInterval(checkDirty, 500);

            form.addEventListener('submit', function() {
                // Mark as submitting so checkDirty / updateFloatingSaveBar never
                // re-enable the button while the page navigates.
                form.dataset.vlSubmitting = '1';
                form.dataset.vlDirty = '0';
                syncAnyDirty();
                updateFloatingSaveBar();
                // Keep the floating button inert while the page navigates.
                if (floatingBtn) { floatingBtn.disabled = true; floatingBtn.classList.add('opacity-40', 'cursor-not-allowed'); floatingBtn.classList.remove('shadow-sm'); }
            });
            form.addEventListener('reset', function() { establishBaseline(); });

            // Establish baseline after a short delay so editor mounts settle.
            setTimeout(establishBaseline, 60);
            setTimeout(establishBaseline, 500);
        });
    }

    function updateFloatingSaveBar() {
        // Category label always comes from the tab buttons, never from a form.
        var label = tabLabel(currentTab);
        var subBtn = activeSubTabButton();
        if (subBtn) {
            label = label + ' \u203a ' + subBtn.textContent.trim();
        }
        if (floatingCategory) floatingCategory.textContent = label;

        var form = getSettingsForm();
        // Action panels (Payment/Import/API tokens/Webhooks) have no settings
        // form to save — hide the button, keep only the category label.
        var canSave = !!form;
        if (floatingBtn) {
            floatingBtn.classList.toggle('hidden', !canSave);
        }
        // While a form is submitting the page is navigating — never re-enable.
        var submitting = form && form.dataset.vlSubmitting === '1';
        var dirty = form ? (form.dataset.vlDirty === '1') : false;
        var enabled = canSave && dirty && !submitting;
        if (floatingBtn) {
            floatingBtn.disabled = !enabled;
            floatingBtn.classList.toggle('opacity-40', !enabled);
            floatingBtn.classList.toggle('cursor-not-allowed', !enabled);
            floatingBtn.classList.toggle('shadow-sm', enabled);
            floatingBtn.title = enabled
                ? (floatingBtn.dataset.titleSave || floatingBtn.title)
                : (floatingBtn.dataset.titleIdle || floatingBtn.title);
        }
    }

    function refreshFloatingSaveBar() {
        wireDirtyTracking();
        updateFloatingSaveBar();
    }

    // Jumps to the tab (and sub-tab) holding the first unsaved settings form.
    // Called from the beforeunload branch that only runs when the user cancels
    // the leave warning, so they land back on their pending changes.
    function jumpToFirstDirtyTab() {
        var dirtyForm = document.querySelector('.tab-panel form[data-vl-dirty-wired="1"][data-vl-dirty="1"]');
        if (!dirtyForm) return;
        var panel = dirtyForm.closest('.tab-panel');
        if (!panel) return;
        if (panel.id.indexOf('tab-') === 0) activateTab(panel.id.slice(4));
        var sub = dirtyForm.closest('.general-tab-panel, .ec-tab-panel, .mail-tab-panel, .seo-tab-panel, .privacy-tab-panel, .advanced-tab-panel, .maintenance-tab-panel');
        if (sub) {
            var subtab = '';
            if (sub.id.indexOf('general-tab-') === 0) subtab = sub.id.slice(12);
            else if (sub.id.indexOf('ec-tab-') === 0) subtab = sub.id.slice(7);
            else if (sub.id.indexOf('mail-tab-') === 0) subtab = sub.id.slice(9);
            else if (sub.id.indexOf('seo-tab-') === 0) subtab = sub.id.slice(8);
            else if (sub.id.indexOf('privacy-tab-') === 0) subtab = sub.id.slice(12);
            else if (sub.id.indexOf('advanced-tab-') === 0) subtab = sub.id.slice(13);
            else if (sub.id.indexOf('maintenance-tab-') === 0) subtab = sub.id.slice(16);
            if (subtab) {
                if (sub.classList.contains('general-tab-panel')) activateGeneralTab(subtab);
                else if (sub.classList.contains('ec-tab-panel')) activateEcTab(subtab);
                else if (sub.classList.contains('mail-tab-panel')) activateMailTab(subtab);
                else if (sub.classList.contains('seo-tab-panel')) activateSeoTab(subtab);
                else if (sub.classList.contains('privacy-tab-panel')) activatePrivacyTab(subtab);
                else if (sub.classList.contains('advanced-tab-panel')) activateAdvancedTab(subtab);
                else if (sub.classList.contains('maintenance-tab-panel')) activateMaintenanceTab(subtab);
            }
        }
        refreshFloatingSaveBar();
        var focusable = dirtyForm.querySelector('input:not([type="hidden"]):not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled])');
        if (focusable) focusable.focus({ preventScroll: true });
    }

    if (floatingBar && floatingBtn) {
        floatingBtn.addEventListener('click', function() {
            var form = getSettingsForm();
            if (form && form.dataset.vlDirty === '1') {
                // Mark the form as submitting so checkDirty / updateFloatingSaveBar
                // never re-enable the button while the page navigates.
                form.dataset.vlSubmitting = '1';
                // Immediately disable the button so it stays inert until the
                // page finishes reloading (prevents double submits).
                form.dataset.vlDirty = '0';
                syncAnyDirty();
                updateFloatingSaveBar();
                floatingBtn.disabled = true;
                floatingBtn.classList.add('opacity-40', 'cursor-not-allowed');
                floatingBtn.classList.remove('shadow-sm');
                // form.submit() (JS method) does NOT fire the 'submit' event,
                // so the per-form submit listener below never runs — which would
                // leave anyDirty true and trigger a spurious beforeunload warning
                // as the page navigates. Reset the dirty flags here explicitly.
                form.submit();
            }
        });
        wireDirtyTracking();
    }

    // Ctrl+S / Cmd+S triggers the floating Save button (dirty-check aware).
    document.addEventListener('keydown', function(e) {
        if (!(e.ctrlKey || e.metaKey)) return;
        if (e.key.toLowerCase() !== 's' || e.shiftKey || e.altKey) return;
        // The mail template editor owns Ctrl+S page-wide whenever a template is
        // selected — skip so we never double-save its form.
        var tmplName = document.querySelector('#mail-tab-templates form [name="template_name"]');
        if (tmplName && tmplName.value !== '') return;
        if (e.target && e.target.closest && e.target.closest('.codejar-editor')) return;
        if (floatingBtn && !floatingBtn.disabled && !floatingBtn.classList.contains('hidden')) {
            e.preventDefault();
            floatingBtn.click();
        }
    });

