    });

    // Re-sync content sub-tab after x-show toggles apply (Alpine init runs after DOMContentLoaded).
    if (window.vlSettingsNav && window.vlSettingsNav.ensureVisibleContentTab) {
        window.vlSettingsNav.ensureVisibleContentTab();
    }

    Alpine.data('settingsSearch', () => ({
        query: '',
        results: [],
        open: false,
        activeIndex: 0,
        loading: false,
        index: [],
        debounceTimer: null,
        tabLabels: {},

        init() {
            if (this._indexBuilt) {
                return;
            }
            this._indexBuilt = true;
            this.index = [];
            var self = this;
            var seenEls = new WeakSet();
            document.querySelectorAll('#settings-tabs .tab-btn').forEach(function(btn) {
                self.tabLabels[btn.dataset.tab] = btn.textContent.trim();
            });
            document.querySelectorAll('[data-vl-setting]').forEach(function(el, i) {
                if (seenEls.has(el)) {
                    return;
                }
                seenEls.add(el);
                var tab = el.dataset.vlTab || '';
                var subtab = el.dataset.vlSubtab || '';
                var section = el.dataset.vlSection || '';
                var label = el.dataset.vlLabel || '';
                var key = el.dataset.vlKey || '';
                var keywords = el.dataset.vlKeywords || '';
                var uid = el.dataset.vlId || (tab + '|' + subtab + '|' + key + '|' + i);
                var parts = [self.tabLabels[tab] || tab];
                if (subtab) {
                    parts.push(self.subtabLabel(tab, subtab));
                }
                if (section) {
                    parts.push(section);
                }
                self.index.push({
                    uid: uid,
                    el: el,
                    tab: tab,
                    subtab: subtab,
                    section: section,
                    label: label,
                    key: key,
                    keywords: keywords,
                    breadcrumb: parts.filter(Boolean).join(' \u203a '),
                    searchText: (label + ' ' + section + ' ' + key + ' ' + keywords + ' ' + parts.join(' ')).toLowerCase(),
                });
            });
        },

        subtabLabel(tab, subtab) {
            var selector = tab === 'general' ? '.general-tab-btn'
                : tab === 'content' ? '.content-tab-btn'
                : tab === 'ecommerce' ? '.ec-tab-btn'
                : tab === 'mail' ? '.mail-tab-btn'
                : tab === 'seo' ? '.seo-tab-btn'
                : tab === 'privacy' ? '.privacy-tab-btn'
                : tab === 'advanced' ? '.advanced-tab-btn'
                : tab === 'maintenance' ? '.maintenance-tab-btn'
                : null;
            if (!selector) {
                return subtab;
            }
            var btn = document.querySelector(selector + '[data-subtab="' + subtab + '"]');
            return btn ? btn.textContent.trim() : subtab;
        },

        onInput() {
            var self = this;
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(function() { self.search(); }, 120);
        },

        search() {
            var q = this.query.trim().toLowerCase();
            this.open = q.length > 0;
            this.activeIndex = 0;
            if (q === '') {
                this.results = [];
                return;
            }
            var tokens = q.split(/\s+/).filter(Boolean);
            var seenEls = new WeakSet();
            var seenLabels = new Set();
            this.results = this.index.filter(function(item) {
                if (seenEls.has(item.el)) {
                    return false;
                }
                if (!tokens.every(function(t) { return item.searchText.indexOf(t) !== -1; })) {
                    return false;
                }
                var labelKey = item.tab + '|' + item.subtab + '|' + item.label + '|' + item.breadcrumb;
                if (seenLabels.has(labelKey)) {
                    return false;
                }
                seenEls.add(item.el);
                seenLabels.add(labelKey);
                return true;
            }).slice(0, 20).map(function(item, resultIdx) {
                return {
                    uid: item.uid + '|' + resultIdx,
                    el: item.el,
                    tab: item.tab,
                    subtab: item.subtab,
                    label: item.label,
                    labelHtml: item.label,
                    breadcrumb: item.breadcrumb,
                    hiddenHint: item.el.offsetParent === null ? '{{ __('May be hidden until related option is enabled')|e('js') }}' : '',
                };
            });
        },

        goTo(item) {
            var nav = window.vlSettingsNav;
            if (!nav || !item.el) {
                return;
            }
            nav.activateTab(item.tab);
            if (item.subtab) {
                if (item.tab === 'general') nav.activateGeneralTab(item.subtab);
                else if (item.tab === 'content') nav.activateContentTab(item.subtab);
                else if (item.tab === 'ecommerce') nav.activateEcTab(item.subtab);
                else if (item.tab === 'mail') nav.activateMailTab(item.subtab);
                else if (item.tab === 'seo') nav.activateSeoTab(item.subtab);
                else if (item.tab === 'privacy') nav.activatePrivacyTab(item.subtab);
                else if (item.tab === 'advanced') nav.activateAdvancedTab(item.subtab);
                else if (item.tab === 'maintenance') nav.activateMaintenanceTab(item.subtab);
            }
            history.replaceState(null, '', '#tab-' + item.tab);
            this.open = false;
            this.query = '';
            this.results = [];
            var target = item.el;
            setTimeout(function() {
                var scrollBlock = target.matches('tr, thead, tbody, tfoot') ? 'nearest' : 'center';
                target.scrollIntoView({ behavior: 'smooth', block: scrollBlock });
                target.classList.add('vl-setting-flash');
                setTimeout(function() { target.classList.remove('vl-setting-flash'); }, 2200);
                var focusable = target.matches('tr')
                    ? target.querySelector('input:not([type="hidden"]):not([disabled]), select, textarea, button:not([disabled])')
                    : target.querySelector('input:not([type="hidden"]), select, textarea, button');
                if (focusable) {
                    focusable.focus({ preventScroll: true });
                }
            }, 80);
        },

        scrollActiveIntoView() {
            var self = this;
            this.$nextTick(function() {
                var list = self.$refs.resultsList;
                if (!list) {
                    return;
                }
                var active = list.querySelector('[data-vl-search-option][aria-selected="true"]');
                if (active) {
                    active.scrollIntoView({ block: 'nearest' });
                }
            });
        },

        onKeydown(e) {
            if (!this.open || this.results.length === 0) {
                return;
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                this.activeIndex = Math.min(this.activeIndex + 1, this.results.length - 1);
                this.scrollActiveIntoView();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                this.activeIndex = Math.max(this.activeIndex - 1, 0);
                this.scrollActiveIntoView();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (this.results[this.activeIndex]) {
                    this.goTo(this.results[this.activeIndex]);
                }
            } else if (e.key === 'Escape') {
                this.open = false;
            }
        },

        onGlobalKey(e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                this.$refs.input.focus();
                this.$refs.input.select();
            }
        },
    }));

    Alpine.data('countryTaxRates', (config) => ({
        rows: [],
        codes: config.codes || [],
        regionNames: (typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
            ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' })
            : null,

        init() {
            this.rows = (config.initial || []).map(r => ({
                _key: Math.random().toString(36).slice(2),
                country_code: r.country_code || '',
                regime: r.regime || 'normal_vat',
                rate: r.rate != null ? String(r.rate) : '',
                zero_reason: r.zero_reason || '',
                fallback: r.fallback || false,
            }));

            // Ensure fallback row exists (defaults to use_global = inherit global)
            if (!this.rows.some(r => r.fallback)) {
                this.rows.push({
                    _key: Math.random().toString(36).slice(2),
                    country_code: '*',
                    regime: 'use_global',
                    rate: '',
                    zero_reason: '',
                    fallback: true,
                });
            }

            // Sort: fallback first, then country rows (company country at top)
            this.rows.sort(function(a, b) {
                if (a.fallback && !b.fallback) return -1;
                if (!a.fallback && b.fallback) return 1;
                return 0;
            });
        },

        labelFor(code) {
            var normalized = String(code || '').trim().toUpperCase();
            if (normalized === '') return '';
            if (this.regionNames) {
                var name = this.regionNames.of(normalized);
                if (name) return normalized + ' - ' + name;
            }
            return normalized;
        },

        unusedCodes(idx) {
            const current = this.rows[idx]?.country_code || '';
            const pool = this.codes.slice();
            if (current && pool.indexOf(current) === -1) pool.push(current);
            return pool.filter(function(c) {
                return c === current || !this.rows.some(function(r, i) {
                    return i !== idx && r.country_code === c;
                });
            }, this);
        },

        addRow() {
            this.rows.push({
                _key: Math.random().toString(36).slice(2),
                country_code: '',
                regime: 'normal_vat',
                rate: '',
                zero_reason: '',
                fallback: false,
            });
        },

        removeRow(idx) {
            if (this.rows[idx] && this.rows[idx].fallback) return;
            this.rows.splice(idx, 1);
        },

        onRegimeChange(row) {
            if (row.regime === 'no_tax') {
                row.rate = '';
            }
        },
    }));
});

document.addEventListener('alpine:init', () => {
    Alpine.data('seoRobots', () => ({
        blockAi: {{ settings.block_ai_crawlers|default('0') == '1' ? 'true' : 'false' }},
        customTxt: '{{ settings.robots_txt|default('')|e('js') }}',
        aiCrawlers: {{ ai_crawlers|default([])|json_encode|raw }},
        siteUrl: '{{ site_url|e('js') }}',
        get preview() {
            var parts = [];
            if (this.blockAi) {
                for (var i = 0; i < this.aiCrawlers.length; i++) {
                    parts.push('User-agent: ' + this.aiCrawlers[i] + '\nDisallow: /');
                }
                parts.push('');
            }
            if (this.customTxt.trim() !== '') {
                parts.push(this.customTxt);
            } else {
                parts.push('User-agent: *\nAllow: /\n\nSitemap: ' + this.siteUrl + '/sitemap.xml');
            }
            return parts.join('\n\n');
        }
    }));
    Alpine.data('customCarriers', () => ({
        rows: [],
        init() {
            const raw = '{{ settings.custom_shipping_carriers|default('[]')|e('js') }}';
            try {
                const list = JSON.parse(raw);
                this.rows = list.map(function(c) {
                    return { _key: Math.random().toString(36).slice(2), name: c.name || '', url: c.url || '', _warn: !!(c.url && !c.url.includes('{tracking_number}')) };
                });
            } catch (e) {
                this.rows = [];
            }
        },
        addRow() {
            const last = this.rows[this.rows.length - 1];
            if (last && (last.name || '').trim() === '') {
                last._warn = false;
                return;
            }
            this.rows.push({ _key: Math.random().toString(36).slice(2), name: '', url: '', _warn: false });
        },
        removeRow(idx) {
            this.rows.splice(idx, 1);
        },
        get json() {
            const seen = {};
            const unique = [];
            this.rows.forEach(function(r) {
                const n = (r.name || '').trim().toLowerCase();
                if (n === '' || seen[n]) return;
                seen[n] = true;
                unique.push(r);
            });
            return JSON.stringify(unique.map(function(r) {
                var slug = r.name.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
                return { name: r.name.trim(), url: r.url.trim(), value: slug };
            }));
        }
    }));
    window.CUSTOM_CARRIER_RENAMES = {{ custom_carrier_renames|default({})|json_encode|raw }};
    window.showCarrierNotifications = function() {
        const renames = window.CUSTOM_CARRIER_RENAMES || {};
        const keys = Object.keys(renames);
        if (!keys.length) return;
        const container = document.getElementById('carrier-notifications');
        if (!container) return;
        const list = keys.map(function(k) { return '<strong>' + k + '</strong> -> <code>' + renames[k] + '</code>'; }).join('<br>');
        container.innerHTML = '<div class="rounded-lg border border-amber-300 bg-amber-50 dark:bg-amber-900/30 dark:border-amber-700 p-3 text-xs text-amber-800 dark:text-amber-200"><strong>Info:</strong> Duplicate carrier names detected. The following slugs were auto-renamed to avoid conflicts:<br><br>' + list + '</div>';
        container.style.display = 'block';
    };
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', showCarrierNotifications);
    } else {
        showCarrierNotifications();
    }
});
</script>
