    var search = document.getElementById('gmc-browse-search');
    if (search) {
        search.value = gmcCurrentQuery;
    }
    var cacheKey = gmcCacheKey(1);
    if (gmcTaxonomyCache[cacheKey]) {
        gmcRenderData(gmcTaxonomyCache[cacheKey]);
    } else {
        gmcLoadPage(1);
    }
}

function closeGmcBrowser() {
    var modal = document.getElementById('gmc-browse-modal');
    if (modal) modal.classList.add('hidden');
}

var gmcCurrentPage = 1, gmcCurrentQuery = '', gmcTotalPages = 1, gmcTaxonomyCache = {};

function gmcCacheKey(page) {
    return 'page:' + page + '|query:' + gmcCurrentQuery;
}

function gmcRenderData(data) {
    var list = document.getElementById('gmc-browse-list');
    var pagination = document.getElementById('gmc-browse-pagination');
    if (data.data.length === 0) {
        list.innerHTML = '<div class="p-4 text-center text-gray-400">No categories found.</div>';
    } else {
        var html = '';
        for (var i = 0; i < data.data.length; i++) {
            var cat = data.data[i];
            html += '<div class="px-3 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer rounded dark:text-gray-200" onclick="gmcSelect(\'' + cat.replace(/'/g, "\\'") + '\')">' + cat + '</div>';
        }
        list.innerHTML = html;
    }
    pagination.innerHTML = 'Page ' + data.meta.page + ' of ' + data.meta.total_pages + ' (' + data.meta.total + ' categories)';
    if (data.meta.page < data.meta.total_pages) {
        pagination.innerHTML += ' <button type="button" onclick="gmcLoadPage(' + (data.meta.page + 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300">Next →</button>';
    }
    if (data.meta.page > 1) {
        pagination.innerHTML = '<button type="button" onclick="gmcLoadPage(' + (data.meta.page - 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300">← Previous</button> ' + pagination.innerHTML;
    }
}

function gmcLoadPage(page) {
    gmcCurrentPage = page;
    var q = gmcCurrentQuery ? '&q=' + encodeURIComponent(gmcCurrentQuery) : '';
    var list = document.getElementById('gmc-browse-list');
    var pagination = document.getElementById('gmc-browse-pagination');
    list.innerHTML = '<div class="p-4 text-center text-gray-400"><svg class="inline-block h-4 w-4 animate-spin mr-2 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>Loading…</div>';
    var cacheKey = gmcCacheKey(page);
    if (gmcTaxonomyCache[cacheKey]) {
        gmcRenderData(gmcTaxonomyCache[cacheKey]);
        return;
    }
    var url = '{{ url('/admin/gmc/taxonomy') }}?page=' + page + '&per_page=50' + q;
    fetch(url).then(function(r){ return r.json(); }).then(function(data) {
        gmcTotalPages = data.meta.total_pages;
        if (data.data.length === 0) {
            list.innerHTML = '<div class="p-4 text-center text-gray-400">No categories found.</div>';
        } else {
            var html = '';
            for (var i = 0; i < data.data.length; i++) {
                var cat = data.data[i];
                html += '<div class="px-3 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer rounded dark:text-gray-200" onclick="gmcSelect(\'' + cat.replace(/'/g, "\\'") + '\')">' + cat + '</div>';
            }
            list.innerHTML = html;
        }
        pagination.innerHTML = 'Page ' + data.meta.page + ' of ' + data.meta.total_pages + ' (' + data.meta.total + ' categories)';
        if (data.meta.page < data.meta.total_pages) {
            pagination.innerHTML += ' <button type="button" onclick="gmcLoadPage(' + (data.meta.page + 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300">Next →</button>';
        }
        if (data.meta.page > 1) {
            pagination.innerHTML = '<button type="button" onclick="gmcLoadPage(' + (data.meta.page - 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300">← Previous</button> ' + pagination.innerHTML;
        }
        gmcTaxonomyCache[cacheKey] = data;
    }).catch(function(){
        list.innerHTML = '<div class="p-4 text-center text-red-400">Error loading categories.</div>';
    });
}

function gmcSearch(query) {
    gmcCurrentQuery = query;
    gmcLoadPage(1);
}

function gmcSelect(category) {
    var modal = document.getElementById('gmc-browse-modal');
    if (modal && modal._targetId) {
        var target = document.getElementById(modal._targetId);
        if (target) {
            if (target.tagName === 'SELECT') {
                var opt = document.createElement('option');
                opt.value = category;
                opt.text = category;
                opt.selected = true;
                target.appendChild(opt);
            } else {
                target.value = category;
            }
        }
    }
    closeGmcBrowser();
}

/* ── Site Logo picker (Alpine.js) ── */
window.siteLogoPicker = (initialUrl) => {
    const bp = window.APP_BASE_PATH || '';
    return {
        logoUrl: initialUrl || '',
        showModal: false,
        loading: false,
        mediaPage: 1,
        mediaTotalPages: 1,
        mediaQuery: '',
        searchTimer: null,
        mediaItems: [],
        imageId: 0,
        async loadMediaPage(page = 1) {
            this.loading = true;
            try {
                const data = await fetchImageMediaPage(bp, page, this.mediaQuery, 40);
                this.mediaItems = data.items || [];
                this.mediaPage = data.page || page;
                this.mediaTotalPages = data.total_pages || 1;
            } finally {
                this.loading = false;
            }
        },
        async prevMediaPage() {
            if (this.mediaPage > 1) await this.loadMediaPage(this.mediaPage - 1);
        },
        async nextMediaPage() {
            if (this.mediaPage < this.mediaTotalPages) await this.loadMediaPage(this.mediaPage + 1);
        },
        async openBrowser() {
            this.showModal = true;
            if (this.mediaItems.length === 0) await this.loadMediaPage(1);
        },
        async refreshMedia() {
            clearMediaCache();
            this.mediaItems = [];
            await this.loadMediaPage(1);
        },
        onSearchInput() {
            clearTimeout(this.searchTimer);
            this.searchTimer = setTimeout(() => this.loadMediaPage(1), 300);
        },
        selectImage(item) {
            this.logoUrl = item.thumbnail || item.url;
            this.showModal = false;
        },
        // Drag-drop upload (assets/js/media-upload.js): reload the grid
        // and auto-select the first uploaded image.
        async handleDroppedFiles(result) {
            await this.refreshMedia();
            const first = (result && result.uploaded || [])[0];
            if (first) this.selectImage(first);
        },
        removeLogo() {
            this.logoUrl = '';
        },
    };
};
