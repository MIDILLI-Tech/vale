                        <button type="button" disabled
                                class="relative inline-flex h-6 w-11 cursor-not-allowed items-center rounded-full bg-gray-200 dark:bg-gray-700">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </span>
                    {% endif %}
                </div>
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                {% if cko_enabled %}{{ __('Accepting payments.') }}{% if cko_is_default %} {{ __('Preselected at checkout.') }}{% endif %}
                {% elseif cko_tested %}{{ __('Test passed — switch on to accept payments.') }}
                {% else %}{{ __('Save credentials, then run Save & Test.') }}{% endif %}
            </p>

            <div x-show="open" class="mt-4" x-cloak>
            <hr class="my-4 border-gray-200">
            <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{{ step_hint }}</p>
            {% if not cko_can_enable and not cko_enabled %}
            <p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-300">{{ __('Test the connection first to enable.') }}</p>
            {% endif %}
            <form method="post" action="{{ url('/admin/payment/save') }}" id="pay-save-checkoutcom">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="checkoutcom">

                <div class="mb-3" {{ vl.attrs('ecommerce', __('Secret Key'), 'secret_key', 'payment', 'Checkout.com', 'checkout.com secret api key') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Secret Key') }}</label>
                    <input type="password" name="secret_key" value="{{ paymentConfig.checkoutcom.secret_key }}" placeholder="sk_..." autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.checkoutcom.secret_key %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Secret key is saved. Leave unchanged to keep current value.') }}</p>
                    {% endif %}
                </div>
                <div class="mb-4" {{ vl.attrs('ecommerce', __('Webhook Signing Secret'), 'webhook_secret', 'payment', 'Checkout.com', 'checkout.com webhook signing') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Webhook Signing Secret') }}</label>
                    <input type="password" name="webhook_secret" value="{{ paymentConfig.checkoutcom.webhook_secret }}" placeholder="••••••••" autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.checkoutcom.webhook_secret %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Webhook secret is saved. Leave unchanged to keep current value.') }}</p>
                    {% endif %}
                    <p class="mt-1 text-xs text-gray-400">{{ __('Webhook URL') }}: <code>{{ site_url }}/webhooks/checkoutcom</code></p>
                </div>

                <div class="mb-4" {{ vl.attrs('ecommerce', __('Processing Channel ID'), 'processing_channel_id', 'payment', 'Checkout.com', 'checkout.com processing channel pc') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Processing Channel ID') }}</label>
                    <input type="text" name="processing_channel_id" value="{{ paymentConfig.checkoutcom.processing_channel_id }}" placeholder="pc_..."
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('From Checkout.com dashboard → Account settings → Processing channels. Starts with') }} <code>pc_</code>.</p>
                </div>

                <div class="mb-4 flex items-center gap-2">
                    <input type="hidden" name="sandbox" value="0">
                    <input type="checkbox" name="sandbox" id="checkoutcom-sandbox-settings" value="1" {{ paymentConfig.checkoutcom.sandbox == '1' ? 'checked' : '' }}
                           class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                    <label for="checkoutcom-sandbox-settings" class="text-sm text-gray-700">{{ __('Sandbox mode (testing)') }}</label>
                </div>

                <div class="mb-4">
                    <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('API Base URL') }} <span class="font-normal text-gray-400">({{ __('optional — leave blank for default') }})</span></label>
                    <input type="url" name="base_url" value="{{ paymentConfig.checkoutcom.base_url }}"
                           placeholder="https://[account-id].api.sandbox.checkout.com"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Use your account-specific endpoint from Checkout.com dashboard → Account settings → API keys.') }}</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Payment Label') }}</label>
                    <input type="text" name="label" value="{{ paymentConfig.checkoutcom.label }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Displayed as the payment method name on checkout.') }}</p>
                </div>

                {% if signup_urls.payment_gateways.checkoutcom.api_urls is defined %}
                <div class="mb-3 flex flex-wrap gap-2">
                    {% if signup_urls.payment_gateways.checkoutcom.api_urls.test %}
                    <a href="{{ signup_urls.payment_gateways.checkoutcom.api_urls.test }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Test API Keys') }}
                    </a>
                    {% endif %}
                    {% if signup_urls.payment_gateways.checkoutcom.api_urls.live %}
                    <a href="{{ signup_urls.payment_gateways.checkoutcom.api_urls.live }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Live API Keys') }}
                    </a>
                    {% endif %}
                </div>
                {% endif %}

                <button type="submit" formaction="{{ url('/admin/payment/test') }}" class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                    🔌 {{ __('Save & Test Gateway') }}
                </button>
                <p class="mt-1 text-center text-xs text-gray-400">{{ __('A successful test enables the provider automatically.') }}</p>
            </form>

            {% if cko_is_default %}
            <div class="mt-3 rounded-lg border border-indigo-300 bg-slate-50 dark:border-indigo-800 dark:bg-indigo-900/40 px-4 py-2 text-center text-sm font-medium text-indigo-700 dark:text-indigo-300">
                ✓ {{ __('Default Gateway') }} <span class="font-normal">— {{ __('Preselected at checkout.') }}</span>
            </div>
            {% elseif cko_enabled %}
            <form method="post" action="{{ url('/admin/payment/default') }}" class="mt-3">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="checkoutcom">
                <button type="submit" class="w-full rounded-lg border border-indigo-300 dark:border-indigo-800 px-4 py-2 text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:bg-slate-50 dark:hover:bg-indigo-900/40 transition-colors">
                    {{ __('Set Default') }}
                </button>
            </form>
            {% else %}
            <button type="button" disabled title="{{ __('Enable this provider first.') }}" class="mt-3 w-full cursor-not-allowed rounded-lg border border-indigo-300 dark:border-indigo-800 px-4 py-2 text-sm font-medium text-gray-400">
                {{ __('Set Default') }}
            </button>
            {% endif %}
            </div>
        </div>

    </div>
    </div>{# /ec-tab-payment #}

