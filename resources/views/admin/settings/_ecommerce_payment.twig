    {# ══ Payment sub-panel — single source of truth ══ #}
    {# Standalone /admin/payment redirects here (PaymentController::wizard). #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    <div id="ec-tab-payment" class="ec-tab-panel hidden">
    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Payment Gateways') }}</h3>
    <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">{{ __('All enabled methods are offered at checkout. The default is pre-selected.') }}</p>

    {% set default_gw = paymentConfig.default_gateway|default('stripe') %}
    {% set any_enabled = paymentConfig.stripe.enabled == '1'
        or paymentConfig.paypal.enabled == '1'
        or paymentConfig.mollie.enabled == '1'
        or paymentConfig.twocheckout.enabled == '1'
        or paymentConfig.checkoutcom.enabled == '1'
        or paymentConfig.banktransfer.enabled == '1' %}
    {% set enabled_gateways = [] %}
    {% if paymentConfig.stripe.enabled == '1' %}
        {% set label = 'Stripe' ~ (default_gw == 'stripe' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}
    {% if paymentConfig.paypal.enabled == '1' %}
        {% set label = 'PayPal' ~ (default_gw == 'paypal' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}
    {% if paymentConfig.mollie.enabled == '1' %}
        {% set label = 'Mollie' ~ (default_gw == 'mollie' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}
    {% if paymentConfig.twocheckout.enabled == '1' %}
        {% set label = '2Checkout' ~ (default_gw == 'twocheckout' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}
    {% if paymentConfig.checkoutcom.enabled == '1' %}
        {% set label = 'Checkout.com' ~ (default_gw == 'checkoutcom' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}
    {% if paymentConfig.banktransfer.enabled == '1' %}
        {% set label = 'Bank Transfer' ~ (default_gw == 'banktransfer' ? ' (Default)' : '') %}
        {% set enabled_gateways = enabled_gateways|merge([label]) %}
    {% endif %}

    {% if enabled_gateways|length > 0 %}
    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
        ✓ {{ __('Active gateways') }}: <strong>{{ enabled_gateways|join(', ') }}</strong>
    </div>
    {% else %}
    <div class="mb-4 rounded-xl border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-800">
        ⚠ {{ __('No payment gateway is enabled. Configure and enable at least one provider.') }}
    </div>
    {% endif %}

    {% set step_hint = __('Enter credentials → Save & Test (auto-enables) → Set as default (optional).') %}

    {# Smart card expansion: after a save/test/toggle the touched card opens,
       on a plain GET everything stays collapsed. `payment_open_card` is
       single-use (consumed in SettingsController), so F5 collapses again. #}
    {% set _open_card = payment_open_card|default('') %}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 items-start">

        {# ── Mollie ─────────────────────────────── #}
        {% set mollie_enabled = paymentConfig.mollie.enabled == '1' %}
        {% set mollie_tested = paymentConfig.mollie.tested|default('0') == '1' %}
        {% set mollie_is_default = default_gw == 'mollie' %}
        {% set mollie_can_enable = mollie_tested %}
        <div data-provider-card="mollie" x-data="{ open: {{ _open_card == 'mollie' ? 'true' : 'false' }} }" {{ vl.attrs('ecommerce', 'Mollie', 'mollie_enabled', 'payment', __('Payment Gateways'), 'mollie payment gateway enable') }} class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs {{ mollie_enabled ? 'pb-4 ring-2 ring-pink-400 dark:ring-pink-800 order-1' : 'pb-4 order-6' }}">
            <div class="flex items-center justify-between gap-2">
                <button type="button" @click="open = !open" class="inline-flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
                    <span>Mollie
                        <a href="{{ signup_urls.payment_gateways.mollie.signup_url }}" target="_blank" rel="noopener"
                           class="ml-1 text-xs font-normal text-gray-400 hover:text-gray-600" title="{{ __('Create account') }}" onclick="event.stopPropagation()">
                            ↗ {{ __('Sign up') }}
                        </a>
                    </span>
                    <svg x-show="open" class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg x-show="!open" x-cloak class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <div class="flex items-center gap-1.5">
                    {% if mollie_is_default %}
                    <span class="rounded-full bg-gray-900 px-2 py-0.5 text-[11px] font-semibold text-white dark:bg-gray-100 dark:text-gray-900">★ {{ __('Default') }}</span>
                    {% endif %}
                    {% if mollie_tested %}
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">{{ __('Tested') }}</span>
                    {% else %}
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">{{ __('Not tested') }}</span>
                    {% endif %}
                    {% if mollie_enabled %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="mollie">
                        <input type="hidden" name="enabled" value="0">
                        <span class="text-xs font-medium text-green-700 mr-1">{{ __('Enabled') }}</span>
                        <button type="submit" title="{{ __('Disable Mollie') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-green-500 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-6 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% elseif mollie_can_enable %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="mollie">
                        <input type="hidden" name="enabled" value="1">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="submit" title="{{ __('Enable Mollie') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-300 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% else %}
                    <span class="flex items-center gap-2" title="{{ __('Test the connection first to enable.') }}">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="button" disabled
                                class="relative inline-flex h-6 w-11 cursor-not-allowed items-center rounded-full bg-gray-200 dark:bg-gray-700">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </span>
                    {% endif %}
                </div>
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                {% if mollie_enabled %}{{ __('Accepting payments.') }}{% if mollie_is_default %} {{ __('Preselected at checkout.') }}{% endif %}
                {% elseif mollie_tested %}{{ __('Test passed — switch on to accept payments.') }}
                {% else %}{{ __('Save credentials, then run Save & Test.') }}{% endif %}
            </p>

            <div x-show="open" class="mt-4" x-cloak>
            <hr class="my-4 border-gray-200">
            <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{{ step_hint }}</p>
            {% if not mollie_can_enable and not mollie_enabled %}
            <p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-300">{{ __('Test the connection first to enable.') }}</p>
            {% endif %}
            <form method="post" action="{{ url('/admin/payment/save') }}" id="pay-save-mollie">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="mollie">

                <div class="mb-4" {{ vl.attrs('ecommerce', __('API Key'), 'api_key', 'payment', 'Mollie', 'mollie api key test live') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('API Key') }}</label>
                    <input type="password" name="api_key" value="{{ paymentConfig.mollie.api_key }}" placeholder="test_... or live_..." autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.mollie.api_key %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Secret is saved. Leave unchanged to keep current value.') }}</p>
                    {% endif %}
                </div>
                <div class="mb-4">
                    <label class="flex items-center gap-2 text-sm dark:text-gray-300">
                        <input type="hidden" name="sandbox" value="0">
                        <input type="checkbox" name="sandbox" value="1" {{ paymentConfig.mollie.sandbox == '1' ? 'checked' }}
                               class="rounded-sm border-gray-300 dark:border-gray-700 text-pink-600 focus:ring-pink-500">
                        {{ __('Sandbox mode (skip webhook, use test API keys)') }}
                    </label>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Enable when running on localhost or a local network address unreachable from Mollie.') }}</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Payment Label') }}</label>
                    <input type="text" name="label" value="{{ paymentConfig.mollie.label }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Displayed as the payment method name on checkout.') }}</p>
                </div>

                {% if signup_urls.payment_gateways.mollie.api_urls is defined %}
                <div class="mb-3 flex flex-wrap gap-2">
                    {% if signup_urls.payment_gateways.mollie.api_urls.test %}
                    <a href="{{ signup_urls.payment_gateways.mollie.api_urls.test }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Test API Keys') }}
                    </a>
                    {% endif %}
                    {% if signup_urls.payment_gateways.mollie.api_urls.live %}
                    <a href="{{ signup_urls.payment_gateways.mollie.api_urls.live }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Live API Keys') }}
                    </a>
                    {% endif %}
                </div>
                {% endif %}

                <button type="submit" formaction="{{ url('/admin/payment/test') }}" class="w-full rounded-lg bg-pink-500 dark:bg-pink-700 px-4 py-2 text-sm font-medium text-white hover:bg-pink-600 dark:hover:bg-pink-800 transition-colors">
                    🔌 {{ __('Save & Test Gateway') }}
                </button>
                <p class="mt-1 text-center text-xs text-gray-400">{{ __('A successful test enables the provider automatically.') }}</p>
            </form>

            {% if mollie_is_default %}
            <div class="mt-3 rounded-lg border border-pink-300 bg-pink-50 dark:border-pink-800 dark:bg-pink-900/40 px-4 py-2 text-center text-sm font-medium text-pink-700 dark:text-pink-300">
                ✓ {{ __('Default Gateway') }} <span class="font-normal">— {{ __('Preselected at checkout.') }}</span>
            </div>
            {% elseif mollie_enabled %}
            <form method="post" action="{{ url('/admin/payment/default') }}" class="mt-3">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="mollie">
                <button type="submit" class="w-full rounded-lg border border-pink-300 dark:border-pink-800 px-4 py-2 text-sm font-medium text-pink-700 dark:text-pink-400 hover:bg-pink-50 dark:hover:bg-pink-900/40 transition-colors">
                    {{ __('Set Default') }}
                </button>
            </form>
            {% else %}
            <button type="button" disabled title="{{ __('Enable this provider first.') }}" class="mt-3 w-full cursor-not-allowed rounded-lg border border-pink-300 dark:border-pink-800 px-4 py-2 text-sm font-medium text-gray-400">
                {{ __('Set Default') }}
            </button>
            {% endif %}
            </div>
        </div>

        {# ── PayPal ─────────────────────────────── #}
        {% set paypal_enabled = paymentConfig.paypal.enabled == '1' %}
        {% set paypal_tested = paymentConfig.paypal.tested|default('0') == '1' %}
        {% set paypal_is_default = default_gw == 'paypal' %}
        {% set paypal_can_enable = paypal_tested %}
        <div data-provider-card="paypal" x-data="{ open: {{ _open_card == 'paypal' ? 'true' : 'false' }} }" {{ vl.attrs('ecommerce', 'PayPal', 'paypal_enabled', 'payment', __('Payment Gateways'), 'paypal payment gateway enable') }} class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs {{ paypal_enabled ? 'pb-4 ring-2 ring-yellow-400 dark:ring-yellow-800 order-3' : 'pb-4 order-8' }}">
            <div class="flex items-center justify-between gap-2">
                <button type="button" @click="open = !open" class="inline-flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
                    <span>PayPal
                        <a href="{{ signup_urls.payment_gateways.paypal.signup_url }}" target="_blank" rel="noopener"
                           class="ml-1 text-xs font-normal text-gray-400 hover:text-gray-600" title="{{ __('Create account') }}" onclick="event.stopPropagation()">
                            ↗ {{ __('Sign up') }}
                        </a>
                    </span>
                    <svg x-show="open" class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg x-show="!open" x-cloak class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <div class="flex items-center gap-1.5">
                    {% if paypal_is_default %}
                    <span class="rounded-full bg-gray-900 px-2 py-0.5 text-[11px] font-semibold text-white dark:bg-gray-100 dark:text-gray-900">★ {{ __('Default') }}</span>
                    {% endif %}
                    {% if paypal_tested %}
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">{{ __('Tested') }}</span>
                    {% else %}
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">{{ __('Not tested') }}</span>
                    {% endif %}
                    {% if paypal_enabled %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="paypal">
                        <input type="hidden" name="enabled" value="0">
                        <span class="text-xs font-medium text-green-700 mr-1">{{ __('Enabled') }}</span>
                        <button type="submit" title="{{ __('Disable PayPal') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-green-500 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-6 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% elseif paypal_can_enable %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="paypal">
                        <input type="hidden" name="enabled" value="1">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="submit" title="{{ __('Enable PayPal') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-300 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% else %}
                    <span class="flex items-center gap-2" title="{{ __('Test the connection first to enable.') }}">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="button" disabled
                                class="relative inline-flex h-6 w-11 cursor-not-allowed items-center rounded-full bg-gray-200 dark:bg-gray-700">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </span>
                    {% endif %}
                </div>
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                {% if paypal_enabled %}{{ __('Accepting payments.') }}{% if paypal_is_default %} {{ __('Preselected at checkout.') }}{% endif %}
                {% elseif paypal_tested %}{{ __('Test passed — switch on to accept payments.') }}
                {% else %}{{ __('Save credentials, then run Save & Test.') }}{% endif %}
            </p>

            <div x-show="open" class="mt-4" x-cloak>
            <hr class="my-4 border-gray-200">
            <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{{ step_hint }}</p>
            {% if not paypal_can_enable and not paypal_enabled %}
            <p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-300">{{ __('Test the connection first to enable.') }}</p>
            {% endif %}
            <form method="post" action="{{ url('/admin/payment/save') }}" id="pay-save-paypal">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="paypal">

                <div class="mb-3" {{ vl.attrs('ecommerce', __('Client ID'), 'client_id', 'payment', 'PayPal', 'paypal client id') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Client ID') }}</label>
                    <input type="text" name="client_id" value="{{ paymentConfig.paypal.client_id }}" placeholder="AX..." autocomplete="off"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                </div>
                <div class="mb-4" {{ vl.attrs('ecommerce', __('Client Secret'), 'client_secret', 'payment', 'PayPal', 'paypal secret credentials') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Client Secret') }}</label>
                    <input type="password" name="client_secret" value="{{ paymentConfig.paypal.client_secret }}" placeholder="EX..." autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.paypal.client_secret %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Secret is saved. Leave unchanged to keep current value.') }}</p>
                    {% endif %}
                </div>

                <div class="mb-4 flex items-center gap-2">
                    <input type="hidden" name="sandbox" value="0">
                    <input type="checkbox" name="sandbox" id="paypal-sandbox-settings" value="1" {{ paymentConfig.paypal.sandbox == '1' ? 'checked' : '' }}
                           class="h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                    <label for="paypal-sandbox-settings" class="text-sm text-gray-700">{{ __('Sandbox mode (testing)') }}</label>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Webhook ID') }}</label>
                    <input type="text" name="webhook_id" value="{{ paymentConfig.paypal.webhook_id|default('') }}"
                           placeholder="XXXXXXXXXXXXX"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Required for subscription webhooks. Get it from the PayPal developer dashboard webhook settings. Without it, incoming webhooks are rejected.') }}</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Payment Label') }}</label>
                    <input type="text" name="label" value="{{ paymentConfig.paypal.label }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Displayed as the payment method name on checkout.') }}</p>
                </div>

                {% if signup_urls.payment_gateways.paypal.api_urls is defined %}
                <div class="mb-3 flex flex-wrap gap-2">
                    {% if signup_urls.payment_gateways.paypal.api_urls.test %}
                    <a href="{{ signup_urls.payment_gateways.paypal.api_urls.test }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Test API Keys') }}
                    </a>
                    {% endif %}
                    {% if signup_urls.payment_gateways.paypal.api_urls.live %}
                    <a href="{{ signup_urls.payment_gateways.paypal.api_urls.live }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Live API Keys') }}
                    </a>
                    {% endif %}
                </div>
                {% endif %}

                <button type="submit" formaction="{{ url('/admin/payment/test') }}" class="w-full rounded-lg bg-yellow-500 dark:bg-yellow-700 px-4 py-2 text-sm font-medium text-white hover:bg-yellow-600 dark:hover:bg-yellow-800 transition-colors">
                    🔌 {{ __('Save & Test Gateway') }}
                </button>
                <p class="mt-1 text-center text-xs text-gray-400">{{ __('A successful test enables the provider automatically.') }}</p>
            </form>

            {% if paypal_is_default %}
            <div class="mt-3 rounded-lg border border-yellow-300 bg-yellow-50 dark:border-yellow-800 dark:bg-yellow-900/40 px-4 py-2 text-center text-sm font-medium text-yellow-700 dark:text-yellow-300">
                ✓ {{ __('Default Gateway') }} <span class="font-normal">— {{ __('Preselected at checkout.') }}</span>
            </div>
            {% elseif paypal_enabled %}
            <form method="post" action="{{ url('/admin/payment/default') }}" class="mt-3">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="paypal">
                <button type="submit" class="w-full rounded-lg border border-yellow-300 dark:border-yellow-800 px-4 py-2 text-sm font-medium text-yellow-700 dark:text-yellow-500 hover:bg-yellow-50 dark:hover:bg-yellow-900/40 transition-colors">
                    {{ __('Set Default') }}
                </button>
            </form>
            {% else %}
            <button type="button" disabled title="{{ __('Enable this provider first.') }}" class="mt-3 w-full cursor-not-allowed rounded-lg border border-yellow-300 dark:border-yellow-800 px-4 py-2 text-sm font-medium text-gray-400">
                {{ __('Set Default') }}
            </button>
            {% endif %}
            </div>
        </div>

        {# ── Stripe ─────────────────────────────── #}
        {% set stripe_enabled = paymentConfig.stripe.enabled == '1' %}
