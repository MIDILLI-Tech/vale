                            ↗ {{ __('Sign up') }}
                        </a>
                    </span>
                    <svg x-show="open" class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg x-show="!open" x-cloak class="h-4 w-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <div class="flex items-center gap-1.5">
                    {% if stripe_is_default %}
                    <span class="rounded-full bg-gray-900 px-2 py-0.5 text-[11px] font-semibold text-white dark:bg-gray-100 dark:text-gray-900">★ {{ __('Default') }}</span>
                    {% endif %}
                    {% if stripe_tested %}
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">{{ __('Tested') }}</span>
                    {% else %}
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">{{ __('Not tested') }}</span>
                    {% endif %}
                    {% if stripe_enabled %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="stripe">
                        <input type="hidden" name="enabled" value="0">
                        <span class="text-xs font-medium text-green-700 mr-1">{{ __('Enabled') }}</span>
                        <button type="submit" title="{{ __('Disable Stripe') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-green-500 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-6 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% elseif stripe_can_enable %}
                    <form method="post" action="{{ url('/admin/payment/toggle') }}" class="flex items-center gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="provider" value="stripe">
                        <input type="hidden" name="enabled" value="1">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="submit" title="{{ __('Enable Stripe') }}"
                                class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-300 transition-colors">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </form>
                    {% else %}
                    <span class="flex items-center gap-2" title="{{ __('Test the connection first to enable.') }}">
                        <span class="text-xs font-medium text-gray-400 mr-1">{{ __('Disabled') }}</span>
                        <button type="button" disabled
                                class="relative inline-flex h-6 w-11 cursor-not-allowed items-center rounded-full bg-gray-200 dark:bg-gray-700">
                            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white dark:bg-gray-900 transition-transform"></span>
                        </button>
                    </span>
                    {% endif %}
                </div>
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                {% if stripe_enabled %}{{ __('Accepting payments.') }}{% if stripe_is_default %} {{ __('Preselected at checkout.') }}{% endif %}
                {% elseif stripe_tested %}{{ __('Test passed — switch on to accept payments.') }}
                {% else %}{{ __('Save credentials, then run Save & Test.') }}{% endif %}
            </p>

            <div x-show="open" class="mt-4" x-cloak>
            <hr class="my-4 border-gray-200">
            <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{{ step_hint }}</p>
            {% if not stripe_can_enable and not stripe_enabled %}
            <p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-300">{{ __('Test the connection first to enable.') }}</p>
            {% endif %}
            <form method="post" action="{{ url('/admin/payment/save') }}" id="pay-save-stripe">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="stripe">

                <div class="mb-3" {{ vl.attrs('ecommerce', __('Publishable Key'), 'publishable_key', 'payment', 'Stripe', 'stripe publishable pk key') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Publishable Key') }}</label>
                    <input type="text" name="publishable_key" value="{{ paymentConfig.stripe.publishable_key }}" placeholder="pk_live_..." autocomplete="off"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                </div>
                <div class="mb-3" {{ vl.attrs('ecommerce', __('Secret Key'), 'secret_key', 'payment', 'Stripe', 'stripe secret sk key') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Secret Key') }}</label>
                    <input type="password" name="secret_key" value="{{ paymentConfig.stripe.secret_key }}" placeholder="sk_live_..." autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.stripe.secret_key %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Secret is saved. Leave unchanged to keep current value.') }}</p>
                    {% endif %}
                </div>
                <div class="mb-4" {{ vl.attrs('ecommerce', __('Webhook Secret'), 'webhook_secret', 'payment', 'Stripe', 'stripe webhook whsec') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Webhook Secret') }}</label>
                    <input type="password" name="webhook_secret" value="{{ paymentConfig.stripe.webhook_secret }}" placeholder="whsec_..." autocomplete="new-password"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    {% if paymentConfig.stripe.webhook_secret %}
                    <p class="mt-1 text-xs text-green-600">✓ {{ __('Webhook secret is saved. Leave unchanged to keep current value.') }}</p>
                    {% else %}
                    <p class="mt-1 text-xs text-gray-400">{{ __('Webhook URL') }}: <code>{{ site_url }}/webhooks/stripe</code></p>
                    {% endif %}
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Payment Label') }}</label>
                    <input type="text" name="label" value="{{ paymentConfig.stripe.label }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-500 focus:outline-hidden">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Displayed as the payment method name on checkout.') }}</p>
                </div>

                {# Stripe payment method types — Automatic / Card only / Custom #}
                {% set stripe_methods_catalog = stripe_payment_methods|default({}) %}
                {% set stripe_methods_value = paymentConfig.stripe.payment_method_types|default('') %}
                {% set stripe_methods_mode = stripe_methods_value == '' ? 'auto' : (stripe_methods_value == 'card' ? 'card' : 'custom') %}
                <div class="mb-4 rounded-lg border border-gray-200 dark:border-gray-800 p-3"
                     x-data="{
                        mode: 'auto',
                        methods: [],
                        available: [],
                        input: '',
                        fetching: false,
                        fetched: false,
                        strict: false,
                        note: '',
                        endpoint: '',
                        msgLoaded: '',
                        msgFallback: '',
                        msgUnavailable: '',
                        init() {
                            const el = this.$el;
                            this.endpoint = el.dataset.endpoint || '';
                            this.msgLoaded = el.dataset.msgLoaded || '';
                            this.msgFallback = el.dataset.msgFallback || '';
                            this.msgUnavailable = el.dataset.msgUnavailable || '';
                            this.mode = el.dataset.mode || 'auto';
                            const map = JSON.parse(el.dataset.catalogJson || '{}');
                            this.available = Object.keys(map).map(key => ({ key: key, label: map[key] }));
                            this.methods = (el.dataset.methods || '').split(',').map(s => s.trim().toLowerCase()).filter(v => v !== '');
                            if (this.mode === 'custom') { this.loadMethods(); }
                        },
                        get availableKeys() {
                            return this.available.map(m => m.key);
                        },
                        get customMethods() {
                            return this.methods.filter(m => this.availableKeys.indexOf(m) === -1);
                        },
                        isUnavailable(key) {
                            return this.strict && this.availableKeys.indexOf(key) === -1;
                        },
                        addCustom() {
                            const v = this.input.trim().toLowerCase().replace(/[^a-z0-9_]/g, '');
                            if (v !== '' && this.methods.indexOf(v) === -1) { this.methods.push(v); }
                            this.input = '';
                        },
                        removeMethod(key) {
                            const i = this.methods.indexOf(key);
                            if (i !== -1) { this.methods.splice(i, 1); }
                        },
                        async loadMethods(force) {
                            if (this.fetching || (this.fetched && !force)) { return; }
                            this.fetching = true;
                            this.note = '';
                            const ctrl = new AbortController();
                            const timer = setTimeout(() => ctrl.abort(), 10000);
                            try {
                                const res = await fetch(this.endpoint + (force ? '?refresh=1' : ''), {
                                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                                    signal: ctrl.signal
                                });
                                const data = await res.json();
                                if (Array.isArray(data.methods) && data.methods.length > 0) {
                                    this.available = data.methods;
                                    this.strict = data.source === 'stripe';
                                    this.note = this.strict ? this.msgLoaded : this.msgFallback;
                                } else {
                                    this.note = this.msgFallback;
                                }
                            } catch (e) {
                                this.note = this.msgFallback;
                            }
                            clearTimeout(timer);
                            this.fetching = false;
                            this.fetched = true;
                        }
                     }"
                     data-mode="{{ stripe_methods_mode }}"
                     data-methods="{{ stripe_methods_value }}"
                     data-catalog-json="{{ stripe_methods_catalog|json_encode }}"
                     data-endpoint="{{ url('/admin/payment/stripe/methods') }}"
                     data-msg-loaded="{{ __('Methods loaded from your Stripe account.') }}"
                     data-msg-fallback="{{ __('Could not reach Stripe — showing the default method list.') }}"
                     data-msg-unavailable="{{ __('Not available on your Stripe account — Stripe will reject it at checkout.') }}">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ __('Payment Methods') }}</label>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <button type="button" @click="mode = 'auto'"
                                :class="mode === 'auto' ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800'"
                                class="rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors">
                            {{ __('Automatic') }}
                        </button>
                        <button type="button" @click="mode = 'card'"
                                :class="mode === 'card' ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800'"
                                class="rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors">
                            {{ __('Card only') }}
                        </button>
                        <button type="button" @click="mode = 'custom'; loadMethods()"
                                :class="mode === 'custom' ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800'"
                                class="rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors">
                            {{ __('Custom') }}
                        </button>
                    </div>

                    <p class="mt-2 text-xs text-gray-400 dark:text-gray-500" x-show="mode === 'auto'">
                        {{ __('Recommended. Stripe picks the methods dynamically from your Dashboard settings, which may include local methods like iDEAL.') }}
                    </p>
                    <p class="mt-2 text-xs text-gray-400 dark:text-gray-500" x-show="mode === 'card'" x-cloak>
                        {{ __('Only card payments: Visa, Mastercard, Amex — plus Apple Pay / Google Pay.') }}
                    </p>

                    <div class="mt-3" x-show="mode === 'custom'" x-cloak>
                        <div class="mb-2 flex items-center justify-between gap-3">
                            <p class="text-xs text-gray-400 dark:text-gray-500" x-show="fetching">{{ __('Loading methods from your Stripe account…') }}</p>
                            <p class="text-xs text-gray-400 dark:text-gray-500" x-show="!fetching" x-cloak x-text="note"></p>
                            <button type="button" @click="loadMethods(true)" :disabled="fetching"
                                    class="shrink-0 inline-flex items-center gap-1 rounded-md border border-gray-300 dark:border-gray-700 px-2 py-0.5 text-[11px] text-gray-500 dark:text-gray-400 transition-colors hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-50"
                                    title="{{ __('Refresh from Stripe') }}"><span class="vl-icon-refresh" :class="fetching ? 'vl-icon-spin' : ''"></span> {{ __('Refresh') }}</button>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <template x-for="m in available" :key="m.key">
                                <label class="flex items-start gap-2 rounded-lg border border-gray-200 dark:border-gray-700 px-2.5 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800">
                                    <input type="checkbox" x-model="methods" :value="m.key"
                                           class="mt-0.5 h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                                    <span class="text-xs">
                                        <span class="block font-mono text-gray-700 dark:text-gray-200" x-text="m.key"></span>
                                        <span class="block text-[11px] text-gray-400 dark:text-gray-500" x-text="m.label"></span>
                                    </span>
                                </label>
                            </template>
                        </div>

                        <div class="mt-3 flex flex-wrap gap-1.5" x-show="customMethods.length > 0" x-cloak>
                            <template x-for="method in customMethods" :key="method">
                                <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-xs"
                                      :class="isUnavailable(method) ? 'border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300' : 'border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200'"
                                      :title="isUnavailable(method) ? msgUnavailable : ''">
                                    <span class="font-mono" x-text="method"></span>
                                    <button type="button" @click="removeMethod(method)" class="font-bold leading-none opacity-60 hover:opacity-100" title="{{ __('Remove') }}">&times;</button>
                                </span>
                            </template>
                        </div>

                        <p class="mt-2 text-xs text-amber-600 dark:text-amber-400" x-show="strict && customMethods.length > 0" x-cloak>
                            {{ __('Some selected methods are not available on your Stripe account and will be rejected at checkout.') }}
                        </p>

                        <div class="mt-3 flex gap-2">
                            <input type="text" x-model="input" @keydown.enter.prevent="addCustom()"
                                   placeholder="{{ __('Other method type, e.g. twint') }}"
                                   class="block w-full rounded-lg border-gray-300 dark:border-gray-700 dark:bg-gray-800 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
                            <button type="button" @click="addCustom()"
                                    class="shrink-0 rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">+ {{ __('Add') }}</button>
                        </div>
                        <p class="mt-2 text-xs text-amber-600 dark:text-amber-400" x-show="methods.length === 0" x-cloak>
                            {{ __('No method selected — saving keeps Automatic.') }}
                        </p>
                        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">
                            {{ __('Only the selected methods are allowed. A method unavailable for the currency or your account country is rejected by Stripe at checkout.') }}
                        </p>
                    </div>

                    <input type="hidden" name="payment_method_types"
                           :value="mode === 'auto' ? '' : (mode === 'card' ? 'card' : methods.join(','))">
                </div>

                {% if signup_urls.payment_gateways.stripe.api_urls is defined %}
                <div class="mb-3 flex flex-wrap gap-2">
                    {% if signup_urls.payment_gateways.stripe.api_urls.test %}
                    <a href="{{ signup_urls.payment_gateways.stripe.api_urls.test }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Test API Keys') }}
                    </a>
                    {% endif %}
                    {% if signup_urls.payment_gateways.stripe.api_urls.live %}
                    <a href="{{ signup_urls.payment_gateways.stripe.api_urls.live }}" target="_blank" rel="noopener"
                       class="text-xs text-gray-500 hover:text-gray-700 underline">
                        {{ __('Get Live API Keys') }}
                    </a>
                    {% endif %}
                </div>
                {% endif %}

                <button type="submit" formaction="{{ url('/admin/payment/test') }}" class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                    🔌 {{ __('Save & Test Gateway') }}
                </button>
                <p class="mt-1 text-center text-xs text-gray-400">{{ __('A successful test enables the provider automatically.') }}</p>
            </form>

            {% if stripe_is_default %}
            <div class="mt-3 rounded-lg border border-gray-400 bg-gray-50 dark:border-gray-600 dark:bg-gray-800/50 px-4 py-2 text-center text-sm font-medium text-gray-800 dark:text-gray-300">
                ✓ {{ __('Default Gateway') }} <span class="font-normal">— {{ __('Preselected at checkout.') }}</span>
            </div>
            {% elseif stripe_enabled %}
            <form method="post" action="{{ url('/admin/payment/default') }}" class="mt-3">
                {{ csrf_field() }}
                <input type="hidden" name="provider" value="stripe">
                <button type="submit" class="w-full rounded-lg border border-gray-400 dark:border-gray-600 px-4 py-2 text-sm font-medium text-gray-800 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 dark:bg-gray-800/50 transition-colors">
                    {{ __('Set Default') }}
                </button>
            </form>
            {% else %}
            <button type="button" disabled title="{{ __('Enable this provider first.') }}" class="mt-3 w-full cursor-not-allowed rounded-lg border border-gray-400 dark:border-gray-600 px-4 py-2 text-sm font-medium text-gray-400">
                {{ __('Set Default') }}
            </button>
            {% endif %}
            </div>
        </div>

        {# ── 2Checkout ──────────────────────────── #}
        {% set tco_enabled = paymentConfig.twocheckout.enabled == '1' %}
        {% set tco_tested = paymentConfig.twocheckout.tested|default('0') == '1' %}
        {% set tco_is_default = default_gw == 'twocheckout' %}
        {% set tco_can_enable = tco_tested %}
