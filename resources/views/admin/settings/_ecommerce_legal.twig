    {# ══ Legal sub-panel ══ #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    <div id="ec-tab-legal" class="ec-tab-panel hidden">
    <form method="post" action="{{ url('/admin/settings') }}" class="space-y-6">
        {{ csrf_field() }}
        <input type="hidden" name="_METHOD" value="PUT">
        <input type="hidden" name="_group" value="ecommerce">
        <input type="hidden" name="_subtab" value="legal">

        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs space-y-5">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 border-b pb-3">{{ __('Legal Pages') }}</h3>
            <div x-data="{ open: false }" class="rounded-lg bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700 text-sm text-amber-800 dark:text-amber-200">
                <button type="button" @click="open = !open" class="w-full flex items-center justify-between p-3.5 font-medium text-amber-900 dark:text-amber-200 focus:outline-hidden text-left cursor-pointer">
                    <span class="flex items-center gap-2">
                        <svg class="h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 110 20A10 10 0 0112 2z"/>
                        </svg>
                        <span>{{ __('Legal Requirements Notice') }}</span>
                    </span>
                    <svg x-show="open" class="h-4 w-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                    <svg x-show="!open" x-cloak class="h-4 w-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
                <div x-show="open" x-cloak class="px-4 pb-4 border-t border-amber-200/60 dark:border-amber-700 pt-3 space-y-2 text-amber-800 dark:text-amber-200">
                    <p>{{ __('You need to check your local regulations to comply with legal requirements for online stores. The three pages below — Return Policy, Privacy Policy, and Terms & Conditions — are commonly required in many jurisdictions.') }}</p>
                    <p>{{ __('Depending on your country, an additional :imprint page may be mandatory. It typically includes your business name, address, contact information, and registration details. In some regions you may also need to display this in the footer or on a dedicated page.', {':imprint': 'Imprint (Legal Notice)'}) }}</p>
                </div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ __('Select existing pages to link as policy documents. These appear on the checkout page and in order confirmation emails.') }}</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {% set legal_fields = [
                    { key: 'policy_page_returns', label: __('Return Policy Page'), seed: pagePickerSeeds.policy_returns|default(null), attrs_key: 'policy_page_returns', keywords: 'returns refund policy' },
                    { key: 'policy_page_privacy', label: __('Privacy Policy Page'), seed: pagePickerSeeds.policy_privacy|default(null), attrs_key: 'policy_page_privacy', keywords: 'privacy gdpr policy' },
                    { key: 'policy_page_terms', label: __('Terms & Conditions Page'), seed: pagePickerSeeds.policy_terms|default(null), attrs_key: 'policy_page_terms', keywords: 'terms conditions tos' },
                ] %}
                {% for field in legal_fields %}
                <div {{ vl.attrs('ecommerce', field.label, field.attrs_key, 'legal', __('Legal Pages'), field.keywords) }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ field.label }}</label>
                    {% include 'admin/components/page-async-select.twig' with {
                        name: field.key,
                        value_field: 'slug',
                        initial_value: field.seed ? field.seed.value : attribute(settings, field.key)|default(''),
                        initial_label: field.seed ? field.seed.label : '',
                        placeholder: __('Search pages…'),
                    } %}
                </div>
                {% endfor %}
            </div>
            <div class="pt-2">
                <a href="{{ url('/admin/pages/create') }}" target="_blank"
                   class="inline-flex items-center gap-1.5 text-sm text-gray-900 dark:text-gray-100 hover:text-gray-800 dark:hover:text-gray-300 transition-colors font-medium">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ __('Create a new page') }} →
                </a>
            </div>
        </div>

    </form>
    </div>{# /ec-tab-legal #}
