    {# ══ Shipping sub-panel ══ #}
{% import 'admin/macros/vl-setting.twig' as vl %}
    <div id="ec-tab-shipping" class="ec-tab-panel hidden">
    <form method="post" action="{{ url('/admin/settings') }}" class="space-y-6">
        {{ csrf_field() }}
        <input type="hidden" name="_METHOD" value="PUT">
        <input type="hidden" name="_group" value="ecommerce">
        <input type="hidden" name="_subtab" value="shipping">

        {# ── Shipping ── #}
        <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs space-y-5">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 border-b pb-3">{{ __('Shipping') }}</h3>

            <div {{ vl.attrs('ecommerce', __('Enable shipping'), 'shipping_enabled', 'shipping', __('Shipping'), 'delivery shipping rates') }}>
            <label class="flex items-center gap-3">
                <input type="hidden" name="shipping_enabled" value="0">
                <input type="checkbox" name="shipping_enabled" value="1"
                       {{ settings.shipping_enabled|default('0') == '1' ? 'checked' }}
                       class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                <span class="text-sm font-medium text-gray-700">{{ __('Enable shipping') }}</span>
            </label>
            </div>

            <div {{ vl.attrs('ecommerce', __('Shipping Mode'), 'shipping_mode', 'shipping', __('Shipping'), 'flat rate free weight based') }}>
                <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Shipping Mode') }}</label>
                <select name="shipping_mode" class="w-full max-w-xs rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                    {% for mode in [['flat_rate', 'Flat rate'], ['free', 'Always free'], ['free_above_threshold', 'Free above order threshold'], ['weight_based', 'Weight-based'], ['highest_item_rate', 'Highest item rate']] %}
                    <option value="{{ mode[0] }}" {{ settings.shipping_mode|default('flat_rate') == mode[0] ? 'selected' }}>{{ mode[1] }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div {{ vl.attrs('ecommerce', __('Flat Rate'), 'shipping_flat_rate', 'shipping', __('Shipping'), 'flat rate cost') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Flat Rate') }}</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">{{ currency_symbol }}</span>
                        <input type="number" step="0.01" min="0" name="shipping_flat_rate"
                               value="{{ settings.shipping_flat_rate|default('0') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm pl-7">
                    </div>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Fixed cost per order (flat_rate / free_above_threshold mode)') }}</p>
                </div>
                <div {{ vl.attrs('ecommerce', __('Free Shipping Threshold'), 'shipping_free_threshold', 'shipping', __('Shipping'), 'free shipping minimum order') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Free Shipping Threshold') }}</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">{{ currency_symbol }}</span>
                        <input type="number" step="0.01" min="0" name="shipping_free_threshold"
                               value="{{ settings.shipping_free_threshold|default('50') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm pl-7">
                    </div>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Orders equal to or above this get free shipping (free_above_threshold mode)') }}</p>
                </div>
                <div {{ vl.attrs('ecommerce', __('Default Rate (over all weight tiers)'), 'shipping_default_rate', 'shipping', __('Shipping'), 'fallback default shipping rate') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Default Rate (over all weight tiers)') }}</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">{{ currency_symbol }}</span>
                        <input type="number" step="0.01" min="0" name="shipping_default_rate"
                               value="{{ settings.shipping_default_rate|default('0') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm pl-7">
                    </div>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Fallback rate when order weight exceeds all weight tiers.') }}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div {{ vl.attrs('ecommerce', __('Default Estimated Delivery (min days)'), 'shipping_time_min', 'shipping', __('Shipping'), 'estimated delivery days min') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Default Estimated Delivery (min days)') }}</label>
                    <input type="number" min="1" max="365" name="shipping_time_min"
                           value="{{ settings.shipping_time_min|default('') }}"
                           placeholder="1"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Earliest delivery estimate in days. Used when no country or product override applies.') }}</p>
                </div>
                <div {{ vl.attrs('ecommerce', __('Default Estimated Delivery (max days)'), 'shipping_time_max', 'shipping', __('Shipping'), 'estimated delivery days max') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Default Estimated Delivery (max days)') }}</label>
                    <input type="number" min="1" max="365" name="shipping_time_max"
                           value="{{ settings.shipping_time_max|default('') }}"
                           placeholder="7"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                    <p class="mt-1 text-xs text-gray-400">{{ __('Latest delivery estimate in days. Shown to customers as "Delivery in X–Y days".') }}</p>
                </div>
            </div>

            <div {{ vl.attrs('ecommerce', __('Weight-based Rates (JSON)'), 'shipping_weight_rates', 'shipping', __('Shipping'), 'weight tiers json rates') }}>
                <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Weight-based Rates (JSON)') }}</label>
                <textarea name="shipping_weight_rates" rows="4"
                          class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm font-mono"
                          placeholder='[{"max_weight":1,"rate":5},{"max_weight":5,"rate":10}]'>{{ settings.shipping_weight_rates|default('') }}</textarea>
                <p class="mt-1 text-xs text-gray-400">{{ __('Array of {max_weight, rate} tiers sorted ascending. Used in weight_based / highest_item_rate modes.') }}</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div {{ vl.attrs('ecommerce', __('Additional Countries'), 'shipping_countries', 'shipping', __('Shipping'), 'allowed shipping countries') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Additional Countries') }}</label>
                    <div x-data="tokenMultiSelect({
                            initial: '{{ settings.shipping_countries|default('')|e('js') }}',
                            options: window.VL_SHIPPING_COUNTRY_OPTIONS_EX_COMPANY || window.VL_SHIPPING_COUNTRY_OPTIONS || window.VL_COUNTRY_CODES || [],
                            kind: 'country',
                            placeholder: '{{ __('Select country code')|e('js') }}'
                        })"
                        class="space-y-2">
                        <div class="flex gap-2 min-w-0">
                            <select x-model="selected"
                                    class="flex-1 min-w-0 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                <option value="" x-text="placeholder"></option>
                                <template x-for="opt in availableOptions()" :key="opt">
                                    <option :value="opt" x-text="displayLabel(opt)"></option>
                                </template>
                            </select>
                            <button type="button" @click="addSelected()"
                                    class="shrink-0 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{{ __('Add') }}</button>
                        </div>
                        <div class="flex flex-wrap gap-2" x-show="items.length > 0" x-cloak>
                            <template x-for="item in items" :key="item">
                                <span class="inline-flex items-center gap-1 rounded-full border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-2.5 py-1 text-xs font-medium text-gray-700">
                                    <span x-text="displayLabel(item)"></span>
                                    <button type="button" @click="remove(item)" class="text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors" aria-label="Remove">&times;</button>
                                </span>
                            </template>
                        </div>
                        <input type="hidden" name="shipping_countries" :value="items.join(',')">
                    </div>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Select additional shipping countries. Leave empty to allow company country only.') }}</p>
                </div>
                <div {{ vl.attrs('ecommerce', __('Blocked Countries'), 'shipping_blocked_countries', 'shipping', __('Shipping'), 'blocked shipping countries') }}>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Blocked Countries') }}</label>
                    <div x-data="tokenMultiSelect({
                            initial: '{{ settings.shipping_blocked_countries|default('')|e('js') }}',
                            options: window.VL_SHIPPING_COUNTRY_OPTIONS_EX_COMPANY || window.VL_SHIPPING_COUNTRY_OPTIONS || window.VL_COUNTRY_CODES || [],
                            kind: 'country',
                            placeholder: '{{ __('Select country code')|e('js') }}'
                        })"
                        class="space-y-2">
                        <div class="flex gap-2 min-w-0">
                            <select x-model="selected"
                                    class="flex-1 min-w-0 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                <option value="" x-text="placeholder"></option>
                                <template x-for="opt in availableOptions()" :key="opt">
                                    <option :value="opt" x-text="displayLabel(opt)"></option>
                                </template>
                            </select>
                            <button type="button" @click="addSelected()"
                                    class="shrink-0 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">{{ __('Add') }}</button>
                        </div>
                        <div class="flex flex-wrap gap-2" x-show="items.length > 0" x-cloak>
                            <template x-for="item in items" :key="item">
                                <span class="inline-flex items-center gap-1 rounded-full border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 px-2.5 py-1 text-xs font-medium text-gray-700">
                                    <span x-text="displayLabel(item)"></span>
                                    <button type="button" @click="remove(item)" class="text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors" aria-label="Remove">&times;</button>
                                </span>
                            </template>
                        </div>
                        <input type="hidden" name="shipping_blocked_countries" :value="items.join(',')">
                    </div>
                    <p class="mt-1 text-xs text-gray-400">{{ __('Select countries to always block, even if they are in the additional countries list.') }}</p>
                </div>
            </div>

            {# ── Country-specific shipping ── #}
            <div {{ vl.attrs('ecommerce', __('Country-specific Shipping'), 'shipping_country_rates', 'shipping', __('Shipping'), 'per country shipping rates') }} x-data="{
                countryCodes: window.VL_SHIPPING_COUNTRY_OPTIONS_EX_COMPANY || window.VL_SHIPPING_COUNTRY_OPTIONS || window.VL_COUNTRY_CODES || [],
                regionNames: (typeof Intl !== 'undefined' && typeof Intl.DisplayNames !== 'undefined')
                    ? new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' })
                    : null,
                rates: window.VL_SHIPPING_RATES_DATA || [],
                get items() {
                    return this.countryCodes
                        .map(function(code) {
                            var name = code;
                            if (this.regionNames) {
                                try { name = this.regionNames.of(code) || code; } catch(e) {}
                            }
                            return { code: code, name: name };
                        }, this)
                        .sort(function(a, b) { return a.name.localeCompare(b.name, navigator.language || 'en'); });
                }
            }">
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">{{ __('Country-specific Rates') }}</label>
                    <button type="button" @click="rates.push({code:'',rate:''})"
                            class="text-xs text-gray-900 dark:text-gray-100 hover:text-gray-800 dark:hover:text-gray-300 transition-colors font-medium">+ {{ __('Add') }}</button>
                </div>
                <div class="space-y-3 sm:space-y-2">
                    <template x-for="(row, idx) in rates" :key="idx">
                        <div class="p-3 sm:p-0 rounded-lg sm:rounded-none bg-gray-50 dark:bg-gray-800/40 sm:bg-transparent dark:sm:bg-transparent border sm:border-0 border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row gap-2 items-stretch sm:items-center min-w-0">
                            <div class="w-full sm:w-56 shrink-0">
                                <select x-model="row.code"
                                        class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                    <option value="">{{ __('Select country') }}</option>
                                    <template x-for="item in items" :key="item.code">
                                        <option :value="item.code" x-text="item.name + ' (' + item.code + ')'"></option>
                                    </template>
                                </select>
                            </div>
                            <div class="flex items-center gap-2 w-full sm:w-auto">
                                <div class="relative flex-1 sm:w-32 shrink-0">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">{{ currency_symbol }}</span>
                                    <input type="text" x-model="row.rate" placeholder="3.99"
                                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm pl-7">
                                </div>
                                <div class="flex items-center gap-1 shrink-0">
                                    <input type="number" min="1" max="365" x-model="row.shipping_time_min" placeholder="Min"
                                           class="w-14 sm:w-16 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                    <span class="text-xs text-gray-400">-</span>
                                    <input type="number" min="1" max="365" x-model="row.shipping_time_max" placeholder="Max"
                                           class="w-14 sm:w-16 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                </div>
                                <button type="button" @click="rates.splice(idx,1)" class="text-red-400 hover:text-red-600 dark:hover:text-red-400 transition-colors text-sm p-1 ml-auto sm:ml-0" title="{{ __('Remove') }}">✕</button>
                            </div>
                        </div>
                    </template>
                </div>
                <input type="hidden" name="shipping_country_rates"
                       :value="JSON.stringify(rates.reduce(function(acc,r){if(r.code){acc[r.code]={rate: r.rate ? r.rate.replace(',','.') : '', shipping_time_min: r.shipping_time_min ? parseInt(r.shipping_time_min) : null, shipping_time_max: r.shipping_time_max ? parseInt(r.shipping_time_max) : null};}return acc},{}))">
                <p class="mt-1 text-xs text-gray-400">{{ __('Per-country flat shipping overrides. Country code (ISO 2-letter) + rate. Min/Max override the default delivery estimate for that country.') }}</p>
            </div>

            {# ── Custom Tracking Carriers ── #}
            <div id="carrier-notifications" style="display: none;" class="mb-3"></div>
            <div x-data="customCarriers()" class="border-t pt-4">
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">{{ __('Custom Tracking Carriers') }}</label>
                    <button type="button" @click="addRow()"
                            class="text-xs text-gray-900 dark:text-gray-100 hover:text-gray-800 dark:hover:text-gray-300 transition-colors font-medium">+ {{ __('Add') }}</button>
                </div>
                <p class="mt-1 text-xs text-gray-400 mb-3">{{ __('Add your own carriers. Use {tracking_number} as placeholder in the URL.') }}</p>

                <div class="space-y-3 sm:space-y-2">
                    <template x-for="(row, idx) in rows" :key="row._key">
                        <div class="p-3 sm:p-0 rounded-lg sm:rounded-none bg-gray-50 dark:bg-gray-800/40 sm:bg-transparent dark:sm:bg-transparent border sm:border-0 border-gray-200 dark:border-gray-800">
                            <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center min-w-0">
                                <div class="w-full sm:w-40 shrink-0">
                                    <input type="text" x-model="row.name" placeholder="AcmeCargo"
                                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                           @blur="row._dup = rows.some(function(r, i) { return i !== idx && (r.name || '').trim().toLowerCase() === (row.name || '').trim().toLowerCase(); })">
                                </div>
                                <div class="flex items-center gap-2 w-full sm:flex-1 min-w-0">
                                    <input type="url" x-model="row.url" placeholder="https://acmecargo.com/track/{tracking_number}"
                                           class="flex-1 min-w-0 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                           @blur="row._warn = row.url.trim() !== '' && !row.url.includes('{tracking_number}')">
                                    <button type="button" @click="removeRow(idx)"
                                            class="shrink-0 text-red-400 hover:text-red-600 dark:hover:text-red-400 transition-colors text-sm p-1.5"
                                            title="{{ __('Remove') }}">&times;</button>
                                </div>
                            </div>
                            <template x-if="row._dup">
                                <p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ __('A carrier with this name already exists.') }}</p>
                            </template>
                            <template x-if="row._warn">
                                <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">{{ __('Tracking number won\'t be appended automatically.') }}</p>
                            </template>
                        </div>
                    </template>
                </div>
                <input type="hidden" name="custom_shipping_carriers" :value="json">
            </div>
        </div>

    </form>
    </div>{# /ec-tab-shipping #}
