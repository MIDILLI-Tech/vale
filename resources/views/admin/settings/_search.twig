<div class="relative w-44 sm:w-52"
     x-data="settingsSearch()"
     x-init="init()"
     @keydown.window="onGlobalKey($event)">
    <label for="vl-settings-search" class="sr-only">{{ __('Search settings') }}</label>
    <div class="relative">
        <svg class="vl-settings-search-icon pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/>
        </svg>
        <input id="vl-settings-search"
               type="search"
               x-ref="input"
               x-model="query"
               @input="onInput()"
               @focus="open = query.length > 0 || results.length > 0"
               @keydown="onKeydown($event)"
               autocomplete="off"
               placeholder="{{ __('Search settings…') }}"
               class="vl-settings-search-input w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-gray-100 shadow-xs focus:border-gray-600 focus:ring-gray-500">
        <kbd class="vl-settings-search-kbd pointer-events-none absolute right-1.5 top-1/2 hidden -translate-y-1/2 rounded border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 px-1 py-px text-[9px] font-medium leading-none text-gray-400 lg:inline">Ctrl K</kbd>
    </div>

    <div x-show="open && (results.length > 0 || (query.length > 0 && !loading))"
         x-cloak
         @click.outside="open = false"
         class="absolute right-0 z-40 mt-1 w-72 max-w-[calc(100vw-2rem)] overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg sm:w-80">
        <ul x-show="results.length > 0" x-ref="resultsList" class="max-h-80 overflow-y-auto py-1" role="listbox">
            <template x-for="(item, idx) in results" :key="item.uid">
                <li>
                    <button type="button"
                            data-vl-search-option
                            @click="goTo(item)"
                            @mouseenter="activeIndex = idx"
                            :class="activeIndex === idx ? 'bg-gray-100 dark:bg-gray-800' : ''"
                            class="flex w-full flex-col gap-0.5 px-3 py-2 text-left transition-colors"
                            role="option"
                            :aria-selected="activeIndex === idx ? 'true' : 'false'">
                        <span class="text-sm font-medium text-gray-900 dark:text-gray-100" x-html="item.labelHtml"></span>
                        <span class="text-xs text-gray-500 dark:text-gray-400" x-text="item.breadcrumb"></span>
                        <span x-show="item.hiddenHint" class="text-[10px] italic text-amber-600 dark:text-amber-400" x-text="item.hiddenHint"></span>
                    </button>
                </li>
            </template>
        </ul>
        <p x-show="query.length > 0 && results.length === 0"
           class="px-3 py-4 text-sm text-gray-500 dark:text-gray-400">{{ __('No settings found.') }}</p>
    </div>
</div>
