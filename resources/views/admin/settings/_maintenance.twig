{# Maintenance #}
{% import 'admin/macros/vl-setting.twig' as vl %}
<div id="tab-maintenance" class="tab-panel hidden space-y-6" data-maintenance-stats-url="{{ maintenance_stats_url|default('') }}">

    {# ── Missing System Requirements Collapsible Warning ── #}
    {% if missing_required_php or missing_required_exts|length > 0 or missing_recommended_exts|length > 0 %}
    <div class="rounded-xl border border-amber-200 bg-amber-50 dark:bg-amber-950/20 dark:border-amber-900 p-5 shadow-xs" x-data="{ open: false }">
        <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-4">
                <svg class="h-6 w-6 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
                <div>
                    <p class="font-semibold text-amber-800 dark:text-amber-400">{{ __('System Requirements Warning') }}</p>
                    <p class="text-sm text-amber-700 dark:text-amber-500 mt-0.5">
                        {{ __('Some required or recommended system requirements are missing. This may cause updates or features to fail.') }}
                    </p>
                </div>
            </div>
            <button type="button" @click="open = !open" class="text-sm font-semibold text-amber-800 dark:text-amber-400 hover:underline shrink-0 flex items-center gap-1">
                <span x-text="open ? '{{ __('Hide Details') }}' : '{{ __('Show Details') }}'"></span>
                <svg x-show="open" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
                <svg x-show="!open" x-cloak class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>

        <div x-show="open" x-cloak class="mt-4 pt-4 border-t border-amber-200/50 dark:border-amber-900/50 space-y-3 text-sm text-amber-900 dark:text-amber-300">
            {% if missing_required_php %}
            <div>
                <span class="font-semibold text-red-600 dark:text-red-400">⚠️ {{ __('Required PHP Version:') }}</span> {{ __('Running PHP') }} {{ constant('PHP_VERSION') }} {{ __('but requires') }} {{ missing_required_php }}+
            </div>
            {% endif %}

            {% if missing_required_exts|length > 0 %}
            <div>
                <span class="font-semibold text-red-600 dark:text-red-400">⚠️ {{ __('Missing Required Extensions:') }}</span>
                <ul class="list-disc pl-5 mt-1 ml-6 space-y-1">
                    {% for ext, desc in missing_required_exts %}
                    <li><strong>{{ ext }}</strong>: {{ desc }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if missing_recommended_exts|length > 0 %}
            <div>
                <span class="font-semibold text-amber-700 dark:text-amber-500">ℹ️ {{ __('Missing Recommended Extensions (Some features may not work as expected):') }}</span>
                <ul class="list-disc pl-5 mt-1 ml-6 space-y-1">
                    {% for ext, desc in missing_recommended_exts %}
                    <li><strong>{{ ext }}</strong>: {{ desc }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── Maintenance Sub-tabs ── #}
    <div class="mb-6 border-b border-gray-200 dark:border-gray-700">
        <nav class="-mb-px flex gap-4 overflow-x-auto" id="maintenance-subtabs">
            <button type="button" data-subtab="updates" class="maintenance-tab-btn shrink-0 border-b-2 border-blue-600 pb-2 text-sm font-medium text-blue-600 dark:border-blue-400 dark:text-blue-400 transition-colors duration-150 md:hover:bg-blue-50 md:hover:text-blue-700 dark:md:hover:bg-blue-900/20 dark:md:hover:text-blue-300">{{ __('Updates & Backups') }}</button>
            <button type="button" data-subtab="cron" class="maintenance-tab-btn shrink-0 border-b-2 border-transparent pb-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">{{ __('Scheduled Tasks') }}</button>
            <button type="button" data-subtab="caching" class="maintenance-tab-btn shrink-0 border-b-2 border-transparent pb-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">{{ __('Cache') }}</button>
            <button type="button" data-subtab="data" class="maintenance-tab-btn shrink-0 border-b-2 border-transparent pb-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">{{ __('Data') }}</button>
            <button type="button" data-subtab="cleanup" class="maintenance-tab-btn shrink-0 border-b-2 border-transparent pb-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">{{ __('Cleanup') }}</button>
        </nav>
    </div>

    {{ include('admin/settings/_maintenance_updates.twig') }}
    {{ include('admin/settings/_maintenance_cron.twig') }}
    {{ include('admin/settings/_maintenance_cache.twig') }}
    {{ include('admin/settings/_maintenance_data.twig') }}
    {{ include('admin/settings/_maintenance_cleanup.twig') }}

</div>{# /tab-maintenance #}
