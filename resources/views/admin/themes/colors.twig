{% extends "admin/layout.twig" %}

{% block title %}{{ __('Theme Colors') }} — {{ theme_meta.name ?? theme_slug }}{% endblock %}

{% block content %}
<div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-2">
        <a href="{{ url('/admin/themes') }}" class="hover:text-gray-900 dark:hover:text-gray-100">{{ __('Themes') }}</a>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span>{{ theme_meta.name ?? theme_slug }}</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span>{{ __('Colors') }}</span>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
        {{ __('Theme Colors') }}: <span class="font-extrabold">{{ theme_meta.name ?? theme_slug }}</span>
    </h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        {{ __('Customize theme CSS color variables. Changes apply dynamically across frontend pages.') }}
    </p>
</div>

<div x-data="{
    colors: {
        {% for varName, val in current_colors %}
        '{{ varName }}': '{{ val }}',
        {% endfor %}
    },
    defaults: {
        {% for varName, spec in schema %}
        '{{ varName }}': '{{ spec.default }}',
        {% endfor %}
    },
    hexSafe(v) {
        return /^#[0-9a-fA-F]{6}$/.test(v || '') ? v : '#000000';
    }
}" class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    {# Form Column #}
    <div class="lg:col-span-2 space-y-6">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-900 space-y-6">
            <form method="post" action="{{ url('/admin/themes/' ~ theme_slug ~ '/colors') }}" class="space-y-6">
                {{ csrf_field() }}

                <div class="border-b border-gray-200 pb-4 dark:border-gray-800 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ __('Color Variables') }}</h2>
                    {% if has_custom %}
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        {{ __('Custom Colors Active') }}
                    </span>
                    {% endif %}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {% for varName, spec in schema %}
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                            {{ spec.label ?? varName }}
                            <span class="text-xs font-mono text-gray-400 dark:text-gray-500 ml-1">({{ varName }})</span>
                        </label>

                        <div class="flex items-center gap-3">
                            <div class="relative h-10 w-12 shrink-0 rounded-lg border border-gray-300 dark:border-gray-700 overflow-hidden shadow-xs cursor-pointer">
                                <input type="color"
                                       :value="hexSafe(colors['{{ varName }}'])"
                                       @input="colors['{{ varName }}'] = $event.target.value"
                                       class="absolute -inset-2 h-14 w-16 cursor-pointer border-0 p-0">
                            </div>

                            <input type="text"
                                   name="colors[{{ varName }}]"
                                   x-model="colors['{{ varName }}']"
                                   class="flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-mono text-gray-900 shadow-xs focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100"
                                   placeholder="{{ spec.default }}"
                                   pattern="^#[0-9a-fA-F]{3,8}$|^((rgba?|hsla?)\([0-9a-zA-Z #%.,\/\(\)\-]+\))$|^((linear|radial)-gradient\([0-9a-zA-Z #%.,\/\(\)\-]+\))$">

                            <button type="button"
                                    @click="colors['{{ varName }}'] = defaults['{{ varName }}']"
                                    class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                                    title="{{ __('Reset to default') }}">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="flex flex-wrap items-center justify-end gap-4 pt-4 border-t border-gray-200 dark:border-gray-800">
                    {% if has_custom %}
                    <button type="submit" form="vl-colors-reset"
                            class="inline-flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-medium text-red-600 hover:bg-red-100 dark:border-red-900/30 dark:bg-red-900/20 dark:text-red-400 dark:hover:bg-red-900/30 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        {{ __('Reset to Default Colors') }}
                    </button>
                    {% endif %}
                    <button type="submit"
                            class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600 shadow-xs transition-colors">
                        {{ __('Save Colors') }}
                    </button>
                </div>
            </form>

            {% if has_custom %}
            <form id="vl-colors-reset" method="post" action="{{ url('/admin/themes/' ~ theme_slug ~ '/colors/reset') }}" class="hidden"
                  onsubmit="return confirm('{{ __('Are you sure you want to reset color customizations to defaults?') }}')">
                {{ csrf_field() }}
            </form>
            {% endif %}
        </div>
    </div>

    {# Live Preview Column #}
    <div class="space-y-6">
        <div class="sticky top-6 rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-900">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
                {{ __('Live Preview') }}
            </h3>

            <div class="rounded-lg border border-gray-100 dark:border-gray-800 p-4 space-y-4 transition-colors"
                 x-data="{ primaryHover: false, secondaryHover: false }"
                 :style="Object.entries(colors).map(([k,v]) => k + ':' + v).join(';') + '; background-color: ' + (colors['--theme-bg'] || 'inherit') + '; color: ' + (colors['--theme-text'] || 'inherit')">

                {# Header / Navbar Mock #}
                {% if schema['--theme-header-bg'] is defined %}
                <div class="rounded-lg p-3 flex items-center justify-between shadow-xs transition-colors border border-gray-200 dark:border-gray-800"
                     :style="{ backgroundColor: colors['--theme-header-bg'] || '#ffffff', color: colors['--theme-text'] || '#111827', borderColor: colors['--theme-border'] || '#e5e7eb' }">
                    <span class="font-bold text-sm">{{ theme_meta.name ?? theme_slug }}</span>
                    <span class="text-xs" :style="{ color: colors['--theme-text-muted'] || '#6b7280' }">{{ __('Navigation') }}</span>
                </div>
                {% else %}
                <div class="rounded-lg p-3 flex items-center justify-between shadow-xs transition-colors"
                     :style="{ backgroundColor: colors['--theme-primary'] || '#111827', color: '#ffffff' }">
                    <span class="font-bold text-sm">{{ theme_meta.name ?? theme_slug }}</span>
                    <span class="text-xs opacity-80">{{ __('Navigation') }}</span>
                </div>
                {% endif %}

                {# Hero Banner Mock if theme-hero-bg is defined #}
                {% if schema['--theme-hero-bg'] is defined %}
                <div class="space-y-1">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Hero / Banner Area') }}</p>
                    <div class="rounded-lg p-4 text-center shadow-xs transition-all"
                         :style="{ background: colors['--theme-hero-bg'] || colors['--theme-primary'] || '#111827', color: '#ffffff' }">
                        <span class="font-bold text-xs block">{{ __('Hero Banner Title') }}</span>
                        <span class="text-[10px] opacity-80">{{ __('Customizable hero gradient background') }}</span>
                    </div>
                </div>
                {% endif %}

                {# Navigation Bar Mock if theme-nav-bg is defined #}
                {% if schema['--theme-nav-bg'] is defined %}
                <div class="space-y-1">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Navigation Bar') }}</p>
                    <div class="rounded-lg p-2.5 flex items-center gap-4 shadow-xs transition-colors"
                         :style="{ backgroundColor: colors['--theme-nav-bg'] || '#047857' }">
                        <span class="text-[10px] font-medium" style="color: rgba(255,255,255,.92)">{{ __('Home') }}</span>
                        <span class="text-[10px]" style="color: rgba(255,255,255,.92)">{{ __('Blog') }}</span>
                        <span class="text-[10px]" style="color: rgba(255,255,255,.92)">{{ __('Shop') }}</span>
                    </div>
                </div>
                {% endif %}

                {# Buttons Preview #}
                <div class="space-y-2">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Primary Button') }} <span class="text-[10px] text-gray-400">({{ __('Hover to test') }})</span></p>
                    <button type="button"
                            @mouseenter="primaryHover = true"
                            @mouseleave="primaryHover = false"
                            class="w-full rounded-lg px-4 py-2.5 text-sm font-medium text-white shadow-xs transition-all duration-200"
                            :style="{ backgroundColor: primaryHover ? (colors['--theme-primary-hover'] || colors['--theme-primary'] || '#374151') : (colors['--theme-primary'] || '#111827') }">
                        {{ __('Action Button') }}
                    </button>
                </div>

                {# Secondary Button Preview #}
                {% if schema['--theme-secondary'] is defined %}
                <div class="space-y-2">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Secondary Element') }} <span class="text-[10px] text-gray-400">({{ __('Hover to test') }})</span></p>
                    <button type="button"
                            @mouseenter="secondaryHover = true"
                            @mouseleave="secondaryHover = false"
                            class="w-full rounded-lg px-4 py-2 text-sm font-medium transition-all duration-200"
                            :style="{
                                backgroundColor: secondaryHover ? (colors['--theme-secondary-hover'] || colors['--theme-secondary'] || '#e5e7eb') : (colors['--theme-secondary'] || '#f3f4f6'),
                                color: colors['--theme-text'] || 'inherit'
                            }">
                        {{ __('Secondary Button') }}
                    </button>
                </div>
                {% endif %}

                {# Cyan / Accent Preview if available #}
                {% if schema['--theme-cyan'] is defined %}
                <div class="space-y-2">
                    <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Accent Element') }}</p>
                    <div class="rounded-lg p-3 text-center text-xs font-bold"
                         :style="{ backgroundColor: colors['--theme-cyan'] || '#22d3ee', color: '#0f172a' }">
                        {{ __('Accent Tag') }}
                    </div>
                </div>
                {% endif %}

                {# Card Mock #}
                <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-3 shadow-xs space-y-2"
                     :style="{ backgroundColor: colors['--theme-surface'] || '#ffffff', color: colors['--theme-text'] || 'inherit' }">
                    <p class="text-xs font-bold">{{ __('Card Heading') }}</p>
                    <p class="text-xs opacity-75">{{ __('Sample content rendering with updated theme variables.') }}</p>
                </div>

                {# Footer Mock #}
                {% if schema['--theme-footer-bg'] is defined %}
                <div class="rounded-lg p-3 text-center shadow-xs transition-colors border border-gray-200 dark:border-gray-800"
                     :style="{ backgroundColor: colors['--theme-footer-bg'] || '#ffffff', color: colors['--theme-text-muted'] || '#6b7280', borderColor: colors['--theme-border'] || '#e5e7eb' }">
                    <span class="text-[10px]">&copy; {{ "now"|date("Y") }} {{ theme_meta.name ?? theme_slug }}</span>
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}
