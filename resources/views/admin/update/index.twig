{% extends "admin/layout.twig" %}

{% block title %}{{ __('Updates & Backups') }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Vale Updates and Backups') }}</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ __('Manage software updates and backups for your installation.') }}</p>
    </div>
</div>

{# Both tab panels live in the DOM; switching is client-side (no page load).
   ?tab=backups (or the /admin/update/backups route) opens the Backups tab. #}
<div x-data="{
        tab: '{{ active_tab|default('updates') }}',
        setTab(name) {
            this.tab = name;
            window.history.replaceState({}, '', name === 'backups'
                ? '{{ url('/admin/update?tab=backups') }}'
                : '{{ url('/admin/update') }}');
        }
     }">

    {# Tab bar — same treatment the Settings page tabs use for their selected tab:
       blue label + blue underline (light: blue-600, dark: blue-400), inactive gray,
       hover lightens the label. #}
    <div class="mb-6 border-b border-gray-200 dark:border-gray-700">
        <nav class="-mb-px flex gap-4 overflow-x-auto">
            <button type="button" @click="setTab('updates')"
                    :class="tab === 'updates'
                        ? 'border-blue-600 text-blue-600 dark:border-blue-400 dark:text-blue-400'
                        : 'border-transparent text-gray-500 dark:text-gray-400'"
                    class="border-b-2 pb-2 text-sm font-medium hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
                {{ __('Updates') }}
            </button>
            <button type="button" @click="setTab('backups')"
                    :class="tab === 'backups'
                        ? 'border-blue-600 text-blue-600 dark:border-blue-400 dark:text-blue-400'
                        : 'border-transparent text-gray-500 dark:text-gray-400'"
                    class="border-b-2 pb-2 text-sm font-medium hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
                {{ __('Backups') }}
            </button>
        </nav>
    </div>

    <div x-show="tab === 'updates'" x-cloak>
        {% include 'admin/update/_updates.twig' %}
    </div>

    <div x-show="tab === 'backups'" x-cloak>
        {% include 'admin/update/_backups.twig' %}
    </div>
</div>
{% endblock %}
