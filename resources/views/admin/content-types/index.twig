{% extends "admin/layout.twig" %}

{% block title %}{{ __('Content Types') }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Content Types') }}</h1>
    <a href="{{ url('/admin/content-types/new') }}" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
        + {{ __('New Content Type') }}
    </a>
</div>

<div class="overflow-x-auto rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-left text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800/50 text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">
            <tr>
                <th class="px-6 py-3">{{ __('Name') }}</th>
                <th class="px-6 py-3">{{ __('Slug') }}</th>
                <th class="px-6 py-3">{{ __('Description') }}</th>
                <th class="px-6 py-3 text-right">{{ __('Actions') }}</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            {% for ct in contentTypes %}
            <tr class="hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800/50 transition-colors">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-100">
                    <div class="flex items-center gap-2">
                        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ resolveIcon(ct.icon) }}"/>
                        </svg>
                        <a href="{{ url('/admin/content-types/' ~ ct.id ~ '/edit') }}" class="text-gray-900 dark:text-gray-100 hover:underline">{{ ct.name }}</a>
                        {% if ct.isSystem %}
                            <span class="ml-2 rounded-sm bg-blue-100 px-1.5 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">SYSTEM</span>
                        {% elseif not ct.isActive %}
                            <span class="ml-2 rounded-sm bg-gray-200 px-1.5 py-0.5 text-[10px] font-bold text-gray-600 dark:bg-gray-700 dark:text-gray-400">INACTIVE</span>
                        {% endif %}
                    </div>
                </td>
                <td class="px-6 py-4 text-gray-500 dark:text-gray-400">{{ ct.slug }}</td>
                <td class="px-6 py-4 text-gray-500 dark:text-gray-400 text-xs">{{ ct.description }}</td>
                <td class="px-6 py-4 text-right">
                    <div class="inline-flex items-center justify-end gap-2">
                        <a href="{{ url('/admin/content-types/' ~ ct.id ~ '/edit') }}"
                           class="rounded-sm px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-gray-300 dark:ring-gray-700 hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800">
                            {{ __('Edit') }}
                        </a>
                        {% if not ct.isSystem %}
                        <form method="POST" action="{{ url('/admin/content-types/' ~ ct.id ~ '/toggle-active') }}">
                            {{ csrf_field() }}
                            <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium ring-1 {{ ct.isActive ? 'text-yellow-700 dark:text-yellow-400 ring-yellow-300 dark:ring-yellow-700 hover:bg-yellow-50 dark:hover:bg-yellow-950/40' : 'text-green-700 dark:text-green-400 ring-green-300 dark:ring-green-700 hover:bg-green-50 dark:hover:bg-green-950/40' }}">
                                {{ ct.isActive ? __('Disable') : __('Enable') }}
                            </button>
                        </form>
                        <form method="POST" action="{{ url('/admin/content-types/' ~ ct.id ~ '/clone') }}" onsubmit="return confirm('{{ __('Clone this content type?')|e('js') }}')">
                            {{ csrf_field() }}
                            <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-blue-600 dark:text-blue-400 ring-1 ring-blue-300 dark:ring-blue-700 hover:bg-blue-50 dark:hover:bg-blue-900/40">{{ __('Clone') }}</button>
                        </form>
                        <form method="POST" action="{{ url('/admin/content-types/' ~ ct.id) }}" onsubmit="return confirm('{{ __('Are you sure you want to delete this content type?')|e('js') }}')">
                            {{ csrf_field() }}
                            <input type="hidden" name="_METHOD" value="DELETE">
                            <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">{{ __('Delete') }}</button>
                        </form>
                        {% endif %}
                        {% if ct.slug == 'post' %}
                            {% set create_url = url('/admin/posts/create') %}
                        {% elseif ct.slug == 'page' %}
                            {% set create_url = url('/admin/pages/create') %}
                        {% else %}
                            {% set create_url = url('/admin/posts/create', [], {content_type: ct.slug.value}) %}
                        {% endif %}
                        <a href="{{ create_url }}" class="rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-800 flex items-center gap-1">
                            <span class="text-sm">+</span> {{ __('New Content') }}
                        </a>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}