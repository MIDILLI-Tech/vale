{% extends "admin/layout.twig" %}

{% set panel_rail = true %}

{% block title %}{{ is_edit ? __('Edit') ~ ' ' ~ (type.name|default(__('Post'))) : __('Create') ~ ' ' ~ (type.name|default(__('Post'))) }}{% endblock %}

{% block content %}
{% set listUrl = (type and type.slug.value != 'post') ? url('/admin/posts?content_type=' ~ type.slug.value) : url('/admin/posts') %}
{% set listLabel = (type and type.slug.value != 'post') ? type.name : __('Posts') %}
<div class="mb-6 flex items-center gap-3 flex-wrap">
    <a href="{{ listUrl }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700">← {{ listLabel }}</a>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ is_edit ? __('Edit') ~ ' ' ~ (type.name|default(__('Post'))) : __('Create') ~ ' ' ~ (type.name|default(__('Post'))) }}</h1>
    {% if is_edit %}<span data-clean-badge class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">✓ {{ __('Saved') }}</span>{% endif %}
    <span data-dirty-badge class="hidden px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">● {{ __('Unsaved changes') }}</span>
    {% include 'admin/components/rail-toggle.twig' %}
</div>

<form method="post"
      action="{{ url(is_edit ? '/admin/posts/' ~ post.id : '/admin/posts') }}"
      data-autosave
      data-panel-reorder-key="{{ (type and type.slug ? 'cpt_' ~ (type.slug.value|default(type.slug)) : 'post') }}"
      class="space-y-6">
    {{ csrf_field() }}
    {% if is_edit %}<input type="hidden" name="_METHOD" value="PUT">{% endif %}
    {% if is_edit and post %}<input type="hidden" name="id" value="{{ post.id }}">{% endif %}
    <input type="hidden" name="content_type" value="{{ type.slug.value|default('post') }}">

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {# Main column #}
        <div class="lg:col-span-2 space-y-6" data-panel-container="left">
            {# Title #}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="title_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ (type.name|default(__('Post'))) ~ ' ' ~ __('Title') }}</h3>
                <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Title') }} <span class="text-red-500">*</span></label>
                <input type="text" id="title" name="title"
                       value="{{ old.title|default(post ? post.title : '') }}"
                       class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm"
                       required>
                {% if errors.title is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.title|join(', ') }}</p>{% endif %}
            </div>

            {# Body #}
            {% if 'editor' in (type.supports|default(['editor'])) %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="content_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('Content') }}</h3>
                <label for="body" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ __('Content Body') }}</label>
                {% if type and type.fieldSchema and type.fieldSchema|length > 0 %}
                <div x-data="{ showCustomFields: false }" class="mb-2">
                    <button type="button" @click="showCustomFields = !showCustomFields"
                            class="flex items-center gap-1 text-xs text-slate-600 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 font-medium select-none">
                        <svg x-bind:class="showCustomFields ? 'rotate-90' : ''" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        {{ __('Custom Field Shortcodes') }}
                    </button>
                    <div x-show="showCustomFields" x-cloak class="mt-1 rounded-lg bg-slate-100 dark:bg-slate-800/60 p-3 text-xs text-slate-700 dark:text-slate-200 space-y-1">
                        <p class="text-slate-500 dark:text-slate-400 italic mb-1">{{ __('Click any tag to insert it at cursor position.') }}</p>
                        <div class="flex flex-wrap gap-2">
                            {% for field in type.fieldSchema %}
                            <code data-tag="{{ '{{' ~ field.name ~ '}}' }}" @click.stop="lpInsertVar($el.dataset.tag)" title="{{ __('Click to insert') }}"
                                  class="bg-slate-200 dark:bg-slate-700 dark:text-slate-100 px-1.5 py-0.5 rounded-sm cursor-pointer hover:bg-slate-300 dark:hover:bg-slate-600">
                                {{ '{{' ~ field.name ~ '}}' }}
                            </code>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                <textarea id="body" name="body" rows="18" data-editor
                          data-show-reading-time="{{ show_reading_time_on_posts|default('0') }}"
                          data-reading-time-wpm="{{ reading_time_wpm|default(200) }}"
                          class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">{{ old.body|default(post ? post.body : '') }}</textarea>
            </div>
            {% endif %}

            {# Custom Fields #}
            {% if type and type.fieldSchema %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs space-y-4" data-panel-id="custom_fields_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 border-b dark:border-gray-800 pb-2">{{ __('Additional Information') }}</h3>
                <div class="flex flex-wrap -mx-2 gap-y-4">
                    {% for field in type.fieldSchema %}
                        {% set width = field.width|default('100') %}
                        {% set colClass = width == '50' ? 'w-full sm:w-1/2' : (width == '33' ? 'w-full sm:w-1/3' : (width == '25' ? 'w-full sm:w-1/4' : 'w-full')) %}
                        <div class="{{ colClass }} px-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ field.label }}</label>
                            {% if field.type == 'textarea' %}
                                <textarea name="meta[{{ field.name }}]" rows="3" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">{{ post ? post.getMetaValue(field.name) : (old.meta[field.name]|default('')) }}</textarea>
                            {% elseif field.type == 'select' %}
                                <select name="meta[{{ field.name }}]" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                    <option value="">— {{ __('Select') }} —</option>
                                    {% for opt in field.options %}
                                        <option value="{{ opt }}" {{ (post ? post.getMetaValue(field.name) : (old.meta[field.name]|default(''))) == opt ? 'selected' }}>{{ opt }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif field.type == 'checkbox' %}
                                <label class="flex items-center gap-2 mt-2">
                                    <input type="checkbox" name="meta[{{ field.name }}]" value="1" {{ (post ? post.getMetaValue(field.name) : (old.meta[field.name]|default(''))) ? 'checked' }} class="rounded-sm border-gray-300 dark:border-gray-700">
                                    <span class="text-sm text-gray-600 dark:text-gray-300">{{ field.label }}</span>
                                </label>
                            {% elseif field.type == 'image' %}
                                <div x-data="featuredImage({{ post ? post.getMetaValue(field.name) : (old.meta[field.name]|default('0')) }})">
                                    <input type="hidden" name="meta[{{ field.name }}]" :value="imageId">
                                    <div x-show="imageId > 0" class="mb-2">
                                        <img :src="thumbnailUrl" class="h-24 w-24 rounded-lg border object-cover cursor-pointer hover:opacity-90 transition-opacity" @click="openBrowser()" title="{{ __('Click to change image') }}">
                                        <div class="mt-1 flex items-center gap-2">
                                            <button type="button" @click="openBrowser()" class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 shadow-2xs transition-colors">{{ __('Change') }}</button>
                                            <button type="button" @click="removeImage()" class="rounded-md border border-red-200 dark:border-red-900/50 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 px-2 py-0.5 text-xs font-medium transition-colors">&times; {{ __('Remove') }}</button>
                                        </div>
                                    </div>
                                    <button type="button" @click="openBrowser()" x-show="imageId == 0"
                                            class="rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-700 px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-400 hover:border-gray-500 hover:text-gray-900 dark:text-gray-100 transition-colors w-full">
                                        📷 {{ __('Choose Image') }}
                                    </button>
                                    {% include 'admin/components/media-browser-modal.twig' %}
                                </div>
                            {% else %}
                                <input type="{{ field.type == 'number' ? 'number' : (field.type == 'date' ? 'date' : 'text') }}"
                                       name="meta[{{ field.name }}]"
                                       value="{{ post ? post.getMetaValue(field.name) : (old.meta[field.name]|default('')) }}"
                                       class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Excerpt #}
            {% if 'excerpt' in (type.supports|default(['excerpt'])) %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="excerpt_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('Excerpt') }}</h3>
                <label for="excerpt" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Summary / Excerpt') }}</label>
                <textarea id="excerpt" name="excerpt" rows="3"
                          class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">{{ old.excerpt|default(post ? post.excerpt : '') }}</textarea>
            </div>
            {% endif %}
        </div>

        {# Sidebar #}
        <div class="space-y-6" data-panel-container="right">
            {# Language #}
            {% if multi_language_content and 'i18n' in (type.supports|default([])) %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="language_card">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200">{{ __('Language') }}</h3>
                    <span class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                        {{ current_locale }}
                    </span>
                </div>

                <div class="mb-3">
                    <label for="language" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Content Language') }}</label>
                    <select id="language" name="language" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm focus:ring-gray-500 focus:border-gray-500">
                        {% for code, name in supported_locales %}
                            <option value="{{ code }}" {{ (old.language|default(post ? post.language : current_locale)) == code ? 'selected' }}>{{ locale_name(code) }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-4">
                    <label for="translation_of" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Translation Of') }}</label>
                    <div class="flex gap-2">
                        {% include 'admin/components/translation-select.twig' with {
                            originals: potential_originals,
                            label_field: 'title',
                            value: old.translation_of|default(post ? post.translationOf : (prefill_translation_of|default('')))
                        } %}
                        <button type="button" id="copy-original-btn"
                                class="mt-1 inline-flex w-9 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-500 hover:bg-gray-50 hover:text-gray-700 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                title="{{ __('Copy content from original') }}">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </button>
                    </div>
                </div>

                {% if translations is defined and supported_locales|length > 1 %}
                <div class="pt-3 border-t border-gray-200 mt-3">
                    <p class="text-xs font-medium text-gray-500 mb-2">{{ __('Translations') }}</p>
                    <div class="space-y-1.5">
                        {% for code, name in supported_locales %}
                            {% set trans = null %}
                            {% for t in translations %}
                                {% if t.language == code %}{% set trans = t %}{% endif %}
                            {% endfor %}

                            <div class="flex items-center justify-between rounded-md bg-gray-50 dark:bg-gray-800/50 px-3 py-1.5 text-sm">
                                <span class="flex items-center gap-2 min-w-0">
                                    <span class="text-xs font-medium uppercase text-gray-500 w-8 shrink-0">{{ code }}</span>
                                    <span class="{{ trans ? 'text-gray-900 dark:text-gray-100' : 'text-gray-400 italic' }} text-xs shrink-0">{{ locale_name(code) }}</span>
                                    {% if trans %}
                                        <span class="text-xs text-gray-400 shrink-0">—</span>
                                        <a href="{{ url('/admin/posts/' ~ trans.id ~ '/edit') }}" title="{{ trans.title|e('html') }}" class="text-gray-900 dark:text-gray-100 hover:underline text-xs truncate">{{ trans.title }}</a>
                                    {% endif %}
                                </span>
                                <span class="shrink-0">
                                    {% set form_lang = old.language|default(post ? post.language : current_locale) %}
                                    {% if trans %}
                                        {% if trans.id == (post.id|default(0)) %}
                                            <span class="text-xs font-medium text-green-600">{{ __('Current') }}</span>
                                        {% else %}
                                            <a href="{{ url('/admin/posts/' ~ trans.id ~ '/edit') }}" class="text-blue-600 hover:underline text-xs">{{ __('Edit') }}</a>
                                        {% endif %}
                                    {% else %}
                                        {% if not is_edit and code == form_lang %}
                                            <span class="text-xs font-medium text-green-600">{{ __('Current') }}</span>
                                        {% else %}
                                            <a href="{{ url('/admin/posts/create', [], {content_type: type.slug.value, language: code, translation_of: original_id|default(post.id|default(''))}) }}" class="text-xs text-blue-600 hover:underline">
                                                + {{ __('Add') }}
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {# Publish box #}
            {% set _db_status = post ? post.status : 'draft' %}
            {% set _shown_status = _db_status == 'scheduled' ? 'draft' : _db_status %}
            {% set _st = old.status|default(_shown_status) %}
            {% set _has_schedule = post and (post.status == 'scheduled' or (post.publishedAt and post.publishedAt|date('U') > 'now'|date('U')) or post.expiresAt or post.swapPostId) %}
            {% set _sched = old.set_schedule|default(_has_schedule ? '1' : '') %}
            <div class="rounded-xl border bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="publish_card" x-data="{ status: '{{ _st }}', scheduling: {{ _sched ? 'true' : 'false' }} }">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Publish') }}</h3>

                <div class="mb-3">
                    <label for="status" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Status') }}</label>
                    <select id="status" name="status" x-model="status" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                        {% set _sa = user.role is defined and user.role == 'super_admin' %}
                        {% set _can_publish = _sa or (user_permissions is defined and 'posts.publish' in user_permissions) %}
                        {% for s in ['draft', 'published', 'unlisted', 'archived'] %}
                        {% if s == 'draft' or _can_publish or (post and post.status == s) %}
                        <option value="{{ s }}" {{ _st == s ? 'selected' }}>{{ __(s)|capitalize }}</option>
                        {% endif %}
                        {% endfor %}
                        {% if post and (old.status|default(post.status)) == 'expired' %}
                        <option value="expired" selected>{{ __('Expired') }}</option>
                        {% endif %}
                    </select>
                    <p x-show="status === 'unlisted'" x-cloak class="mt-1 text-xs text-purple-600 dark:text-purple-400">&#128274; {{ __('Accessible via direct URL but hidden from all listings.') }}</p>
                    <label class="mt-2 flex cursor-pointer items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                        <input type="checkbox" name="set_schedule" value="1" x-model="scheduling" class="rounded-sm border-gray-300 dark:border-gray-700">
                        {{ __('Set schedule') }}
                    </label>
                    <div x-show="scheduling" x-cloak class="mt-3 space-y-3">
                        {% if cron_mode|default('none') == 'none' %}
                        <p class="text-xs text-amber-600 dark:text-amber-400">&#9888; {{ __('Cron is disabled — scheduled publishing will not run automatically.') }} <a href="{{ url('/admin/settings', {}, {tab: 'maintenance', subtab: 'cron'}) }}" class="underline">{{ __('Enable it in Settings → Scheduled Tasks') }}</a></p>
                        {% endif %}
                        <div x-show="status !== 'published'">
                            <label for="published_at" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1 cursor-pointer">{{ __('Publish date & time') }}</label>
                            <input type="datetime-local" name="published_at" id="published_at"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm cursor-pointer"
                                   value="{{ old.published_at ?? (post and post.publishedAt ? post.publishedAt|date('Y-m-d\\TH:i') : '') }}">
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Optional. A draft goes live here, or an unlisted item becomes public, at this time.') }}</p>
                            {% if errors.published_at is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.published_at|join(', ') }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="expires_at" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Expiry date & time') }}</label>
                            <input type="datetime-local" name="expires_at" id="expires_at"
                                   class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                   value="{{ old.expires_at ?? (post and post.expiresAt ? post.expiresAt|date('Y-m-d\\TH:i') : '') }}">
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Optional. A published or unlisted item returns to expired at this time.') }}</p>
                            {% if errors.expires_at is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.expires_at|join(', ') }}</p>{% endif %}
                        </div>
                        {% if type.slug|default('post') == 'page' or 'scheduled_swap' in (type.supports|default([])) %}
                        {% set _swap = old.swap_post_id|default(post ? post.swapPostId : '') %}
                        <div x-data="{ doSwap: {{ _swap ? 'true' : 'false' }} }">
                            <label class="flex items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                                <input type="checkbox" x-model="doSwap" class="rounded-sm border-gray-300 dark:border-gray-700">
                                {{ __('Replace a live page on schedule') }}
                            </label>
                    <template x-if="doSwap">
                        <div class="mt-2">
                            <span class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">{{ __('Replaces') }}</span>
                            <div class="flex gap-2">
                                <div class="grow min-w-0">
                            {% include 'admin/components/page-async-select.twig' with {
                                name: 'swap_post_id',
                                initial_value: _swap,
                                content_type: type.slug|default('post'),
                                exclude_id: post ? post.id : '',
                                placeholder: __('Search…'),
                                empty_label: __('— None —')
                            } %}
                                </div>
                                <button type="button" id="copy-swap-btn"
                                        class="inline-flex w-9 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-500 hover:bg-gray-50 hover:text-gray-700 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                        title="{{ __('Copy content from replaced page') }}"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></button>
                            </div>
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('At go-live this item takes over the selected item’s URL.') }}</p>
                            {% if errors.swap_post_id is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.swap_post_id|join(', ') }}</p>{% endif %}
                        </div>
                    </template>
                </div>
                {% endif %}
                    </div>
                </div>

                <div class="mb-3">
                     <label for="comment_status" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Comments') }}</label>
                     <select id="comment_status" name="comment_status" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm">
                         {% set cs = old.comment_status|default(post ? post.commentStatus : 'use_global') %}
                         <option value="use_global" {{ cs == 'use_global' ? 'selected' }}>{{ __('Use global') }}</option>
                         <option value="open" {{ cs in ['open', 'enabled'] ? 'selected' }}>{{ __('Open') }}</option>
                         <option value="closed" {{ cs in ['closed', 'disabled'] ? 'selected' }}>{{ __('Closed') }}</option>
                     </select>
                 </div>

                {% include 'admin/components/final-url-field.twig' with {
                    prefix: site_url ~ _prefix ~ '/',
                    slug: post.slug|default(''),
                    hint: __('The address this item will be live at. Share it before it goes live.')
                } %}

                <button type="submit"
                        class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800"
                        title="Shortcut: Ctrl/Cmd+S">
                    {{ is_edit ? __('Update') : __('Create') }}
                </button>
                {% if _can_publish is defined and _can_publish and _st != 'published' %}
                <button type="button" data-publish-action data-no-dirty
                        title="{{ __('Set status to published and save') }}"
                        class="mt-2 flex w-full items-center justify-center gap-1 rounded-lg border border-blue-400 dark:border-blue-600 px-4 py-2 text-sm font-medium text-blue-700 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors">
                    &#9889; {{ __('Publish') }}
                </button>
                {% endif %}
                <button type="button" id="vl-preview-btn" data-preview-action
                   title="Shortcut: Ctrl/Cmd+Shift+P"
                   class="mt-2 flex items-center justify-center gap-1 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50 dark:text-gray-300">
                    &#128065; {{ __('Preview') }}
                </button>
                {% if is_edit and post and post.status in ['published', 'unlisted'] %}
                {% set active_url = absolute_url(type.slug == 'page' ? url(routing_page_prefix ~ '/' ~ post.slug) : (type.slug == 'post' ? url(routing_blog_prefix ~ '/' ~ post.slug) : url('cpt.show.' ~ type.slug, {slug: post.slug}))) %}
                <a href="{{ active_url }}" target="_blank" data-show-active-version
                   title="Shortcut: Ctrl/Cmd+Shift+S"
                   class="mt-2 flex items-center justify-center gap-1 w-full rounded-lg border border-green-400 dark:border-green-600 px-4 py-2 text-sm text-green-700 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/30">
                    &#127760; {{ __('Show Active Version') }}
                </a>
                {% endif %}

                {% if is_edit and 'revisions' in (type.supports|default(['revisions'])) %}
                {% include 'admin/components/revision-modal.twig' with { revision_url_prefix: '/admin/posts/' } %}
                {% endif %}
            </div>

            {# Featured Image (Thumbnail) #}
            {% if 'thumbnail' in (type.supports|default(['thumbnail'])) %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="featured_image_card" x-data="featuredImage({{ post and post.featuredImageId ? post.featuredImageId : '0' }})">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Featured Image') }}</h3>
                <input type="hidden" name="featured_image_id" :value="imageId">
                <div x-show="imageId > 0" class="mb-3">
                    <img :src="thumbnailUrl" alt="Featured" class="w-full rounded-lg border bg-gray-100 dark:bg-gray-800 object-contain aspect-square cursor-pointer hover:opacity-90 transition-opacity" @click="openBrowser()" title="{{ __('Click to change image') }}">
                    <div class="mt-2 flex items-center justify-between gap-2">
                        <button type="button" @click="openBrowser()"
                                class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 shadow-2xs transition-colors">
                            {{ __('Change image') }}
                        </button>
                        <button type="button" @click="removeImage()"
                                class="rounded-md border border-red-200 dark:border-red-900/50 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 px-2.5 py-1 text-xs font-medium transition-colors">
                            ✕ {{ __('Remove image') }}
                        </button>
                    </div>
                </div>
                <button type="button" @click="openBrowser()" x-show="imageId == 0"
                        class="w-full rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-700 py-8 text-center text-sm text-gray-500 dark:text-gray-400 hover:border-gray-500 hover:text-gray-900 dark:text-gray-100 transition-colors">
                    📷 {{ __('Choose Image') }}
                </button>

                {% include 'admin/components/media-browser-modal.twig' %}
            </div>
            {% endif %}

            {# Access #}
            {% if membership_tags is defined and membership_tags is not empty %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="access_card">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Access') }}</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">{{ __('Require a membership tag to view full content.') }}</p>
                {% set selectedAccess = old.access_tags|default(post ? post.accessTags : []) %}
                {% for tag in membership_tags %}
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200 mb-1">
                    <input type="checkbox" name="access_tags[]" value="{{ tag }}"
                           {{ tag in selectedAccess ? 'checked' }}
                           class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900">
                    {{ tag }}
                </label>
                {% endfor %}
            </div>
            {% endif %}

            {# Categories #}
            {% if type and 'categories' in type.supports %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="categories_card">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Categories') }}</h3>
                {% set selectedCats = old.category_ids|default(post ? post.categoryIds : original_category_ids|default([])) %}
                {% for cat in categories %}
                    <label class="flex items-center gap-2 text-sm dark:text-gray-200" style="padding-left: {{ cat.depth * 16 }}px">
                        <input type="checkbox" name="category_ids[]" value="{{ cat.id }}"
                               {{ cat.id in selectedCats ? 'checked' }}
                               class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100">
                        {% if cat.depth > 0 %}<span class="text-gray-400 dark:text-gray-400 mr-1">└</span>{% endif %}
                        {{ cat.name }}
                    </label>
                {% else %}
                    <p class="text-xs text-gray-400">{{ __('No categories yet.') }}</p>
                {% endfor %}
            </div>
            {% endif %}

            {# Tags #}
            {% if type and 'tags' in type.supports %}
            <div class="rounded-xl border bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="tags_card">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Tags') }}</h3>
                <div x-data="tagInput({ allTags: {{ allTagNames|default([])|json_encode|e('html_attr') }}, initial: '{{ initialTagNames|default('')|e('js') }}' })">
                    <div class="flex flex-wrap gap-2 mb-2" x-show="items.length > 0" x-cloak>
                        <template x-for="(item, i) in items" :key="i">
                            <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 dark:bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-700">
                                <span x-text="item"></span>
                                <button type="button" @click="remove(item)" class="text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-400">&times;</button>
                            </span>
                        </template>
                    </div>
                    <div class="relative">
                        <input type="text" x-model="input" @input="onInput" @keydown="onKeydown" @blur="onBlur" @focus="onInput"
                               placeholder="{{ __('Type tag name...') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm focus:border-gray-600 focus:ring-gray-500">
                        <div x-show="showSuggestions && filteredSuggestions.length > 0" x-cloak
                             class="absolute z-10 mt-1 w-full rounded-lg border border-gray-200 bg-white dark:bg-gray-900 dark:border-gray-700 shadow-lg max-h-48 overflow-y-auto">
                            <template x-for="(s, i) in filteredSuggestions" :key="s">
                                <div @click="selectSuggestion(s)" @mouseenter="focusedIndex = i"
                                     :class="i === focusedIndex ? 'bg-gray-100 dark:bg-gray-800' : ''"
                                     class="cursor-pointer px-3 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800"
                                     x-text="s"></div>
                            </template>
                        </div>
                    </div>
                    <input type="hidden" name="tag_names" :value="items.join(',')">
                    <div class="mt-2 text-xs text-gray-400">{{ __('Type a tag name and press Enter or comma to add. Existing tags are suggested. New tags are created automatically.') }}</div>
                </div>
            </div>
            {% endif %}

            {# Slug #}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="slug_card">
                <div x-data="{ originalSlug: '{{ old.slug|default(post ? post.slug : '')|e('js') }}', slugChanged: false, autoRedirect: {{ auto_redirect_enabled ? 'true' : 'false' }}, isEdit: {{ is_edit ? 'true' : 'false' }} }">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Slug') }}</h3>
                    <input type="text" id="slug" name="slug"
                           value="{{ old.slug|default(post ? post.slug : '') }}"
                           @input="slugChanged = ($event.target.value !== originalSlug)"
                           class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm"
                           placeholder="{{ __('Auto-generated from title') }}">
                    <div x-show="isEdit && slugChanged" class="mt-2 space-y-2">
                        <div x-show="!autoRedirect"
                             class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200">
                            <span>⚠️</span>
                            <span>{{ __('SEO redirect setting is disabled. If you change this slug, old links may stop working.') }} <a href="{{ url('/admin/settings', {}, {tab: 'seo'}) }}" class="underline font-medium">{{ __('Open SEO settings') }}</a></span>
                        </div>
                        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                            <input type="hidden" name="create_redirect" value="0">
                            <input type="checkbox" name="create_redirect" value="1" checked
                                   class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 focus:ring-gray-500">
                            {{ __('Create a 301 redirect from the old URL to the new URL') }}
                        </label>
                    </div>
                </div>
                {% include 'admin/components/alias-chips.twig' with { alias_value: old.aliases|default(post_aliases|default([])|join(',')) } %}
                <div class="mt-2 text-xs text-gray-400">{{ __('Used to create a human and SEO-friendly address to access this content later.') }}</div>
            </div>

            {# SEO #}
            {% if 'seo' in type.supports|default([]) %}
            <div data-panel-id="seo_card">
                {% include 'admin/components/seo-panel.twig' with { seo: seo|default(null), hasRss: 'rss' in type.supports|default([]) } %}
            </div>
            {% endif %}
        </div>
    </div>
</form>

<script>
(function() {
    const copyBtn = document.getElementById('copy-original-btn');

    copyBtn?.addEventListener('click', async function() {
        const transOf = document.querySelector('input[name="translation_of"]');
        const id = transOf?.value;
        if (!id) return;

        if (!confirm('{{ __('Overwrite current content with original?')|e('js') }}')) return;

        const origHtml = this.innerHTML;
        this.innerHTML = '<svg class="h-3.5 w-3.5 animate-spin inline-block" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';
        this.disabled = true;

        try {
            const r = await fetch('{{ url('/admin/posts/')|e('js') }}' + id + '/json');
            const data = await r.json();

            document.getElementById('title').value = data.title;

            const ta = document.querySelector('textarea[data-editor]');
            if (ta) {
                if (!window.vlSetEditorContent || !window.vlSetEditorContent(ta.id, data.body)) {
                    ta.value = data.body || '';
                    if (window.vlSetEditorContentToggle) {
                        window.vlSetEditorContentToggle(ta.id, data.body);
                    }
                }
            } else {
                const bodyField = document.getElementById('body');
                if (bodyField) bodyField.value = data.body || '';
            }

            const excerptField = document.getElementById('excerpt');
            if (excerptField) excerptField.value = data.excerpt;

            this.innerHTML = '✓';
        } catch (e) {
            this.innerHTML = '✗';
            alert('Failed to copy content.');
        } finally {
            setTimeout(() => { this.innerHTML = origHtml; this.disabled = false; }, 1500);
        }
    });
})();

(function() {
    async function fillFromJson(btn, id) {
        const origHtml = btn.innerHTML;
        btn.innerHTML = '<svg class="h-3.5 w-3.5 animate-spin inline-block" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';
        btn.disabled = true;

        try {
            const r = await fetch('{{ url('/admin/posts/')|e('js') }}' + id + '/json');
            const data = await r.json();

            document.getElementById('title').value = data.title;

            const ta = document.querySelector('textarea[data-editor]');
            if (ta) {
                if (!window.vlSetEditorContent || !window.vlSetEditorContent(ta.id, data.body)) {
                    ta.value = data.body || '';
                    if (window.vlSetEditorContentToggle) {
                        window.vlSetEditorContentToggle(ta.id, data.body);
                    }
                }
            } else {
                const bodyField = document.getElementById('body');
                if (bodyField) bodyField.value = data.body || '';
            }

            const excerptField = document.getElementById('excerpt');
            if (excerptField) excerptField.value = data.excerpt;

            btn.innerHTML = '✓';
        } catch (e) {
            btn.innerHTML = '✗';
            alert('Failed to copy content.');
        } finally {
            setTimeout(() => { btn.innerHTML = origHtml; btn.disabled = false; }, 1500);
        }
    }

    // Copy content from the selected replacement target (same UX as copy-original).
    // Delegated: the button lives inside an x-if block and may render after load.
    document.addEventListener('click', async function(e) {
        const btn = e.target?.closest?.('#copy-swap-btn');
        if (!btn || btn.disabled) return;

        const swapOf = document.querySelector('input[name="swap_post_id"]');
        const id = swapOf?.value;
        if (!id) return;

        if (!confirm('{{ __('Overwrite current content with replaced page?')|e('js') }}')) return;

        await fillFromJson(btn, id);
    });
})();

document.getElementById('vl-preview-btn')?.addEventListener('click', function() {
    const form = this.closest('form');
    const origAction = form.action;
    const origTarget = form.target;
    const origMethod = form.querySelector('input[name="_METHOD"]');
    const origMethodVal = origMethod ? origMethod.value : null;

    form.action = '{{ url('/admin/posts/preview') }}';
    form.target = '_blank';
    if (origMethod) origMethod.value = 'POST';

    form.querySelectorAll('textarea[data-editor]').forEach(ta => {
        ta.dispatchEvent(new Event('input'));
    });

    form.submit();

    form.action = origAction;
    form.target = origTarget || '';
    if (origMethod) origMethod.value = origMethodVal;
});

document.addEventListener('alpine:init', function() {
    Alpine.data('revisionHistory', function (config) {
        return {
            show: false,
            loading: false,
            loaded: false,
            revisions: [],
            selected: null,
            restoreConfirm: null,
            deleteConfirm: null,
            count: 0,
            detailLoading: false,
            detailError: false,
            diffLoading: false,
            diffError: false,
            diffCache: {},
            activeDiff: null,

            open: function () {
                this.show = true;
                this.selected = null;
                this.restoreConfirm = null;
                this.deleteConfirm = null;
                this.diffCache = {};
                this.activeDiff = null;

                if (this.loaded) return;

                this.loading = true;
                var self = this;
                fetch(config.jsonUrl)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        self.revisions = data;
                        self.count = data.length;
                        self.loading = false;
                        self.loaded = true;
                    })
                    .catch(function () {
                        self.loading = false;
                    });
            },

            close: function () {
                this.show = false;
                this.selected = null;
                this.restoreConfirm = null;
                this.deleteConfirm = null;
                this.diffCache = {};
                this.activeDiff = null;
                this.detailLoading = false;
                this.detailError = false;
                this.diffLoading = false;
                this.diffError = false;
            },

            select: function (rev) {
                this.selected = rev;
                this.detailLoading = true;
                this.detailError = false;
                this.diffCache = {};
                this.activeDiff = null;

                var self = this;
                fetch(config.detailUrl.replace('__REV_ID__', rev.id))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        self.selected.body = data.body;
                        self.selected.bodyReadable = data.body_readable;
                        self.detailLoading = false;
                    })
                    .catch(function () {
                        self.detailError = true;
                        self.detailLoading = false;
                    });
            },

            showDiff: function (type) {
                if (!this.selected) return;

                if (this.diffCache[type]) {
                    this.activeDiff = type;
                    return;
                }

                this.diffLoading = true;
                this.diffError = false;
                this.activeDiff = null;

                var self = this;
                var url = config.diffUrl.replace('__REV_ID__', self.selected.id).replace('__TYPE__', type);
                fetch(url)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        self.diffCache[type] = data.diff;
                        self.activeDiff = type;
                        self.diffLoading = false;
                    })
                    .catch(function () {
                        self.diffError = true;
                        self.diffLoading = false;
                    });
            },

            confirmRestore: function (rev) {
                this.restoreConfirm = rev;
            },

            restore: function (rev) {
                this.restoreConfirm = rev;
            },

            doRestore: function () {
                if (!this.restoreConfirm) return;
                var rev = this.restoreConfirm;

                var form = document.createElement('form');
                form.method = 'POST';
                var action = config.restoreUrl.replace('__REV_ID__', rev.id);
                if (window.APP_BASE_PATH && window.APP_BASE_PATH !== '/' && action.startsWith('/') && !action.startsWith(window.APP_BASE_PATH + '/')) {
                    action = window.APP_BASE_PATH + action;
                }
                form.action = action;
                var csrf = document.createElement('input');
                csrf.type = 'hidden';
                csrf.name = '_csrf_token';
                csrf.value = config.csrfToken;
                form.appendChild(csrf);
                document.body.appendChild(form);
                form.submit();
            },

            confirmDelete: function (rev) {
                this.deleteConfirm = rev;
            },

            doDelete: function () {
                if (!this.deleteConfirm) return;
                var rev = this.deleteConfirm;
                var self = this;

                var form = document.createElement('form');
                form.method = 'POST';
                var action = config.deleteUrl.replace('__REV_ID__', rev.id);
                if (window.APP_BASE_PATH && window.APP_BASE_PATH !== '/' && action.startsWith('/') && !action.startsWith(window.APP_BASE_PATH + '/')) {
                    action = window.APP_BASE_PATH + action;
                }
                form.action = action;
                var csrf = document.createElement('input');
                csrf.type = 'hidden';
                csrf.name = '_csrf_token';
                csrf.value = config.csrfToken;
                form.appendChild(csrf);
                document.body.appendChild(form);
                form.submit();
            }
        };
    });
});
</script>
<script>vlDirtyGuard();</script>
{% endblock %}
