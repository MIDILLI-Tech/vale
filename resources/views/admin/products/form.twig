<script>
(function() {
    const copyBtn = document.getElementById('copy-prod-original-btn');

    copyBtn?.addEventListener('click', async function() {
        const transOf = document.querySelector('input[name="translation_of"]');
        const id = transOf?.value;
        if (!id) return;

        if (!confirm('{{ __('Overwrite current content with original?')|e('js') }}')) return;

        const origHtml = this.innerHTML;
        this.innerHTML = '<svg class="h-3.5 w-3.5 animate-spin inline-block" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';
        this.disabled = true;

        try {
            const r = await fetch('{{ url('/admin/products/')|e('js') }}' + id + '/json');
            const data = await r.json();

            document.querySelector('input[name="name"]').value = data.name;
            document.querySelector('textarea[name="short_description"]').value = data.short_description;
            document.querySelector('input[name="price"]').value = data.price;
            document.querySelector('input[name="sale_price"]').value = data.sale_price;
            document.querySelector('input[name="sku"]').value = data.sku;

            const textarea = document.querySelector('textarea[data-editor]');
            if (textarea && typeof window.vlSetEditorContent === 'function') {
                window.vlSetEditorContent(textarea.id, data.description);
            } else if (textarea && typeof window.vlSetEditorContentToggle === 'function') {
                window.vlSetEditorContentToggle(textarea.id, data.description);
            } else if (textarea) {
                textarea.value = data.description;
            }

            this.innerHTML = '✓';
        } catch (e) {
            this.innerHTML = '✗';
            alert('Failed to copy content.');
        } finally {
            setTimeout(() => { this.innerHTML = origHtml; this.disabled = false; }, 1500);
        }
    });
})();

async function findFileById(bp, id) {
    let page = 1;
    let totalPages = 1;
    do {
        const data = await fetchFileMediaPage(bp, page, '', 80);
        const found = (data.items || []).find(i => Number(i.id) === Number(id));
        if (found) return found;
        totalPages = Number(data.total_pages || 1);
        page += 1;
    } while (page <= totalPages);
    return null;
}

function digitalSection() {
    const bp = window.APP_BASE_PATH || '';
    const productId = {{ product ? product.id : 0 }};
    return {
        productName: '{{ product.name|default('')|e('js') }}',
        shortDescription: '{{ product.shortDescription|default('')|e('js') }}',
        shClass: '{{ product.shippingClass|default('use_global') }}',
        productType: '{{ product.shippingClass|default('') }}' === 'digital' ? 'digital' : 'physical',
        dlSource: '{{ product.downloadSource|default('none') }}',
        dlFileIds: [],
        dlFiles: [],
        dlUrl: '{{ product.downloadUrl|default('')|e('js') }}',
        dlUrlProxy: {{ (product ? product.downloadUrlProxy : true) ? 'true' : 'false' }},
        dlLimit: {{ product.downloadLimit|default(0) }},
        dlExpiryDays: {{ product.downloadExpiryDays|default(0) }},
        dlShowModal: false,
        dlMediaItems: [],
        dlMediaLoading: false,
        dlMediaPage: 1,
        dlMediaTotalPages: 1,
        dlMediaQuery: '',
        dlSearchTimer: null,
        sharedDlTarget: 'product',
        sharedDlVariationIdx: null,
        async init() {
            let ids = {{ downloadFileIds|default([])|json_encode|raw }};
            if (!Array.isArray(ids)) {
                ids = [];
            }
            ids = ids.map((v) => Number(v)).filter((v) => Number.isInteger(v) && v > 0);

            const legacySingleId = Number({{ product.downloadFileId|default(0)|number_format(0, '', '') }} || 0);
            if (ids.length === 0 && legacySingleId > 0) {
                ids = [legacySingleId];
            }

            this.dlFileIds = [...new Set(ids)];
            if (this.dlFileIds.length > 0) {
                const foundItems = await Promise.all(this.dlFileIds.map((id) => findFileById(bp, id)));
                this.dlFiles = foundItems.filter(Boolean).map((f) => ({ id: Number(f.id), name: f.name }));
                this.dlFileIds = this.dlFiles.map((f) => Number(f.id));
            }
        },
        setProductType(type) {
            this.productType = type;
            if (type === 'digital') {
                this.shClass = 'digital';
            } else if (this.shClass === 'digital') {
                this.shClass = 'use_global';
            }
        },
        async loadDlMediaPage(page = 1) {
            this.dlMediaLoading = true;
            try {
                const data = await fetchFileMediaPage(bp, page, this.dlMediaQuery, 40);
                this.dlMediaItems = data.items || [];
                this.dlMediaPage = Number(data.page || page);
                this.dlMediaTotalPages = Number(data.total_pages || 1);
            } finally {
                this.dlMediaLoading = false;
            }
        },
        prevDlMediaPage() { if (this.dlMediaPage > 1) this.loadDlMediaPage(this.dlMediaPage - 1); },
        nextDlMediaPage() { if (this.dlMediaPage < this.dlMediaTotalPages) this.loadDlMediaPage(this.dlMediaPage + 1); },
        onDlSearchInput() {
            clearTimeout(this.dlSearchTimer);
            this.dlSearchTimer = setTimeout(() => this.loadDlMediaPage(1), 300);
        },
        getVariationManager() {
            return window.__lpVariationsManager || null;
        },
        async openSharedDownloadModal(detail = {}) {
            this.sharedDlTarget = detail && detail.target === 'variation' ? 'variation' : 'product';
            this.sharedDlVariationIdx = this.sharedDlTarget === 'variation'
                ? Number(detail.index ?? -1)
                : null;
            this.dlShowModal = true;
            if (this.dlMediaItems.length === 0) {
                await this.loadDlMediaPage(1);
            }
        },
        async openFileBrowser() {
            await this.openSharedDownloadModal({ target: 'product' });
        },
        async refreshDlMedia() {
            clearMediaCache();
            this.dlMediaItems = [];
            await this.loadDlMediaPage(1);
        },
        // Drag-drop upload (assets/js/media-upload.js): routed like
        // selectFile — variation target toggles through the shared manager,
        // product target appends to the download list.
        async handleDroppedFiles(result) {
            const uploaded = (result && result.uploaded) || [];
            if (uploaded.length === 0) return;
            if (this.sharedDlTarget === 'variation') {
                const vm = this.getVariationManager();
                if (vm && this.sharedDlVariationIdx !== null && this.sharedDlVariationIdx >= 0) {
                    uploaded.forEach(item => vm.toggleSharedFile(this.sharedDlVariationIdx, item));
                }
            } else {
                uploaded.forEach(item => {
                    const id = Number(item.id);
                    if (!this.dlFileIds.includes(id)) {
                        this.dlFileIds.push(id);
                        this.dlFiles.push({ id, name: item.name });
                    }
                });
            }
            await this.refreshDlMedia();
        },
        isDlFileSelected(id) {
            const nid = Number(id);
            if (this.sharedDlTarget === 'variation') {
                const vm = this.getVariationManager();
                if (!vm || this.sharedDlVariationIdx === null || this.sharedDlVariationIdx < 0) {
                    return false;
                }
                return vm.isSharedFileSelected(this.sharedDlVariationIdx, nid);
            }
            return this.dlFileIds.includes(nid);
        },
        selectFile(item) {
            const id = Number(item.id);
            if (this.sharedDlTarget === 'variation') {
                const vm = this.getVariationManager();
                if (!vm || this.sharedDlVariationIdx === null || this.sharedDlVariationIdx < 0) {
                    return;
                }
                vm.toggleSharedFile(this.sharedDlVariationIdx, item);
                return;
            }

            const idx = this.dlFileIds.indexOf(id);
            if (idx >= 0) {
                this.dlFileIds.splice(idx, 1);
                this.dlFiles = this.dlFiles.filter((f) => Number(f.id) !== id);
                return;
            }
            this.dlFileIds.push(id);
            this.dlFiles.push({ id, name: item.name });
        },
        removeDlFile(id) {
            const nid = Number(id);
            this.dlFileIds = this.dlFileIds.filter((fid) => Number(fid) !== nid);
            this.dlFiles = this.dlFiles.filter((f) => Number(f.id) !== nid);
        },
        clearFile() {
            this.dlFileIds = [];
            this.dlFiles = [];
        },
        formatBytes(bytes) {
            if (!bytes) return '';
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        },
    };
}

function productGallery(initialIds) {
    const bp = window.APP_BASE_PATH || '';
    const toGalleryItem = i => ({
        id: i.id,
        url: i.url,
        thumbnail: i.thumbnail || i.url,
        mime: i.mime || '',
        isVideo: !!(i.mime && i.mime.indexOf('video/') === 0),
    });
    return {
        images: [],
        current: 0,
        showModal: false,
        loading: false,
        resolving: false,
        mediaPage: 1,
        mediaTotalPages: 1,
        mediaQuery: '',
        searchTimer: null,
        mediaItems: [],
        selected: [],
        async init() {
            const ids = (initialIds || []).map(Number).filter(id => Number.isInteger(id) && id > 0);
            if (ids.length > 0) {
                this.resolving = true;
                try {
                    const foundItems = await fetchMediaByIds(bp, ids);
                    this.images = foundItems
                        .filter(Boolean)
                        .map(toGalleryItem);
                } finally {
                    this.resolving = false;
                }
            }
            this.$nextTick(() => {
                const el = this.$refs.thumbStrip;
                if (!el || typeof window.Sortable === 'undefined' || el._vlSortable) return;
                el._vlSortable = window.Sortable.create(el, {
                    animation: 150,
                    delay: 120,
                    delayOnTouchOnly: true,
                    onEnd: (evt) => {
                        const moved = this.images.splice(evt.oldIndex, 1)[0];
                        this.images.splice(evt.newIndex, 0, moved);
                        this.current = evt.newIndex;
                    },
                });
            });
        },
        prev() {
            if (this.images.length === 0) return;
            this.current = (this.current - 1 + this.images.length) % this.images.length;
        },
        next() {
            if (this.images.length === 0) return;
            this.current = (this.current + 1) % this.images.length;
        },
        async loadMediaPage(page = 1) {
            this.loading = true;
            try {
                const data = await fetchGalleryMediaPage(bp, page, this.mediaQuery, 40);
                this.mediaItems = data.items;
                this.mediaPage = data.page;
                this.mediaTotalPages = data.total_pages;
            } finally {
                this.loading = false;
            }
        },
        async prevMediaPage() {
            if (this.mediaPage > 1) {
                await this.loadMediaPage(this.mediaPage - 1);
            }
        },
        async nextMediaPage() {
            if (this.mediaPage < this.mediaTotalPages) {
                await this.loadMediaPage(this.mediaPage + 1);
            }
        },
        async openBrowser() {
            this.showModal = true;
            this.selected = this.images.map(i => ({ ...i }));
            if (this.mediaItems.length === 0) {
                await this.loadMediaPage(1);
            }
        },
        async refreshMedia() {
            clearMediaCache();
            this.mediaItems = [];
            await this.loadMediaPage(1);
        },
        onSearchInput() {
            clearTimeout(this.searchTimer);
            this.searchTimer = setTimeout(() => {
                this.loadMediaPage(1);
            }, 300);
        },
        selectImage(item) {
            if (!this.images.find(i => Number(i.id) === Number(item.id))) {
                this.images.push(toGalleryItem(item));
                this.current = this.images.length - 1;
            }
            this.showModal = false;
        },
        get selectedCount() {
            return this.selected.length;
        },
        isSelected(item) {
            return this.selected.some(s => Number(s.id) === Number(item.id));
        },
        toggleSelect(item) {
            if (this.isSelected(item)) {
                this.selected = this.selected.filter(s => Number(s.id) !== Number(item.id));
            } else {
                this.selected.push(toGalleryItem(item));
            }
        },
        clearSelection() {
            this.selected = [];
        },
        // Drag-drop upload (assets/js/media-upload.js): add the uploaded
        // rows to the selection and reload page 1 so they show as checked.
        async handleDroppedFiles(result) {
            const uploaded = (result && result.uploaded) || [];
            uploaded.forEach(item => {
                const galleryItem = toGalleryItem(item);
                if (!this.selected.some(s => Number(s.id) === Number(galleryItem.id))) {
                    this.selected.push(galleryItem);
                }
            });
            updateSelectionUi();
            await this.refreshMedia();
        },
        confirmSelection() {
            const selectedIds = new Set(this.selected.map(s => Number(s.id)));
            const keptImages = this.images.filter(img => selectedIds.has(Number(img.id)));
            const keptIds = new Set(keptImages.map(img => Number(img.id)));
            const newImages = this.selected.filter(s => !keptIds.has(Number(s.id))).map(s => ({
                id: s.id,
                url: s.url,
                thumbnail: s.thumbnail || s.url,
                mime: s.mime || '',
                isVideo: !!s.isVideo,
            }));
            this.images = [...keptImages, ...newImages];
            if (this.current >= this.images.length) {
                this.current = Math.max(0, this.images.length - 1);
            }
            this.selected = [];
            this.showModal = false;
        },
        remove(idx) {
            this.images.splice(idx, 1);
            if (this.current >= this.images.length) {
                this.current = Math.max(0, this.images.length - 1);
            }
        }
    };
}

function variationsManager() {
    const bp = window.APP_BASE_PATH || '';
    const existing = {{ variations|default([])|json_encode|raw }};
    var _keyCounter = 0;
    function nextKey() { return ++_keyCounter; }
    return {
        sectionOpen: {{ (is_edit and not _variations_empty) ? 'true' : 'false' }},
        items: existing.map(v => {
            const attrs = typeof v.attributes === 'string' ? JSON.parse(v.attributes || '{}') : (v.attributes || {});
            return {
                _key: nextKey(),
                id: v.id || null,
                attrs: Object.entries(attrs).map(([name, value]) => ({ name, value })),
                price: v.price || '',
                sale_price: v.sale_price || '',
                sale_price_start: v.sale_price_start || '',
                sale_price_end: v.sale_price_end || '',
                sku: v.sku || '',
                stock_quantity: v.stock_quantity || 0,
                image_id: v.image_id || null,
                imageThumb: '',
                download_mode: v.download_mode === 'non_digital' ? 'physical' : (v.download_mode || 'use_parent'),
                download_file_ids: Array.isArray(v.download_file_ids)
                    ? v.download_file_ids.map((id) => Number(id)).filter((id) => Number.isInteger(id) && id > 0)
                    : (v.download_file_id ? [Number(v.download_file_id)] : []),
                download_files: [],
                download_url: v.download_url || '',
                download_url_proxy: v.download_url_proxy !== undefined ? !!v.download_url_proxy : true,
                download_limit: v.download_limit || 0,
                download_expiry_days: v.download_expiry_days || 0,
                shipping_class: v.shipping_class || 'use_parent',
                shipping_cost: v.shipping_cost || '',
                shipping_time_min: v.shipping_time_min || '',
                shipping_time_max: v.shipping_time_max || '',
                time_mode: (v.shipping_time_min || v.shipping_time_max) ? 'custom' : 'use_parent',
                vat_mode: v.vat_mode || 'use_parent',
                vat_rate: v.vat_rate || '',
                refund_mode: v.refund_mode || 'use_parent',
                shipping_country_overrides: v.shipping_country_overrides || '{}',
                showCO: false,
                nc: '',
                ncls: 'use_global',
                weight_mode: v.weight ? 'custom' : 'use_parent',
                weight: v.weight || '',
                dim_mode: (v.length || v.width || v.height) ? 'custom' : 'use_parent',
                length: v.length || '',
                width: v.width || '',
                height: v.height || '',
                collapsed: false,
            };
        }),
        varMediaItems: [],
        varShowModal: false,
        varTargetIdx: null,
        varLoading: false,
        varMediaPage: 1,
        varMediaTotalPages: 1,
        varMediaQuery: '',
        varSearchTimer: null,
        // File browser state
        varFileItems: [],
        varShowFileModal: false,
        varFileTargetIdx: null,
        varFileLoading: false,
        varFilePage: 1,
        varFileTotalPages: 1,
        varFileQuery: '',
        varFileSearchTimer: null,
        // Transient drag-drop notice (e.g. files uploaded with no variation
        // target selected) shown inside the variation picker modals.
        dropNotice: '',
        dropNoticeTimer: null,
        setDropNotice(msg) {
            this.dropNotice = msg;
            clearTimeout(this.dropNoticeTimer);
            this.dropNoticeTimer = setTimeout(() => { this.dropNotice = ''; }, 5000);
        },
        async init() {
            window.__lpVariationsManager = this;
            const withImages = this.items.filter(v => v.image_id);
            if (withImages.length > 0) {
                await Promise.all(this.items.map(async (v) => {
                    if (v.image_id) {
                        const found = await findImageById(bp, v.image_id);
                        if (found) {
                            v.imageThumb = found.thumbnail || found.url;
                        }
                    }
                }));
            }
            // Load file names for variations with internal download
            await Promise.all(this.items.map(async (v) => {
                if (v.download_mode === 'internal' && v.download_file_ids.length > 0) {
                    const foundItems = await Promise.all(v.download_file_ids.map((id) => findFileById(bp, id)));
                    v.download_files = foundItems.filter(Boolean).map((f) => ({ id: Number(f.id), name: f.name }));
                    v.download_file_ids = v.download_files.map((f) => Number(f.id));
                }
            }));
            this.$nextTick(() => {
                var el = document.getElementById('variations-sortable');
                if (!el || typeof Sortable === 'undefined') return;
                var self = this;
                Sortable.create(el, {
                    handle: '.drag-handle',
                    animation: 150,
                    onEnd: function (evt) {
                        var item = self.items.splice(evt.oldIndex, 1)[0];
                        self.items.splice(evt.newIndex, 0, item);
                        document.body.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                });
            });
        },
        async loadVarMediaPage(page = 1) {
            this.varLoading = true;
            try {
                const data = await fetchImageMediaPage(bp, page, this.varMediaQuery, 40);
                this.varMediaItems = data.items || [];
                this.varMediaPage = data.page || page;
                this.varMediaTotalPages = data.total_pages || 1;
            } finally {
                this.varLoading = false;
            }
        },
        async prevVarMediaPage() {
            if (this.varMediaPage > 1) {
                await this.loadVarMediaPage(this.varMediaPage - 1);
            }
        },
        async nextVarMediaPage() {
            if (this.varMediaPage < this.varMediaTotalPages) {
                await this.loadVarMediaPage(this.varMediaPage + 1);
            }
        },
        async openVarImageBrowser(idx) {
            this.varTargetIdx = idx;
            this.varShowModal = true;
            if (this.varMediaItems.length === 0) {
                await this.loadVarMediaPage(1);
            }
        },
        async refreshVarMedia() {
            clearMediaCache();
            this.varMediaItems = [];
            await this.loadVarMediaPage(1);
        },
        // Drag-drop upload (assets/js/media-upload.js): attach the first
        // uploaded image to the targeted variation through the normal
        // select path.
        async handleVarDroppedImages(result) {
            const uploaded = (result && result.uploaded) || [];
            if (uploaded.length === 0) return;
            if (this.varTargetIdx === null) {
                this.setDropNotice("{{ __('Select a variation first, then drop an image to attach it.')|e('js') }}");
                return;
            }
            this.selectVarImage(uploaded[0]);
            await this.refreshVarMedia();
        },
        onVarSearchInput() {
            clearTimeout(this.varSearchTimer);
            this.varSearchTimer = setTimeout(() => {
                this.loadVarMediaPage(1);
            }, 300);
        },
        selectVarImage(item) {
            if (this.varTargetIdx !== null) {
                this.items[this.varTargetIdx].image_id = item.id;
                this.items[this.varTargetIdx].imageThumb = item.thumbnail || item.url;
            }
            this.varShowModal = false;
        },
        removeVarImage(idx) {
            this.items[idx].image_id = null;
            this.items[idx].imageThumb = '';
        },
        addVariation() {
            this.sectionOpen = true;
            this.items.push({
                _key: nextKey(),
                id: null,
                attrs: [{ name: '', value: '' }],
                price: '',
                sale_price: '',
                sale_price_start: '',
                sale_price_end: '',
                sku: '',
                stock_quantity: 0,
                image_id: null,
                imageThumb: '',
                download_mode: 'use_parent',
                download_file_ids: [],
                download_files: [],
                download_url: '',
                download_url_proxy: true,
                download_limit: 0,
                download_expiry_days: 0,
                shipping_class: 'use_parent',
                shipping_cost: '',
                shipping_time_min: '',
                shipping_time_max: '',
                time_mode: 'use_parent',
                vat_mode: 'use_parent',
                vat_rate: '',
                refund_mode: 'use_parent',
                shipping_country_overrides: '{}',
                showCO: false,
                nc: '',
                ncls: 'use_global',
                weight_mode: 'use_parent',
                weight: '',
                dim_mode: 'use_parent',
                length: '',
                width: '',
                height: '',
                collapsed: false,
            });
            this.$nextTick(() => { this.$el.querySelector('#variations-sortable')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
        },
        removeVariation(idx) {
            this.items.splice(idx, 1);
        },
        moveTop(i) {
            if (i <= 0) return;
            const item = this.items.splice(i, 1)[0];
            this.items.unshift(item);
        },
        moveUp(i) {
            if (i <= 0) return;
            const item = this.items.splice(i, 1)[0];
            this.items.splice(i - 1, 0, item);
        },
        moveDown(i) {
            if (i >= this.items.length - 1) return;
            const item = this.items.splice(i, 1)[0];
            this.items.splice(i + 1, 0, item);
        },
        moveBottom(i) {
            if (i >= this.items.length - 1) return;
            const item = this.items.splice(i, 1)[0];
            this.items.push(item);
        },
        collapseAll() {
            this.items.forEach(s => s.collapsed = true);
        },
        expandAll() {
            this.items.forEach(s => s.collapsed = false);
        },
        applySaleDatesToAll() {
            const startEl = document.querySelector('input[name="sale_price_start"]');
            const endEl = document.querySelector('input[name="sale_price_end"]');
            const start = startEl ? startEl.value : '';
            const end = endEl ? endEl.value : '';
            if (!start && !end) {
                return;
            }
            this.items.forEach(s => {
                s.sale_price_start = start;
                s.sale_price_end = end;
            });
        },
        // File browser
        async loadVarFilePage(page = 1) {
            this.varFileLoading = true;
            try {
                const data = await fetchFileMediaPage(bp, page, this.varFileQuery, 40);
                this.varFileItems = data.items || [];
                this.varFilePage = Number(data.page || page);
                this.varFileTotalPages = Number(data.total_pages || 1);
            } finally {
                this.varFileLoading = false;
            }
        },
        prevVarFilePage() { if (this.varFilePage > 1) this.loadVarFilePage(this.varFilePage - 1); },
        nextVarFilePage() { if (this.varFilePage < this.varFileTotalPages) this.loadVarFilePage(this.varFilePage + 1); },
        onVarFileSearchInput() {
            clearTimeout(this.varFileSearchTimer);
            this.varFileSearchTimer = setTimeout(() => this.loadVarFilePage(1), 300);
        },
        async openVarFileBrowser(idx) {
            this.varFileTargetIdx = idx;
            this.varShowFileModal = true;
            if (this.varFileItems.length === 0) {
                await this.loadVarFilePage(1);
            }
        },
        async refreshVarFileMedia() {
            clearMediaCache();
            this.varFileItems = [];
            await this.loadVarFilePage(1);
        },
        // Drag-drop upload (assets/js/media-upload.js): attach each uploaded
        // file to the targeted variation through the normal select path.
        async handleDroppedFiles(result) {
            const uploaded = (result && result.uploaded) || [];
            if (uploaded.length === 0) return;
            if (this.varFileTargetIdx === null) {
                this.setDropNotice("{{ __('Select a variation first, then drop a file to attach it.')|e('js') }}");
                return;
            }
            uploaded.forEach(item => this.selectVarFile(item));
            await this.refreshVarFileMedia();
        },
        isVarFileSelected(id) {
            if (this.varFileTargetIdx === null) return false;
            return this.items[this.varFileTargetIdx]?.download_file_ids?.includes(Number(id));
        },
        selectVarFile(item) {
            if (this.varFileTargetIdx !== null) {
                const target = this.items[this.varFileTargetIdx];
                const id = Number(item.id);
                const idx = target.download_file_ids.indexOf(id);
                if (idx >= 0) {
                    target.download_file_ids.splice(idx, 1);
                    target.download_files = target.download_files.filter((f) => Number(f.id) !== id);
                    return;
                }
                target.download_file_ids.push(id);
                target.download_files.push({ id, name: item.name });
            }
        },
        removeVarFile(idx, id) {
            const target = this.items[idx];
            const nid = Number(id);
            target.download_file_ids = target.download_file_ids.filter((fid) => Number(fid) !== nid);
            target.download_files = target.download_files.filter((f) => Number(f.id) !== nid);
        },
        clearVarFiles(idx) {
            this.items[idx].download_file_ids = [];
            this.items[idx].download_files = [];
        },
        isSharedFileSelected(idx, id) {
            if (idx === null || idx < 0 || !this.items[idx]) return false;
            return this.items[idx].download_file_ids.includes(Number(id));
        },
        toggleSharedFile(idx, item) {
            if (idx === null || idx < 0 || !this.items[idx]) return;
            const target = this.items[idx];
            const id = Number(item.id);
            const existingIdx = target.download_file_ids.indexOf(id);
            if (existingIdx >= 0) {
                target.download_file_ids.splice(existingIdx, 1);
                target.download_files = target.download_files.filter((f) => Number(f.id) !== id);
                return;
            }
            target.download_file_ids.push(id);
            if (!target.download_files.find((f) => Number(f.id) === id)) {
                target.download_files.push({ id, name: item.name });
            }
        },
        formatFileBytes(bytes) {
            if (!bytes) return '';
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        },
    };
}

function lpPreviewDraft(productId) {
    // Clone the main form, POST it to the preview-draft endpoint (no _METHOD override), open in new tab
    const mainForm = document.querySelector('form[action*="/admin/products/' + productId + '"]');
    if (!mainForm) { return; }
    // Sync editor content and mark clean (untrusted input triggers editor.js dirty reset)
    mainForm.querySelectorAll('textarea[data-editor]').forEach(function(ta) {
        ta.dispatchEvent(new Event('input'));
    });

    const clone = mainForm.cloneNode(true);
    // cloneNode doesn't preserve .value — copy so preview shows current edits
    mainForm.querySelectorAll('textarea').forEach(function(orig) {
        var cloned = clone.querySelector('textarea[name="' + orig.name.replace(/"/g, '\\"') + '"]');
        if (cloned) cloned.value = orig.value;
    });
    clone.action = (window.APP_BASE_PATH || '') + '/admin/products/' + productId + '/preview-draft';
    clone.method = 'POST';
    clone.target = '_blank';
    clone.style.display = 'none';

    // Remove _METHOD override so the route receives a plain POST
    const methodOverride = clone.querySelector('input[name="_METHOD"]');
    if (methodOverride) { methodOverride.remove(); }

    document.body.appendChild(clone);
    clone.submit();
    document.body.removeChild(clone);
}

