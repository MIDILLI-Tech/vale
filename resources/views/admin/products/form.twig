                                <button type="button" @click="refreshVarMedia()" title="{{ __('Refresh') }}" class="text-gray-400 hover:text-gray-600"><span class="vl-icon-refresh" :class="varLoading ? 'vl-icon-spin' : ''"></span></button>
                                <button type="button" @click="varShowModal = false" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
                            </div>
