                            <div x-show="varFileLoading" class="py-8 text-center text-sm text-gray-500 dark:text-gray-400"><span class="vl-icon-refresh vl-icon-spin mr-1"></span>{{ __('Loading…') }}</div>
                            <div x-show="!varFileLoading && varFileItems.length === 0" class="py-8 text-center text-sm text-gray-400">{{ __('No files found.') }}</div>
                            <div class="divide-y divide-gray-100">
                                <template x-for="fitem in varFileItems" :key="fitem.id">
                                    <button type="button" @click="selectVarFile(fitem)"
                                            class="w-full flex items-center gap-3 py-2.5 px-2 rounded-sm hover:bg-gray-50 dark:bg-gray-800/50 text-left transition-colors"
                                            :class="isVarFileSelected(fitem.id) ? 'bg-slate-50' : ''">
                                        <span class="text-xl shrink-0" x-text="fitem.mime && fitem.mime.startsWith('image/') ? '🖼️' : (fitem.mime && fitem.mime.startsWith('audio/') ? '🎵' : (fitem.mime && fitem.mime.startsWith('video/') ? '🎬' : '📄'))"></span>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-sm font-medium text-gray-800 truncate" x-text="fitem.name"></div>
                                            <div class="text-xs text-gray-400" x-text="fitem.mime + (fitem.size ? ' · ' + formatFileBytes(fitem.size) : '')"></div>
                                        </div>
                                        <span x-show="isVarFileSelected(fitem.id)" class="text-xs font-semibold text-indigo-600 shrink-0">{{ __('Selected') }}</span>
                                    </button>
                                </template>
                            </div>
                        </div>
                        <div class="border-t px-6 py-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                            <span x-text="'Page ' + varFilePage + ' / ' + varFileTotalPages"></span>
                            <div class="flex items-center gap-2">
                                <button type="button" @click="prevVarFilePage()" :disabled="varFileLoading || varFilePage <= 1"
                                        class="rounded-sm border px-2 py-1 hover:bg-gray-50 dark:bg-gray-800/50 disabled:opacity-50 disabled:cursor-not-allowed">{{ __('Previous') }}</button>
                                <button type="button" @click="nextVarFilePage()" :disabled="varFileLoading || varFilePage >= varFileTotalPages"
                                        class="rounded-sm border px-2 py-1 hover:bg-gray-50 dark:bg-gray-800/50 disabled:opacity-50 disabled:cursor-not-allowed">{{ __('Next') }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-6" data-panel-id="shipping_reviews_card">
                {% set _comments_empty = is_edit and (product.commentStatus|default('use_global') == 'use_global') and (product.voteStatus|default('use_global') == 'use_global') %}
                <div x-data="{ open: {{ (is_edit and not _comments_empty) ? 'true' : 'false' }} }" class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs">
                    <div class="flex items-center gap-2" :class="open ? 'mb-4' : ''">
                        <button type="button" @click="open = !open" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                            <span x-show="open">▼</span>
                            <span x-show="!open">▶</span>
                        </button>
                        <h3 @click="open = !open" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('Reviews & Voting') }}</h3>
                    </div>
                    <div x-show="open" x-collapse>
                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Reviews') }}</label>
                        <select name="comment_status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="use_global" {{ (product.commentStatus|default('use_global')) == 'use_global' ? 'selected' }}>{{ __('Use global setting') }}</option>
                            <option value="enabled" {{ (product.commentStatus|default('')) == 'enabled' ? 'selected' }}>Enabled</option>
                            <option value="disabled" {{ (product.commentStatus|default('')) == 'disabled' ? 'selected' }}>{{ __('Disabled') }}</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Star Ratings') }}</label>
                        <select name="vote_status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="use_global" {{ (product.voteStatus|default('use_global')) == 'use_global' ? 'selected' }}>{{ __('Use global setting') }}</option>
                            <option value="enabled" {{ (product.voteStatus|default('')) == 'enabled' ? 'selected' }}>Enabled</option>
                            <option value="disabled" {{ (product.voteStatus|default('')) == 'disabled' ? 'selected' }}>{{ __('Disabled') }}</option>
                        </select>
                    </div>
                    </div>
                </div>

                {% set _shipping_empty = is_edit and (product.shippingClass|default('use_global') in ['use_global', null, '']) and not product.shippingCost and not product.shippingTimeMin and not product.shippingTimeMax and not product.weight and not product.length and not product.width and not product.height %}
                <div x-data="{ open: {{ (is_edit and not _shipping_empty) ? 'true' : 'false' }}, timeMode: '{{ (product.shippingTimeMin|default('') or product.shippingTimeMax|default('')) ? 'custom' : 'use_global' }}' }" class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs">
                    <div class="flex items-center gap-2" :class="open ? 'mb-4' : ''">
                        <button type="button" @click="open = !open" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                            <span x-show="open">▼</span>
                            <span x-show="!open">▶</span>
                        </button>
                        <h3 @click="open = !open" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('Shipping') }}</h3>
                    </div>
                    <div x-show="open" x-collapse>
                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Shipping Class') }}</label>
                        <select name="shipping_class" x-model="shClass" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="use_global">{{ __('Use global settings') }}</option>
                            <option value="free">{{ __('Always free') }}</option>
                            <option value="digital">{{ __('Digital (no shipping)') }}</option>
                            <option value="custom">{{ __('Custom') }}</option>
                            <option value="do_not_ship">{{ __('Do not ship') }}</option>
                        </select>
                    </div>
                    <div x-show="shClass === 'custom'" style="display:none">
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Shipping Cost') }}</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">{{ default_currency_symbol }}</span>
                            <input type="number" step="0.01" min="0" name="shipping_cost"
                                   value="{{ product.shippingCost|default('') }}"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm pl-7"
                                   placeholder="0.00">
                        </div>
                    </div>

                    {# Estimated Delivery Time #}
                    <div class="mt-3 border-t pt-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Estimated Delivery Time</label>
                        <div class="flex flex-wrap items-center gap-2">
                            <select x-model="timeMode" class="w-full sm:w-48 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                <option value="use_global">{{ __('Use global settings') }}</option>
                                <option value="custom">{{ __('Custom estimate') }}</option>
                            </select>
                            <template x-if="timeMode === 'custom'">
                                <div class="flex items-center gap-1">
                                    <input type="number" min="1" max="365" name="shipping_time_min"
                                           value="{{ product.shippingTimeMin|default('') }}"
                                           placeholder="Min" class="w-20 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                    <span class="text-xs text-gray-400">-</span>
                                    <input type="number" min="1" max="365" name="shipping_time_max"
                                           value="{{ product.shippingTimeMax|default('') }}"
                                           placeholder="Max" class="w-20 rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                                </div>
                            </template>
                            <template x-if="timeMode !== 'custom'">
                                <span class="text-xs text-gray-400">{{ __('Uses the default from Settings → E-Commerce → Shipping') }}</span>
                            </template>
                        </div>
                    </div>

                    {# Weight #}
                    <div class="mt-3 border-t pt-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Weight (kg)</label>
                        <input type="number" step="0.01" min="0" name="weight"
                               value="{{ product.weight|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                               placeholder="0.00">
                    </div>

                    {# Dimensions #}
                    <div class="mt-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Dimensions (cm)') }}</label>
                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Length') }}</label>
                                <input type="number" step="0.1" min="0" name="length"
                                       value="{{ product.length|default('') }}"
                                       class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                       placeholder="0">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Width') }}</label>
                                <input type="number" step="0.1" min="0" name="width"
                                       value="{{ product.width|default('') }}"
                                       class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                       placeholder="0">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Height') }}</label>
                                <input type="number" step="0.1" min="0" name="height"
                                       value="{{ product.height|default('') }}"
                                       class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm"
                                       placeholder="0">
                            </div>
                        </div>
                    </div>

                    {# Country Overrides #}
                    <div class="mt-4 border-t pt-4" x-data="shippingCountryOverrides()">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">{{ __('Country Overrides') }}</label>
                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 mb-2">{{ __('Adjust country-specific cost or delivery time') }}</p>
                        <input type="hidden" name="shipping_country_overrides_json" x-model="json">
                        <template x-for="(rule, ccode) in rules" :key="ccode">
                            <div class="flex flex-wrap items-center gap-2 mb-2" x-data>
                                <span class="text-xs font-semibold uppercase dark:text-gray-100" x-text="ccode"></span>
                                <select x-model="rules[ccode].class" @change="updateJson"
                                        class="flex-1 sm:flex-none sm:w-26 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                                    <option value="use_global">{{ __('Use global') }}</option>
                                    <option value="free">{{ __('Free') }}</option>
                                    <option value="custom">{{ __('Custom') }}</option>
                                    <option value="digital">{{ __('Digital') }}</option>
                                    <option value="do_not_ship">{{ __('Do not ship') }}</option>
                                </select>
                                <template x-if="rule.class === 'custom'">
                                    <div class="relative">
                                        <span class="absolute left-2 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 text-xs">{{ default_currency_symbol }}</span>
                                        <input type="number" step="0.01" min="0"
                                               x-model.number="rules[ccode].cost" @input="updateJson" @change="updateJson"
                                               class="w-16 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 pl-4 dark:bg-gray-800 dark:text-gray-200"
                                               placeholder="0.00">
                                    </div>
                                </template>
                                <template x-if="rule.class === 'custom'">
                                    <div class="flex items-center gap-1">
                                        <input type="number" min="1" max="365"
                                               :value="rules[ccode].shipping_time_min || ''" @input="rules[ccode].shipping_time_min = $event.target.value; updateJson()" @change="updateJson"
                                               placeholder="Min" class="w-12 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-1.5 py-1 dark:bg-gray-800 dark:text-gray-200">
                                        <span class="text-xs text-gray-400">-</span>
                                        <input type="number" min="1" max="365"
                                               :value="rules[ccode].shipping_time_max || ''" @input="rules[ccode].shipping_time_max = $event.target.value; updateJson()" @change="updateJson"
                                               placeholder="Max" class="w-12 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-1.5 py-1 dark:bg-gray-800 dark:text-gray-200">
                                    </div>
                                </template>
                                <template x-if="rule.class !== 'custom'">
                                    <span class="text-xs text-gray-400 w-24"></span>
                                </template>
                                <button type="button" @click="remove(ccode)" class="text-red-500 hover:text-red-700 text-xs shrink-0">✕</button>
                            </div>
                        </template>
                        <div x-show="Object.keys(rules).length === 0" class="text-xs text-gray-400 dark:text-gray-500 mb-2">{{ __('No overrides set.') }}</div>
                        <div class="flex flex-wrap items-center gap-2 mt-1">
                            <select x-ref="countrySel" @change="newCountry = $refs.countrySel.value" class="w-full sm:w-36 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                                <option value="">{{ __('Select country…') }}</option>
                                <template x-for="c in availableCountries.filter(function(cc) { return !rules[cc]; })" :key="c">
                                    <option x-bind:value="c" x-text="countryOptionLabel(c)"></option>
                                </template>
                            </select>
                            <select x-model="newClass" class="flex-1 sm:flex-none sm:w-36 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                                <option value="use_global">{{ __('Use global') }}</option>
                                <option value="free">{{ __('Free') }}</option>
                                <option value="custom">{{ __('Custom') }}</option>
                                <option value="digital">{{ __('Digital') }}</option>
                                <option value="do_not_ship">{{ __('Do not ship') }}</option>
                            </select>
                            <button type="button" @click="if(newCountry&&!rules[newCountry]){r=Object.assign({},rules);r[newCountry]={class:newClass};rules=r;json=JSON.stringify(rules);newCountry='';newClass='use_global'}" x-bind:disabled="!newCountry"
                                    class="shrink-0 rounded-sm bg-gray-900 px-2 py-1 text-xs font-medium text-white hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed" title="{{ __('Add') }}">
                                +
                            </button>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        {# Side column #}
        <div class="space-y-6" data-panel-container="right">


            {# Language #}            {% if multi_language_content %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="language_card">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200">{{ __('Language') }}</h3>
                    <span class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                        {{ current_locale }}
                    </span>
                </div>

                <div class="mb-3">
                    <label for="language" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Product Language') }}</label>
                    <select id="language" name="language" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm focus:ring-gray-500 focus:border-gray-500">
                        {% for code, name in supported_locales %}
                            <option value="{{ code }}" {{ (old.language|default(product ? product.language : current_locale)) == code ? 'selected' }}>{{ locale_name(code) }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-4">
                    <label for="translation_of" class="block text-xs font-medium text-gray-500 dark:text-gray-400">{{ __('Translation Of') }}</label>
                    <div class="flex gap-2">
                        {% include 'admin/components/translation-select.twig' with {
                            originals: potential_originals,
                            label_field: 'name',
                            value: old.translation_of|default(product ? product.translationOf : (prefill_translation_of|default('')))
                        } %}
                        <button type="button" id="copy-prod-original-btn"
                                class="mt-1 inline-flex w-9 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-500 hover:bg-gray-50 hover:text-gray-700 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
                                title="{{ __('Copy content from original') }}">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </button>
                    </div>
                </div>

                {% if translations is defined and supported_locales|length > 1 %}
                <div class="pt-3 border-t border-gray-200 mt-3">
                    <p class="text-xs font-medium text-gray-500 mb-2">{{ __('Translations') }}</p>
                    <div class="space-y-1.5">
                        {% for code, name in supported_locales %}
                            {% set trans = null %}
                            {% for t in translations %}
                                {% if t.language == code %}{% set trans = t %}{% endif %}
                            {% endfor %}

                            <div class="flex items-center justify-between rounded-md bg-gray-50 dark:bg-gray-800/50 px-3 py-1.5 text-sm">
                                <span class="flex items-center gap-2 min-w-0">
                                    <span class="text-xs font-medium uppercase text-gray-500 w-8 shrink-0">{{ code }}</span>
                                    <span class="{{ trans ? 'text-gray-900 dark:text-gray-100' : 'text-gray-400 italic' }} text-xs shrink-0">{{ locale_name(code) }}</span>
                                    {% if trans %}
                                        <span class="text-xs text-gray-400 shrink-0">—</span>
                                        <a href="{{ url('/admin/products/' ~ trans.id ~ '/edit') }}" title="{{ trans.name|e('html') }}" class="text-gray-900 dark:text-gray-100 hover:underline text-xs truncate">{{ trans.name }}</a>
                                    {% endif %}
                                </span>
                                <span class="shrink-0">
                                    {% set form_lang = old.language|default(product ? product.language : current_locale) %}
                                    {% if trans %}
                                        {% if trans.id == (product.id|default(0)) %}
                                            <span class="text-xs font-medium text-green-600">{{ __('Current') }}</span>
                                        {% else %}
                                            <a href="{{ url('/admin/products/' ~ trans.id ~ '/edit') }}" class="text-blue-600 hover:underline text-xs">{{ __('Edit') }}</a>
                                        {% endif %}
                                    {% else %}
                                        {% if not is_edit and code == form_lang %}
                                            <span class="text-xs font-medium text-green-600">{{ __('Current') }}</span>
                                        {% else %}
                                            <a href="{{ url('/admin/products/create', {}, {language: code, translation_of: original_id|default(product.id|default(''))}) }}" class="text-xs text-blue-600 hover:underline">
                                                + {{ __('Add') }}
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {% set _raw_status = product.status|default('draft') %}
            {% set _shown_status = _raw_status == 'scheduled' ? 'draft' : _raw_status %}
            {% set _st = old.status|default(_shown_status) %}
            {% set _has_schedule = product and (product.status == 'scheduled' or (product.publishedAt and product.publishedAt|date('U') > 'now'|date('U')) or product.expiresAt) %}
            {% set _sched = old.set_schedule|default(_has_schedule ? '1' : '') %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow-xs" data-panel-id="publish_card" x-data="{ status: '{{ _st }}', scheduling: {{ _sched ? 'true' : 'false' }} }">
                <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ __('Publish') }}</h3>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Status') }}</label>
                    <select name="status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs" x-model="status">
                        {% for s in ['draft', 'published', 'unlisted', 'archived'] %}
                        <option value="{{ s }}" {{ _st == s ? 'selected' }}>{{ __(s)|capitalize }}</option>
                        {% endfor %}
                        {% if _st not in ['draft', 'published', 'unlisted'] %}
                        <option value="{{ _st }}" selected>{{ _st|capitalize }}</option>
                        {% endif %}
                    </select>
                    <label class="mt-2 flex cursor-pointer items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                        <input type="checkbox" name="set_schedule" value="1" x-model="scheduling" class="rounded-sm border-gray-300 dark:border-gray-700">
                        {{ __('Set schedule') }}
                    </label>
                    <div x-show="scheduling" x-cloak class="mt-3 space-y-3">
                        <div x-show="status !== 'published'">
                            <label for="published_at" class="block text-sm font-medium text-gray-700 mb-1 cursor-pointer">{{ __('Publish date & time') }}</label>
                            <input type="datetime-local" name="published_at" id="published_at"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm cursor-pointer"
                                   value="{{ old.published_at ?? (product.publishedAt ? product.publishedAt|date('Y-m-d\\TH:i') : '') }}">
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Optional. A draft goes live here, or an unlisted item becomes public, at this time.') }}</p>
                            {% if errors.published_at is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.published_at|join(', ') }}</p>{% endif %}
                            {% if cron_mode|default('none') == 'none' %}
                            <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">&#9888; {{ __('Cron is disabled — scheduled publishing will not run automatically.') }} <a href="{{ url('/admin/settings', {}, {tab: 'maintenance', subtab: 'cron'}) }}" class="underline">{{ __('Enable it in Settings → Scheduled Tasks') }}</a></p>
                            {% endif %}
                        </div>
                        <div>
                            <label for="expires_at" class="block text-sm font-medium text-gray-700 mb-1 cursor-pointer">{{ __('Expiry date & time') }}</label>
                            <input type="datetime-local" name="expires_at" id="expires_at"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm cursor-pointer"
                                   value="{{ old.expires_at ?? (product.expiresAt ? product.expiresAt|date('Y-m-d\\TH:i') : '') }}">
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Optional. The product expires at this time.') }}</p>
                            {% if errors.expires_at is defined %}<p class="mt-1 text-sm text-red-600 dark:text-red-400">{{ errors.expires_at|join(', ') }}</p>{% endif %}
                        </div>
                    </div>

                    {% include 'admin/components/final-url-field.twig' with {
                        prefix: site_url ~ routing_shop_prefix ~ '/',
                        slug: product.slug|default(''),
                        hint: __('The address this product will be live at. Share it before it goes live.')
                    } %}
                </div>
