{% extends "admin/layout.twig" %}

{% set panel_rail = true %}

{% block title %}{{ is_edit ? 'Edit' : 'New' }} Product{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-3">
    <a href="{{ url('/admin/products') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700">← {{ __('Products') }}</a>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ is_edit ? __('Edit Product') : __('New Product') }}</h1>
    {% if is_edit %}<span data-clean-badge class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">✓ {{ __('Saved') }}</span>{% endif %}
    <span data-dirty-badge class="hidden px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">● {{ __('Unsaved changes') }}</span>
    {% include 'admin/components/rail-toggle.twig' %}
</div>

<form method="POST" action="{{ url(is_edit ? '/admin/products/' ~ product.id : '/admin/products') }}" data-autosave data-panel-reorder-key="product" class="space-y-6" x-data="digitalSection()" @open-shared-download-modal.window="openSharedDownloadModal($event.detail || {})">
    {{ csrf_field() }}
    {% if is_edit %}<input type="hidden" name="_METHOD" value="PUT">{% endif %}

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {# Main column #}
        <div class="lg:col-span-2 space-y-6" data-panel-container="left">
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="general_info_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('General Information') }}</h3>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Product Name') }} <span class="text-red-500">*</span></label>
                    <input type="text" id="title" name="name" required value="{{ product.name|default('') }}"
                           x-model="productName"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Short Description') }}</label>
                    <textarea id="excerpt" name="short_description" rows="2"
                              x-model="shortDescription"
                              class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs">{{ product.shortDescription|default('') }}</textarea>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ __('Product Type') }}</label>
                    <div class="inline-flex rounded-lg border border-gray-300 dark:border-gray-700 overflow-hidden text-sm">
                        <button type="button" @click="setProductType('physical')"
                                :class="productType === 'physical' ? 'bg-gray-900 text-white' : 'bg-white dark:bg-gray-900 text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50'"
                                class="px-4 py-2 font-medium transition-colors">📦 {{ __('Physical') }}</button>
                        <button type="button" @click="setProductType('digital')"
                                :class="productType === 'digital' ? 'bg-indigo-600 dark:bg-indigo-700 text-white' : 'bg-white dark:bg-gray-900 text-gray-600 hover:bg-gray-50 dark:bg-gray-800/50'"
                                class="px-4 py-2 font-medium border-l border-gray-300 dark:border-gray-700 transition-colors">⬇️ {{ __('Digital') }}</button>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Description') }}</label>
                    <textarea id="description" name="description" rows="8" data-editor
                              class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs">{{ product.description|default('') }}</textarea>
                </div>
            </div>

            {# Pricing #}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="pricing_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('Pricing') }} <span class="text-xs font-normal text-gray-400">({{ default_currency }})</span></h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Regular Price') }}</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm pointer-events-none">{{ default_currency_symbol }}</span>
                            <input type="number" name="price" step="0.01" min="0" value="{{ product.price|default(0) }}"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs pl-7">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Sale Price') }}</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm pointer-events-none">{{ default_currency_symbol }}</span>
                            <input type="number" name="sale_price" step="0.01" min="0" value="{{ product.salePrice|default('') }}"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs pl-7">
                        </div>
                    </div>
                </div>
                <div class="mt-4 border-t pt-4" x-data="{ showSchedule: {{ (product.salePriceStart or product.salePriceEnd) ? 'true' : 'false' }} }">
                    <div class="flex items-center justify-between mb-3">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" x-model="showSchedule" class="rounded-sm border-gray-300 text-gray-900 focus:ring-gray-500">
                            <span class="text-sm font-medium text-gray-700">{{ __('Sale Schedule') }}</span>
                        </label>
                        <button type="button" @click="$dispatch('apply-sale-dates')" x-show="showSchedule"
                                class="rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">
                            {{ __('Apply Sale Dates to All Variations') }}
                        </button>
                    </div>
                    <div x-show="showSchedule" x-cloak class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Sale Starts') }}</label>
                            <input type="datetime-local" name="sale_price_start"
                                   value="{{ product.salePriceStart ? product.salePriceStart|date('Y-m-d\\TH:i') : '' }}"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Sale Ends') }}</label>
                            <input type="datetime-local" name="sale_price_end"
                                   value="{{ product.salePriceEnd ? product.salePriceEnd|date('Y-m-d\\TH:i') : '' }}"
                                   class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                        </div>
                    </div>
                    <p x-show="showSchedule" x-cloak class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ __('Leave both empty for always active. The sale price is only applied within this time window.') }}</p>
                </div>
                <div class="mt-4 grid grid-cols-3 gap-4 border-t pt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Refund Policy') }}</label>
                        <select name="refund_mode" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="use_global" {{ (product.refundMode|default('use_global')) == 'use_global' ? 'selected' : '' }}>{{ __('Use global settings') }}</option>
                            <option value="allow" {{ (product.refundMode|default('')) == 'allow' ? 'selected' : '' }}>{{ __('Allow refunds') }}</option>
                            <option value="non_refundable" {{ (product.refundMode|default('')) == 'non_refundable' ? 'selected' : '' }}>{{ __('Non-refundable') }}</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('VAT Mode') }}</label>
                        <select name="vat_mode" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            <option value="use_global" {{ (product.vatMode|default('use_global')) == 'use_global' ? 'selected' : '' }}>{{ __('Use global tax settings') }}</option>
                            <option value="custom" {{ (product.vatMode|default('')) == 'custom' ? 'selected' : '' }}>{{ __('Custom VAT rate') }}</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('VAT Rate (%)') }}</label>
                        <input type="number" name="vat_rate" step="0.01" min="0" value="{{ product.vatRate|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs">
                        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Used only when VAT mode is custom.') }}</p>
                    </div>
                </div>

                {# VAT Country Overrides #}
                <div class="border-t pt-4 mt-4" x-data="vatCountryOverrides()">
                    <label class="block text-sm font-medium text-gray-700 mb-2">{{ __('VAT Country Overrides') }}</label>
                    <input type="hidden" name="vat_country_overrides_json" x-model="json">
                    <template x-for="(rule, ccode) in rules" :key="ccode">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <span class="text-xs font-semibold uppercase dark:text-gray-100" x-text="ccode"></span>
                            <select x-model="rules[ccode].mode" @change="updateJson"
                                    class="flex-1 sm:flex-none sm:w-36 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                                <option value="use_global">{{ __('Use global') }}</option>
                                <option value="custom">{{ __('Custom rate') }}</option>
                                <option value="none">{{ __('No VAT') }}</option>
                            </select>
                            <template x-if="rule.mode === 'custom'">
                                <div class="relative">
                                    <input type="number" step="0.01" min="0"
                                           x-model.number="rules[ccode].rate" @input="updateJson" @change="updateJson"
                                           class="w-20 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200"
                                           placeholder="0.00">
                                    <span class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 text-xs">%</span>
                                </div>
                            </template>
                            <template x-if="rule.mode !== 'custom'">
                                <span class="text-xs text-gray-400 w-20"></span>
                            </template>
                            <button type="button" @click="remove(ccode)" class="text-red-500 hover:text-red-700 text-xs shrink-0">✕</button>
                        </div>
                    </template>
                    <div x-show="Object.keys(rules).length === 0" class="text-xs text-gray-400 dark:text-gray-500 mb-2">{{ __('No overrides set.') }}</div>
                    <div class="flex flex-wrap items-center gap-2 mt-1">
                        <select x-ref="countrySel" @change="newCountry = $refs.countrySel.value" class="w-full sm:w-44 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                            <option value="">{{ __('Select country…') }}</option>
                            <template x-for="c in availableCountries.filter(function(cc) { return !rules[cc]; })" :key="c">
                                <option x-bind:value="c" x-text="countryOptionLabel(c)"></option>
                            </template>
                        </select>
                        <select x-model="newMode" class="flex-1 sm:flex-none sm:w-28 rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 dark:bg-gray-800 dark:text-gray-200">
                            <option value="use_global">{{ __('Use global') }}</option>
                            <option value="custom">{{ __('Custom rate') }}</option>
                            <option value="none">{{ __('No VAT') }}</option>
                        </select>
                        <button type="button" @click="if(newCountry&&!rules[newCountry]){r=Object.assign({},rules);r[newCountry]={mode:newMode};rules=r;json=JSON.stringify(rules);newCountry='';newMode='use_global'}" x-bind:disabled="!newCountry"
                                class="shrink-0 rounded-sm bg-gray-900 px-2 py-1 text-xs font-medium text-white hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed">
                            + Add
                        </button>
                    </div>
                </div>
            </div>

            {# Digital Download Panel — shown only when product type is digital #}
            <div x-show="productType === 'digital'" x-cloak class="rounded-xl border border-indigo-200 dark:border-gray-800 bg-slate-50/40 dark:bg-gray-900 p-6 shadow-xs" data-panel-id="digital_downloads_card">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('Downloads') }}</h3>

                <input type="hidden" name="download_source" :value="dlSource">
                <input type="hidden" name="download_file_id" :value="dlFileIds.length ? dlFileIds[0] : ''">
                <template x-for="fid in dlFileIds" :key="'dl-hidden-' + fid">
                    <input type="hidden" name="download_file_ids[]" :value="fid">
                </template>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('File Source') }}</label>
                    <select x-model="dlSource" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm dark:text-gray-200 dark:bg-gray-800">
                        <option value="none">{{ __('No file configured') }}</option>
                        <option value="internal">{{ __('Internal file (media library)') }}</option>
                        <option value="external">{{ __('External URL') }}</option>
                    </select>
                </div>

                <div x-show="dlSource === 'internal'" class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Files') }}</label>
                    <div class="flex items-center gap-2">
                        <button type="button" @click.prevent="openSharedDownloadModal({ target: 'product' })"
                                class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-1.5 text-sm dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700"
                                x-text="dlFileIds.length ? '📎 Add / Manage files' : '📎 Pick from library'">
                        </button>
                        <span class="text-xs text-gray-500 dark:text-gray-300" x-text="dlFileIds.length + ' file(s) selected'"></span>
                        <button x-show="dlFileIds.length" type="button" @click.prevent="clearFile()"
                                class="text-xs text-red-500 hover:text-red-700 ml-1">✕</button>
                    </div>
                    <div x-show="dlFiles.length" class="mt-2 space-y-1">
                        <template x-for="f in dlFiles" :key="'dl-picked-' + f.id">
                            <div class="flex items-center justify-between rounded-sm border border-indigo-100 dark:border-indigo-900 bg-white dark:bg-gray-800 px-2 py-1.5 text-xs">
                                <span class="truncate text-gray-700 dark:text-gray-300" x-text="f.name"></span>
                                <button type="button" @click.prevent="removeDlFile(f.id)" class="ml-2 text-red-500 hover:text-red-700">Remove</button>
                            </div>
                        </template>
                    </div>
                </div>

                <div x-show="dlSource === 'external'" class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Download URL') }}</label>
                    <input type="text" name="download_url" x-model="dlUrl" :disabled="dlSource !== 'external'"
                           placeholder="https://example.com/file.zip"
                           class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm dark:bg-gray-800 dark:text-gray-200">
                    <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Must start with https:// or http://') }}</p>
                    <div class="mt-2">
                        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                            <input type="checkbox" name="download_url_proxy" x-model="dlUrlProxy" :disabled="dlSource !== 'external'"
                                   class="rounded-sm border-gray-300 dark:border-gray-700 text-indigo-600 focus:ring-indigo-500">
                            <span>{{ __('Hide URL (Proxy Download)') }}</span>
                        </label>
                        <p x-show="!dlUrlProxy" class="mt-1 text-[11px] text-amber-600 dark:text-amber-400">
                            {{ __('Warning: If hidden URL is disabled, the destination link (e.g. Google Drive/Dropbox) will be visible to the customer and remains accessible even after a refund.') }}
                        </p>
                    </div>
                </div>
                {# Ensure values are reset if not external #}
                <template x-if="dlSource !== 'external'">
                    <input type="hidden" name="download_url" value="">
                </template>
                <template x-if="dlSource !== 'external'">
                    <input type="hidden" name="download_url_proxy" value="0">
                </template>

                <div class="grid grid-cols-2 gap-4 mt-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Download Limit') }}</label>
                        <input type="number" name="download_limit" min="0" x-model="dlLimit"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm dark:bg-gray-800 dark:text-gray-200">
                        <p class="mt-1 text-xs text-gray-400 dark:text-gray-400">0 = {{ __('unlimited') }}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Expiry (days after purchase)') }}</label>
                        <input type="number" name="download_expiry_days" min="0" x-model="dlExpiryDays"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm dark:bg-gray-800 dark:text-gray-200">
                        <p class="mt-1 text-xs text-gray-400 dark:text-gray-400">0 = {{ __('never expires') }}</p>
                    </div>
                </div>

                {# File picker modal — teleported to <body>: it must stay usable
                   when the product itself is physical (a digital variation
                   opens this shared modal), and the digital panel is hidden
                   in that case. #}
                <template x-teleport="body">
                <div x-show="dlShowModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @keydown.escape.window="dlShowModal = false">
                    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl w-full max-w-3xl max-h-[80vh] flex flex-col"
                         data-vl-media-drop data-vl-media-filter=""
                         @vl:media-uploaded="typeof handleDroppedFiles === 'function' && handleDroppedFiles($event.detail)">
                        <div class="flex items-center justify-between border-b px-6 py-4">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100" x-text="sharedDlTarget === 'variation' ? 'Select Download Files (Variation)' : 'Select Download Files'"></h3>
                            <div class="flex items-center gap-2">
                                <button type="button" @click="refreshDlMedia()" title="{{ __('Refresh') }}" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"><span class="vl-icon-refresh" :class="dlMediaLoading ? 'vl-icon-spin' : ''"></span></button>
                                <button type="button" @click="dlShowModal = false" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xl">&times;</button>
                            </div>
                        </div>
                        {% set _sa = user.role is defined and user.role == 'super_admin' %}
                        {% set _can_upload = _sa or (user_permissions is defined and 'media.upload' in user_permissions) %}
                        {% if _can_upload %}
                        <div class="px-6 py-3 border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 text-xs text-gray-500 dark:text-gray-400">
                            <p>{{ __('Tip: You can upload new files by dragging and dropping them here.') }}</p>
                        </div>
                        {% endif %}
                        <div class="border-b px-6 py-3">
                            <input type="text" x-model="dlMediaQuery"
                                   @input="onDlSearchInput()" @keydown.enter.prevent="loadDlMediaPage(1)"
                                   placeholder="{{ __('Search files...') }}" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm dark:bg-gray-800 dark:text-gray-200">
                        </div>
                        <div class="overflow-y-auto p-4">
                            <div x-show="dlMediaLoading" class="py-8 text-center text-sm text-gray-500 dark:text-gray-400"><span class="vl-icon-refresh vl-icon-spin mr-1"></span>{{ __('Loading…') }}</div>
                            <div x-show="!dlMediaLoading && dlMediaItems.length === 0" class="py-8 text-center text-sm text-gray-400 dark:text-gray-500">{{ __('No files found.') }}</div>
                            <div class="divide-y divide-gray-100">
                                <template x-for="mitem in dlMediaItems" :key="mitem.id">
                                    <button type="button" @click="selectFile(mitem)"
                                            class="w-full flex items-center gap-3 py-2.5 px-2 rounded-sm hover:bg-gray-50 dark:hover:bg-gray-700/50 text-left transition-colors"
                                            :class="isDlFileSelected(mitem.id) ? 'bg-slate-50 dark:bg-gray-700' : ''">
                                        <span class="text-xl shrink-0" x-text="mitem.mime && mitem.mime.startsWith('image/') ? '🖼️' : (mitem.mime && mitem.mime.startsWith('audio/') ? '🎵' : (mitem.mime && mitem.mime.startsWith('video/') ? '🎬' : '📄'))"></span>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-sm font-medium text-gray-800 dark:text-gray-200 truncate" x-text="mitem.name"></div>
                                            <div class="text-xs text-gray-400 dark:text-gray-500" x-text="mitem.mime + (mitem.size ? ' · ' + formatBytes(mitem.size) : '')"></div>
                                        </div>
                                        <span x-show="isDlFileSelected(mitem.id)" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 shrink-0">{{ __('Selected') }}</span>
                                    </button>
                                </template>
                            </div>
                        </div>
                        <div class="border-t px-6 py-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                            <span x-text="'Page ' + dlMediaPage + ' / ' + dlMediaTotalPages"></span>
                            <div class="flex items-center gap-2">
                                <button type="button" @click="prevDlMediaPage()" :disabled="dlMediaLoading || dlMediaPage <= 1"
                                        class="rounded-sm border dark:border-gray-700 px-2 py-1 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 dark:bg-gray-800/50 disabled:opacity-50 disabled:cursor-not-allowed">{{ __('Previous') }}</button>
                                <button type="button" @click="nextDlMediaPage()" :disabled="dlMediaLoading || dlMediaPage >= dlMediaTotalPages"
                                        class="rounded-sm border dark:border-gray-700 px-2 py-1 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 dark:bg-gray-800/50 disabled:opacity-50 disabled:cursor-not-allowed">{{ __('Next') }}</button>
                            </div>
                        </div>
                    </div>
                </div>
                </template>
            </div>

            {# Inventory #}
            {% set _inventory_empty = is_edit and (product.sku|default('') == '' and product.gtin|default('') == '' and product.mpn|default('') == '' and product.brand|default('') == '' and product.stockQuantity|default(0) == 0 and product.stockStatus|default('in_stock') == 'in_stock' and product.totalSold|default(0) == 0) %}
            <div x-data="{ open: {{ (is_edit and not _inventory_empty) ? 'true' : 'false' }} }" class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="inventory_card">
                <div class="flex items-center gap-2" :class="open ? 'mb-4' : ''">
                    <button type="button" @click="open = !open" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                        <span x-show="open">▼</span>
                        <span x-show="!open">▶</span>
                    </button>
                    <h3 @click="open = !open" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('Inventory') }}</h3>
                </div>
                <div x-show="open" x-collapse>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('SKU') }}</label>
                        <input type="text" name="sku" value="{{ product.sku|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">GTIN <span class="text-xs text-gray-400 dark:text-gray-500">(UPC/EAN/JAN/ISBN)</span></label>
                        <input type="text" name="gtin" value="{{ product.gtin|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">MPN</label>
                        <input type="text" name="mpn" value="{{ product.mpn|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Brand') }}</label>
                        <input type="text" name="brand" value="{{ product.brand|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Stock Qty (Leave 0 to disable)') }}</label>
                        <input type="number" name="stock_quantity" min="0" value="{{ product.stockQuantity|default(0) }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Stock Status') }}</label>
                        <select name="stock_status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                            {% for s in ['in_stock', 'out_of_stock', 'on_backorder'] %}
                            <option value="{{ s }}" {{ (product.stockStatus|default('in_stock')) == s ? 'selected' }}>{{ s|replace({'_': ' '})|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Total Sold') }}</label>
                        <input type="number" name="total_sold" min="0" value="{{ product.totalSold|default(0) }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Can be manually adjusted.') }}</p>
                    </div>
                </div>
                </div>
            </div>

            {# Google Merchant Center — only shown when GMC is enabled in settings #}
            {% if gmc_enabled|default(false) %}
            {% set _gmc_empty = is_edit and not product.gmcExclude and (product.googleProductCategory is null or product.googleProductCategory == '' or product.googleProductCategory == '__global__') and (product.condition|default('new') == 'new') and not product.color and not product.size and not product.material and not product.pattern and not product.gender and not product.ageGroup %}
            <div x-data="{ open: {{ (is_edit and not _gmc_empty) ? 'true' : 'false' }} }" class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs" data-panel-id="gmc_card">
                <div class="flex items-center gap-2" :class="open ? 'mb-4' : ''">
                    <button type="button" @click="open = !open" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                        <span x-show="open">▼</span>
                        <span x-show="!open">▶</span>
                    </button>
                    <h3 @click="open = !open" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('External Marketplaces') }}</h3>
                </div>
                <div x-show="open" x-collapse>
                <div class="flex items-center gap-3 mb-4 pb-4 border-b">
                    <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                        <input type="hidden" name="gmc_exclude" value="0">
                        <input type="checkbox" name="gmc_exclude" value="1"
                               {{ product.gmcExclude|default(false) ? 'checked' }}
                               class="rounded-sm border-gray-300 dark:border-gray-700 text-red-600">
                        {{ __('Exclude from all external marketplaces') }}
                    </label>
                    <span class="text-xs px-2 py-0.5 rounded-full font-medium
                        {{ product.gmcExclude|default(false) ? 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300' : 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400' }}">
                        {{ product.gmcExclude|default(false) ? 'Excluded' : 'Included' }}
                    </span>
                    <span class="text-xs text-gray-400 dark:text-gray-500">({{ __('overrides channel settings for this product') }})</span>
                </div>
                <div class="grid grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Google Product Category') }}</label>
                        <select name="google_product_category" id="gmc-prod-category" onchange="toggleGmcFields()" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                            <option value="">— {{ __('Not set') }} —</option>
                            {% if gmc_default_category is defined and gmc_default_category is not empty %}
                            <option value="__global__" {{ (product is null or product.googleProductCategory is null or product.googleProductCategory == '__global__') ? 'selected' }}>{{ __('Use global') }}: {{ gmc_default_category }}</option>
                            {% endif %}
                            {% if product.googleProductCategory is defined and product.googleProductCategory is not empty and product.googleProductCategory != '__global__' %}
                            <option value="{{ product.googleProductCategory }}" selected>{{ product.googleProductCategory }}</option>
                            {% endif %}
                        </select>
                        <div class="mt-1 flex gap-2">
                            <button type="button" onclick="openGmcCategoryBrowser('gmc-prod-category')"
                                    class="text-xs text-gray-900 dark:text-gray-100 underline hover:text-gray-700">{{ __('Browse categories') }} 🔍</button>
                            {% if gmc_default_category is defined and gmc_default_category is not empty %}
                            <span class="text-xs text-gray-400 dark:text-gray-500">|</span>
                            <span class="text-xs text-gray-400 dark:text-gray-500">Default: {{ gmc_default_category }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Condition') }}</label>
                        <select name="condition" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                            {% for c in ['new', 'refurbished', 'used'] %}
                            <option value="{{ c }}" {{ (product.condition|default('new')) == c ? 'selected' }}>{{ c|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div data-gmc-field="apparel">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Gender') }}</label>
                        <select name="gender" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                            <option value="">— {{ __('Not set') }} —</option>
                            {% for g in ['male', 'female', 'unisex'] %}
                            <option value="{{ g }}" {{ (product.gender|default('')) == g ? 'selected' }}>{{ g|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div data-gmc-field="apparel">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Age Group') }}</label>
                        <select name="age_group" class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200">
                            <option value="">— {{ __('Not set') }} —</option>
                            {% for a in ['newborn', 'infant', 'toddler', 'kids', 'adult'] %}
                            <option value="{{ a }}" {{ (product.ageGroup|default('')) == a ? 'selected' }}>{{ a|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Color') }}</label>
                        <input type="text" name="color" value="{{ product.color|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200" placeholder="e.g. Red">
                    </div>
                    <div data-gmc-field="apparel">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Size') }}</label>
                        <input type="text" name="size" value="{{ product.size|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200" placeholder="e.g. M, 42, XL">
                    </div>
                    <div data-gmc-field="apparel">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Material') }}</label>
                        <input type="text" name="material" value="{{ product.material|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200" placeholder="e.g. Cotton">
                    </div>
                    <div data-gmc-field="apparel">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Pattern') }}</label>
                        <input type="text" name="pattern" value="{{ product.pattern|default('') }}"
                               class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs dark:bg-gray-800 dark:text-gray-200" placeholder="e.g. Striped">
                    </div>
                </div>
                <div class="border-t pt-4">
                    <details class="group">
                        <summary class="text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer select-none group-open:text-gray-900 dark:text-gray-100">{{ __('Custom Labels (for Shopping campaigns)') }}</summary>
                        <div class="grid grid-cols-2 gap-4 mt-3">
                            {% for i in 0..4 %}
                            {% set label_key = 'custom_label_' ~ i %}
                            {% set getter = 'customLabel' ~ i %}
                            <div>
                                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Custom Label {{ i }}</label>
                                <input type="text" name="{{ label_key }}" value="{{ attribute(product, getter)|default('') }}"
                                       class="w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs text-sm">
                            </div>
                            {% endfor %}
                        </div>
                    </details>
                </div>
            </div>
            </div>
            {% endif %}

            {# Upsells & Cross-sells #}
            {% set _upsells_empty = is_edit and (product.upsellIds|default([])|length == 0) and (product.crossSellIds|default([])|length == 0) %}
            <div x-data="relationManager()" class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="relations_card">
                <div class="flex items-center gap-2" :class="sectionOpen ? 'mb-4' : ''">
                    <button type="button" @click="sectionOpen = !sectionOpen" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                        <span x-show="sectionOpen">▼</span>
                        <span x-show="!sectionOpen">▶</span>
                    </button>
                    <h3 @click="sectionOpen = !sectionOpen" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('Upsells & Cross-sells') }}</h3>
                </div>
                <div x-show="sectionOpen" x-collapse>

                {% include 'admin/components/product-multi-picker.twig' with {
                    label: __('Upsells'),
                    hint: __('Customers who buy this product may also be interested in these products.'),
                    hidden_name: 'upsell_ids',
                    hidden_model: 'upsellsJson',
                    query_model: 'upsellSearch',
                    results_var: 'filteredUpsells',
                    selected_var: 'selectedUpsells',
                    open_var: 'upsellOpen',
                    loading_var: 'allProductsLoading',
                    focus_method: 'loadAllProducts',
                    add_method: 'addUpsell',
                    remove_method: 'removeUpsell',
                    wrapper_class: 'mb-4'
                } %}

                {# Cross-sells #}
                {% include 'admin/components/product-multi-picker.twig' with {
                    label: __('Cross-sells'),
                    hint: __('Customers who buy this product may also add these products to their cart.'),
                    hidden_name: 'cross_sell_ids',
                    hidden_model: 'crossellsJson',
                    query_model: 'crossellSearch',
                    results_var: 'filteredCrossells',
                    selected_var: 'selectedCrossells',
                    open_var: 'crossellOpen',
                    loading_var: 'allProductsLoading',
                    focus_method: 'loadAllProducts',
                    add_method: 'addCrossell',
                    remove_method: 'removeCrossell'
                } %}
                </div>
            </div>

            {# Variations #}
            {% set _variations_empty = is_edit and (variations|default([])|length == 0) %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-xs" data-panel-id="variations_card" x-data="variationsManager()" @apply-sale-dates.window="applySaleDatesToAll()">
                <div class="grid grid-cols-3 items-center" :class="sectionOpen ? 'mb-4' : ''">
                    <div class="flex items-center gap-2">
                        <button type="button" @click="sectionOpen = !sectionOpen" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-xs leading-none select-none w-4 text-center">
                            <span x-show="sectionOpen">▼</span>
                            <span x-show="!sectionOpen">▶</span>
                        </button>
                        <h3 @click="sectionOpen = !sectionOpen" class="text-base font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">{{ __('Variations') }}</h3>
                    </div>
                    <div class="flex items-center justify-center gap-2">
                        <button type="button" @click="collapseAll()" class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700">{{ __('Collapse All') }}</button>
                        <button type="button" @click="expandAll()" class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700">{{ __('Expand All') }}</button>
                        <button type="button" @click="addVariation()"
                                class="rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-800">
                            + {{ __('Add Variation') }}
                        </button>
                    </div>
                    <div></div>
                </div>
                <div x-show="sectionOpen" x-collapse>

                <div x-show="items.length === 0" class="py-6 text-center text-sm text-gray-400">
                    {{ __('No variations yet. Click "Add Variation" to add size, color, or other options.') }}
                </div>

                <div id="variations-sortable" class="space-y-0">
                <template x-for="(item, idx) in items" :key="item._key">
                    <div class="mb-4 rounded-lg border border-gray-200 p-4 bg-gray-50 dark:bg-gray-800/50">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <button type="button" @click="item.collapsed = !item.collapsed"
                                        class="text-xs text-gray-400 hover:text-gray-700 w-4 text-center leading-none select-none"
                                        x-html="item.collapsed ? '&#9654;' : '&#9660;'"></button>
                                <span class="drag-handle text-gray-300 hover:text-gray-500 dark:text-gray-400 select-none text-lg leading-none cursor-grab">⠿</span>
                                <span class="text-sm font-semibold text-gray-700 dark:text-gray-300" x-text="'Variation #' + (idx + 1)"></span>
                                <span x-show="item.collapsed" class="text-xs text-gray-500 dark:text-gray-400 ml-1 truncate max-w-xs"
                                      x-text="(item.attrs.filter(a => a.value).map(a => a.value).join(', ') || '(no attributes)') + (item.price ? ' — ' + item.price : '')"></span>
                            </div>
                            <div class="flex items-center gap-1">
                                <button type="button" @click="moveTop(idx)" title="{{ __('Move to top') }}"
                                        class="text-xs text-gray-400 hover:text-gray-700 px-1 leading-none">⇈</button>
                                <button type="button" @click="moveUp(idx)" title="{{ __('Move up') }}"
                                        class="text-xs text-gray-400 hover:text-gray-700 px-1 leading-none">↑</button>
                                <button type="button" @click="moveDown(idx)" title="{{ __('Move down') }}"
                                        class="text-xs text-gray-400 hover:text-gray-700 px-1 leading-none">↓</button>
                                <button type="button" @click="moveBottom(idx)" title="{{ __('Move to bottom') }}"
                                        class="text-xs text-gray-400 hover:text-gray-700 px-1 leading-none">⇊</button>
                                <span class="mx-1 text-gray-300">|</span>
                                <button type="button" @click="removeVariation(idx)"
                                        class="text-xs text-red-500 hover:text-red-700">Remove</button>
                            </div>
                        </div>
                        <input type="hidden" :name="'variations[' + idx + '][id]'" :value="item.id || ''">

                        <div x-show="!item.collapsed">

                        {# Attributes #}
                        <div class="mb-3">
                            <label class="block text-xs font-medium text-gray-600 mb-1">{{ __('Attributes') }}</label>
                            <template x-for="(attr, ai) in item.attrs" :key="ai">
                                <div class="flex items-center gap-2 mb-1">
                                    <input type="text" :name="'variations[' + idx + '][attr_name][]'" x-model="attr.name"
                                           placeholder="e.g. Color" class="w-1/3 rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                                    <input type="text" :name="'variations[' + idx + '][attr_value][]'" x-model="attr.value"
                                           placeholder="e.g. Red" class="w-1/3 rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                                    <button type="button" @click="item.attrs.splice(ai, 1)" class="text-gray-400 hover:text-red-500 text-xs">✕</button>
                                </div>
                            </template>
                            <button type="button" @click="item.attrs.push({name:'', value:''})"
                                    class="mt-1 text-xs text-gray-900 dark:text-gray-100 hover:text-gray-800">+ {{ __('Add attribute') }}</button>
                            <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{{ __('Leave value empty for free text input on frontend. Use commas for dropdown options (e.g. Red,Blue,Black).') }}</p>
                        </div>

                        {# Price / SKU / Stock #}
                        <div class="grid grid-cols-4 gap-2">
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Price') }}</label>
                                <input type="number" step="0.01" min="0" :name="'variations[' + idx + '][price]'" x-model="item.price"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">Sale Price</label>
                                <input type="number" step="0.01" min="0" :name="'variations[' + idx + '][sale_price]'" x-model="item.sale_price"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('SKU') }}</label>
                                <input type="text" :name="'variations[' + idx + '][sku]'" x-model="item.sku"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">{{ __('Stock Qty') }}</label>
                                <input type="number" min="0" :name="'variations[' + idx + '][stock_quantity]'" x-model="item.stock_quantity"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-sm px-2 py-1">
                            </div>
                        </div>

                        {# Sale Schedule #}
                        <div class="mt-2 grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">Sale Starts</label>
                                <input type="datetime-local" :name="'variations[' + idx + '][sale_price_start]'" x-model="item.sale_price_start"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1">
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 dark:text-gray-400">Sale Ends</label>
                                <input type="datetime-local" :name="'variations[' + idx + '][sale_price_end]'" x-model="item.sale_price_end"
                                       class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1">
                            </div>
                        </div>

                        {# Variation Image #}
                        <div class="mt-3 flex items-center gap-3">
                            <label class="block text-xs text-gray-500 dark:text-gray-400 w-12 shrink-0">{{ __('Image') }}</label>
                            <input type="hidden" :name="'variations[' + idx + '][image_id]'" :value="item.image_id || ''">
                            <button type="button" @click.prevent="openVarImageBrowser(idx)"
                                    class="rounded-sm border-2 overflow-hidden hover:border-gray-500 transition-colors flex items-center justify-center"
                                    :class="item.imageThumb ? 'w-12 h-12 p-0 border-solid border-gray-200' : 'border-dashed border-gray-300 dark:border-gray-700 px-3 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:text-gray-100'">
                                <img x-show="item.imageThumb" :src="item.imageThumb" class="w-full h-full object-cover" alt="">
                                <span x-show="!item.imageThumb" class="text-xs">📷 Set</span>
                            </button>
                            <button x-show="item.image_id" type="button" @click.prevent="removeVarImage(idx)"
                                    class="text-xs text-red-500 hover:text-red-700">✕ Remove</button>
                        </div>

                        {# Variation Download #}
                        <div class="mt-3 border-t border-gray-200 pt-3">
                            <label class="block text-xs font-medium text-gray-600 mb-1">{{ __('Download Source') }}</label>
                            <select :name="'variations[' + idx + '][download_mode]'" x-model="item.download_mode"
                                    class="w-full rounded-sm border-gray-300 dark:border-gray-700 text-xs px-2 py-1 mb-2">
                                <option value="use_parent">{{ __('Inherit parent product setting') }}</option>
                                <option value="internal">{{ __('Internal file') }}</option>
                                <option value="external">{{ __('External file') }}</option>
                                <option value="physical">{{ __('Physical (no download)') }}</option>
                            </select>

                            <div x-show="item.download_mode === 'internal'" class="mb-2">
                                <input type="hidden" :name="'variations[' + idx + '][download_file_id]'" :value="item.download_file_ids.length ? item.download_file_ids[0] : ''">
                                <template x-for="fid in item.download_file_ids" :key="'var-dl-hidden-' + idx + '-' + fid">
                                    <input type="hidden" :name="'variations[' + idx + '][download_file_ids][]'" :value="fid">
                                </template>
                                <div class="flex items-center gap-2">
                                <button type="button" @click.prevent="$dispatch('open-shared-download-modal', { target: 'variation', index: idx })"
                                        class="rounded-sm border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-2 py-1 text-xs hover:bg-gray-50 dark:bg-gray-800/50 dark:text-gray-100"
                                        x-text="item.download_file_ids.length ? '📎 Add / Manage files' : '📎 Pick files'">
