function closeGmcBrowser() {
    var modal = document.getElementById('gmc-browse-modal');
    if (modal) modal.classList.add('hidden');
}

var gmcCurrentPage = 1, gmcCurrentQuery = '', gmcTotalPages = 1;

function gmcLoadPage(page) {
    gmcCurrentPage = page;
    var q = gmcCurrentQuery ? '&q=' + encodeURIComponent(gmcCurrentQuery) : '';
    var list = document.getElementById('gmc-browse-list');
    var pagination = document.getElementById('gmc-browse-pagination');
    list.innerHTML = '<div class="p-4 text-center text-gray-400">{{ __('Loading…') }}</div>';
    var url = (window.APP_BASE_PATH || '') + '/admin/gmc/taxonomy?page=' + page + '&per_page=50' + q;
    fetch(url).then(function(r){ return r.json(); }).then(function(data) {
        gmcTotalPages = data.meta.total_pages;
        if (data.data.length === 0) {
            list.innerHTML = '<div class="p-4 text-center text-gray-400">No categories found.</div>';
        } else {
            var html = '';
            for (var i = 0; i < data.data.length; i++) {
                var cat = data.data[i];
                html += '<div class="px-3 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer rounded dark:text-gray-200" onclick="gmcSelect(\'' + cat.replace(/'/g, "\\'") + '\')">' + cat + '</div>';
            }
            list.innerHTML = html;
        }
        pagination.innerHTML = 'Page ' + data.meta.page + ' of ' + data.meta.total_pages + ' (' + data.meta.total + ' categories)';
        if (data.meta.page < data.meta.total_pages) {
            pagination.innerHTML += ' <button type="button" onclick="gmcLoadPage(' + (data.meta.page + 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700">Next &rarr;</button>';
        }
        if (data.meta.page > 1) {
            pagination.innerHTML = '<button type="button" onclick="gmcLoadPage(' + (data.meta.page - 1) + ')" class="underline text-gray-900 dark:text-gray-100 hover:text-gray-700">&larr; Previous</button> ' + pagination.innerHTML;
        }
    }).catch(function(){
        list.innerHTML = '<div class="p-4 text-center text-red-400">Error loading categories.</div>';
    });
}

function gmcSearch(query) {
    gmcCurrentQuery = query;
    gmcLoadPage(1);
}

function gmcSelect(category) {
    var modal = document.getElementById('gmc-browse-modal');
    if (modal && modal._targetId) {
        var target = document.getElementById(modal._targetId);
        if (target && target.tagName === 'SELECT') {
            // Check if option already exists
            var existing = Array.from(target.options).find(function(o) { return o.value === category; });
            if (!existing) {
                var opt = document.createElement('option');
                opt.value = category;
                opt.text = category;
                target.appendChild(opt);
            }
            target.value = category;
            if (target.id === 'gmc-prod-category') toggleGmcFields();
        }
    }
    closeGmcBrowser();
}

function toggleGmcFields() {
    var sel = document.getElementById('gmc-prod-category');
    var val = sel ? sel.value : '';
    var isApparel = val === '' || /Apparel|Clothing|Shoes|Accessories|Jewelry|Watches|Bags|Luggage/i.test(val);
    document.querySelectorAll('[data-gmc-field]').forEach(function(el) {
        el.style.display = isApparel ? '' : 'none';
    });
}

window.VL_COUNTRY_CODES = {{ country_codes|default([])|json_encode|raw }};

window.VL_SHIPPING_COUNTRY_OPTIONS = (function() {
    var raw = '{{ shipping_countries|default('')|e('js') }}';
    var company = '{{ shop_country|default('')|e('js') }}';
    if (!raw) return [];
    return raw.split(',').map(function(c) { return c.trim().toUpperCase(); }).filter(Boolean).filter(function(c) {
        return c !== company && (window.VL_COUNTRY_CODES || []).indexOf(c) !== -1;
    });
})();

function parseVarOverrides(json) {
    try { var p = JSON.parse(json); return (p && typeof p === 'object' && !Array.isArray(p)) ? p : {}; } catch(e) { return {}; }
}
function updateVarOverride(item, ccode, cls) {
    const overrides = parseVarOverrides(item.shipping_country_overrides);
    if (!overrides[ccode]) overrides[ccode] = {};
    overrides[ccode].class = cls;
    item.shipping_country_overrides = JSON.stringify(overrides);
}
function updateVarOverrideCost(item, ccode, cost) {
    const overrides = parseVarOverrides(item.shipping_country_overrides);
    if (!overrides[ccode]) overrides[ccode] = {};
    overrides[ccode].class = 'custom';
    overrides[ccode].cost = parseFloat(cost) || 0;
    item.shipping_country_overrides = JSON.stringify(overrides);
}
function updateVarOverrideTime(item, ccode, key, value) {
    const overrides = parseVarOverrides(item.shipping_country_overrides);
    if (!overrides[ccode]) overrides[ccode] = {};
    const num = value === '' ? null : parseInt(value, 10);
    overrides[ccode][key] = (num === null || Number.isNaN(num)) ? null : num;
    item.shipping_country_overrides = JSON.stringify(overrides);
}
function removeVarOverride(item, ccode) {
    const overrides = parseVarOverrides(item.shipping_country_overrides);
    delete overrides[ccode];
    item.shipping_country_overrides = JSON.stringify(overrides);
}
function addVarOverride(item, ccode, cls) {
    if (!ccode) return;
    const overrides = parseVarOverrides(item.shipping_country_overrides);
    overrides[ccode] = { class: cls || 'use_global' };
    item.shipping_country_overrides = JSON.stringify(overrides);
}
function availableCountriesExcluding(overridesJson) {
    var all = window.VL_SHIPPING_COUNTRY_OPTIONS || [];
    var existing = Object.keys(parseVarOverrides(overridesJson));
    return all.filter(function(c) { return existing.indexOf(c) === -1; });
}

var _countryNames = null;
function countryName(code) {
    if (!_countryNames) {
        try { _countryNames = new Intl.DisplayNames(['en'], { type: 'region' }); } catch(e) { _countryNames = { of: function(c) { return c; } }; }
    }
    return _countryNames.of(code) || code;
}
function countryOptionLabel(code) {
    return countryName(code) + ' (' + code + ')';
}

function relationManager() {
    const bp = window.APP_BASE_PATH || '';
    const productId = {{ product ? product.id : 0 }};
    const upsellInitial = {{ (product ? product.upsellIds : [])|default([])|json_encode|raw }};
    const crossellInitial = {{ (product ? product.crossSellIds : [])|default([])|json_encode|raw }};
    return {
        sectionOpen: {{ (is_edit and not _upsells_empty) ? 'true' : 'false' }},
        ...vlProductPool({ withVariations: true }),
        upsellOpen: false,
        upsellSearch: '',
        selectedUpsells: [],
        upsellsJson: JSON.stringify(upsellInitial),
        crossellOpen: false,
        crossellSearch: '',
        selectedCrossells: [],
        crossellsJson: JSON.stringify(crossellInitial),
        upsellSearchTimer: null,
        crossellSearchTimer: null,
        async init() {
            if (upsellInitial.length > 0) {
                const loaded = await this.fetchProductsByIds(upsellInitial);
                this.selectedUpsells = loaded;
            }
            if (crossellInitial.length > 0) {
                const loaded = await this.fetchProductsByIds(crossellInitial);
                this.selectedCrossells = loaded;
            }
        },
        async fetchProductsByIds(ids) {
            if (!ids.length) return [];
            const url = `${bp}/admin/products/list-json?ids=${ids.join(',')}`;
            try {
                const res = await fetch(url);
                return await res.json();
            } catch { return []; }
        },
        get filteredUpsells() {
            const q = (this.upsellSearch || '').trim().toLowerCase();
            let items = this.allProducts || [];
            if (q) items = items.filter(p => (p.name || '').toLowerCase().includes(q) || (p.sku || '').toLowerCase().includes(q));
            const selected = new Set((this.selectedUpsells || []).map(sp => Number(sp.id)));
            return items.filter(p => Number(p.id) !== productId && !selected.has(Number(p.id)));
        },
        get filteredCrossells() {
            const q = (this.crossellSearch || '').trim().toLowerCase();
            let items = this.allProducts || [];
            if (q) items = items.filter(p => (p.name || '').toLowerCase().includes(q) || (p.sku || '').toLowerCase().includes(q));
            const selected = new Set((this.selectedCrossells || []).map(sp => Number(sp.id)));
            return items.filter(p => Number(p.id) !== productId && !selected.has(Number(p.id)));
        },        addUpsell(p) {
            if (this.selectedUpsells.some(sp => Number(sp.id) === Number(p.id))) return;
            this.selectedUpsells.push({ id: Number(p.id), name: p.name, sku: p.sku || '' });
            this.upsellsJson = JSON.stringify(this.selectedUpsells.map(sp => Number(sp.id)));
            this.upsellSearch = '';
        },
        removeUpsell(id) {
            this.selectedUpsells = this.selectedUpsells.filter(sp => Number(sp.id) !== Number(id));
            this.upsellsJson = JSON.stringify(this.selectedUpsells.map(sp => Number(sp.id)));
        },
        addCrossell(p) {
            if (this.selectedCrossells.some(sp => Number(sp.id) === Number(p.id))) return;
            this.selectedCrossells.push({ id: Number(p.id), name: p.name, sku: p.sku || '' });
            this.crossellsJson = JSON.stringify(this.selectedCrossells.map(sp => Number(sp.id)));
            this.crossellSearch = '';
        },
        removeCrossell(id) {
            this.selectedCrossells = this.selectedCrossells.filter(sp => Number(sp.id) !== Number(id));
            this.crossellsJson = JSON.stringify(this.selectedCrossells.map(sp => Number(sp.id)));
        },
    };
}

function shippingCountryOverrides() {
    return {
        availableCountries: window.VL_SHIPPING_COUNTRY_OPTIONS || [],
        rules: {},
        newCountry: '',
        newClass: 'use_global',
        json: '{}',
        init() {
            {% if product is not null and product.shippingCountryOverrides is defined %}
            var initial = {{ product.shippingCountryOverrides|default({})|json_encode|raw }};
            {% else %}
            var initial = {};
            {% endif %}
            try {
                var parsed = typeof initial === 'object' && initial !== null ? initial : {};
                this.rules = Object.assign({}, parsed);
            } catch(e) {
                this.rules = {};
            }
            this.json = JSON.stringify(this.rules);
        },
        remove(cc) {
            var r = Object.assign({}, this.rules);
            delete r[cc];
            this.rules = r;
            this.json = JSON.stringify(this.rules);
        },
        updateJson() {
            this.json = JSON.stringify(this.rules);
        }
    };
}

