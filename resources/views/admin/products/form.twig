            '<div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col mx-4" onclick="event.stopPropagation()">' +
            '<div class="flex items-center justify-between border-b dark:border-gray-700 px-5 py-3">' +
            '<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Browse Google Categories</h3>' +
            '<button type="button" onclick="closeGmcBrowser()" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>' +
            '</div>' +
            '<div class="px-5 py-3 border-b dark:border-gray-700">' +
            '<input type="text" id="gmc-browse-search" placeholder="Search categories..." class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm" oninput="gmcSearch(this.value)">' +
