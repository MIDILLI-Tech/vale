{% extends "admin/layout.twig" %}

{% block title %}{{ __('Roles & Permissions') }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Roles & Permissions') }}</h1>
    <a href="{{ url('/admin/roles/create') }}"
       class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
        + {{ __('New Role') }}
    </a>
</div>

{% import "admin/partials/_table.twig" as table %}

<div x-data="dataTable({perPage: 20, serverSide: false, sortBy: '', sortDir: 'desc', search: '', perPage: 20})">
    <div class="mb-4 flex items-center gap-3">
        {{ table.search('Search roles…') }}
        {{ table.columnsToggle() }}
    </div>
    <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr>
                    {{ table.th('Name', 'name') }}
                    {{ table.th('Slug', 'slug') }}
                    {{ table.th('Description', 'description') }}
                    {{ table.th('Permissions', 'permissions') }}
                    {{ table.th('Type', 'type') }}
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
                <tbody x-ref="items" class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">

                {% for role in roles %}
                <tr data-row-id="{{ role.id }}" data-sort="{{ {name: role.name, slug: role.slug, description: role.description ?? '', permissions: role.permissionIds|length, type: role.system ? 'System' : 'Custom'}|json_encode|e('html_attr') }}">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-gray-100">
                        <a href="{{ url('/admin/roles/' ~ role.id ~ '/edit') }}" class="text-gray-900 dark:text-gray-100 hover:underline">{{ role.name }}</a>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                        <code class="rounded-sm bg-gray-100 px-1.5 py-0.5 text-xs">{{ role.slug }}</code>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">{{ role.description ?? '—' }}</td>
                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-800">
                            {{ role.permissionIds|length }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm">
                        {% if role.system %}
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ __('System') }}</span>
                        {% else %}
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs text-green-700">{{ __('Custom') }}</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right text-sm">
                        <div class="inline-flex items-center justify-end gap-2">
                            <a href="{{ url('/admin/roles/' ~ role.id ~ '/edit') }}"
                               class="rounded-sm px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-gray-300 dark:ring-gray-700 hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800">{{ __('Edit') }}</a>
                            {% if not role.system %}
                            <form method="post" action="{{ url('/admin/roles/' ~ role.id ~ '') }}"
                                  onsubmit="return confirm('{{ __('Delete this role?')|e('js') }}')">
                                {{ csrf_field() }}
                                <input type="hidden" name="_METHOD" value="DELETE">
                                <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">{{ __('Delete') }}</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-400">
                        {{ __('No roles yet.') }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ table.pagination() }}
</div>

{# Permissions overview #}
{% if permissions %}
<div class="mt-8">
    <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">{{ __('Available Permissions') }}</h2>
    {% set groups = {} %}
    {% for perm in permissions %}
        {% set g = perm.groupName ?? 'General' %}
        {% set groups = groups|merge({(g): (groups[g] ?? [])|merge([perm])}) %}
    {% endfor %}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for group, perms in groups %}
        <div class="rounded-xl border bg-white dark:bg-gray-900 p-4 shadow-xs">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ groupLabels[group] ?? group }}</h3>
            <ul class="space-y-1">
                {% for perm in perms %}
                <li class="text-sm text-gray-700">
                    <code class="mr-1 rounded-sm bg-gray-100 px-1 text-xs">{{ perm.slug }}</code>{{ perm.name }}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
