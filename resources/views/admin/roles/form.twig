{% extends "admin/layout.twig" %}

{% block title %}{{ is_edit ? __('Edit Role') : __('New Role') }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-3">
    <a href="{{ url('/admin/roles') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700">← {{ __('Roles') }}</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
        {{ is_edit ? __('Edit Role') : __('New Role') }}
    </h1>
</div>

<form method="post" action="{{ url(is_edit ? '/admin/roles/' ~ role.id : '/admin/roles') }}">
    {{ csrf_field() }}
    {% if is_edit %}
    <input type="hidden" name="_METHOD" value="PUT">
    {% endif %}

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        {# ── Main column ─── #}
        <div class="lg:col-span-2 space-y-6">

            {# Basic Info #}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
                <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('Role Info') }}</h2>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="name">{{ __('Name') }} <span class="text-red-500">*</span></label>
                    <input type="text" id="name" name="name"
                           value="{{ role.name ?? '' }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:outline-hidden focus:ring-1 focus:ring-gray-500"
                           required>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="slug">{{ __('Slug') }}</label>
                    <input type="text" id="slug" name="slug"
                           value="{{ role.slug ?? '' }}"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm font-mono focus:border-gray-600 focus:outline-hidden focus:ring-1 focus:ring-gray-500"
                           {% if is_edit and role.system %}readonly{% endif %}>
                    {% if is_edit and role.system %}
                    <p class="mt-1 text-xs text-gray-400">{{ __('System role slugs cannot be changed.') }}</p>
                    {% endif %}
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="description">{{ __('Description') }}</label>
                    <textarea id="description" name="description" rows="3"
                              class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-2 text-sm focus:border-gray-600 focus:outline-hidden focus:ring-1 focus:ring-gray-500">{{ role.description ?? '' }}</textarea>
                </div>
            </div>

            {# Permissions #}
            {% if permissions %}
            <div class="rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
                <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('Permissions') }}</h2>

                {% set groups = {} %}
                {% for perm in permissions %}
                    {% set g = perm.groupName ?? 'General' %}
                    {% set groups = groups|merge({(g): (groups[g] ?? [])|merge([perm])}) %}
                {% endfor %}

                {% for group, perms in groups %}
                <div class="mb-5">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ groupLabels[group] ?? group }}</span>
                        <button type="button"
                                class="text-xs text-gray-700 hover:text-gray-800"
                                onclick="toggleGroup('group-{{ loop.index }}')">
                            {{ __('Toggle all') }}
                        </button>
                    </div>
                    <div id="group-{{ loop.index }}" class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        {% for perm in perms %}
                        <label class="flex items-start gap-2 rounded-lg border border-gray-100 p-2 hover:bg-gray-50 dark:bg-gray-800/50 cursor-pointer">
                            <input type="checkbox" name="permission_ids[]" value="{{ perm.id }}"
                                   class="mt-0.5 h-4 w-4 rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100"
                                   {% if role and perm.id in role.permissionIds %}checked{% endif %}>
                            <span>
                                <span class="block text-sm font-medium text-gray-800">{{ perm.name }}</span>
                                <code class="text-xs text-gray-400">{{ perm.slug }}</code>
                            </span>
                        </label>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

        </div>

        {# ── Sidebar ─── #}
        <div class="space-y-4">
            <div class="rounded-xl border bg-white dark:bg-gray-900 p-5 shadow-xs">
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('Save') }}</h2>
                <button type="submit"
                        class="w-full rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    {{ is_edit ? __('Update Role') : __('Create Role') }}
                </button>
                <a href="{{ url('/admin/roles') }}"
                   class="mt-2 flex items-center justify-center rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:bg-gray-800/50">
                    {{ __('Cancel') }}
                </a>
            </div>

            {% if is_edit and role %}
            <div class="rounded-xl border bg-white dark:bg-gray-900 p-5 shadow-xs">
                <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{{ __('Info') }}</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400">{{ __('ID') }}: <span class="font-mono">{{ role.id }}</span></p>
                {% if role.system %}
                <p class="mt-2 text-xs text-amber-600">⚠ {{ __('This is a system role and cannot be deleted.') }}</p>
                {% endif %}
            </div>
            {% endif %}
        </div>

    </div>
</form>

<script>
function toggleGroup(id) {
    const group = document.getElementById(id);
    if (!group) return;
    const boxes = group.querySelectorAll('input[type=checkbox]');
    const anyUnchecked = Array.from(boxes).some(b => !b.checked);
    boxes.forEach(b => b.checked = anyUnchecked);
}

// Auto-slug from name (only on create)
{% if not is_edit %}
document.getElementById('name').addEventListener('input', function () {
    const slug = this.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    document.getElementById('slug').value = slug;
});
{% endif %}
</script>
{% endblock %}
