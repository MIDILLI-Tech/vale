{% extends "admin/layout.twig" %}

{% block title %}{{ __('Confirm plugin update') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Confirm plugin update') }}</h1>

    <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-900 dark:bg-amber-950/40">
        <p class="text-sm text-amber-900 dark:text-amber-200">
            {{ __('The new version of plugin :slug requests capabilities the installed version does not declare:', {':slug': plugin_slug}) }}
        </p>

        <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {% for cap in new_capabilities %}
            <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-semibold bg-amber-100 text-amber-800 ring-1 ring-inset ring-amber-600/20 dark:bg-amber-900/40 dark:text-amber-300 dark:ring-amber-500/30">{{ cap }}</span>
            {% endfor %}
        </div>

        <p class="mt-4 text-xs leading-5 text-amber-800 dark:text-amber-300">
            {{ __('Capabilities let a plugin read environment values, run processes, execute code, touch files or open network connections. Approve only updates from a source you trust.') }}
        </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
        <form method="POST" action="{{ url('/admin/plugins/update') }}">
            {{ csrf_field() }}
            <input type="hidden" name="slug" value="{{ plugin_slug }}">
            <input type="hidden" name="acknowledge_version" value="{{ new_version }}">
            <button type="submit"
                    class="rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700 dark:bg-amber-700 dark:hover:bg-amber-600">
                {{ __('Update to v:version anyway', {':version': new_version}) }}
            </button>
        </form>
        <a href="{{ url('/admin/plugins') }}"
           class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50 dark:text-gray-200 dark:ring-gray-700 dark:hover:bg-gray-800">
            {{ __('Cancel') }}
        </a>
    </div>
</div>
{% endblock %}
