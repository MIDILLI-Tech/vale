<script src="{{ url('/assets/build/charts.js') }}"></script>
<script>
document.addEventListener('alpine:init', function () {
    Alpine.data('analyticsDatePresets', function () {
        function fmt(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }
        return {
            setPreset(key) {
                var today = new Date();
                var from, to = new Date(today);

                switch (key) {
                    case '7d':
                        from = new Date(today); from.setDate(from.getDate() - 7);
                        break;
                    case '30d':
                        from = new Date(today); from.setDate(from.getDate() - 30);
                        break;
                    case '90d':
                        from = new Date(today); from.setDate(from.getDate() - 90);
                        break;
                    case 'thisMonth':
                        from = new Date(today.getFullYear(), today.getMonth(), 1);
                        break;
                    case 'lastMonth':
                        from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                        to = new Date(today.getFullYear(), today.getMonth(), 0);
                        break;
                    default:
                        return;
                }

                this.$refs.fromInput.value = fmt(from);
                this.$refs.toInput.value = fmt(to);
            }
        };
    });
});
</script>
<script>
(function () {
    const statusCard = document.querySelector('[data-card-id="status-codes"]');
    if (!statusCard) return;

    const tabs = statusCard.querySelectorAll('[data-status-tab]');
    const panels = statusCard.querySelectorAll('[data-status-panel]');
    const activeCls = ['border-blue-600', 'text-blue-600', 'dark:text-blue-400', 'font-semibold'];
    const inactiveCls = ['border-transparent', 'text-gray-500', 'hover:text-gray-700', 'dark:text-gray-400', 'dark:hover:text-gray-200'];

    tabs.forEach((btn) => {
        btn.addEventListener('click', () => {
            const key = btn.dataset.statusTab;
            tabs.forEach((tab) => {
                const on = tab === btn;
                tab.classList.remove(...activeCls, ...inactiveCls);
                tab.classList.add(...(on ? activeCls : inactiveCls));
                tab.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            panels.forEach((panel) => {
                panel.hidden = panel.dataset.statusPanel !== key;
            });
        });
    });
})();

// JS strings + date range for the AJAX "load more" lists
window.VL_ANALYTICS_LIST = {
    days: {{ range_days }},
    from: {{ (range_query_from ?? '')|json_encode|raw }},
    to: {{ (range_query_to ?? '')|json_encode|raw }},
    limit: {{ list_limit }}
};

(function () {
    const config = window.VL_ANALYTICS_LIST || {};

    const SORT_KEY = 'vl_analytics_sort';

    let sortState = readSortState();
    let utmFilters = {};

    function readSortState() {
        try {
            return JSON.parse(window.localStorage.getItem(SORT_KEY) || '{}') || {};
        } catch (e) {
            return {};
        }
    }

    function saveSortState() {
        try {
            window.localStorage.setItem(SORT_KEY, JSON.stringify(sortState));
        } catch (e) {
            /* storage unavailable (private mode) — sorting still works, just not persisted */
        }
    }

    /** Date range shared by every request. */
    function addSharedParams(params) {
        if (config.days) params.set('days', String(config.days));
        if (config.from) params.set('from', config.from);
        if (config.to) params.set('to', config.to);
    }

    /** The sort/facet state of the card a list body belongs to. */
    function sortCardOf(el) {
        const holder = el ? el.closest('[data-vl-sort-card]') : null;
        return holder ? holder.dataset.vlSortCard : null;
    }

    /**
     * Page size for a list. Cards that open with a deliberately small window
     * (the Top Products tile grid) declare it on the list body so the first
     * sort refresh and every "load more" batch keep the same window.
     */
    function listLimit(el) {
        const body = el ? el.closest('[data-vl-list-body]') : null;
        const own  = body ? Number(body.dataset.vlListLimit || 0) : 0;

        return own > 0 ? own : (config.limit || 100);
    }

    function addCardParams(params, card) {
        const state = sortState[card];
        if (state) {
            params.set('sort', state.col);
            params.set('dir', state.dir);
        }
        if (card === 'utm') {
            Object.keys(utmFilters).forEach(function (key) {
                params.set(key, utmFilters[key]);
            });
        }
    }

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-vl-analytics-more]');
        if (!btn || btn.disabled) return;
        e.preventDefault();
        loadMore(btn);
    });

    function isElementVisible(el) {
        if (!el || !el.isConnected) return false;
        if (typeof el.checkVisibility === 'function') {
            return el.checkVisibility();
        }
        return el.offsetParent !== null && window.getComputedStyle(el).display !== 'none';
    }

    const observersMap = new WeakMap();

    function setupObserver(btn) {
        if (!('IntersectionObserver' in window)) return;

        const scrollContainer = btn.parentElement;
        if (!scrollContainer) return;

        btn.dataset.vlArmed = '1';

        let observer = observersMap.get(scrollContainer);
        if (!observer) {
            observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    const targetBtn = entry.target;
                    if (entry.isIntersecting) {
                        if (targetBtn.dataset.vlArmed === '1' && isElementVisible(targetBtn)) {
                            loadMore(targetBtn);
                        }
                    } else {
                        targetBtn.dataset.vlArmed = '1';
                    }
                });
            }, {
                root: scrollContainer,
                rootMargin: '100px 0px'
            });
            observersMap.set(scrollContainer, observer);
        }

        observer.observe(btn);
    }

    document.querySelectorAll('[data-vl-analytics-more]').forEach(function (btn) {
        setupObserver(btn);
    });

    // Also observe tab switches so when a hidden tab becomes visible,
    // its sentinel gets checked if already near bottom
    document.querySelectorAll('[data-status-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () {
            setTimeout(function () {
                const activePanel = document.querySelector('[data-status-panel]:not([hidden])');
                if (!activePanel) return;
                const btn = activePanel.querySelector('[data-vl-analytics-more]');
                if (btn && isElementVisible(btn) && btn.dataset.vlArmed === '1') {
                    const container = btn.parentElement;
                    if (container) {
                        const rect = btn.getBoundingClientRect();
                        const containerRect = container.getBoundingClientRect();
                        if (rect.top <= containerRect.bottom + 100) {
                            loadMore(btn);
                        }
                    }
                }
            }, 50);
        });
    });

    function loadMore(btn) {
        if (!isElementVisible(btn) || btn.disabled) return;

        btn.dataset.vlArmed = '0';

        const params = new URLSearchParams({
            list: btn.dataset.vlList,
            offset: btn.dataset.vlOffset || '0',
            limit: String(listLimit(btn)),
        });
        if (btn.dataset.vlSeries) params.set('series', btn.dataset.vlSeries);
        if (btn.dataset.vlType) params.set('type', btn.dataset.vlType);
        addSharedParams(params);
        addCardParams(params, sortCardOf(btn));

        const label = btn.querySelector('.vl-analytics-more-label');
        btn.disabled = true;
        btn.classList.add('is-loading');
        if (label) {
            const dark = document.documentElement.classList.contains('dark');
            const color = dark ? '#d1d5db' : '#4b5563';
            label.style.color = color;
            label.innerHTML = '<span class="vl-icon-refresh vl-icon-spin inline-block align-middle" style="color:inherit;"></span> '
                + (btn.dataset.vlLabel || '');
        }

        fetch((window.APP_BASE_PATH || '') + '/admin/analytics/list-rows?' + params.toString(), {
            headers: { 'Accept': 'application/json' },
        })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.html) {
                    btn.insertAdjacentHTML('beforebegin', res.html);
                }
                btn.dataset.vlOffset = String(res.offset ?? btn.dataset.vlOffset ?? '0');
                btn.disabled = false;
                btn.classList.remove('is-loading');
                if (label) {
                    label.innerHTML = '';
                    label.style.color = '';
                }
                if (res.has_more) {
                    continueOnScroll(btn);
                } else {
                    btn.remove();
                }
            })
            .catch(function () {
                btn.disabled = false;
                btn.classList.remove('is-loading');
                if (label) {
                    label.innerHTML = '';
                    label.style.color = '';
                }
                continueOnScroll(btn);
            });
    }

    function continueOnScroll(btn) {
        const container = btn.parentElement;
        if (!container) return;

        function onScroll() {
            container.removeEventListener('scroll', onScroll);
            if (!btn.isConnected) return;

            const rect = btn.getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const inView = rect.top <= containerRect.bottom + 100 && isElementVisible(btn);

            if (inView) {
                loadMore(btn);
            } else {
                btn.dataset.vlArmed = '1';
            }
        }

        container.addEventListener('scroll', onScroll, { passive: true });
    }

    // ── Column sorting (AJAX, no page reload) ───────────────────────────────

    function rearmSentinels(root) {
        (root || document).querySelectorAll('[data-vl-analytics-more]').forEach(function (btn) {
            setupObserver(btn);
        });
    }

    function fetchList(body, offset) {
        const params = new URLSearchParams({
            list: body.dataset.vlListBody,
            offset: String(offset),
            limit: String(listLimit(body)),
        });
        if (body.dataset.vlListSeries) params.set('series', body.dataset.vlListSeries);
        if (body.dataset.vlListType) params.set('type', body.dataset.vlListType);
        addSharedParams(params);
        addCardParams(params, body.dataset.vlSortCard);

        return fetch((window.APP_BASE_PATH || '') + '/admin/analytics/list-rows?' + params.toString(), {
            headers: { 'Accept': 'application/json' },
        }).then(function (r) { return r.json(); });
    }

    /**
     * Covers a card with the loading spinner while its list is being
     * re-fetched. A card can fire several requests at once (the status-code
     * card refreshes three panels), so the calls are reference-counted and the
     * overlay only leaves when the last one settles.
     */
    function cardLoading(el, on) {
        const card = (el && el.closest('[data-card-id]')) || el;
        if (!card) return;

        const pending = Math.max(0, Number(card.dataset.vlLoading || 0) + (on ? 1 : -1));
        card.dataset.vlLoading = String(pending);

        const overlay = card.querySelector(':scope > .vl-card-loading');

        if (pending === 0) {
            if (overlay) overlay.remove();
            return;
        }

        if (overlay) return;

        if (window.getComputedStyle(card).position === 'static') {
            card.style.position = 'relative';
        }

        const spinner = document.createElement('span');
        spinner.className = 'vl-icon-refresh vl-icon-spin';

        const label = document.createElement('span');
        label.className = 'vl-card-loading-label';
        label.appendChild(spinner);
        label.appendChild(document.createTextNode(tjs('Loading...')));

        const box = document.createElement('div');
        box.className = 'vl-card-loading';
        box.appendChild(label);
        card.appendChild(box);
    }

    /** Replaces one list body with its re-sorted page-one rows. */
    function refreshListBody(body) {
        cardLoading(body, true);
        fetchList(body, 0)
            .then(function (res) {
                if (typeof res.html !== 'string') return;
                body.innerHTML = res.html + (res.more_html || '');
                rearmSentinels(body);
            })
            .catch(function () { /* keep the previous rows on failure */ })
            .then(function () { cardLoading(body, false); });
    }

    /**
     * Re-sorts a whole card. The UTM card is re-rendered in one request (its
     * six panels share the facet state); other cards refresh each list body.
     */
    function refreshCard(card) {
        if (card === 'utm') {
            refreshUtm();
            return;
        }
        document.querySelectorAll('[data-vl-list-body]').forEach(function (body) {
            if (body.dataset.vlSortCard === card) {
                refreshListBody(body);
            }
        });
    }

    function utmParams() {
        const params = new URLSearchParams();
        Object.keys(utmFilters).forEach(function (key) {
            params.set(key, utmFilters[key]);
        });
        addCardParams(params, 'utm');
        addSharedParams(params);

        return params;
    }

    function refreshUtm() {
        const box = document.querySelector('[data-vl-utm-body]');
        if (!box) return;

        cardLoading(box, true);
        fetch((window.APP_BASE_PATH || '') + '/admin/analytics/utm-panel?' + utmParams().toString(), {
            headers: { 'Accept': 'application/json' },
        })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (typeof res.html !== 'string') return;
                box.innerHTML = res.html;
                // The chips live in the card header, outside the swapped body.
                const chips = document.querySelector('[data-vl-utm-filters]');
                if (chips && typeof res.filters_html === 'string') {
                    chips.innerHTML = res.filters_html;
                }
                // The header row is part of this body, so the freshly injected
                // button must be re-registered before the state is mirrored.
                box.querySelectorAll('[data-vl-sort-col]').forEach(function (btn) {
                    btn.dataset.vlSortBaseTitle = btn.title;
                });
                applySortUi('utm');
                rearmSentinels(box);
            })
            .catch(function () { /* keep the previous panels on failure */ })
            .then(function () { cardLoading(box, false); });
    }

    /** Mirrors a card's sort state onto its column labels. */
    function applySortUi(card) {
        const state = sortState[card];

        document.querySelectorAll('[data-vl-sort-col]').forEach(function (btn) {
            if (btn.dataset.vlSortCard !== card) return;

            const active = !!state && state.col === btn.dataset.vlSortCol;
            const icon = btn.querySelector('.vl-sort-icon');
            if (icon) icon.textContent = active ? (state.dir === 'asc' ? '↑' : '↓') : '';
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
            btn.title = active
                ? btn.dataset.vlSortBaseTitle + ' — ' + tjs(state.dir === 'asc' ? 'Sort ascending' : 'Sort descending')
                : btn.dataset.vlSortBaseTitle;
            ['text-gray-600', 'dark:text-gray-200', 'font-semibold'].forEach(function (cls) {
                btn.classList.toggle(cls, active);
            });
        });
    }

    // The server marks each card's default column, so its ↓ arrow is visible
    // before any interaction; a stored choice is layered on top of it.
    const domDefaultSort = {};
    document.querySelectorAll('[data-vl-sort-col]').forEach(function (btn) {
        btn.dataset.vlSortBaseTitle = btn.title;
        if (btn.dataset.vlSortActive === '1') {
            domDefaultSort[btn.dataset.vlSortCard] = {
                col: btn.dataset.vlSortCol,
                dir: btn.dataset.vlSortDefault || 'desc',
            };
        }
    });

    const storedSortState = sortState;
    sortState = Object.assign({}, domDefaultSort, storedSortState);

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-vl-sort-col]');
        if (!btn || !btn.dataset.vlSortCard) return;

        const card    = btn.dataset.vlSortCard;
        const col     = btn.dataset.vlSortCol;
        const current = sortState[card];

        // Clicking the active column flips the direction; a new column starts
        // at its own default (views → descending).
        const dir = current && current.col === col
            ? (current.dir === 'asc' ? 'desc' : 'asc')
            : (btn.dataset.vlSortDefault || 'desc');

        sortState[card] = { col: col, dir: dir };

        saveSortState();
        applySortUi(card);
        refreshCard(card);
    });

    // ── UTM facets (filters apply to every panel of the card) ──────────────

    document.addEventListener('click', function (e) {
        const facet = e.target.closest('[data-vl-utm-facet]');
        if (facet) {
            const key = facet.dataset.vlUtmFacet;
            const value = facet.dataset.vlUtmValue;
            if (utmFilters[key] === value) {
                delete utmFilters[key];
            } else {
                utmFilters[key] = value;
            }
            refreshUtm();
            return;
        }

        const clear = e.target.closest('[data-vl-utm-clear]');
        if (clear) {
            if (clear.dataset.vlUtmClear === 'all') {
                utmFilters = {};
            } else {
                delete utmFilters[clear.dataset.vlUtmClear];
            }
            refreshUtm();
        }
    });

    // Restore persisted sort state. Lists whose stored direction already
    // matches the server-rendered default need no refetch.
    document.addEventListener('DOMContentLoaded', function () {
        Object.keys(sortState).forEach(applySortUi);

        Object.keys(storedSortState).forEach(function (card) {
            const stored = storedSortState[card];
            const def    = domDefaultSort[card];
            if (def && def.col === stored.col && def.dir === stored.dir) return;
            refreshCard(card);
        });
    });
})();

const isDark = document.documentElement.classList.contains('dark');

const textColor = isDark ? '#e5e7eb' : '#374151';
const gridColor = isDark ? '#374151' : '#e5e7eb';

const dailyStats = {{ daily_stats|json_encode|raw }};
if (document.getElementById('traffic-chart')) {
    new Chart(document.getElementById('traffic-chart'), {
        type: 'line',
        data: {
            labels: dailyStats.map(d => d.date.slice(5)),
            datasets: [
                {
                    label: '{{ __('Pageviews') }}',
                    data: dailyStats.map(d => d.views),
                    borderColor: isDark ? '#60a5fa' : '#1f2937',
                    backgroundColor: isDark ? 'rgba(96,165,250,0.15)' : 'rgba(31,41,55,0.1)',
                    fill: true,
                    tension: 0.3,
                },
                {
                    label: '{{ __('Unique') }}',
                    data: dailyStats.map(d => d.unique),
                    borderColor: isDark ? '#34d399' : '#6b7280',
                    backgroundColor: isDark ? 'rgba(52,211,153,0.15)' : 'rgba(107,114,128,0.1)',
                    fill: true,
                    tension: 0.3,
                },
            ],
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            color: textColor,
            plugins: { legend: { position: 'top', labels: { color: textColor } } },
            scales: {
                x: { ticks: { color: textColor }, grid: { color: gridColor } },
                y: { beginAtZero: true, ticks: { precision: 0, color: textColor }, grid: { color: gridColor } },
            },
        },
    });
}

const browserData = {{ browsers|json_encode|raw }};
if (document.getElementById('browser-chart') && browserData.length > 0) {
    new Chart(document.getElementById('browser-chart'), {
        type: 'doughnut',
        data: {
            labels: browserData.map(b => b.browser),
            datasets: [{
                data: browserData.map(b => b.views),
                backgroundColor: isDark
                    ? ['#60a5fa','#34d399','#fbbf24','#f472b6','#a78bfa','#fb923c']
                    : ['#1f2937','#6b7280','#9ca3af','#d1d5db','#e5e7eb','#f3f4f6'],
            }],
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            color: textColor,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, color: textColor } } },
        },
    });
}

const deviceData = {{ devices|json_encode|raw }};
if (document.getElementById('device-chart') && deviceData.length > 0) {
    new Chart(document.getElementById('device-chart'), {
        type: 'doughnut',
        data: {
            labels: deviceData.map(d => d.device_type),
            datasets: [{
                data: deviceData.map(d => d.views),
                backgroundColor: isDark
                    ? ['#60a5fa','#34d399','#fbbf24']
                    : ['#1f2937','#6b7280','#9ca3af'],
            }],
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            color: textColor,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, color: textColor } } },
        },
    });
}

// Initialize reusable GridLayoutManager for analytics dashboard
document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.GridLayoutManager === 'undefined') return;

    new window.GridLayoutManager({
        container: '#analytics-grid',
        storageKey: 'vl_analytics_card_order',
        cardSelector: '[data-card-id]',
        cardIdAttr: 'data-card-id',
        handleSelector: '.drag-handle',
        groupName: 'analytics-rows',
        rowClass: 'analytics-row grid gap-4',
        cardSpans: {
            'traffic-over-time': 8,
            'top-referrers': 4,
            'browsers': 3,
            'devices': 3,
            'countries': 3,
            'cities': 3,
            'languages': 4,
            'status-codes': 8,
            'top-landing-pages': 6,
            'top-exit-pages': 6,
            'utm-tracking': 12,
            'top-pages': 6,
            'top-posts': 6,
            'top-products': 12,
        },
        rowDefinitions: [
            { id: 'traffic', cards: ['traffic-over-time', 'top-referrers'] },
            { id: 'technology', cards: ['browsers', 'devices', 'countries', 'cities'] },
            { id: 'language-status', cards: ['languages', 'status-codes'] },
            { id: 'entry-exit', cards: ['top-landing-pages', 'top-exit-pages'] },
            { id: 'utm', cards: ['utm-tracking'] },
            { id: 'pages-posts', cards: ['top-pages', 'top-posts'] },
            { id: 'products', cards: ['top-products'] },
        ]
    });
});
</script>
{% endblock %}
