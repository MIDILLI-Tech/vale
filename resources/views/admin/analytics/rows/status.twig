<div class="grid grid-cols-[3rem_minmax(0,1fr)_3.5rem] md:grid-cols-[4rem_minmax(0,1fr)_6rem_11rem] items-center gap-2 gap-y-1 text-xs rounded-md px-2 py-1.5 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
    <span class="font-mono font-bold text-center rounded-sm px-1.5 py-0.5 text-[11px] {{ row.status_code >= 500 ? 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300' : (row.status_code >= 400 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300') }}">
        {{ row.status_code }}
    </span>
    <a href="{{ site_url }}{{ row.page_url }}" target="_blank" class="truncate font-mono text-gray-700 dark:text-gray-300 hover:text-blue-600 hover:underline" title="{{ row.page_url }}">{{ row.page_url }}</a>
    <span class="tabular-nums font-semibold text-gray-900 dark:text-gray-100 text-right">{{ row.views }}</span>
    <span class="col-span-full md:col-span-1 text-[10px] md:text-xs tabular-nums text-gray-400 md:text-right">
        <span class="md:hidden">{{ __('Last Occurred') }}:</span>{{ row.last_seen }}
    </span>
</div>
