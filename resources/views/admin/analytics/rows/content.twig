{% if mode == 'product' %}
<a href="{{ url('/admin/products/' ~ row.id ~ '/edit') }}" class="h-full flex flex-col justify-center items-center rounded-lg border border-gray-100 bg-gray-50 dark:bg-gray-800/50 p-2.5 sm:p-3 text-center block hover:bg-gray-100 hover:border-gray-200 transition-colors">
    <p class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 break-words line-clamp-2 sm:line-clamp-3" title="{{ row.title }}">{{ row.title }}</p>
    <p class="mt-1 text-base sm:text-lg font-bold text-gray-900 dark:text-gray-100">{{ row.view_count }}</p>
    <p class="text-xs text-gray-400">{{ __('views') }}</p>
</a>
{% elseif mode == 'post' %}
<a href="{{ url('/admin/posts/' ~ row.id ~ '/edit') }}"
   class="grid grid-cols-[minmax(0,1fr)_5.5rem_3rem] items-center gap-2 text-sm rounded-sm px-1 py-0.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
    <span class="truncate text-gray-700 dark:text-gray-300" title="{{ row.title }}">{{ row.title }}</span>
    <span class="tabular-nums text-xs text-gray-400 text-right whitespace-nowrap">
        {% set pdur = row.avg_duration|default(0)|round(0) %}
        {% set pmins = (pdur // 60)|round(0, 'floor') %}
        {% set psecs = pdur % 60 %}
        {{ __(':minutes m :seconds s', {':minutes': pmins, ':seconds': '%02d'|format(psecs)}) }}
    </span>
    <span class="tabular-nums font-medium text-gray-900 dark:text-gray-100 text-right">{{ row.view_count }}</span>
</a>
{% else %}
<a href="{{ url('/admin/posts/' ~ row.id ~ '/edit') }}" class="flex items-center justify-between text-sm rounded-sm px-1 py-0.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
    <span class="truncate text-gray-700 dark:text-gray-300 max-w-[70%]" title="{{ row.title }}">{{ row.title }}</span>
    <span class="ml-2 shrink-0 font-medium text-gray-900 dark:text-gray-100">{{ row.view_count }}</span>
</a>
{% endif %}
