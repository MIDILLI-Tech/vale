<div class="flex min-w-0 items-center justify-between text-sm">
    {# Captured first so the truncated label and its tooltip stay identical. #}
    {%- set label -%}
        {%- if mode == 'country' -%}
            {{ country_name(row.country) }} ({{ row.country }})
        {%- elseif mode == 'language' -%}
            {{ language_name(row.language) }}
        {%- else -%}
            {{ row.city }}{{ row.country ? ' · ' ~ row.country : '' }}
        {%- endif -%}
    {%- endset -%}
    <span class="truncate text-gray-700 dark:text-gray-300" title="{{ label }}">{{ label }}</span>
    <span class="ml-2 shrink-0 font-medium text-gray-900 dark:text-gray-100">{{ row.views }}</span>
</div>
