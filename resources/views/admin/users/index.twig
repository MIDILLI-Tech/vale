{% extends "admin/layout.twig" %}
{% import "admin/partials/_table.twig" as table %}

{% block title %}{{ __('Users') }}{% endblock %}

{% block content %}
{% if two_factor_new_codes is defined %}
<div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4">
    <p class="text-sm font-bold text-red-800">{{ __('Recovery Codes — Show Once') }}</p>
    <p class="text-xs text-red-700 mt-1">{{ __('These codes will not be shown again. Save them before closing.') }}</p>
    <div class="grid grid-cols-2 gap-1 mt-2 bg-white p-3 rounded-sm font-mono text-xs text-red-900">
        {% for code in two_factor_new_codes %}
            <div>{{ code }}</div>
        {% endfor %}
    </div>
</div>
{% endif %}
<div x-data="{
    addOpen: false,
    editOpen: false,
    editId: null,
    editName: '',
    editEmail: '',
    editRole: '',
    editLocale: 'en',
    editIsActive: true,
    editTwoFactorEnabled: false,
    editTwoFactorSecret: false,
    editTwoFactorRecoveryCodes: [],

    openAdd() {
        this.addOpen = true;
    },
    openEdit(id, name, email, role, locale, isActive, twoFactorEnabled, twoFactorSecret, recoveryCodes) {
        this.editId = id;
        this.editName = name;
        this.editEmail = email;
        this.editRole = role;
        this.editLocale = locale;
        this.editIsActive = isActive;
        this.editTwoFactorEnabled = twoFactorEnabled;
        this.editTwoFactorSecret = !!twoFactorSecret;
        this.editTwoFactorRecoveryCodes = recoveryCodes || [];
        this.editOpen = true;
        // notify rolePicker inside the edit modal
        window.dispatchEvent(new CustomEvent('$refreshRole'));
    },
    closeEdit() {
        this.editOpen = false;
        this.editRole = '';
        window.dispatchEvent(new CustomEvent('$resetRole'));
    }
}" x-init="{% if 'users.create' in user_permissions %}vlAutoOpenModal('add', () => { addOpen = true; }){% endif %}">
{% set allIds = users|map(u => u.id) %}
<div x-data="dataTable({perPage: {{ per_page|default(20) }}{% if client_side is defined and not client_side %}, serverSide: true, page: {{ page }}, totalItems: {{ total }}, baseUrl: '{{ base_url|e('js') }}', search: '{{ (filters.search|default(''))|e('js') }}', sort: '{{ (filters.sort|default(''))|e('js') }}', dir: '{{ (filters.dir|default('desc'))|e('js') }}'{% endif %}})">
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 dark:text-white">{{ __('Users') }}</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400 dark:text-gray-400"><span x-text="visibleCount"></span> {{ __('users total') }}</p>
    </div>
    <div class="flex items-center gap-3">
        {% if 'users.create' in user_permissions %}
        <button type="button" @click="openAdd()"
           class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
            {{ __('Create User') }}
        </button>
        {% endif %}
        {% if 'roles.manage' in user_permissions %}
        <a href="{{ url('/admin/roles') }}"
           class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
            {{ __('Roles') }}
        </a>
        {% endif %}
    </div>
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    {{ table.search(__('Search') ~ '…') }}
    {{ table.columnsToggle() }}
</div>

<div class="overflow-x-auto rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 shadow-xs">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800/50 dark:bg-gray-800/50">
            <tr>
                {{ table.th_checkbox(allIds) }}
                {{ table.th(__('Name'), 'name') }}
                {{ table.th(__('Email'), 'email') }}
                {{ table.th(__('Role'), 'role') }}
                {{ table.th(__('Status'), 'is_active') }}
                {{ table.th_static(__('Actions'), 'right') }}
            </tr>
        </thead>
        <tbody x-ref="items" class="divide-y divide-gray-200 dark:divide-gray-700">
            {% for u in users %}
            <tr data-row-id="{{ u.id }}" class="hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800/50 transition-colors" data-sort="{{ {name: u.name, email: u.email, role: u.roles[0] ?? 'subscriber', is_active: u.isActive ? '1' : '0'}|json_encode|e('html_attr') }}">
                {{ table.td_checkbox(u.id) }}
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900 dark:text-gray-100 dark:text-gray-100">
                    <button type="button" @click="openEdit({{ u.id }}, '{{ u.name|e('js') }}', '{{ u.email|e('js') }}', '{{ (u.roles[0] ?? 'subscriber')|e('js') }}', '{{ u.locale|e('js') }}', {{ u.isActive ? 'true' : 'false' }}, {{ u.twoFactorEnabled ? 'true' : 'false' }}, '{{ u.twoFactorSecret|e('js') }}', {{ u.twoFactorRecoveryCodes|json_encode|e('html_attr') }})"
                            class="text-gray-900 dark:text-gray-100 dark:text-gray-100 hover:underline text-left font-medium">{{ u.name }}</button>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600 dark:text-gray-400">{{ u.email }}</td>
                <td class="whitespace-nowrap px-6 py-4 text-sm">
                    <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium
                        {{ u.roles[0] ?? '' in ['super_admin', 'admin'] ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-400' : 'bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-300' }}">
                        {{ u.roles[0] ?? 'subscriber' }}
                    </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm">
                    {% if u.isActive %}
                    <span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/30 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:text-green-400">{{ __('Active') }}</span>
                    {% else %}
                    <span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/30 px-2.5 py-0.5 text-xs font-medium text-red-800 dark:text-red-400">Inactive</span>
                    {% endif %}
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                    <div class="inline-flex items-center justify-end gap-2">
                        <button type="button" @click="openEdit({{ u.id }}, '{{ u.name|e('js') }}', '{{ u.email|e('js') }}', '{{ (u.roles[0] ?? 'subscriber')|e('js') }}', '{{ u.locale|e('js') }}', {{ u.isActive ? 'true' : 'false' }}, {{ u.twoFactorEnabled ? 'true' : 'false' }}, '{{ u.twoFactorSecret|e('js') }}', {{ u.twoFactorRecoveryCodes|json_encode|e('html_attr') }})"
                                class="rounded-sm px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-gray-300 dark:ring-gray-700 hover:bg-gray-50 dark:bg-gray-800/50 dark:hover:bg-gray-800">{{ __('Edit') }}</button>
                        <form method="POST" action="{{ url('/admin/users/' ~ u.id ~ '/anonymize') }}"
                              onsubmit="return confirm('{{ __('Anonymize user :name? Their profile, comments and subscriptions will be anonymized. Email will be preserved.', {':name': u.name})|e('js') }}')">
                            {{ csrf_field() }}
                            <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-orange-600 dark:text-orange-400 bg-white dark:bg-gray-800 ring-1 ring-orange-300 dark:ring-orange-700 hover:bg-orange-50 dark:hover:bg-orange-900/20">{{ __('Anonymize') }}</button>
                        </form>
                        <form method="POST" action="{{ url('/admin/users/' ~ u.id ~ '') }}"
                              onsubmit="return confirm('{{ __('Delete user :name? Comments will be anonymized, orders preserved. This action cannot be undone.', {':name': u.name})|e('js') }}')">
                            {{ csrf_field() }}
                            <input type="hidden" name="_METHOD" value="DELETE">
                            <button type="submit" class="rounded-sm px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-800 ring-1 ring-red-300 dark:ring-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">{{ __('Delete') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">{{ __('No users found.') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{{ table.pagination() }}
{% include 'admin/partials/_bulk_bar.twig' with {action: 'users', extraActions: [
    {label: __('Activate'), action: 'activate', class: 'bg-green-600/10 text-green-700 dark:text-green-400 hover:bg-green-600/20'},
    {label: __('Deactivate'), action: 'deactivate', class: 'bg-red-600/10 text-red-700 dark:text-red-400 hover:bg-red-600/20'},
    {label: __('Anonymize'), action: 'anonymize', class: 'bg-orange-600/10 text-orange-700 dark:text-orange-400 hover:bg-orange-600/20'},
]} %}
</div>

{# Create Modal #}
<div x-show="addOpen" x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
     @mousedown="if($event.target === $el) addOpen = false"
     @keydown.escape.window="addOpen = false">
    <div class="flex max-h-[85vh] w-full max-w-md flex-col overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-xl" @click.stop>
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ __('Create User') }}</h3>
            <button type="button" @click="addOpen = false" class="text-gray-400 hover:text-gray-600 text-lg leading-none">&times;</button>
        </div>
        <form method="POST" action="{{ url('/admin/users') }}" class="flex min-h-0 flex-1 flex-col">
            <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-6 py-4">
            {{ csrf_field() }}
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Name') }}</label>
                <input type="text" name="name" required class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" name="email" required class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Password') }}</label>
                <input type="password" name="password" required minlength="8" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Confirm Password') }}</label>
                <input type="password" name="password_confirmation" required class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Role') }}</label>
                <div x-data="rolePicker()" x-init="selectedRole = 'subscriber'">
                    <input type="hidden" name="role" :value="selectedRole">
                    <div class="flex flex-wrap gap-2">
                        <template x-for="roleMeta in [
                            {% for role in roles %}{'slug': '{{ role.slug|e('js') }}', 'name': '{{ role.name|e('js') }}'}{{ not loop.last ? ',' : '' }}
                            {% endfor %}
                        ]" :key="roleMeta.slug">
                            <button type="button" @click="pick(roleMeta.slug)"
                                    :class="isSelected(roleMeta.slug)
                                        ? 'rounded-full bg-gray-900 px-3.5 py-1.5 text-xs font-medium text-white border border-gray-900'
                                        : 'rounded-full bg-gray-100 px-3.5 py-1.5 text-xs font-medium text-gray-700 border border-gray-200 hover:bg-gray-200'"
                                    x-text="roleMeta.name"></button>
                        </template>
                    </div>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Language') }}</label>
                <select name="locale" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
                    {% for code, name in supported_locales %}
                    <option value="{{ code }}">{{ locale_name(code) }}</option>
                    {% endfor %}
                </select>
            </div>
            {% if two_factor_global %}
                {% if two_factor_forced_global %}
                <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-3">
                    <p class="text-xs font-semibold text-yellow-800">{{ __('Two-Factor Authentication is required for all users.') }}</p>
                </div>
                {% else %}
                <div>
                    <label class="flex items-center gap-2 text-sm text-gray-700">
                        <input type="checkbox" name="enable_2fa" value="1"
                               class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                        {{ __('Enable Two-Factor Authentication') }}
                    </label>
                </div>
                {% endif %}
            {% endif %}
            </div>
            <div class="vl-modal-actions">
                <button type="button" @click="addOpen = false" class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/50">{{ __('Cancel') }}</button>
                <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">{{ __('Save') }}</button>
            </div>
        </form>
    </div>
</div>

{# Edit Modal #}
<div x-show="editOpen" x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
     @mousedown="if($event.target === $el) closeEdit()"
     @keydown.escape.window="closeEdit()">
    <div class="flex max-h-[85vh] w-full max-w-md flex-col overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-xl" @mousedown.stop>
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ __('Edit User') }}</h3>
            <button type="button" @click="closeEdit()" class="text-gray-400 hover:text-gray-600 text-lg leading-none">&times;</button>
        </div>
        <form method="POST" :action="'{{ url('/admin/users')|e('js') }}/' + editId" class="flex min-h-0 flex-1 flex-col">
            <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-6 py-4">
            {{ csrf_field() }}
            <input type="hidden" name="_METHOD" value="PUT">
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Name') }}</label>
                <input type="text" name="name" required x-model="editName" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" name="email" required x-model="editEmail" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Password') }}</label>
                <input type="password" name="password" minlength="8" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Role') }}</label>
                <div x-data="rolePicker()"
                     x-init="
                         window.addEventListener('$refreshRole', () => { selectedRole = editRole; });
                         window.addEventListener('$resetRole',  () => { selectedRole = ''; });
                     ">
                    <input type="hidden" name="role" :value="selectedRole">
                    <div class="flex flex-wrap gap-2">
                        <template x-for="roleMeta in [
                            {% for role in roles %}{'slug': '{{ role.slug|e('js') }}', 'name': '{{ role.name|e('js') }}'}{{ not loop.last ? ',' : '' }}
                            {% endfor %}
                        ]" :key="roleMeta.slug">
                            <button type="button" @click="pick(roleMeta.slug)"
                                    :class="isSelected(roleMeta.slug)
                                        ? 'rounded-full bg-gray-900 px-3.5 py-1.5 text-xs font-medium text-white border border-gray-900'
                                        : 'rounded-full bg-gray-100 px-3.5 py-1.5 text-xs font-medium text-gray-700 border border-gray-200 hover:bg-gray-200'"
                                    x-text="roleMeta.name"></button>
                        </template>
                    </div>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">{{ __('Language') }}</label>
                <select name="locale" x-model="editLocale" class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
                    {% for code, name in supported_locales %}
                    <option value="{{ code }}">{{ locale_name(code) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="flex items-center gap-2">
                <input type="checkbox" id="edit-active" name="is_active" value="1" x-model="editIsActive" class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                <label for="edit-active" class="text-sm text-gray-700">{{ __('Active') }}</label>
            </div>
            {% if two_factor_global %}
                <div x-show="editTwoFactorEnabled" class="rounded-lg border border-yellow-200 bg-yellow-50 p-3 space-y-3">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <p class="text-xs font-bold text-yellow-800">{{ __('Two-Factor Authentication is enabled') }}</p>
                            {% if two_factor_forced_global %}
                                <p class="text-[10px] text-yellow-700 mt-0.5">{{ __('Resetting will force the user to re-enroll on next login.') }}</p>
                            {% endif %}
                        </div>
                        <button type="submit" name="disable_2fa" value="1"
                                :onclick="editTwoFactorEnabled && '{{ two_factor_forced_global }}' == '1' ? 'return confirm(\'{{ __('Reset 2FA for this user? They will be forced to set it up again on next login.')|e('js') }}\')' : 'return confirm(\'{{ __('Are you sure you want to disable 2FA for this user?')|e('js') }}\')'"
                                class="rounded-lg bg-red-600 dark:bg-red-700 px-2 py-1 text-[10px] font-bold text-white hover:bg-red-700 dark:hover:bg-red-800 shrink-0">
                            <span x-text="'{{ two_factor_forced_global }}' == '1' ? '{{ __('Reset 2FA')|e('js') }}' : '{{ __('Disable 2FA')|e('js') }}'"></span>
                        </button>
                    </div>

                    <template x-if="editTwoFactorRecoveryCodes.length > 0">
                        <div class="border-t border-yellow-300 pt-2">
                            <div class="flex items-center justify-between mb-1">
                                <p class="text-[10px] font-semibold text-yellow-800">{{ __('Recovery Codes') }}</p>
                                <button type="submit" name="regenerate_2fa_codes" value="1"
                                        onclick="return confirm('{{ __('Regenerate recovery codes for this user? Old codes will stop working.')|e('js') }}')"
                                        class="text-[10px] font-medium text-yellow-800 hover:text-yellow-900 underline">
                                    {{ __('Regenerate') }}
                                </button>
                            </div>
                            <div class="grid grid-cols-2 gap-x-2 gap-y-0.5 font-mono text-[10px] text-yellow-800">
                                <template x-for="code in editTwoFactorRecoveryCodes">
                                    <div x-text="code"></div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>

                <div x-show="!editTwoFactorEnabled">
                    <div x-show="editTwoFactorSecret && '{{ two_factor_forced_global }}' != '1'" class="rounded-lg border border-blue-200 bg-blue-50 p-3 space-y-2">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <p class="text-xs font-bold text-blue-800">{{ __('Two-Factor Authentication is pending setup') }}</p>
                                <p class="text-[10px] text-blue-700 mt-0.5">{{ __('A secret has been provisioned. This user must complete setup on their next login.') }}</p>
                            </div>
                            <button type="submit" name="disable_2fa" value="1"
                                    onclick="return confirm('{{ __('Clear the provisioned 2FA secret for this user?')|e('js') }}')"
                                    class="rounded-lg bg-blue-600 dark:bg-blue-700 px-2 py-1 text-[10px] font-bold text-white hover:bg-blue-700 dark:hover:bg-blue-800 shrink-0">
                                {{ __('Clear') }}
                            </button>
                        </div>
                    </div>

                    <div x-show="!editTwoFactorSecret && '{{ two_factor_forced_global }}' != '1'">
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" name="enable_2fa" value="1"
                                   class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                            {{ __('Enable Two-Factor Authentication') }}
                        </label>
                    </div>

                    <div x-show="'{{ two_factor_forced_global }}' == '1'" class="rounded-lg border border-yellow-200 bg-yellow-50 p-3">
                        <p class="text-xs font-semibold text-yellow-800">{{ __('Two-Factor Authentication is required. This user must set up 2FA on their next login.') }}</p>
                    </div>
                </div>
            {% endif %}
            </div>
            <div class="vl-modal-actions">
                <button type="button" @click="closeEdit()" class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/50">{{ __('Cancel') }}</button>
                <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">{{ __('Save') }}</button>
            </div>
        </form>
    </div>
</div>
</div>
{% endblock %}
