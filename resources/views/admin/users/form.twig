{% extends "admin/layout.twig" %}

{% block title %}{{ is_edit ? __('Edit') ~ ' ' ~ __('User') : __('Create') ~ ' ' ~ __('User') }}{% endblock %}

{% block content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
        {{ is_edit ? __('Edit') ~ ' ' ~ __('User') : __('Create') ~ ' ' ~ __('User') }}
    </h1>
    <a href="{{ url('/admin/users') }}" class="mt-1 text-sm text-gray-900 dark:text-gray-100 hover:text-gray-800">&larr; {{ __('Back to Users') }}</a>
</div>

<div class="max-w-2xl rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 dark:bg-gray-900 p-6 shadow-xs">
    {% if errors is defined %}
    <div class="mb-4 rounded-lg bg-red-50 p-3">
        <ul class="text-sm text-red-800">
            {% for field, msgs in errors %}
                {% for msg in msgs %}
                <li>{{ msg }}</li>
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form method="POST"
          action="{{ url(is_edit ? '/admin/users/' ~ user.id : '/admin/users') }}"
          class="space-y-5">
        {{ csrf_field() }}
        {% if is_edit %}
        <input type="hidden" name="_METHOD" value="PUT">
        {% endif %}

        <div>
            <label for="name" class="block text-sm font-medium text-gray-700">{{ __('Name') }} <span class="text-red-500">*</span></label>
            <input type="text" id="name" name="name" required
                   value="{{ old.name ?? user.name ?? '' }}"
                   class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
        </div>

        <div>
            <label for="email" class="block text-sm font-medium text-gray-700">{{ __('Email') }} <span class="text-red-500">*</span></label>
            <input type="email" id="email" name="email" required
                   value="{{ old.email ?? user.email ?? '' }}"
                   class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
        </div>

        <div>
            <label for="password" class="block text-sm font-medium text-gray-700">
                {{ __('Password') }}{% if not is_edit %} <span class="text-red-500">*</span>{% endif %}
                {% if is_edit %}
                <span class="text-xs text-gray-400">({{ __('leave blank to keep current') }})</span>
                {% endif %}
            </label>
            <input type="password" id="password" name="password" minlength="8" {{ not is_edit ? 'required' : '' }}
                   pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*\W).{8,}"
                   title="{{ __('Password must be at least 8 characters, include at least one uppercase letter, one lowercase letter, one number, and one special character.') }}"
                   class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
        </div>

        {% if not is_edit %}
        <div>
            <label for="password_confirmation" class="block text-sm font-medium text-gray-700">{{ __('Confirm Password') }} <span class="text-red-500">*</span></label>
            <input type="password" id="password_confirmation" name="password_confirmation" required minlength="8"
                   pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*\W).{8,}"
                   title="{{ __('Password must be at least 8 characters, include at least one uppercase letter, one lowercase letter, one number, and one special character.') }}"
                   class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
        </div>
        {% endif %}

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{{ __('Role') }}</label>
            <div x-data="rolePicker()" x-init="selectedRole = '{{ (user ? user.roles[0] ?? 'subscriber')|e('js') }}'">
                <div class="flex flex-wrap gap-2">
                    <template x-for="roleMeta in [
                        {% for role in roles %}{'slug': '{{ role.slug|e('js') }}', 'name': '{{ role.name|e('js') }}'}{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    ]" :key="roleMeta.slug">
                        <button type="button" @click="pick(roleMeta.slug)"
                                :class="isSelected(roleMeta.slug)
                                    ? 'rounded-full bg-gray-900 px-3.5 py-1.5 text-xs font-medium text-white border border-gray-900'
                                    : 'rounded-full bg-gray-100 px-3.5 py-1.5 text-xs font-medium text-gray-700 border border-gray-200 hover:bg-gray-200'"
                                x-text="roleMeta.name"></button>
                    </template>
                </div>
                <input type="hidden" name="role" :value="selectedRole">
            </div>
        </div>

        <div>
            <label for="locale" class="block text-sm font-medium text-gray-700">{{ __('Language') }}</label>
            <select id="locale" name="locale"
                    class="mt-1 block w-full rounded-lg border-gray-300 dark:border-gray-700 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
                {% for code, name in supported_locales %}
                <option value="{{ code }}" {{ (old.locale ?? (user ? user.locale : 'en')) == code ? 'selected' : '' }}>{{ locale_name(code) }}</option>
                {% endfor %}
            </select>
        </div>

        {% if is_edit %}
        <div class="space-y-4 border-t pt-4">
            <div class="flex items-center">
                <input type="checkbox" id="is_active" name="is_active" value="1"
                       {{ (old.is_active ?? (user ? user.isActive : true)) ? 'checked' : '' }}
                       class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                <label for="is_active" class="ml-2 text-sm text-gray-700">{{ __('Active') }}</label>
            </div>

            {% if two_factor_global %}
                {% if user.twoFactorEnabled %}
                <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4 space-y-3">
                    <div class="flex items-start justify-between">
                        <div>
                            <p class="text-sm font-bold text-yellow-800">{{ __('Two-Factor Authentication is enabled') }}</p>
                            <p class="text-xs text-yellow-700">{{ __('If the user lost access to their device, you can disable or reset it here.') }}</p>
                        </div>
                        {% if two_factor_forced_global %}
                        <button type="submit" name="disable_2fa" value="1"
                                onclick="return confirm('{{ __('Reset 2FA for this user? They will be forced to set it up again on next login.') }}')"
                                class="rounded-lg bg-red-600 dark:bg-red-700 px-3 py-1.5 text-xs font-bold text-white hover:bg-red-700 dark:hover:bg-red-800 shrink-0">
                            {{ __('Reset 2FA') }}
                        </button>
                        {% else %}
                        <button type="submit" name="disable_2fa" value="1"
                                onclick="return confirm('{{ __('Are you sure you want to disable 2FA for this user?') }}')"
                                class="rounded-lg bg-yellow-600 dark:bg-yellow-700 px-3 py-1.5 text-xs font-bold text-white hover:bg-yellow-700 dark:hover:bg-yellow-800 shrink-0">
                            {{ __('Disable 2FA') }}
                        </button>
                        {% endif %}
                    </div>
                    {% if user.twoFactorRecoveryCodes %}
                    <div class="border-t border-yellow-300 pt-3">
                        <div class="flex items-center justify-between mb-1">
                            <p class="text-xs font-semibold text-yellow-800">{{ __('Recovery Codes') }}</p>
                            <button type="submit" name="regenerate_2fa_codes" value="1"
                                    onclick="return confirm('{{ __('Regenerate recovery codes for this user? Old codes will stop working.') }}')"
                                    class="text-xs font-medium text-yellow-800 hover:text-yellow-900 underline">
                                {{ __('Regenerate') }}
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-1 font-mono text-xs text-yellow-800">
                            {% for code in user.twoFactorRecoveryCodes %}
                                <div>{{ code }}</div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>
                {% elseif not two_factor_forced_global %}
                    {% if user.twoFactorSecret %}
                    <div class="rounded-lg border border-blue-200 bg-blue-50 p-4">
                        <p class="text-sm font-bold text-blue-800">{{ __('Two-Factor Authentication is pending setup') }}</p>
                        <p class="text-xs text-blue-700 mt-1">{{ __('A secret has been provisioned. This user must complete setup on their next login.') }}</p>
                    </div>
                    {% else %}
                    <label class="flex items-center gap-2 text-sm text-gray-700">
                        <input type="checkbox" name="enable_2fa" value="1" {{ old.enable_2fa is defined and old.enable_2fa ? 'checked' : '' }}
                               class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                        {{ __('Enable Two-Factor Authentication') }}
                    </label>
                    {% endif %}
                {% else %}
                <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4">
                    <p class="text-sm font-bold text-yellow-800">{{ __('Two-Factor Authentication is required') }}</p>
                    <p class="text-xs text-yellow-700 mt-1">{{ __('This user must set up 2FA on their next login. No action is needed here.') }}</p>
                </div>
                {% endif %}
                {% if two_factor_new_codes is defined %}
                <div class="rounded-lg border border-red-300 bg-red-50 p-4">
                    <p class="text-sm font-bold text-red-800">{{ __('Recovery Codes — Show Once') }}</p>
                    <p class="text-xs text-red-700 mt-1">{{ __('These codes will not be shown again. Save them before closing.') }}</p>
                    <div class="grid grid-cols-2 gap-1 mt-2 bg-white p-3 rounded-sm font-mono text-xs text-red-900">
                        {% for code in two_factor_new_codes %}
                            <div>{{ code }}</div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            {% endif %}
        </div>
        {% elseif two_factor_global %}
            {% if two_factor_forced_global %}
            <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4">
                <p class="text-sm font-bold text-yellow-800">{{ __('Two-Factor Authentication is required') }}</p>
                <p class="text-xs text-yellow-700 mt-1">{{ __('The new user must set up 2FA on their first login. No action is needed here.') }}</p>
            </div>
            {% else %}
            <div>
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" name="enable_2fa" value="1" {{ old.enable_2fa is defined and old.enable_2fa ? 'checked' : '' }}
                           class="rounded-sm border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 shadow-xs focus:ring-gray-500">
                    {{ __('Enable Two-Factor Authentication') }}
                </label>
                <p class="text-xs text-gray-500 mt-1">{{ __('A TOTP secret and recovery codes will be generated for this user.') }}</p>
            </div>
            {% endif %}
        {% endif %}

        <div class="flex items-center space-x-3 pt-2">
            <button type="submit"
                    class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
                {{ __('Save') }}
            </button>
            <a href="{{ url('/admin/users') }}" class="rounded-lg border px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:bg-gray-800/50">
                {{ __('Cancel') }}
            </a>
        </div>
    </form>
</div>
{% endblock %}
