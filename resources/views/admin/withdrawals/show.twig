{% extends "admin/layout.twig" %}

{% block title %}{{ __('Withdrawal :reference', {':reference': withdrawal.reference}) }}{% endblock %}

{% block content %}
{% set status_labels = {
    pending:   __('Pending'),
    accepted:  __('Accepted'),
    rejected:  __('Rejected'),
    completed: __('Completed')
} %}
{% set status_colors = {
    pending:   'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    accepted:  'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
    rejected:  'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
    completed: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300'
} %}

<div class="mb-6 flex flex-wrap items-center gap-3">
    <a href="{{ url('/admin/withdrawals') }}" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">← {{ __('Withdrawals') }}</a>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ withdrawal.reference }}</h1>
    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold {{ status_colors[withdrawal.status]|default('bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300') }}">
        {{ status_labels[withdrawal.status]|default(withdrawal.status|capitalize) }}
    </span>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-2 space-y-6">
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 space-y-4">
            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ __('Declaration') }}</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Withdrawal period') }}</dt>
                    <dd class="font-medium text-gray-900 dark:text-gray-100">
                        {{ withdrawal.deadlineAt ? withdrawal.deadlineAt|date('Y-m-d') : '—' }}
                        {% if withdrawal.late %}<span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">{{ __('Late') }}</span>{% elseif withdrawal.deadlineEstimated %}<span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-semibold text-gray-700 dark:bg-gray-800 dark:text-gray-300">{{ __('Estimated') }}</span>{% endif %}
                    </dd>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Submitted') }}</dt>
                    <dd class="mt-0.5 text-gray-900 dark:text-gray-100">{{ withdrawal.createdAt ? withdrawal.createdAt|date('Y-m-d H:i') : '—' }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Source') }}</dt>
                    <dd class="mt-0.5 text-gray-900 dark:text-gray-100">{{ withdrawal.source }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Order number') }}</dt>
                    <dd class="mt-0.5 font-mono text-gray-900 dark:text-gray-100">#{{ withdrawal.orderNumber }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Locale') }}</dt>
                    <dd class="mt-0.5 text-gray-900 dark:text-gray-100">{{ withdrawal.locale }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Name') }}</dt>
                    <dd class="mt-0.5 text-gray-900 dark:text-gray-100">{{ withdrawal.customerName ?: '—' }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">{{ __('Email') }}</dt>
                    <dd class="mt-0.5 text-gray-900 dark:text-gray-100">{{ withdrawal.customerEmail }}</dd>
                </div>
            </dl>

            {% if withdrawal.items is not empty %}
            <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Items covered by this withdrawal') }}</h3>
                <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
                    {% for item in withdrawal.items %}
                    <li>{{ item.quantity }} × {{ item.product_name }}{% if item.variation %} <span class="text-gray-500 dark:text-gray-400">({{ item.variation }})</span>{% endif %}</li>
                    {% endfor %}
                </ul>
            </div>
            {% elseif withdrawal.itemsNote %}
            <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Items') }}</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-line">{{ withdrawal.itemsNote }}</p>
            </div>
            {% endif %}

            {% if withdrawal.reason %}
            <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">{{ __('Reason') }}</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-line">{{ withdrawal.reason }}</p>
            </div>
            {% endif %}
        </div>

        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">{{ __('Process withdrawal') }}</h2>
            <form method="post" action="{{ url('/admin/withdrawals/' ~ withdrawal.id ~ '/status') }}" class="space-y-4">
                {{ csrf_field() }}
                <div class="max-w-xs">
                    <label for="withdrawal-status" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Status') }}</label>
                    <select id="withdrawal-status" name="status" class="w-full rounded-lg border-gray-300 dark:border-gray-700 text-sm dark:bg-gray-800 dark:text-gray-100">
                        {% for status in statuses %}
                        <option value="{{ status }}" {{ withdrawal.status == status ? 'selected' }}>{{ status_labels[status]|default(status) }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="withdrawal-note" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{{ __('Internal note') }}</label>
                    <textarea id="withdrawal-note" name="admin_note" rows="3"
                              class="w-full rounded-lg border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 text-sm">{{ withdrawal.adminNote|default('') }}</textarea>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white dark:bg-gray-100 dark:text-gray-900">{{ __('Save') }}</button>
                </div>
            </form>
        </div>
    </div>

    <div class="space-y-6">
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 space-y-3 text-sm">
            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ __('Order') }}</h2>
            {% if order %}
            <p>
                <a href="{{ url('/admin/orders/' ~ order.id) }}" class="font-mono font-medium underline text-gray-900 dark:text-gray-100">#{{ order.orderNumber }}</a>
            </p>
            <p class="text-gray-600 dark:text-gray-400">{{ __('Status') }}: {{ order.status }}</p>
            <p class="text-gray-600 dark:text-gray-400">{{ __('Total') }}: {{ order.total|price(order.currency) }}</p>
            <p class="text-gray-600 dark:text-gray-400">{{ __('Placed') }}: {{ order.createdAt ? order.createdAt|date('Y-m-d') : '—' }}</p>
            {% else %}
            <p class="text-gray-500 dark:text-gray-400">{{ __('No order matched the number and email.') }}</p>
            {% endif %}
        </div>

        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 space-y-2 text-sm">
            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ __('Processing') }}</h2>
            <p class="text-gray-600 dark:text-gray-400">{{ __('Processed at') }}: {{ withdrawal.processedAt ? withdrawal.processedAt|date('Y-m-d H:i') : '—' }}</p>
            {% if withdrawal.ipAddress %}
            <p class="text-gray-600 dark:text-gray-400">{{ __('IP address') }}: <span class="font-mono">{{ withdrawal.ipAddress }}</span></p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
