            },
            get titleLen() {
                return String(this.metaTitle || '').length;
            },
            get descLen() {
                return String(this.metaDesc || '').length;
            },
            async init() {
                this.syncLiveFields();
                if (this.imageId > 0) {
                    const [found] = await fetchMediaByIds(bp, [this.imageId]);
                    if (found) this.thumbnailUrl = found.thumbnail || found.url;
                }
                const sync = () => this.syncLiveFields();
                document.addEventListener('input', (event) => {
                    if (!event.target) return;
                    const match = event.target.matches('#title, input[name="name"], #excerpt, textarea[name="short_description"], textarea[name="excerpt"]');
                    if (match) sync();
                });
                document.addEventListener('change', (event) => {
                    if (!event.target) return;
                    const match = event.target.matches('#title, input[name="name"], #excerpt, textarea[name="short_description"], textarea[name="excerpt"]');
                    if (match) sync();
                });
            },
            removeImage() {
                this.imageId = 0;
                this.thumbnailUrl = '';
            },
            async loadMediaPage(page = 1) {
                this.loading = true;
                try {
                    const data = await fetchImageMediaPage(bp, page, this.mediaQuery, 40);
                    this.mediaItems = data.items || [];
                    this.mediaPage = data.page || page;
                    this.mediaTotalPages = data.total_pages || 1;
                } finally {
                    this.loading = false;
                }
            },
            async prevMediaPage() {
                if (this.mediaPage > 1) await this.loadMediaPage(this.mediaPage - 1);
            },
            async nextMediaPage() {
                if (this.mediaPage < this.mediaTotalPages) await this.loadMediaPage(this.mediaPage + 1);
            },
            async openBrowser() {
                this.showModal = true;
                this.mediaQuery = '';
                if (this.imageId > 0) {
                    const foundPage = await findImagePageById(bp, this.imageId, 40);
                    await this.loadMediaPage(foundPage);
                } else if (this.mediaItems.length === 0) {
                    await this.loadMediaPage(1);
                }
            },
            async refreshMedia() {
                clearMediaCache();
                this.mediaItems = [];
                await this.loadMediaPage(1);
            },
            onSearchInput() {
                clearTimeout(this.searchTimer);
                this.searchTimer = setTimeout(() => this.loadMediaPage(1), 300);
            },
            selectImage(item) {
                this.imageId = item.id;
                this.thumbnailUrl = item.thumbnail || item.url;
                this.showModal = false;
            },
            // Drag-drop upload (assets/js/media-upload.js): reload the grid
            // and auto-select the first uploaded image.
            async handleDroppedFiles(result) {
                await this.refreshMedia();
                const first = (result && result.uploaded || [])[0];
                if (first) this.selectImage(first);
            }
        };
    };
    </script>

    {# Shared media browse helpers (used by featuredImage / productGallery / mediaPicker across all admin pages) #}
    <script>
    window.CLIENT_SEARCH_FETCH_LIMIT = {{ client_search_fetch_limit|default(100) }};
    const _mediaBrowseCache = new Map();
    async function _mediaBrowseFetch(url) {
        if (_mediaBrowseCache.has(url)) return _mediaBrowseCache.get(url);
        const res = await fetch(url);
        const data = await res.json();
        _mediaBrowseCache.set(url, data);
        return data;
    }
    function clearMediaCache() { _mediaBrowseCache.clear(); _clientMediaStore.reset(); }

    function getContentLanguageForMedia() {
        const sel = document.getElementById('language');
        if (sel && sel.value) return sel.value;
        if (typeof window.getEditorContentLanguage === 'function') return window.getEditorContentLanguage();
        if (typeof window._VL_CONTENT_LANG === 'string' && window._VL_CONTENT_LANG) return window._VL_CONTENT_LANG;
        return '';
    }

    /**
     * Client-side media store: when the library (per type + lang) has at most
     * CLIENT_SEARCH_FETCH_LIMIT files, it is preloaded once and search/paging
     * are served from memory; larger libraries are declined after the first
     * response (total > limit) and fall back to per-request browse-json calls.
     * Mirrors the media page's client-side search limit.
     */
    const _clientMediaStore = {
        _entries: new Map(),
        _key(type, lang) { return `${type || ''}|${lang || ''}`; },
        _entry(type, lang) {
            const key = this._key(type, lang);
            if (!this._entries.has(key)) {
                this._entries.set(key, { all: null, promise: null, declined: false });
            }
            return this._entries.get(key);
        },
        reset() { this._entries.clear(); },
        _matches(item, needle) {
            const hay = [item.name, item.alt_text, item.description, item.title]
                .filter(v => typeof v === 'string' && v !== '').join(' ').toLowerCase();
            return hay.includes(needle);
        },
        async _preload(bp, type, lang, entry) {
            const q = type ? `&type=${encodeURIComponent(type)}` : '';
            const langParam = lang ? `&lang=${encodeURIComponent(lang)}` : '';
            const first = await _mediaBrowseFetch(`${bp}/admin/media/browse-json?page=1&per_page=40${q}${langParam}`);
            if (Number(first.total || 0) > window.CLIENT_SEARCH_FETCH_LIMIT) {
                entry.declined = true;
                return null;
            }
            const items = first.items || [];
            const totalPages = Number(first.total_pages || 1);
            for (let p = 2; p <= totalPages; p++) {
                const next = await _mediaBrowseFetch(`${bp}/admin/media/browse-json?page=${p}&per_page=40${q}${langParam}`);
                items.push(...(next.items || []));
            }
            entry.all = items;
            return items;
        },
        async all(bp, type, lang) {
            const entry = this._entry(type, lang);
            if (entry.all) return entry.all;
            if (entry.declined) return null;
            if (!entry.promise) {
                entry.promise = this._preload(bp, type, lang, entry)
                    .catch(() => { entry.declined = true; return null; });
            }
            return entry.promise;
        },
        async page(bp, type, page = 1, query = '', perPage = 40, lang = '') {
            const items = await this.all(bp, type, lang);
            if (items === null) return null;
            const needle = (query || '').trim().toLowerCase();
            const filtered = needle ? items.filter(i => this._matches(i, needle)) : items;
            const start = (page - 1) * perPage;
            return {
                items: filtered.slice(start, start + perPage),
                total: filtered.length,
                page,
                per_page: perPage,
                total_pages: Math.max(1, Math.ceil(filtered.length / perPage)),
            };
        },
    };

    async function vlMediaBrowsePage(bp, page = 1, query = '', { type = '', lang = '', perPage = 40 } = {}) {
        if (window.CLIENT_SEARCH_FETCH_LIMIT > 0) {
            const local = await _clientMediaStore.page(bp, type, page, query, perPage, lang);
            if (local) return local;
        }
        const q = query ? `&q=${encodeURIComponent(query)}` : '';
        const typeParam = type ? `&type=${encodeURIComponent(type)}` : '';
        const langParam = lang ? `&lang=${encodeURIComponent(lang)}` : '';
        return _mediaBrowseFetch(`${bp}/admin/media/browse-json?page=${page}&per_page=${perPage}${typeParam}${q}${langParam}`);
    }

    async function fetchImageMediaPage(bp, page = 1, query = '', perPage = 40, lang = '') {
        const contentLang = lang || getContentLanguageForMedia();
        return vlMediaBrowsePage(bp, page, query, { type: 'image/', lang: contentLang, perPage });
    }

    /** Product gallery browser (images + videos) — excludes other file types. */
    async function fetchGalleryMediaPage(bp, page = 1, query = '', perPage = 40, lang = '') {
        const contentLang = lang || getContentLanguageForMedia();
        return vlMediaBrowsePage(bp, page, query, { type: 'image/,video/', lang: contentLang, perPage });
    }

    /** Untyped browser (any file type) — used by download/file pickers. */
    async function fetchFileMediaPage(bp, page = 1, query = '', perPage = 40) {
        return vlMediaBrowsePage(bp, page, query, { type: '', perPage });
    }

    async function findImageById(bp, id) {
        let page = 1, totalPages = 1;
        do {
            const data = await fetchImageMediaPage(bp, page, '', 80);
            const found = (data.items || []).find(i => Number(i.id) === Number(id));
            if (found) return found;
            totalPages = data.total_pages || 1;
            page++;
        } while (page <= totalPages);
        return null;
    }
    async function findImagePageById(bp, id, perPage = 40) {
        let page = 1, totalPages = 1;
        do {
            const data = await fetchImageMediaPage(bp, page, '', perPage);
            const found = (data.items || []).some(i => Number(i.id) === Number(id));
            if (found) return page;
            totalPages = data.total_pages || 1;
            page++;
        } while (page <= totalPages);
        return 1;
    }
    /** Batch resolve media rows by ID (order-preserving, null for missing). */
    async function fetchMediaByIds(bp, ids) {
        const wanted = [...new Set((ids || []).map(Number).filter(id => Number.isInteger(id) && id > 0))].slice(0, 200);
        if (wanted.length === 0) return [];
        const rows = [];
        let page = 1, totalPages = 1;
        do {
            const data = await _mediaBrowseFetch(`${bp}/admin/media/browse-json?page=${page}&per_page=80&ids=${wanted.join(',')}`);
            rows.push(...(data.items || []));
            totalPages = data.total_pages || 1;
            page++;
        } while (page <= totalPages);
        const byId = new Map(rows.map(i => [Number(i.id), i]));
        return wanted.map(id => byId.get(id) || null);
    }
    </script>
