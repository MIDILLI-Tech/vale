            get displayOptions() {
                const term = this.filterTerm;
                const tl = this.targetLanguage;
                const translatedLabel = tjs('Translated');
                const currentLabel = tjs('Current');
                const statusLabels = {
                    draft: tjs('Draft'),
                    unlisted: tjs('Unlisted'),
                    scheduled: tjs('Scheduled')
                };
                return this.options
                    .filter((option) => !tl || option.language !== tl)
                    .filter((option) => !term || (option.baseLabel || option.label).toLowerCase().indexOf(term) !== -1)
