            },
        });
        Alpine.data('entityPicker', createEntityPicker);
        Alpine.data('asyncPageSelect', (config = {}) => createEntityPicker(Object.assign({ mode: 'async' }, config)));
        Alpine.data('searchableSelect', (config = {}) => createEntityPicker(Object.assign({ mode: 'static' }, config)));
