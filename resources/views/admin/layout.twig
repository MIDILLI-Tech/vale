                    this.selectAllVisible = false;
                    this.lastSelectedId = targetIds[targetIds.length - 1] || null;
                }
                this.updateTrigger++;
            },
            selectVisible() {
                const visibleIds = this.getVisibleCheckboxes().map(cb => String(cb.value)).filter(id => id !== '');
                const allVisibleSelected = visibleIds.length > 0 && visibleIds.every(id => this.selected.includes(id));
                if (allVisibleSelected) {
                    this.selected = [];
                    this.selectAll = false;
                    this.selectAllVisible = false;
                    this.lastSelectedId = null;
                } else {
                    this.selected = visibleIds;
                    this.selectAll = false;
                    this.selectAllVisible = visibleIds.length > 0;
                    this.lastSelectedId = visibleIds[visibleIds.length - 1] || null;
                }
                this.updateTrigger++;
            },
            selectAllItems() {
                if (this.selectAll) {
                    this.selected = [];
                    this.selectAll = false;
                    this.selectAllVisible = false;
                    this.lastSelectedId = null;
                } else {
                    const allIds = [];
                    document.querySelectorAll('[data-row-id] input[type=checkbox][data-bulk-item]').forEach(cb => {
                        allIds.push(String(cb.value));
                    });
                    this.selected = [...new Set(allIds.filter(id => id !== ''))];
                    this.selectAll = true;
                    this.selectAllVisible = false;
                    this.lastSelectedId = this.selected[this.selected.length - 1] || null;
                }
                this.updateTrigger++;
            },
            clear() {
                this.selected = [];
                this.selectAll = false;
                this.selectAllVisible = false;
                this.lastSelectedId = null;
                this.updateTrigger++;
            },
            isSelected(id) {
                return this.selected.includes(String(id));
            },
            get count() {
                return this.selected.length;
            }
        });
    });
