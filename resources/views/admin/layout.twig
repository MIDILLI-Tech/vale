    {# Global featuredImage function (used by posts, products, and custom content type forms) #}
    <script>
    window.featuredImage = (initialId) => {
        const bp = window.APP_BASE_PATH || '';
        return {
            imageId: initialId || 0,
            thumbnailUrl: '',
            showModal: false,
            loading: false,
            mediaPage: 1,
            mediaTotalPages: 1,
            mediaQuery: '',
            searchTimer: null,
            mediaItems: [],
            async init() {
                if (this.imageId > 0) {
                    const [found] = await fetchMediaByIds(bp, [this.imageId]);
                    if (found) this.thumbnailUrl = found.thumbnail || found.url;
                }
            },
            removeImage() { this.imageId = 0; this.thumbnailUrl = ''; },
            async loadMediaPage(page = 1) {
                this.loading = true;
                try {
                    const data = await fetchImageMediaPage(bp, page, this.mediaQuery, 40);
                    this.mediaItems = data.items || [];
                    this.mediaPage = data.page || page;
                    this.mediaTotalPages = data.total_pages || 1;
                } finally {
                    this.loading = false;
                }
            },
            async prevMediaPage() {
                if (this.mediaPage > 1) await this.loadMediaPage(this.mediaPage - 1);
            },
            async nextMediaPage() {
                if (this.mediaPage < this.mediaTotalPages) await this.loadMediaPage(this.mediaPage + 1);
            },
            async openBrowser() {
                this.showModal = true;
                this.mediaQuery = '';
                if (this.imageId > 0) {
                    const foundPage = await findImagePageById(bp, this.imageId, 40);
                    await this.loadMediaPage(foundPage);
                } else if (this.mediaItems.length === 0) {
                    await this.loadMediaPage(1);
                }
            },
            async refreshMedia() {
                clearMediaCache();
                this.mediaItems = [];
                await this.loadMediaPage(1);
            },
            onSearchInput() {
                clearTimeout(this.searchTimer);
                this.searchTimer = setTimeout(() => this.loadMediaPage(1), 300);
            },
            selectImage(item) {
                this.imageId = item.id;
                this.thumbnailUrl = item.thumbnail || item.url;
                this.showModal = false;
            },
            // Drag-drop upload (assets/js/media-upload.js): reload the grid
            // and auto-select the first uploaded image.
            async handleDroppedFiles(result) {
                await this.refreshMedia();
                const first = (result && result.uploaded || [])[0];
                if (first) this.selectImage(first);
            }
        };
    };

    window.seoPanel = function (initial = {}) {
        const bp = window.APP_BASE_PATH || '';
