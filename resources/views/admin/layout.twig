            tab: 'general',
            seoEnabled: !!initial.seoEnabled,
            metaTitle: initial.metaTitle || '',
            metaDesc: initial.metaDesc || '',
            ogTitle: initial.ogTitle || '',
            ogDesc: initial.ogDesc || '',
            twitterCard: initial.twitterCard || 'summary',
            imageId: Number(initial.imageId || 0),
            thumbnailUrl: '',
            showModal: false,
            loading: false,
            mediaPage: 1,
            mediaTotalPages: 1,
            mediaQuery: '',
            searchTimer: null,
            mediaItems: [],
            liveTitle: '',
            liveDesc: '',
            syncLiveFields() {
