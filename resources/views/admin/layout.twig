    <script>
    function tagInput(config) {
        var allTags = Array.isArray(config && config.allTags) ? config.allTags : [];
        var initial = String((config && config.initial) || '');
        return {
            items: initial.split(',').map(function (v) { return v.trim(); }).filter(function (v) { return v !== ''; }),
            input: '',
            showSuggestions: false,
            focusedIndex: -1,
            get filteredSuggestions() {
                var q = this.input.trim().toLowerCase();
                var self = this;
                // Empty query lists everything preloaded, so clicking the
                // field alone offers all tags for point-and-click selection.
                return allTags.filter(function (tag) {
                    return (q === '' || tag.toLowerCase().indexOf(q) !== -1) && self.items.indexOf(tag) === -1;
                });
            },
            addFromInput: function () {
                var tag = this.input.trim().replace(/,+$/, '');
                if (tag === '' || this.items.indexOf(tag) !== -1) return;
                this.items.push(tag);
                this.input = '';
                this.showSuggestions = false;
                this.focusedIndex = -1;
                this.$el.dispatchEvent(new Event('change', { bubbles: true }));
            },
            remove: function (tag) {
                this.items = this.items.filter(function (t) { return t !== tag; });
                this.$el.dispatchEvent(new Event('change', { bubbles: true }));
            },
            selectSuggestion: function (tag) {
                if (this.items.indexOf(tag) === -1) this.items.push(tag);
                this.input = '';
                this.showSuggestions = false;
                this.focusedIndex = -1;
                this.$el.dispatchEvent(new Event('change', { bubbles: true }));
            },
            onInput: function () {
                this.showSuggestions = true;
                this.focusedIndex = -1;
            },
            onKeydown: function (e) {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    if (this.focusedIndex >= 0 && this.focusedIndex < this.filteredSuggestions.length) {
                        this.selectSuggestion(this.filteredSuggestions[this.focusedIndex]);
                    } else {
                        this.addFromInput();
                    }
                } else if (e.key === 'Backspace' && this.input === '' && this.items.length > 0) {
                    this.items.pop();
                    this.$el.dispatchEvent(new Event('change', { bubbles: true }));
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (this.focusedIndex < this.filteredSuggestions.length - 1) this.focusedIndex++;
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (this.focusedIndex > -1) this.focusedIndex--;
                } else if (e.key === 'Escape') {
                    this.showSuggestions = false;
                    this.focusedIndex = -1;
                }
            },
            onBlur: function () {
                var self = this;
                setTimeout(function () { self.showSuggestions = false; }, 200);
            },
        };
    }
    </script>
    <script>
    document.addEventListener('keydown', function(e) {
        var modifier = e.ctrlKey || e.metaKey;
        if (!modifier) return;

        if (e.key.toLowerCase() === 's' && !e.shiftKey && !e.altKey) {
            var form = document.querySelector('form[data-autosave]');
            if (form) { e.preventDefault(); form.requestSubmit(); }
            return;
        }

        if (e.key.toLowerCase() === 's' && e.shiftKey && !e.altKey) {
            var activeVersion = document.querySelector('[data-show-active-version]');
            if (activeVersion) { e.preventDefault(); activeVersion.click(); }
            return;
        }

        if (e.key.toLowerCase() === 'p' && e.shiftKey && !e.altKey) {
            var preview = document.querySelector('[data-preview-action]');
            if (preview) { e.preventDefault(); preview.click(); }
        }
    });
    </script>
    <script>
    (function () {
        var path = window.location.pathname.replace(/\/$/, '') || '/';
        var searchParams = new URLSearchParams(window.location.search);
        var contentType = searchParams.get('content_type');
        var entityType = searchParams.get('entity_type');
        var links = document.querySelectorAll('.vl-nav-link');
        var bp = window.APP_BASE_PATH || '';
        var best = null, bestLen = 0;
        links.forEach(function (a) {
            var href = a.getAttribute('href');
            var hrefUrl = new URL(href, location.origin);
            var hrefPath = (hrefUrl.pathname || href).replace(/\/$/, '') || '/';
            var hrefCt = hrefUrl.searchParams.get('content_type');
            var hrefEt = hrefUrl.searchParams.get('entity_type');
            var normPath = path;
            var normHref = hrefPath;
            if (bp && normPath.startsWith(bp)) normPath = normPath.substring(bp.length);
            if (bp && normHref.startsWith(bp)) normHref = normHref.substring(bp.length);
            var pathMatches = normPath === normHref || (normHref !== '/admin' && normPath.startsWith(normHref + '/')) || (normHref === '/admin' && normPath === '/admin');
            // For /admin/posts, match content_type if specified
            // For /admin/comments, match entity_type if specified
            if (pathMatches) {
                if (normHref === '/admin/posts') {
                    if (!contentType && !hrefCt) {
                        if (normHref.length > bestLen) { best = a; bestLen = normHref.length; }
                    } else if (contentType && hrefCt === contentType) {
                        if (normHref.length > bestLen) { best = a; bestLen = normHref.length; }
                    }
                } else if (normHref === '/admin/comments') {
                    if (!entityType && !hrefEt) {
                        if (normHref.length > bestLen) { best = a; bestLen = normHref.length; }
                    } else if (entityType && hrefEt === entityType) {
                        if (normHref.length > bestLen) { best = a; bestLen = normHref.length; }
                    }
                } else {
                    if (normHref.length > bestLen) { best = a; bestLen = normHref.length; }
                }
            }
        });
        // Fallback: if no match found and we're on /admin/posts with non-post content_type,
        // still highlight the base /admin/posts link (for backward compatibility)
        if (!best && path.includes('/admin/posts') && (!contentType || contentType === 'all')) {
            links.forEach(function (a) {
                var href = a.getAttribute('href');
                var hrefUrl = new URL(href, location.origin);
                var hrefPath = (hrefUrl.pathname || href).replace(/\/$/, '') || '/';
                if (hrefPath === '/admin/posts') {
                    best = a;
                }
            });
        }
        // Fallback: if on /admin/comments without matching entity_type, highlight base comments link
        if (!best && path.includes('/admin/comments')) {
            links.forEach(function (a) {
                var href = a.getAttribute('href');
                var hrefUrl = new URL(href, location.origin);
                var hrefPath = (hrefUrl.pathname || href).replace(/\/$/, '') || '/';
                if (hrefPath === '/admin/comments') {
                    best = a;
                    return false;
                }
            });
        }
        if (best) {
            best.classList.remove('text-gray-300');
            best.classList.add('bg-gray-800', 'text-white');
            best.querySelector('svg')?.classList.replace('text-gray-400', 'text-white');
            best.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        }
    })();
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var title = document.getElementById('title');
        var slug  = document.getElementById('slug');
        if (!title || !slug) return;
        var manual = slug.value.trim() !== '';
        slug.addEventListener('input', function () { manual = true; });
        title.addEventListener('input', function () {
            if (manual) return;
            slug.value = title.value
                .toLowerCase()
                .replace(/[ğ]/g,'g').replace(/[ü]/g,'u').replace(/[ş]/g,'s')
                .replace(/[ı]/g,'i').replace(/[ö]/g,'o').replace(/[ç]/g,'c')
                .replace(/[ä]/g,'ae').replace(/[ë]/g,'e').replace(/[ï]/g,'i')
                .replace(/[ô]/g,'o').replace(/[û]/g,'u').replace(/[ñ]/g,'n')
                .replace(/[àáâã]/g,'a').replace(/[èéê]/g,'e').replace(/[ìíî]/g,'i')
                .replace(/[òóõ]/g,'o').replace(/[ùúû]/g,'u')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/[\s]+/g, '-')
                .replace(/-+/g, '-');
            // Programmatic assignment fires no 'input' event, so refresh the
            // "copy public link" field explicitly.
            if (typeof syncLiveSlugLinks === 'function') syncLiveSlugLinks();
        });
    });
    </script>
    <script>
        // ── CSRF-aware fetch helper ──────────────────────────────────────
        function vlPost(url, data) {
            const token = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
            const bp = window.APP_BASE_PATH || '';
            return fetch(bp + url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token },
                body: JSON.stringify(data),
            }).then(r => r.json());
        }
        // ── Open a create modal on page load (?modal=add) ────────────────
        // Quick actions point at list pages with ?modal=add so the matching
        // create modal opens automatically. The param is stripped from the
        // URL so reloads and table pagination never re-open the modal.
        function vlAutoOpenModal(name, open) {
            const params = new URLSearchParams(window.location.search);
            if (params.get('modal') !== name) return;
            params.delete('modal');
            const qs = params.toString();
            window.history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
            open();
        }
        // ── Quick actions hidden from the top-right menu (per browser) ───
        // The dashboard "Manage" mode writes hidden keys to localStorage.
        // The header menu filters itself on every page load; the dashboard
        // grid keeps the cards visible (dimmed) so they stay clickable.
        function vlQaHiddenKeys() {
            try { return JSON.parse(localStorage.getItem('vl_quick_actions_hidden') || '[]'); } catch (e) { return []; }
        }
        function vlQaSaveHidden(keys) {
            try { localStorage.setItem('vl_quick_actions_hidden', JSON.stringify(keys)); } catch (e) {}
        }
        function vlQaApplyHidden(root) {
            root = root || document;
            const hidden = vlQaHiddenKeys();
            let anyVisible = false;
            root.querySelectorAll('[data-qa-key]').forEach(function (el) {
                const isHidden = hidden.indexOf(el.getAttribute('data-qa-key')) > -1;
                el.style.display = isHidden ? 'none' : '';
                if (!isHidden) anyVisible = true;
            });
            // Hide the section label + divider too when everything is hidden.
            root.querySelectorAll('[data-qa-section]').forEach(function (el) {
                el.style.display = anyVisible ? '' : 'none';
            });
        }
        document.addEventListener('DOMContentLoaded', function () { vlQaApplyHidden(); });
        // ── Nav reorder ────────────────────────────────────────────────
        function lpNavReorder() {
            return {
                reordering: false,
                _sortable: null,
                _childSortables: [],
                init() {},
                start() {
                    this.reordering = true;
                    this._sortable = Sortable.create(
                        document.getElementById('vl-nav-sortable'),
                        { handle: '.drag-handle', animation: 150, ghostClass: 'opacity-40' }
                    );
                    this._childSortables = [];
                    document.querySelectorAll('[data-nav-group-children]').forEach((list) => {
                        this._childSortables.push(Sortable.create(list, {
                            handle: '.child-drag-handle',
                            draggable: '[data-nav-child]',
                            animation: 150,
                            ghostClass: 'opacity-40',
                        }));
                    });
                },
                childOrder() {
                    const children = {};
                    document.querySelectorAll('[data-nav-group-children]').forEach((list) => {
                        const groupId = list.getAttribute('data-nav-group-children');
                        const ids = Array.from(list.children)
                            .filter((child) => child.hasAttribute('data-nav-child'))
                            .map((child) => child.getAttribute('data-nav-child'));
                        if (groupId && ids.length) children[groupId] = ids;
                    });
                    return children;
                },
                save() {
                    const order = Array.from(
                        document.querySelectorAll('#vl-nav-sortable .vl-nav-block[data-id]')
                    ).map(b => b.dataset.id);
                    const children = this.childOrder();
                    vlPost('/admin/nav-order', { order, children }).then(() => {
                        this.reordering = false;
                        this._sortable && this._sortable.destroy();
                        this._sortable = null;
                        this._childSortables.forEach((sortable) => sortable.destroy());
                        this._childSortables = [];
                    });
                },
                reset() {
                    if (!confirm('{{ __('Reset the sidebar order to the default?')|e('js') }}')) return;
                    vlPost('/admin/nav-order', { order: [], children: {} }).then(() => {
                        location.reload();
                    });
                },
            };
        }
        // ── Prevent double submit ───────────────────────────────────────
        (function() {
            function disableSubmitButtons(form) {
                const buttons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
                buttons.forEach(btn => {
                    btn.disabled = true;
                    btn.classList.add('opacity-50', 'cursor-not-allowed');
                    btn.style.cursor = 'not-allowed';
                });
            }
            document.addEventListener('submit', function(e) {
                const form = e.target.closest('form');
                if (!form) return;
                const submitter = e.submitter;
                if (form.hasAttribute('data-no-disable') || (submitter && submitter.hasAttribute('data-no-disable'))) return;
                const action = form.getAttribute('action') || '';
                const formaction = submitter ? (submitter.getAttribute('formaction') || '') : '';
                if (action.includes('/export') || formaction.includes('/export')) return;

                const hasFetchHandler = form.hasAttribute('data-fetch') ||
                    form.querySelector('[data-fetch]') ||
                    (form.getAttribute('onsubmit') || '').includes('fetch');
                if (hasFetchHandler) return;

                // Delay disabling to allow the browser to include the clicked button's name/value in the POST body.
                requestAnimationFrame(() => {
                    if (e.defaultPrevented) return;
                    disableSubmitButtons(form);
                });
            }, true);
        })();
        // ── Insert variable at cursor position ───────────────────────────────────
        window.lpInsertVar = function(tag) {
            const activeEl = document.activeElement;
            let targetEl = null;
            if (activeEl && (activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'INPUT')) {
                targetEl = activeEl;
            } else {
                targetEl = document.querySelector('[data-editor], textarea, input');
            }
            if (!targetEl) return;
            const start = targetEl.selectionStart || 0;
            const end = targetEl.selectionEnd || 0;
            const val = targetEl.value;
            targetEl.value = val.substring(0, start) + tag + val.substring(end);
            const newPos = start + tag.length;
            targetEl.selectionStart = targetEl.selectionEnd = newPos;
            targetEl.focus();
            targetEl.dispatchEvent(new Event('input', { bubbles: true }));
            targetEl.dispatchEvent(new Event('change', { bubbles: true }));
        };
    </script>
</body>
</html>
