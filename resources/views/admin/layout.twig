            selected: [],
            selectAll: false,
            selectAllVisible: false,
            lastSelectedId: null,
            updateTrigger: 0,
            getVisibleCheckboxes() {
                const checkboxes = document.querySelectorAll('[data-row-id] input[type=checkbox][data-bulk-item]');
                return Array.from(checkboxes).filter(cb => {
                    const row = cb.closest('[data-row-id]');
                    if (!row) return false;
                    const rowRect = row.getBoundingClientRect();
                    const checkboxRect = cb.getBoundingClientRect();
                    return rowRect.width > 0 && rowRect.height > 0 && checkboxRect.width > 0 && checkboxRect.height > 0;
                });
            },
            getVisibleCheckbox(id) {
                const key = String(id);
                return this.getVisibleCheckboxes().find(cb => String(cb.value) === key) || null;
            },
            getVisibleSelectAllCheckbox() {
                const checkboxes = document.querySelectorAll('input[type=checkbox][data-bulk-select-all]');
                return Array.from(checkboxes).find(cb => {
                    const rect = cb.getBoundingClientRect();
                    return rect.width > 0 && rect.height > 0;
                }) || null;
            },
            toggle(id) {
                const key = String(id);
                const idx = this.selected.indexOf(key);
                if (idx === -1) {
                    this.selected = [...this.selected, key];
                    this.lastSelectedId = key;
                } else {
                    this.selected = this.selected.filter(i => i !== key);
                    if (String(this.lastSelectedId) === key) this.lastSelectedId = this.selected[this.selected.length - 1] || null;
                }
