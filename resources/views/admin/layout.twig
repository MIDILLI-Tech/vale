                        const disabled = !!tl && (option.translatedLanguages || []).indexOf(tl) !== -1 && !isCurrent;
                        const base = option.baseLabel || option.label;
                        const statusHint = (option.status && option.status !== 'published' && statusLabels[option.status])
                            ? ' (' + statusLabels[option.status] + ')' : '';
                        const translatedHint = disabled ? ' (' + translatedLabel + ')' : '';
                        const currentHint = isCurrent && tl ? ' (' + currentLabel + ')' : '';
