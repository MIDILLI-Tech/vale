    <script>
    // Dirty-state guard: warns before navigation with unsaved changes and
    // toggles all [data-dirty-badge] / [data-clean-badge] indicators on the page.
    // Defined in <head> so page-level scripts (content block) can call it immediately.
    // Usage: vlDirtyGuard() for document scope, or vlDirtyGuard({ root: '#sel', clicks: true }).
    // clicks: also mark dirty when a button[type="button"] is clicked (Alpine-driven UIs).
    // Buttons can opt out with data-no-dirty.
    window.vlDirtyGuard = function (opts) {
        opts = opts || {};
        var scope = opts.root ? document.querySelector(opts.root) : document;
        if (!scope) return null;
        var dirty = false;
        // Ignore input/change events fired while the page is still initializing
        // (editor mount, Alpine init, option rebuilds). The guard arms itself
        // just after DOMContentLoaded.
        var armed = document.readyState !== 'loading';
        if (!armed) {
            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(function () { armed = true; }, 0);
            });
        }
        var api = {
            mark: function () { if (!armed) return; dirty = true; api.sync(); },
            reset: function () { dirty = false; api.sync(); },
            isDirty: function () { return dirty; },
            sync: function () {
                document.querySelectorAll('[data-dirty-badge]').forEach(function (el) {
                    el.classList.toggle('hidden', !dirty);
                });
                document.querySelectorAll('[data-clean-badge]').forEach(function (el) {
                    el.classList.toggle('hidden', dirty);
                });
            }
        };
        scope.addEventListener('input', api.mark, true);
        scope.addEventListener('change', api.mark, true);
        if (opts.clicks) {
            scope.addEventListener('click', function (e) {
                if (e.target.closest && e.target.closest('button[type="button"]:not([data-no-dirty])')) api.mark();
            }, true);
        }
        scope.addEventListener('submit', api.reset, true);
        window.addEventListener('beforeunload', function (e) {
            if (dirty) { e.preventDefault(); e.returnValue = ''; }
        });
        return api;
    };
    </script>
