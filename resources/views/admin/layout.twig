            },
            get pageList() {
                const t = this.totalPages;
                if (t <= 7) return Array.from({length: t}, (_, i) => i + 1);
                const p = this.page, r = [1];
                if (p > 3) r.push('…');
                for (let i = Math.max(2, p - 1); i <= Math.min(t - 1, p + 1); i++) r.push(i);
                if (p < t - 2) r.push('…');
                if (t > 1) r.push(t);
