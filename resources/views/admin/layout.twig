<body class="min-h-screen bg-gray-100 dark:bg-gray-950 antialiased" x-data="{
        sidebarOpen: (() => {
            const wide = window.matchMedia('(min-width: 1024px)').matches;
            try {
                const stored = localStorage.getItem('vl_admin_sidebar');
                if (wide && (stored === '1' || stored === '0')) return stored === '1';
            } catch (e) {}
            return wide;
        })(),
        toggleSidebar() { this.sidebarOpen = !this.sidebarOpen; this.saveSidebar(); },
        closeSidebar() { this.sidebarOpen = false; this.saveSidebar(); },
