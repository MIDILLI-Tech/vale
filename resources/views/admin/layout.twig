            },

            clear() {
                this.selectedValue = '';
                this.selectedLabel = '';
                this.selectedUrl = '';
                this.query = '';
                this.search = '';
                this.open = false;
                this.announce();
            },

            announce() {
                var payload = { name: this.name, value: this.selectedValue, url: this.selectedUrl };
