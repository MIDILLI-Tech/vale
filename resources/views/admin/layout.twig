            }
        }));
        // Unified searchable record picker.
        // mode: 'async' | 'static'
        //   async  — preloads a list, then searches the server (debounced)
        //   static — filters the options rendered by Twig
        const createEntityPicker = (config = {}) => ({
            mode: config.mode === 'static' ? 'static' : 'async',
            name: config.name || '',
            valueField: config.valueField === 'slug' ? 'slug' : 'id',
            endpoint: config.endpoint || '/admin/posts/list-json',
            itemEndpoint: config.itemEndpoint || '/admin/posts/:id/json',
            params: config.params && !Array.isArray(config.params) ? config.params : {},
            contentType: config.contentType || 'page',
            excludeId: config.excludeId ? String(config.excludeId) : '',
            options: [],
            selectedValue: config.initialValue ? String(config.initialValue) : '',
            selectedLabel: config.initialLabel || '',
            selectedUrl: '',
            query: config.initialLabel || '',
            search: '',
            open: false,
            loading: false,
            preloaded: false,
            placeholder: config.placeholder || 'Search…',
            emptyLabel: config.emptyLabel || '',
            emptyHint: config.emptyHint || '',
            showEmptyRow: config.showEmptyRow === true,
            loadingLabel: config.loadingLabel || 'Loading…',
            preloadPerPage: config.preloadPerPage || window.VL_CLIENT_SEARCH_FETCH_LIMIT || 100,
            searchTimer: null,
            initialSelectedValue: config.initialValue ? String(config.initialValue) : '',
            targetSelector: config.targetSelector || '',
            targetLanguage: config.targetLanguage || '',
            _targetEl: null,

            init() {
                this.options = (config.options || []).map((option) => this.normalizeOption(option));
                if (this.selectedValue) {
                    const match = this.options.find((option) => option.value === this.selectedValue);
                    if (match) {
                        this.selectedLabel = match.label;
                        this.selectedUrl = match.url || '';
                        this.query = match.label;
                        this.announce();
                    } else if (this.mode === 'async') {
