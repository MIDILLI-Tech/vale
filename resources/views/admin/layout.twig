                    await this.preload();
                }
            },

            async preload() {
                const cacheKey = this.endpoint + '|' + JSON.stringify(this.params) + '|' + this.contentType + '|' + this.valueField;
                const cached = window.__entityPickerCache && window.__entityPickerCache.get(cacheKey);
                if (cached) {
                    this.mergeItems(cached.items);
                    this.preloaded = true;
                    return;
                }
                this.loading = true;
                try {
                    var data = await this.fetchJson('', 1, this.preloadPerPage);
                    var items = data.items || [];
                    if (!window.__entityPickerCache) window.__entityPickerCache = new Map();
                    window.__entityPickerCache.set(cacheKey, { items: items });
                    this.mergeItems(items);
                    this.preloaded = true;
                } finally {
                    this.loading = false;
                }
            },

            onSearchInput() {
                var self = this;
                clearTimeout(this.searchTimer);
                this.searchTimer = setTimeout(function() {
                    var term = self.filterTerm;
                    if (term.length >= 1) {
                        self.fetchAndMerge(term);
