            setElevated(active) {
                if (this._elevatedNodes) {
                    this._elevatedNodes.forEach(function(node) {
                        node.classList.remove('vl-async-select-open');
                    });
                }
                this._elevatedNodes = [];
                if (active) {
                    var node = this.$el.parentElement;
                    while (node && node !== document.body) {
