        function tjs(text, replacements = {}) {
            let translated = window.VL_I18N[text] || text;
            for (const [key, value] of Object.entries(replacements)) {
                translated = translated.replace(key, value);
            }
            return translated;
        }
        function copyToClipboard(text, btn) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    copyToClipboardFeedback(btn);
                }).catch(function () {
                    copyToClipboardFallback(text, btn);
                });
            } else {
                copyToClipboardFallback(text, btn);
            }
        }
        function copyToClipboardFallback(text, btn) {
            var t = document.createElement('textarea');
            t.value = text;
            t.style.position = 'fixed';
            t.style.opacity = '0';
            document.body.appendChild(t);
            t.select();
            t.setSelectionRange(0, 99999);
            document.execCommand('copy');
            document.body.removeChild(t);
            copyToClipboardFeedback(btn);
        }
        function copyToClipboardFeedback(btn) {
            if (!btn) return;
            // Never replace button content (icon buttons lose their SVG this
            // way) — show a floating "Copied!" badge near the button instead.
            if (btn.__vlCopyFb) {
                copyToClipboardDismiss(btn.__vlCopyFb);
            }
            var el = document.createElement('div');
            el.className = 'vl-copy-feedback';
            el.setAttribute('role', 'status');
            el.textContent = tjs('Copied!');
            document.body.appendChild(el);
            var state = { el: el, btn: btn, timer: null, reposition: null, dismiss: null };
            var reposition = function () {
                // Button gone from the DOM or without a layout box (hidden tab
                // panel, x-cloak): drop the badge instead of leaving it
                // floating at a random spot, detached from its button.
                if (!document.body.contains(btn)) {
                    copyToClipboardDismiss(state);
                    return;
                }
                var rect = btn.getBoundingClientRect();
                if (!rect.width && !rect.height) {
                    copyToClipboardDismiss(state);
                    return;
                }
                var vw = window.innerWidth || document.documentElement.clientWidth;
                var vh = window.innerHeight || document.documentElement.clientHeight;
                var w = el.offsetWidth, h = el.offsetHeight;
                // Clamp the badge center into the viewport so an edge button
                // never clips the "Copied!" text half off-screen.
                var minLeft = w / 2 + 8;
                var maxLeft = Math.max(minLeft, vw - w / 2 - 8);
                var left = Math.min(Math.max(rect.left + rect.width / 2, minLeft), maxLeft);
                var top = rect.bottom + 6;
                if (top + h > vh - 8) {
                    top = Math.max(rect.top - h - 6, 8);
                }
                el.style.left = left + 'px';
                el.style.top = top + 'px';
            };
            var dismiss = function () {
                copyToClipboardDismiss(state);
            };
            state.reposition = reposition;
            state.dismiss = dismiss;
            el.addEventListener('click', dismiss);
            // Keep the badge glued to its button while the page scrolls.
            window.addEventListener('scroll', reposition, true);
            window.addEventListener('resize', reposition);
            state.timer = setTimeout(dismiss, 1400);
            btn.__vlCopyFb = state;
            reposition();
        }
        function copyToClipboardDismiss(state) {
            if (!state) return;
            clearTimeout(state.timer);
            window.removeEventListener('scroll', state.reposition, true);
            window.removeEventListener('resize', state.reposition);
            state.el.remove();
            if (state.btn && state.btn.__vlCopyFb === state) {
                state.btn.__vlCopyFb = null;
            }
        }
        // Keep the read-only "copy public link" field in sync with the slug input
        // so a scheduled/unlisted item's shareable URL is never stale.
        var vlParentPath = { prefix: '' };
        function syncLiveSlugLinks() {
            var slug = document.getElementById('slug');
            if (!slug) return;
            document.querySelectorAll('[data-live-slug-prefix]').forEach(function (field) {
                var prefix = field.getAttribute('data-live-slug-prefix');
                // Parent-aware fields prepend the picked parent's own path.
                if (field.hasAttribute('data-live-parent-aware')) {
                    var base = field.getAttribute('data-base') || prefix;
                    var mid  = vlParentPath.prefix || '';
                    prefix = base + (mid ? mid + '/' : '');
                }
                field.value = prefix + slug.value;
            });
        }
        document.addEventListener('input', function (e) {
            if (e.target && e.target.id === 'slug') {
                syncLiveSlugLinks();
            }
        });
        // The async record picker (parent page, swap target) reports its choice
        // so the shareable URL can be rebuilt before anything is saved.
        document.addEventListener('vl-record-picked', function (e) {
            var d = e.detail || {};
            if (d.name !== 'parent_id') return;
            vlParentPath.prefix = vlResolveParentPrefix(String(d.url || ''));
            syncLiveSlugLinks();
        });
        /**
         * Turn a picked page's full URL into the path a child would inherit:
         * drop origin, base path and the page prefix — what remains is the
         * parent's full path (its own slug included).
         */
        function vlResolveParentPrefix(url) {
            if (!url) return '';
            var path = url;
            var m = /^[a-z][a-z0-9+.\-]*:\/\/[^/?#]*/i.exec(path);
            if (m) path = path.slice(m[0].length);
            path = path.split('#')[0].split('?')[0];
            var base = window.APP_BASE_PATH || '';
            if (base && path.indexOf(base) === 0) path = path.slice(base.length);
            var field = document.querySelector('[data-live-parent-aware]');
            if (field) {
                var pfx = field.getAttribute('data-parent-prefix') || '';
                if (pfx && path.indexOf(pfx) === 0) path = path.slice(pfx.length);
            }
            return path.split('/').filter(Boolean).join('/');
        }
        document.addEventListener('DOMContentLoaded', syncLiveSlugLinks);
    </script>
    <script>
    /**
     * Shared show/hide-columns state for admin tables. Spread into any Alpine
     * scope that renders table.columnsToggle(): dataTable does it by default,
     * pages with a custom inline x-data (e.g. coupons) spread it themselves
     * and call this._initColumns() from init().
     */
    function vlColumnMixins() {
        return {
            columns: [], hiddenCols: [],
            tableId: '', _colStyle: null, _storeKey: '',
            _initColumns() {
                const anchor = this.$refs.items || this.$refs.listItems;
                let table = anchor ? anchor.closest('table') : null;
                if (!table && this.$refs.listItems) table = this.$refs.listItems.closest('table');
                if (!table) return;
                const path = location.pathname.replace(/\/+$/, '');
                const tables = Array.from(document.querySelectorAll('[x-data^="dataTable"]'));
                const ordinal = Math.max(0, tables.indexOf(this.$el));
                this._storeKey = 'vl_table_cols:' + path + ':' + ordinal;
                this.tableId = 'vl-tbl-' + path.replace(/[^a-z0-9]+/gi, '-') + '-' + ordinal;
                table.id = this.tableId;
                const headerCells = Array.from(table.querySelectorAll('thead th'));
                this.columns = headerCells
                    .map((th, position) => {
                        const isBulkSelect = !!th.querySelector('input[data-bulk-select-all]');
                        const labeled = /sort\(['"]([^'"]+)['"]\)/.exec(th.innerHTML || '');
                        const label = this._thLabel(th);
                        return {
                            key: labeled ? labeled[1] : this._slug(label) || ('col-' + (position + 1)),
                            label: label || ('#' + (position + 1)),
                            locked: isBulkSelect || String(th.className || '').includes('text-right'),
                            index: position + 1,
                            isBulkSelect: isBulkSelect,
                            panel: label !== '',
                            defaultHidden: th.hasAttribute('data-default-hidden'),
                        };
                    })
                    .filter(c => !c.isBulkSelect);
                const firstHideable = this.columns.findIndex(c => !c.locked);
                if (firstHideable >= 0) this.columns[firstHideable].locked = true;
                let saved = null;
                try { saved = JSON.parse(localStorage.getItem(this._storeKey) || 'null'); } catch (e) { saved = null; }
                const hideable = new Set(this.columns.filter(c => c.panel && !c.locked).map(c => c.key));
                if (saved === null) {
                    this.hiddenCols = this.columns
                        .filter(c => c.panel && !c.locked && c.defaultHidden)
                        .map(c => c.key);
                    this._persistColumns();
                } else {
                    this.hiddenCols = Array.isArray(saved) ? [...new Set(saved.filter(k => hideable.has(k)))] : [];
                    this._applyColumns();
                }
            },
            _thLabel(th) {
                const button = th.querySelector('button');
                if (button) {
                    const text = Array.from(button.childNodes)
                        .filter(n => n.nodeType === 3)
                        .map(n => n.textContent.trim())
                        .join(' ');
                    if (text) return text.replace(/\s+/g, ' ');
                }
                return (th.textContent || '').trim().replace(/\s+/g, ' ');
            },
            _slug(text) {
                return String(text || '').toLowerCase().trim()
                    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
            },
            _applyColumns() {
                if (!this.tableId) return;
                if (!this._colStyle) {
                    this._colStyle = document.createElement('style');
                    this._colStyle.setAttribute('data-vl-table-columns', this.tableId);
                    document.head.appendChild(this._colStyle);
                }
                this._colStyle.textContent = this.hiddenCols
                    .map(key => {
                        const col = this.columns.find(c => c.key === key);
                        if (!col) return '';
                        return '#' + this.tableId + ' th:nth-child(' + col.index + '), #'
                            + this.tableId + ' td:nth-child(' + col.index + ') { display: none; }';
                    })
                    .join('\n');
                // Lets width-adaptive table columns (e.g. the products SKU
                // column) re-measure after a visibility change.
                document.dispatchEvent(new CustomEvent('vl:columns-changed', {
                    detail: { tableId: this.tableId }
                }));
            },
            _persistColumns() {
                try { localStorage.setItem(this._storeKey, JSON.stringify(this.hiddenCols)); } catch (e) {}
                this._applyColumns();
            },
            isColHidden(key) { return this.hiddenCols.includes(key); },
            toggleCol(key) {
                const at = this.hiddenCols.indexOf(key);
                if (at >= 0) this.hiddenCols.splice(at, 1);
                else this.hiddenCols.push(key);
                this._persistColumns();
            },
            resetCols() {
                this.hiddenCols = this.columns
                    .filter(c => c.panel && !c.locked && c.defaultHidden)
                    .map(c => c.key);
                this._persistColumns();
            },
        };
    }

    window.vlProductPool = function (config) {
        const withVariations = !!(config && config.withVariations);
        return {
            allProducts: [],
            allProductsTotal: 0,
            allProductsLoading: false,
            allHasMore: false,

            async loadAllProducts() {
                if (this.allProductsLoading) return;
                const cache = window.__vlProductPoolCache;
                if (cache && cache.items && cache.items.length && this.allProducts.length === 0) {
                    this.allProducts = [...cache.items];
                    this.allProductsTotal = cache.total;
                    this.allHasMore = this.allProducts.length < this.allProductsTotal;
                    if (!this.allHasMore) return;
                }
                if (this.allProductsTotal > 0 && this.allProducts.length >= this.allProductsTotal) {
                    this.allHasMore = false;
                    return;
                }
                this.allProductsLoading = true;
                const batchSize = window.VL_CLIENT_SEARCH_FETCH_LIMIT || 100;
                const page = Math.floor(this.allProducts.length / batchSize) + 1;
                try {
                    const params = new URLSearchParams({ page: String(page), per_page: String(batchSize) });
                    if (withVariations) params.set('with_variations', '1');
                    const resp = await fetch(window.APP_BASE_PATH + '/admin/products/list-json?' + params.toString());
                    const res = await resp.json();
                    const items = res.data || [];
                    this.allProducts = [...this.allProducts, ...items];
                    this.allProductsTotal = res.total || this.allProductsTotal;
                    this.allHasMore = this.allProducts.length < this.allProductsTotal;
                    if (!window.__vlProductPoolCache) window.__vlProductPoolCache = { items: [], total: 0 };
                    window.__vlProductPoolCache.items = [...this.allProducts];
                    window.__vlProductPoolCache.total = this.allProductsTotal;
                } catch (e) {}
                this.allProductsLoading = false;
            },
        };
    };

    document.addEventListener('alpine:init', () => {
        Alpine.data('dataTable', (config = {}) => ({
            ...vlColumnMixins(),
            sortBy: config.sort || '', sortDir: config.dir || 'desc',
            perPage: config.perPage || 20, page: config.page || 1, search: config.search || '',
            searchBody: !!config.searchBody,
            allRows: [], listRows: [], visibleCount: 0,
            serverSide: !!config.serverSide,
            totalItems: config.totalItems || 0,
            baseUrl: config.baseUrl || '',
            isNavigating: false,
            navTimer: null,
            init() {
                this._initColumns();
                // Always watched: checking the toggle on a small (client-side)
                // table navigates to a server-side URL carrying search_body.
                this.$watch('searchBody', () => { this.page = 1; this._debouncedNav(); });
                if (this.serverSide) {
                    this.visibleCount = this.totalItems;
                    this.$watch('search', () => { this.page = 1; this._debouncedNav(); });
                    this.$watch('perPage', () => { this.page = 1; this._nav(); });
                    return;
                }
                this.allRows = Array.from(this.$refs.items.querySelectorAll('[data-sort]'));
                this.allRows.forEach(r => { try { r._s = JSON.parse(r.dataset.sort); } catch(e) { r._s = {}; } });
                this.listRows = [];
                if (this.$refs.listItems) {
                    this.listRows = Array.from(this.$refs.listItems.querySelectorAll('[data-sort]'));
                    this.listRows.forEach(r => { try { r._s = JSON.parse(r.dataset.sort); } catch(e) { r._s = {}; } });
                }
                this.apply();
            },
            apply() {
                if (this.serverSide) return;
                const q = this.search.trim().toLowerCase();
                const rowMatches = (r) => {
                    if (!q) return true;
                    // Cells often render a truncated preview (e.g. SKU "ABC12…",
                    // first 5 tags, first 3 form fields) while the full value
                    // lives in data-search or the data-sort payload. Search all
                    // three so hidden parts remain findable.
                    const parts = [];
                    if (r.dataset.search) parts.push(r.dataset.search);
                    if (r._s) parts.push(Object.values(r._s).join(' '));
                    parts.push(r.textContent || '');
                    return parts.join(' ').toLowerCase().includes(q);
                };
                const filterRows = (rows) => q ? rows.filter(rowMatches) : rows;
                const sortRows = (rows) => {
                    if (!this.sortBy) return rows;
                    const col = this.sortBy, dir = this.sortDir === 'asc' ? 1 : -1;
                    return [...rows].sort((a, b) => {
                        let va = a._s[col] ?? '', vb = b._s[col] ?? '';
                        const na = Number(va), nb = Number(vb);
                        if (va !== '' && vb !== '' && !isNaN(na) && !isNaN(nb)) return (na - nb) * dir;
                        return String(va).localeCompare(String(vb), undefined, {numeric: true}) * dir;
                    });
                };
                const grid = sortRows(filterRows(this.allRows));
                const list = sortRows(filterRows(this.listRows));
                this.visibleCount = new Set([...grid, ...list].map(r => r.getAttribute('data-row-id') || r)).size;
                const start = (this.page - 1) * this.perPage, end = start + this.perPage;
                const render = (all, filtered, container) => {
                    if (!container) return;
                    const shown = new Set(filtered.filter((r, i) => i >= start && i < end));
                    all.forEach(r => {
                        const visible = shown.has(r);
                        r.style.display = visible ? '' : 'none';
                        if (visible) {
                            container.appendChild(r);
                            const id = r.getAttribute('data-row-id');
                            if (id) {
                                const d = container.querySelector('[data-detail-for="'+id+'"]');
                                if (d) container.appendChild(d);
                            }
                        }
                    });
                };
                render(this.allRows, grid, this.$refs.items);
                render(this.listRows, list, this.$refs.listItems || null);
                this.$refs.items.querySelectorAll('[data-detail-for]').forEach(r => r.style.display = 'none');
                if (this.$refs.listItems) {
                    this.$refs.listItems.querySelectorAll('[data-detail-for]').forEach(r => r.style.display = 'none');
                }
            },
            sort(col) {
                if (this.sortBy === col) this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
                else { this.sortBy = col; this.sortDir = 'asc'; }
                this.page = 1;
                if (this.serverSide) { this._nav(); return; }
                this.apply();
            },
            setPage(n) {
                if (n >= 1 && n <= this.totalPages) {
                    this.page = n;
                    if (this.serverSide) { this._nav(); return; }
                    this.apply();
                }
            },
            _nav() {
                clearTimeout(this.navTimer);
                this.isNavigating = true;
                const u = new URL(this.baseUrl, location.origin);
                if (this.search) u.searchParams.set('search', this.search);
                if (this.searchBody) u.searchParams.set('search_body', '1');
                if (this.sortBy) { u.searchParams.set('sort', this.sortBy); u.searchParams.set('dir', this.sortDir); }
                if (this.page > 1) u.searchParams.set('page', String(this.page));
                if (this.perPage !== (config.perPage || 20)) u.searchParams.set('per_page', String(this.perPage));
