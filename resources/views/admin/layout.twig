<!DOCTYPE html>
<html lang="{{ current_locale() ?? 'en' }}"{% if panel_rail|default(false) %} class="has-edit-rail"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ __('Admin') }}{% endblock %}{{ seo_title_separator }}{{ site_name }}</title>
    {% if site_logo %}<link rel="icon" href="{{ site_logo }}">{% endif %}
    {% if assets_use_cdn %}
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=inter:400,500,600,700,800|roboto:400,500,700|open-sans:400,600,700|montserrat:400,600,700" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @custom-variant dark (&:where(.dark, .dark *));
        @theme {
            --color-gray-950: #030712;
        }
    </style>
    {% else %}
    {% include 'partials/_build_assets.twig' with { include_js: false, load_alt_fonts: false, load_display_fonts: false, preload_font: false } %}
    {% endif %}
    <script>window.APP_BASE_PATH = '{{ base_path|e('js') }}';</script>
    <script>window.VL_CLIENT_SEARCH_FETCH_LIMIT = {{ client_search_fetch_limit|default(100) }};</script>
    <script>window.VL_LANGUAGES = {{ languages|default({})|json_encode|raw }};</script>
    <script>window.VL_THEME_COLORS = {{ vl_theme_colors|default([])|json_encode|raw }};</script>
    <script>
        (function() {
            const theme = document.cookie.match(/vl_admin_theme=([^;]+)/)?.[1] || 'light';
            if (theme === 'dark') document.documentElement.classList.add('dark');
            const rail = document.cookie.match(/vl_admin_right_rail=([^;]+)/)?.[1];
            if (rail === '0') document.documentElement.classList.add('rail-collapsed');
        })();
    </script>
    <script>window._VL_COUPONS = {{ _VL_COUPONS|default([])|json_encode|raw }};</script>
    <script>window._VL_COUPONS_TRUNCATED = {{ _VL_COUPONS_TRUNCATED|default(false)|json_encode|raw }};</script>
    <script>window._VL_SHOP_ENABLED = '{{ shop_enabled|e('js') }}';</script>
    <script>window._VL_MEMBERSHIP_ENABLED = '{{ membership_enabled|e('js') }}';</script>
    <script>window._VL_SUBSCRIPTIONS_ENABLED = '{{ subscriptions_enabled|e('js') }}';</script>
    <script>window._VL_PAGES_ENABLED = '{{ pages_enabled|e('js') }}';</script>
    <script>window._VL_BLOG_ENABLED = '{{ blog_enabled|e('js') }}';</script>
    <script>window._VL_NEWSLETTER_ENABLED = '{{ newsletter_enabled|e('js') }}';</script>
    <script>window._VL_CAPTCHA = {{ vl_captcha_configured|default({'hcaptcha': false, 'recaptcha': false, 'turnstile': false})|json_encode|raw }};</script>
    <script>window._VL_FORMS_ENABLED = '{{ form_builder_enabled|e('js') }}';</script>
    <script>window._VL_MULTI_LANG_ENABLED = '{{ settings.multi_language_content|default("0") }}';</script>
    {% set raw_content_langs = settings.content_languages|default(settings.default_locale|default('en')) %}
    {% set content_langs_list = raw_content_langs is iterable ? raw_content_langs : raw_content_langs|split(',') %}
    <script>window._VL_CONTENT_LANGUAGES = {{ content_langs_list|filter(Boolean)|json_encode|raw }};</script>
    <script>window._VL_ACTIVE_CPTS = {{ _VL_ACTIVE_CPTS|default([])|json_encode|raw }};</script>
    <script>window._VL_MEDIA_EMBEDS = {{ media_embeds|default({})|json_encode|raw }};</script>
