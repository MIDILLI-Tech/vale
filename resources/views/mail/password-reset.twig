{% extends "mail/layout.twig" %}

{% block title %}{{ __('Reset your password') }}{% endblock %}

{% block body %}
<h2>{{ __('Reset your password') }}</h2>
<p>{{ __('Hi :name,', {':name': name}) }}</p>
<p>{{ __('We received a request to reset the password for your account. Click the button below to choose a new password. This link expires in 1 hour.') }}</p>
<a href="{{ reset_url }}" class="btn">{{ __('Reset Password') }}</a>
<p style="color:{{ email_text_muted }}; font-size:13px;">{{ __('If you did not request a password reset, you can safely ignore this email. Your password will not be changed.') }}</p>
{% endblock %}
