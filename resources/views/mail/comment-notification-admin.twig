{% extends "mail/layout.twig" %}

{% block title %}{{ __('New Comment') }}{% endblock %}

{% block body %}
<h2>{{ __('New Comment') }}</h2>
<p>{{ __('A new comment has been submitted on your site.') }}</p>

<table style="width:100%; border-collapse:collapse; margin:20px 0;">
  <tr>
    <td style="padding:4px 8px; color:{{ email_text_muted }}; font-size:13px; vertical-align:top; white-space:nowrap;">{{ __('Author') }}</td>
    <td style="padding:4px 8px; font-weight:600;">{{ author_name }}</td>
  </tr>
  <tr>
    <td style="padding:4px 8px; color:{{ email_text_muted }}; font-size:13px; vertical-align:top; white-space:nowrap;">{{ __('Email') }}</td>
    <td style="padding:4px 8px;">{{ author_email }}</td>
  </tr>
  <tr>
    <td style="padding:4px 8px; color:{{ email_text_muted }}; font-size:13px; vertical-align:top; white-space:nowrap;">{{ __('Entity') }}</td>
    <td style="padding:4px 8px;">{{ entity_type_label }}: <a href="{{ entity_url }}" style="color:{{ email_accent }};">{{ entity_title }}</a></td>
  </tr>
  {% if rating is defined and rating %}
  <tr>
    <td style="padding:4px 8px; color:{{ email_text_muted }}; font-size:13px; vertical-align:top; white-space:nowrap;">{{ __('Rating') }}</td>
    <td style="padding:4px 8px;">{{ rating }}/5</td>
  </tr>
  {% endif %}
</table>

<blockquote style="margin:16px 0; padding:12px 16px; background:{{ email_bg }}; border-left:4px solid {{ email_border }}; border-radius:4px; color:{{ email_text }}; font-style:italic;">
  {{ comment_content|nl2br }}
</blockquote>

<p style="margin:24px 0;">
  <a href="{{ admin_url }}" class="btn">{{ __('View in admin') }}</a>
</p>
{% endblock %}
