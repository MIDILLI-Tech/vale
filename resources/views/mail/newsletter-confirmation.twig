{% extends "mail/layout.twig" %}

{% block title %}{{ __('Confirm your subscription') }}{% endblock %}

{% block body %}
<h2>{{ __('Confirm Your Subscription') }}</h2>
<p>{{ __('Thanks for signing up. Please confirm your email address to activate your newsletter subscription.') }}</p>
<a href="{{ confirm_url }}" class="btn">{{ __('Confirm Subscription') }}</a>
<p style="word-break:break-all; color:{{ email_text_muted }}; font-size:13px;">
    {{ __('If the button does not work, copy and paste this link into your browser:') }}<br>
    <a href="{{ confirm_url }}">{{ confirm_url }}</a>
</p>
<p style="color:{{ email_text_muted }}; font-size:13px;">{{ __('If you did not request this subscription, you can safely ignore this email.') }}</p>
{% endblock %}
