{% extends "layout.twig" %}

{% block title %}Unsubscribed{% endblock %}
{% block meta_description %}{{ __('Manage your email preferences and unsubscribe from our newsletter.') }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-20 max-w-md text-center">
    {% if success %}
    <div class="text-gray-400 text-6xl mb-4">👋</div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">You've Been Unsubscribed</h1>
    <p class="text-gray-600 mb-8">You have been successfully removed from our mailing list. You won't receive any more emails from us.</p>
    {% else %}
    <div class="text-orange-400 text-6xl mb-4">⚠</div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Invalid Link</h1>
    <p class="text-gray-600 mb-8">This unsubscribe link is not valid or has already been used.</p>
    {% endif %}
    <a href="{{ url('/') }}" class="inline-block text-sm text-gray-900 hover:underline">Return to homepage</a>
</div>
{% endblock %}
