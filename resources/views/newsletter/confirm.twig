{% extends "layout.twig" %}

{% block title %}Confirm Subscription{% endblock %}
{% block meta_description %}{{ __('Confirm your newsletter subscription.') }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-20 max-w-md text-center">
    {% if success %}
    <div class="text-green-500 text-6xl mb-4">✓</div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Subscription Confirmed!</h1>
    <p class="text-gray-600 mb-8">You're now subscribed to our newsletter. Thank you!</p>
    <a href="{{ url('/') }}" class="inline-block rounded-lg bg-gray-900 px-6 py-3 text-white font-medium hover:bg-gray-800">
        Go to Homepage
    </a>
    {% else %}
    <div class="text-red-400 text-6xl mb-4">✗</div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Link Expired or Invalid</h1>
    <p class="text-gray-600 mb-8">This confirmation link may have already been used or has expired.</p>
    <a href="{{ url('/') }}" class="inline-block text-gray-900 hover:underline text-sm">Return to homepage</a>
    {% endif %}
</div>
{% endblock %}
