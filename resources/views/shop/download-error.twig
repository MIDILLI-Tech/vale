{% extends "layout.twig" %}

{% block title %}Download Error{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto mt-24 text-center">
    <div class="bg-white dark:bg-zinc-800 rounded-2xl shadow-sm p-10">
        <p class="text-5xl mb-4">{{ code == 410 ? '🔒' : '❌' }}</p>
        <h1 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100 mb-3">
            {{ code == 410 ? 'Link Unavailable' : 'Not Found' }}
        </h1>
        <p class="text-zinc-600 dark:text-zinc-400 mb-6">{{ message }}</p>
        <a href="{{ url('/') }}" class="inline-block px-5 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-lg font-medium transition">
            Back to Home
        </a>
    </div>
</div>
{% endblock %}
