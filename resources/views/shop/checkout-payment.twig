{% extends "layout.twig" %}

{% block title %}{{ __('Complete Payment') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}
{% block meta_description %}{{ __('Complete your payment securely.') }}{% endblock %}

{% block head %}
<script src="{{ media_embeds.stripe_js.script_url }}"></script>
{% endblock %}

{% block content %}
<div class="mx-auto max-w-lg px-4 py-14">
    <h1 class="mb-2 text-2xl font-bold text-gray-900 dark:text-gray-100">{{ __('Complete Payment') }}</h1>
    {% if order %}
    <p class="mb-8 text-sm text-gray-500 dark:text-gray-400">{{ __('Order') }} #{{ order.orderNumber }} &mdash; <strong>{{ order.total|price(current_currency) }}</strong></p>
    {% endif %}

    <div id="payment-element" class="mb-6"></div>
    <div id="payment-message" class="mb-4 hidden rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-400"></div>

    <button id="submit-btn" disabled
            class="w-full rounded-lg btn-primary py-3 px-4 text-sm font-bold disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
        <span id="btn-text">{{ __('Pay Now') }}</span>
        <span id="btn-spinner" class="hidden">{{ __('Processing…') }}</span>
    </button>
    <a href="{{ url('checkout.cancel') }}" class="mt-3 block text-center text-xs text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300">{{ __('Cancel and go back') }}</a>
</div>

<script>
const stripe = Stripe({{ stripe_key|json_encode|raw }});
const clientSecret = {{ client_secret|json_encode|raw }};

const isDark = document.documentElement.classList.contains('dark');

const appearance = {
    theme: isDark ? 'night' : 'stripe',
    variables: {
        colorPrimary: isDark ? '#0ea5e9' : '#0284c7',
        colorBackground: isDark ? '#0f172a' : '#ffffff',
        colorText: isDark ? '#f1f5f9' : '#111827',
        colorTextSecondary: isDark ? '#94a3b8' : '#6b7280',
        colorTextPlaceholder: isDark ? '#64748b' : '#9ca3af',
        colorDanger: isDark ? '#f87171' : '#ef4444',
        labelColorText: isDark ? '#cbd5e1' : '#374151',
        inputColorBorder: isDark ? '#475569' : '#d1d5db',
        inputFocusColorBorder: isDark ? '#0ea5e9' : '#0284c7',
        iconColor: isDark ? '#94a3b8' : '#6b7280',
        fontFamily: 'Inter, system-ui, sans-serif',
    },
    rules: {
        '.Input': {
            fontWeight: '400',
        },
        '.Input::placeholder': {
            fontWeight: '400',
        },
        '.Label': {
            fontWeight: '500',
        },
        '.Tab--selected': {
            borderColor: isDark ? '#0ea5e9' : '#0284c7',
            boxShadow: isDark
                ? '0 0 0 1px #0ea5e9'
                : '0px 1px 1px rgba(0, 0, 0, 0.03), 0 0 0 1px #0284c7',
        },
    },
};

const orderBilling = {{ (order ? order.billing : {})|json_encode|raw }};
const defaultValues = {
    billingDetails: {
        name: [orderBilling.first_name || '', orderBilling.last_name || ''].join(' ').trim(),
        email: orderBilling.email || '',
        phone: orderBilling.phone || '',
        address: {
            line1: orderBilling.address || '',
            city: orderBilling.city || '',
            state: orderBilling.state || '',
            postalCode: orderBilling.postcode || '',
            country: orderBilling.country || '',
        },
    },
};

const elements = stripe.elements({ clientSecret, appearance, defaultValues });
const paymentElement = elements.create('payment');
paymentElement.mount('#payment-element');

const btn  = document.getElementById('submit-btn');
const msg  = document.getElementById('payment-message');
const text = document.getElementById('btn-text');
const spin = document.getElementById('btn-spinner');

// The Payment Element mounts asynchronously — keep Pay Now locked until
// Stripe signals the form is ready, otherwise an early click confirms
// with empty elements and fails silently.
paymentElement.on('ready', () => {
    btn.disabled = false;
});
paymentElement.on('loaderror', (event) => {
    msg.textContent = event.error ? event.error.message : 'Payment form failed to load. Please refresh and try again.';
    msg.classList.remove('hidden');
});

btn.addEventListener('click', async () => {
    btn.disabled = true;
    text.classList.add('hidden');
    spin.classList.remove('hidden');
    msg.classList.add('hidden');

    const successUrl = {{ success_url|json_encode|raw }};

    const { error, paymentIntent } = await stripe.confirmPayment({
        elements,
        confirmParams: {
            return_url: successUrl,
        },
        redirect: 'if_required',
    });

    if (error) {
        msg.textContent = error.message;
        msg.classList.remove('hidden');
        btn.disabled = false;
        text.classList.remove('hidden');
        spin.classList.add('hidden');
    } else if (paymentIntent && paymentIntent.status === 'succeeded') {
        window.location.href = successUrl + '?payment_intent=' + encodeURIComponent(paymentIntent.id);
    }
});
</script>
{% endblock %}
