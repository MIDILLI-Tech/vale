{# Product tabs: Description / Additional information / Reviews.
   `comments_ctx` is the full variable hash for partials/comments.twig. #}
{% set _variant = variant|default('light') %}
{% set _dark = _variant == 'dark' %}
{% set _unit_labels = {
    'piece': __('Piece'), 'g': __('Gram (g)'), 'kg': __('Kilogram (kg)'), 'oz': __('Ounce (oz)'),
    'lb': __('Pound (lb)'), 'ml': __('Millilitre (ml)'), 'l': __('Litre (l)'), 'fl_oz': __('Fluid ounce (fl oz)'),
    'gal': __('Gallon (gal)'), 'm': __('Metre (m)'), 'm2': __('Square metre (m²)'), 'ft': __('Foot (ft)'), 'ft2': __('Square foot (ft²)')
} %}
{% set _amount = product.baseAmount|default('') %}
{% set _unit = product.unit|default('') %}
{% set _manual_label = product.manualLabel|default('') ?: __('Manual / Instructions') %}
{% set _manual_docs = manual_documents|default(product.manualDocuments|default([])) %}
{% set _batch_values = [] %}
{% if product.batchNumber|default('') %}{% set _batch_values = _batch_values|merge([product.batchNumber]) %}{% endif %}
{% for _variation in variations|default([]) %}
    {% if _variation.batch_number|default('') and _variation.batch_number not in _batch_values %}
        {% set _batch_values = _batch_values|merge([_variation.batch_number]) %}
    {% endif %}
{% endfor %}
{# Warranty in months: the variation overrides the product, which overrides the shop default; 0 hides the line. #}
{% set _product_warranty = product.warrantyMonths is defined and product.warrantyMonths is not null
    ? product.warrantyMonths : settings.product_warranty_default|default(0) %}
{% set _warranty_months = [] %}
{% if _product_warranty > 0 %}{% set _warranty_months = _warranty_months|merge([_product_warranty]) %}{% endif %}
{% for _variation in variations|default([]) %}
    {% set _variation_warranty = _variation.warranty_months|default(null) %}
    {% if _variation_warranty is not null and _variation_warranty > 0 and _variation_warranty not in _warranty_months %}
        {% set _warranty_months = _warranty_months|merge([_variation_warranty]) %}
    {% endif %}
{% endfor %}
{% set _warranty_values = _warranty_months|map(months => months == 1
    ? __('1 month warranty') : __(':months months warranty', {':months': months})) %}
{% set _has_info = _unit or _amount or product.manufacturerName|default('') or product.manufacturerAddress|default('')
    or product.euResponsibleName|default('') or product.euResponsibleAddress|default('')
    or product.countryOfOrigin|default('') or product.safetyWarnings|default('')
    or product.minAge|default(0) or _batch_values|length
    or _warranty_values|length
    or _manual_docs|length %}
{% set _tabs = [] %}
{% if product.description %}{% set _tabs = _tabs|merge(['description']) %}{% endif %}
{% if _has_info %}{% set _tabs = _tabs|merge(['info']) %}{% endif %}
{% set _tabs = _tabs|merge(['reviews']) %}

<div class="mb-12"
     x-data="{ tab: ((['#reviews', '#comments'].indexOf(window.location.hash) !== -1 || window.location.hash.indexOf('#comment-') === 0) ? 'reviews' : '{{ _tabs|first }}') }"
     @vl-open-reviews.window="tab = 'reviews'">
    <div class="flex flex-wrap gap-x-6 gap-y-2 border-b {{ _dark ? 'border-slate-700' : 'border-gray-200' }} mb-6">
        {% for key in _tabs %}
        <button type="button" @click="tab = '{{ key }}'"
                class="pb-3 -mb-px border-b-2 text-sm font-medium transition-colors"
                :class="tab === '{{ key }}'
                    ? '{{ _dark ? 'border-blue-500 text-white' : 'border-gray-900 text-gray-900' }}'
                    : '{{ _dark ? 'border-transparent text-slate-400 hover:text-slate-200' : 'border-transparent text-gray-500 hover:text-gray-800' }}'">
            {% if key == 'description' %}{{ __('Description') }}{% elseif key == 'info' %}{{ __('Additional information') }}{% else %}{{ __('Reviews') }}{% endif %}
        </button>
        {% endfor %}
    </div>

    {% if product.description %}
    <div x-show="tab === 'description'" x-cloak>
        <div class="prose max-w-none {{ _dark ? 'text-slate-300' : 'text-gray-700' }}">{{ product.description|shortcodes(product)|nl2br }}</div>
    </div>
    {% endif %}

    {% if _has_info %}
    <div x-show="tab === 'info'" x-cloak>
        <dl class="grid grid-cols-1 gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
            {% if _amount %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Content') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ _amount }}{% if _unit and _unit != 'piece' %} {{ _unit_labels[_unit]|default(_unit) }}{% elseif _unit == 'piece' %} {{ __('Piece') }}{% endif %}</dd>
            </div>
            {% endif %}
            {% if product.manufacturerName or product.manufacturerAddress %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Manufacturer') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ product.manufacturerName }}{% if product.manufacturerAddress %}<br>{{ product.manufacturerAddress|nl2br }}{% endif %}</dd>
            </div>
            {% endif %}
            {% if product.euResponsibleName or product.euResponsibleAddress %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('EU Responsible Person') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ product.euResponsibleName }}{% if product.euResponsibleAddress %}<br>{{ product.euResponsibleAddress|nl2br }}{% endif %}</dd>
            </div>
            {% endif %}
            {% if product.countryOfOrigin %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Country of Origin') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ country_name(product.countryOfOrigin) }} ({{ product.countryOfOrigin }})</dd>
            </div>
            {% endif %}
            {% if _batch_values|length %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Batch number') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ _batch_values|join(', ') }}</dd>
            </div>
            {% endif %}
            {% if _warranty_values|length %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Warranty') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ _warranty_values|join(', ') }}</dd>
            </div>
            {% endif %}
            {% if product.minAge %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ __('Age restriction') }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">{{ product.minAge }}+</dd>
            </div>
            {% endif %}
            {% if _manual_docs|length %}
            <div>
                <dt class="font-medium {{ _dark ? 'text-slate-200' : 'text-gray-900' }}">{{ _manual_label }}</dt>
                <dd class="{{ _dark ? 'text-slate-400' : 'text-gray-600' }}">
                    <ul class="space-y-1">
                        {% for document in _manual_docs %}
                        {% if document.url %}
                        <li>
                            <a href="{{ document.url }}" rel="noopener nofollow" target="_blank" class="inline-flex items-center gap-1.5 text-blue-600 hover:underline dark:text-blue-400">
                                {% if document.type == 'file' %}
                                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25M9 16.5v.75m3-3v3M15 12v5.25m-7.5 3h9a2.25 2.25 0 0 0 2.25-2.25V6.108c0-.597-.237-1.169-.659-1.591L15.75 2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v13.5a2.25 2.25 0 0 0 2.25 2.25Z"/>
                                </svg>
                                {% else %}
                                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                                </svg>
                                {% endif %}
                                <span>{{ document.label ?: (document.type == 'file' ? document.name : document.value|replace({'https://': '', 'http://': ''})|split('/')|first) }}</span>
                            </a>
                        </li>
                        {% endif %}
                        {% endfor %}
                    </ul>
                </dd>
            </div>
            {% endif %}
        </dl>
        {% if product.safetyWarnings %}
        <div class="mt-6 rounded-lg border {{ _dark ? 'border-amber-500/30 bg-amber-500/10 text-amber-200' : 'border-amber-200 bg-amber-50 text-amber-900' }} p-4 text-sm">
            <p class="mb-1 font-semibold">{{ __('Safety Warnings') }}</p>
            <div>{{ product.safetyWarnings|nl2br }}</div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <div id="reviews" x-show="tab === 'reviews'" x-cloak class="scroll-mt-20">
        {% if comments_ctx is defined %}{% include 'partials/comments.twig' with comments_ctx %}{% endif %}
    </div>
</div>

{# Comment permalinks (#comment-123) must open the Reviews tab before scrolling. #}
<script nonce="{{ csp_nonce }}">
(function () {
    function openReviewFromHash() {
        var hash = window.location.hash;
        if (hash !== '#reviews' && hash !== '#comments' && hash.indexOf('#comment-') !== 0) return;
        window.dispatchEvent(new CustomEvent('vl-open-reviews'));
        setTimeout(function () {
            var el = (hash === '#reviews' || hash === '#comments')
                ? document.getElementById('reviews')
                : document.getElementById(hash.slice(1));
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 80);
    }
    document.addEventListener('alpine:initialized', openReviewFromHash);
    window.addEventListener('hashchange', openReviewFromHash);
})();
</script>
