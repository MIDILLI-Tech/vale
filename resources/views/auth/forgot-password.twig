{% extends "layout.twig" %}

{% block title %}{{ __('Forgot Password') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}
{% block meta_description %}{{ __('Enter your email address to receive a password reset link for your account.') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-xl border bg-white p-8 shadow-xs">
        <h1 class="text-center text-2xl font-bold text-gray-900">{{ __('Forgot Password') }}</h1>
        <p class="mt-2 text-center text-sm text-gray-600">{{ __('Enter your email and we will send you a reset link.') }}</p>

        {% if error is defined %}
        <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{{ error }}</div>
        {% endif %}

        {% if sent is defined and sent %}
        <div class="mt-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">
            {{ __('If that email exists in our system, a password reset link has been sent.') }}
        </div>
        {% if log_hint is defined and log_hint %}
        <div class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-800">
            ⚠ {{ __('Mail is in log mode. The reset link was not sent via email.') }}
            {{ __('Ask your admin to learn how to proceed.') }}
        </div>
        {% endif %}
        <div class="mt-6 text-center">
            <a href="{{ url(routing_login_prefix) }}" class="text-sm text-gray-600 hover:text-gray-900 underline">{{ __('Back to Login') }}</a>
        </div>
        {% else %}

        <form method="POST" action="{{ url(routing_forgot_password_prefix) }}" class="mt-6 space-y-5">
            {{ csrf_field() }}

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       value="{{ email ?? '' }}"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <button type="submit"
                    class="w-full rounded-lg btn-primary px-4 py-2.5 text-sm font-medium">
                {{ __('Send Reset Link') }}
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="{{ url(routing_login_prefix) }}" class="text-sm text-gray-600 hover:text-gray-900 underline">{{ __('Back to Login') }}</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
