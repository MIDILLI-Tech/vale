{% extends "layout.twig" %}

{% block title %}{{ __('Login') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}
{% block meta_description %}{{ __('Sign in to your account to access your orders, profile, and account settings.') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-xl border bg-white p-8 shadow-xs">
        <h1 class="text-center text-2xl font-bold text-gray-900">{{ __('Sign In') }}</h1>
        <p class="mt-2 text-center text-sm text-gray-600">{{ __('Enter your credentials to access the members area.') }}</p>

        {% if error is defined %}
        <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{{ error }}</div>
        {% endif %}

        <form method="POST" action="{{ url(routing_login_prefix) }}" class="mt-6 space-y-5">
            {{ csrf_field() }}
            {% if redirect is defined and redirect %}
            <input type="hidden" name="redirect" value="{{ redirect }}">
            {% endif %}

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       value="{{ old_email ?? '' }}"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700">{{ __('Password') }}</label>
                <input type="password" id="password" name="password" required autocomplete="current-password"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            {# Login Captcha #}
            {% if login_captcha is defined and login_captcha.captcha_type != 'none' %}
            <div class="flex flex-col items-center justify-center py-2 max-w-full overflow-x-auto w-full">
                {% if login_captcha.captcha_type == 'math' and login_captcha.captcha_question %}
                <div class="w-full text-center">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        {{ __('Spam protection') }}: <strong>{{ login_captcha.captcha_question }}</strong> = ?
                        <span class="text-red-500">*</span>
                    </label>
                    <input type="number" name="captcha_answer" required min="1" max="18"
                           class="w-24 rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm mx-auto">
                </div>
                {% elseif login_captcha.captcha_type == 'hcaptcha' and login_captcha.captcha_site_key %}
                <div class="h-captcha max-w-full" data-sitekey="{{ login_captcha.captcha_site_key }}"></div>
                <script src="{{ captcha_urls.hcaptcha.script_url }}" async defer></script>
                {% elseif login_captcha.captcha_type == 'recaptcha' and login_captcha.captcha_site_key %}
                <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response">
                <script src="{{ captcha_urls.recaptcha.script_url }}?render={{ login_captcha.captcha_site_key }}"></script>
                <script>
                    grecaptcha.ready(function() {
                        try {
                            grecaptcha.execute('{{ login_captcha.captcha_site_key }}', {action: 'login'}).then(function(token) {
                                document.getElementById('g-recaptcha-response').value = token;
                            }).catch(function(e) {
                                console.warn('reCAPTCHA execute failed:', e);
                            });
                        } catch (e) {
                            console.warn('reCAPTCHA execute failed:', e);
                        }
                    });
                </script>
                {% elseif login_captcha.captcha_type == 'turnstile' and login_captcha.captcha_site_key %}
                <div class="cf-turnstile max-w-full" data-sitekey="{{ login_captcha.captcha_site_key }}" data-theme="auto" data-size="flexible"></div>
                <script src="{{ captcha_urls.turnstile.script_url }}" async defer></script>
                {% elseif login_captcha.captcha_type == 'honeypot' %}
                <div style="display:none"><input type="text" name="_hp_name" tabindex="-1" autocomplete="off"></div>
                {% elseif login_captcha.captcha_type != 'none' and not login_captcha.captcha_site_key %}
                <p class="text-xs text-red-500 italic">{{ __('Captcha not configured by administrator.') }}</p>
                {% endif %}
            </div>
            {% endif %}

            <div class="flex items-center justify-between">
                <label class="flex items-center">
                    <input type="checkbox" name="remember" class="rounded-sm border-gray-300 text-gray-900 shadow-xs focus:ring-gray-500">
                    <span class="ml-2 text-sm text-gray-600">{{ __('Remember me') }}</span>
                </label>
                <a href="{{ url(routing_forgot_password_prefix) }}" class="text-sm text-gray-500 hover:text-gray-700 underline">{{ __('Forgot password?') }}</a>
            </div>

            <button type="submit"
                    class="w-full rounded-lg btn-primary px-4 py-2.5 text-sm font-medium">
                {{ __('Sign In') }}
            </button>
        </form>

        {% if sso_login_enabled|default('0') == '1' and sso_login_providers_active is defined and sso_login_providers_active is not empty %}
        <div class="mt-6">
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="bg-white px-2 text-gray-500">{{ __('Or continue with') }}</span>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap justify-center gap-2">
                {% for key in sso_login_providers_active %}
                <a href="{{ url('/auth/sso/' ~ key, {}, {redirect: redirect}) }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50">
                    {{ sso_providers[key].label|default(key|capitalize) }}
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if registration_enabled|default('1') == '1' %}
        <p class="mt-6 text-center text-sm text-gray-500">
            {{ __("Don't have an account?") }}
            <a href="{{ url('/register', {}, {redirect: redirect}) }}" class="text-gray-700 underline hover:text-gray-900">{{ __('Register') }}</a>
        </p>
        {% endif %}
    </div>
</div>
{% endblock %}
