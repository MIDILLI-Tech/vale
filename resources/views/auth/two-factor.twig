{% extends "layout.twig" %}

{% block title %}{{ __('Two-Factor Authentication') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-xl border bg-white p-8 shadow-xs">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
            <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h2 class="mt-6 text-center text-2xl font-bold text-gray-900">{{ __('Two-Factor Authentication') }}</h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            {{ __('Please enter the code from your authenticator app or one of your recovery codes.') }}
        </p>

        {% if error %}
            <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">{{ error }}</div>
        {% endif %}

        <form method="POST" action="{{ url('/login/two-factor') }}" class="mt-6 space-y-5">
            {{ csrf_field() }}
            <div>
                <label for="code" class="block text-sm font-medium text-gray-700">{{ __('Authentication Code') }}</label>
                <input id="code" name="code" type="text" autocomplete="one-time-code" required autofocus
                       placeholder="000000"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <button type="submit"
                    class="w-full rounded-lg btn-primary px-4 py-2.5 text-sm font-medium">
                {{ __('Verify Code') }}
            </button>
        </form>

        <div class="mt-6 border-t pt-6 text-center">
             <a href="{{ url(routing_login_prefix) }}" class="text-sm font-medium text-gray-500 hover:text-gray-700 underline">
                {{ __('Back to login') }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
