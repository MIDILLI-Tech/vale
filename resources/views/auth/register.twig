{% extends "layout.twig" %}

{% block title %}{{ __('Register') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}
{% block meta_description %}{{ __('Create a new account to access member-only content, manage orders, and save your profile details.') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-xl border bg-white p-8 shadow-xs">
        {% if steam_register is defined and steam_register %}
        <h1 class="text-center text-2xl font-bold text-gray-900">{{ __('Complete Registration') }}</h1>
        <p class="mt-2 text-center text-sm text-gray-600">{{ __('Your Steam account is verified. Enter your email to finish creating your account.') }}</p>

        {% if errors is defined and errors is not empty %}
        <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">
            {% for field, msgs in errors %}
                {% for msg in msgs %}
                <p>{{ msg }}</p>
                {% else %}
                <p>{{ msgs }}</p>
                {% endfor %}
            {% endfor %}
        </div>
        {% endif %}

        <form method="POST" action="{{ url(routing_register_prefix) }}" class="mt-6 space-y-5">
            {{ csrf_field() }}
            <input type="hidden" name="_sso_steam_register" value="1">
            {% if redirect is defined and redirect %}
            <input type="hidden" name="redirect" value="{{ redirect }}">
            {% endif %}

            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">{{ __('Name') }}</label>
                <input type="text" id="name" value="{{ steam_name|default('') }}" disabled
                       class="mt-1 block w-full rounded-lg border-gray-200 bg-gray-50 text-gray-500 sm:text-sm cursor-not-allowed">
            </div>

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       value="{{ old.email ?? '' }}"
                       placeholder="you@example.com"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <button type="submit"
                    class="w-full rounded-lg btn-primary px-4 py-2.5 text-sm font-medium">
                {{ __('Complete Registration') }}
            </button>
        </form>
        {% else %}
        <h1 class="text-center text-2xl font-bold text-gray-900">{{ __('Create Account') }}</h1>
        <p class="mt-2 text-center text-sm text-gray-600">{{ __('Register to access member-only content.') }}</p>

        {% if errors is defined and errors is not empty %}
        <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">
            {% for field, msgs in errors %}
                {% for msg in msgs %}
                <p>{{ msg }}</p>
                {% else %}
                <p>{{ msgs }}</p>
                {% endfor %}
            {% endfor %}
        </div>
        {% endif %}

        {% if email_registration_enabled|default('1') == '1' %}
        <form method="POST" action="{{ url(routing_register_prefix) }}" class="mt-6 space-y-5">
            {{ csrf_field() }}
            {% if redirect is defined and redirect %}
            <input type="hidden" name="redirect" value="{{ redirect }}">
            {% endif %}

            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">{{ __('Name') }}</label>
                <input type="text" id="name" name="name" required autocomplete="name"
                       value="{{ old.name ?? '' }}"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">{{ __('Email') }}</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       value="{{ old.email ?? '' }}"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700">{{ __('Password') }}</label>
                <input type="password" id="password" name="password" required autocomplete="new-password"
                       pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*\W).{8,}"
                       title="{{ __('Password must be at least 8 characters, include at least one uppercase letter, one lowercase letter, one number, and one special character.') }}"
                       minlength="8"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            <div>
                <label for="password_confirmation" class="block text-sm font-medium text-gray-700">{{ __('Confirm Password') }}</label>
                <input type="password" id="password_confirmation" name="password_confirmation" required autocomplete="new-password"
                       class="mt-1 block w-full rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm">
            </div>

            {# Registration Captcha #}
            {% if register_captcha is defined and register_captcha.captcha_type != 'none' %}
            <div class="flex flex-col items-center justify-center py-2 max-w-full overflow-x-auto w-full">
                {% if register_captcha.captcha_type == 'math' and register_captcha.captcha_question %}
                <div class="w-full text-center">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        {{ __('Spam protection') }}: <strong>{{ register_captcha.captcha_question }}</strong> = ?
                        <span class="text-red-500">*</span>
                    </label>
                    <input type="number" name="captcha_answer" required min="1" max="18"
                           class="w-24 rounded-lg border-gray-300 shadow-xs focus:border-gray-600 focus:ring-gray-500 sm:text-sm mx-auto">
                </div>
                {% elseif register_captcha.captcha_type == 'hcaptcha' and register_captcha.captcha_site_key %}
                <div class="h-captcha max-w-full" data-sitekey="{{ register_captcha.captcha_site_key }}"></div>
                <script src="{{ captcha_urls.hcaptcha.script_url }}" async defer></script>
                {% elseif register_captcha.captcha_type == 'recaptcha' and register_captcha.captcha_site_key %}
                <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response">
                <script src="{{ captcha_urls.recaptcha.script_url }}?render={{ register_captcha.captcha_site_key }}"></script>
                <script>
                    grecaptcha.ready(function() {
                        try {
                            grecaptcha.execute('{{ register_captcha.captcha_site_key }}', {action: 'register'}).then(function(token) {
                                document.getElementById('g-recaptcha-response').value = token;
                            }).catch(function(e) {
                                console.warn('reCAPTCHA execute failed:', e);
                            });
                        } catch (e) {
                            console.warn('reCAPTCHA execute failed:', e);
                        }
                    });
                </script>
                {% elseif register_captcha.captcha_type == 'turnstile' and register_captcha.captcha_site_key %}
                <div class="cf-turnstile max-w-full" data-sitekey="{{ register_captcha.captcha_site_key }}" data-theme="auto" data-size="flexible"></div>
                <script src="{{ captcha_urls.turnstile.script_url }}" async defer></script>
                {% elseif register_captcha.captcha_type == 'honeypot' %}
                <div style="display:none"><input type="text" name="_hp_name" tabindex="-1" autocomplete="off"></div>
                {% elseif register_captcha.captcha_type != 'none' and not register_captcha.captcha_site_key %}
                <p class="text-xs text-red-500 italic">{{ __('Captcha not configured by administrator.') }}</p>
                {% endif %}
            </div>
            {% endif %}

            <button type="submit"
                    class="w-full rounded-lg btn-primary px-4 py-2.5 text-sm font-medium">
                {{ __('Create Account') }}
            </button>
        </form>
        {% endif %}

        {% if sso_registration_enabled|default('0') == '1' and sso_reg_providers_active is defined and sso_reg_providers_active is not empty %}
        <div class="mt-6">
            {% if email_registration_enabled|default('1') == '1' %}
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="bg-white px-2 text-gray-500">{{ __('Or register with') }}</span>
                </div>
            </div>
            {% endif %}
            <div class="mt-4 flex flex-wrap justify-center gap-2">
                {% for key in sso_reg_providers_active %}
                <a href="{{ url('/auth/sso/' ~ key, {}, {register: 1, redirect: redirect}) }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50">
                    {{ sso_providers[key].label|default(key|capitalize) }}
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if email_registration_enabled|default('1') == '1' or (sso_registration_enabled|default('0') == '1' and sso_reg_providers_active is defined and sso_reg_providers_active is not empty) %}
        <p class="mt-6 text-center text-sm text-gray-500">
            {{ __('Already have an account?') }}
            <a href="{{ url('/login', {}, {redirect: redirect}) }}" class="text-gray-700 underline hover:text-gray-900">{{ __('Sign In') }}</a>
        </p>
        {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
