{% extends "layout.twig" %}

{% block title %}404{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-lg px-4 py-24 text-center">
    <p class="text-6xl font-bold text-gray-900">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">{{ __('Page not found') }}</h1>
    <p class="mt-2 text-gray-600">{{ __("Sorry, we couldn't find the page you're looking for.") }}</p>
    <a href="{{ url('/') }}" class="mt-6 inline-block rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800">
        {{ __('Go home') }}
    </a>
</div>
{% endblock %}
