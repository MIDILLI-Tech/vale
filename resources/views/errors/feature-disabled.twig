{% extends "layout.twig" %}

{% block title %}{{ title|default('Not Available') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-lg px-4 py-24 text-center">

    <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
        {% if feature == 'shop' %}
        <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        {% else %}
        <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6"/>
        </svg>
        {% endif %}
    </div>

    <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">
        {% if feature == 'shop' %}{{ __('Store') }}
        {% elseif feature == 'registration' %}{{ __('Registration') }}
        {% elseif feature == 'pages' %}{{ __('Pages') }}
        {% elseif feature == 'newsletter' %}{{ __('Newsletter') }}
        {% elseif feature == 'form_builder' %}{{ __('Forms') }}
        {% else %}{{ __('Blog') }}{% endif %}
    </p>

    <h1 class="mt-2 text-3xl font-bold text-gray-900">
        {% if feature == 'shop' %}
            {{ __('Store is currently unavailable') }}
        {% elseif feature == 'registration' %}
            {{ __('New user registration is currently disabled') }}
        {% elseif feature == 'pages' %}
            {{ __('Pages are currently unavailable') }}
        {% elseif feature == 'newsletter' %}
            {{ __('Newsletter is currently unavailable') }}
        {% elseif feature == 'form_builder' %}
            {{ __('Forms are currently unavailable') }}
        {% else %}
            {{ __('Blog is currently unavailable') }}
        {% endif %}
    </h1>

    <p class="mt-3 text-base text-gray-500">
        {% if feature == 'shop' %}
            {{ __('Our store is temporarily offline. Please check back later.') }}
        {% elseif feature == 'registration' %}
            {{ __('The site administrator has disabled new registrations. If you already have an account, please log in.') }}
        {% elseif feature == 'pages' %}
            {{ __('Static pages are temporarily offline. Please check back later.') }}
        {% elseif feature == 'newsletter' %}
            {{ __('Newsletter features are temporarily offline. Please check back later.') }}
        {% elseif feature == 'form_builder' %}
            {{ __('Form submissions are temporarily offline. Please check back later.') }}
        {% else %}
            {{ __('The blog is temporarily offline. Please check back later.') }}
        {% endif %}
    </p>

    <a href="{{ url('/') }}" class="mt-8 inline-block rounded-lg bg-gray-900 px-6 py-2.5 text-sm font-medium text-white hover:bg-gray-800">
        {{ __('Go to homepage') }}
    </a>

</div>
{% endblock %}
