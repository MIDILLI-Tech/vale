{% extends "layout.twig" %}

{% block title %}403 Forbidden{% endblock %}

{% block content %}
<div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-bold text-gray-200 dark:text-gray-800">403</h1>
    <p class="mt-4 text-2xl font-semibold text-gray-900 dark:text-gray-100">{{ __('Forbidden') }}</p>
    <p class="mt-2 text-gray-600 dark:text-gray-400">{{ __('You do not have permission to access this resource.') }}</p>
    {% if error_id is defined and error_id is not empty %}
    <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">{{ __('Reference') }}: <code class="rounded bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 text-gray-600 dark:text-gray-400">{{ error_id }}</code></p>
    {% endif %}
    <div class="mt-10">
        <a href="{{ site_url('/') }}" class="rounded-lg btn-primary px-6 py-3 text-sm font-medium">
            {{ __('Back to home') }}
        </a>
    </div>
</div>
{% endblock %}
