{# Reusable partial: renders custom fields defined in a ContentType's fieldSchema #}
{# Usage: {% include 'partials/custom_fields.twig' with { type: type, post: post } %} #}

{% if type is defined and type.fieldSchema is defined and type.fieldSchema|length > 0 %}
<div class="rounded-xl border bg-white p-6 shadow-xs space-y-5 mt-6">
    <h3 class="text-lg font-semibold text-gray-900 border-b pb-3">
        {{ type.name }} {{ __('Details') }}
    </h3>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {% for field in type.fieldSchema %}
            {% set value = post is defined ? post.getMetaValue(field.name, '') : '' %}
            <div class="{% if field.type == 'textarea' %}sm:col-span-2{% endif %}">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    {{ field.label }}
                </label>

                {% if field.type == 'textarea' %}
                <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-800 whitespace-pre-wrap leading-relaxed">
                    {{ value|shortcodes(post)|raw }}
                </div>

                {% elseif field.type == 'select' %}
                <span class="inline-block rounded-md bg-gray-100 px-3 py-1.5 text-sm text-gray-800 font-medium">
                    {{ value }}
                </span>

                {% elseif field.type == 'checkbox' %}
                {% if value %}
                <span class="inline-flex items-center gap-1.5 rounded-md bg-green-50 px-2.5 py-1 text-sm font-medium text-green-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{ __('Yes') }}
                </span>
                {% else %}
                <span class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2.5 py-1 text-sm text-gray-500">
                    {{ __('No') }}
                </span>
                {% endif %}

                {% elseif field.type == 'image' %}
                {% if value %}
                    {% set rawVal = value|trim %}
                    {% set imgUrl = rawVal matches '/^\\d+$/' ? get_media_url(rawVal) : rawVal %}
                    {% if imgUrl %}
                <img src="{{ imgUrl }}" alt="{{ field.label }}" class="rounded-lg border border-gray-200 max-w-xs h-auto object-cover">
                    {% endif %}
                {% else %}
                <span class="text-sm text-gray-400 italic">{{ __('No image') }}</span>
                {% endif %}

                {% elseif field.type == 'number' %}
                <p class="text-base font-semibold text-gray-900">
                    {{ value is not empty ? value : '-' }}
                </p>

                {% else %}
                <p class="text-base text-gray-900">
                    {{ value }}
                </p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}
