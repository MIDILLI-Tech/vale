{#
    Shared shop category list — rendered by the desktop sidebar and by the
    mobile drawer, so both always stay in sync.

    Params:
      categories            list of categories (with `depth` and `slug`)
      filters               current filter params (`filters.category`)
      variant               'sidebar' (default) | 'drawer'
#}
{% set _is_drawer = variant|default('sidebar') == 'drawer' %}
{% set _link_pad = _is_drawer ? 'px-3 py-2' : 'px-3 py-1.5' %}
{% set _active = filters.category|default('') %}
<ul class="space-y-1 text-sm">
    <li>
        <a href="{{ url(routing_shop_prefix) }}"
           class="block rounded-lg {{ _link_pad }} {{ not _active ? 'bg-gray-100 text-gray-800 font-medium' : 'text-gray-700 hover:bg-gray-100' }}">
            {{ __('All Products') }}
        </a>
    </li>
    {% for cat in categories %}
    <li style="padding-left:{{ cat.depth|default(0) * 1 }}rem">
        <a href="{{ url(routing_shop_prefix) }}?category={{ cat.slug }}"
           class="block rounded-lg {{ _link_pad }} {{ _active == cat.slug ? 'bg-gray-100 text-gray-800 font-medium' : 'text-gray-700 hover:bg-gray-100' }}">
            {% if cat.depth|default(0) > 0 %}<span class="text-gray-400">└ </span>{% endif %}{{ cat.name }}
        </a>
    </li>
    {% endfor %}
</ul>
