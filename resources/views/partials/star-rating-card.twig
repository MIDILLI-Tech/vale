{#
  Reusable star-rating display for card/listing contexts.
  Defines window.starRatingHtml(avg, count, opts) for use inside Alpine x-for loops.
  Include this once at the top of any template that needs star ratings.
#}
<script>
(function() {
    var starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';

    window.starRatingHtml = function(avg, count, opts) {
        opts = opts || {};
        var size   = opts.size || 'w-4 h-4';
        var text   = opts.text || 'text-gray-300';
        var filled = opts.filled || 'text-yellow-400';
        var half   = opts.half || 'text-yellow-300';
        var label  = opts.labelClass || 'text-xs text-gray-500';

        if (!count || count === 0) return '';

        var stars = '';
        for (var i = 1; i <= 5; i++) {
            var cls = text;
            if (avg >= i) {
                cls = filled;
            } else if (avg >= i - 0.5) {
                cls = half;
            }
            stars += '<svg class="' + size + ' ' + cls + '" fill="currentColor" viewBox="0 0 20 20"><path d="' + starPath + '"/></svg>';
        }

        return '<div class="flex items-center gap-1">'
            + '<div class="flex gap-0.5">' + stars + '</div>'
            + '<span class="' + label + '">' + parseFloat(avg).toFixed(1) + ' (' + count + ')</span>'
            + '</div>';
    };
})();
</script>
