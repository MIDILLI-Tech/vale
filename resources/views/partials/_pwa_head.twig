{% if pwa_enabled %}
<link rel="manifest" href="{{ base_path }}/manifest.webmanifest">
<meta name="theme-color" content="{{ pwa_theme_color }}">
<meta name="application-name" content="{{ pwa_app_name }}">
<meta name="apple-mobile-web-app-title" content="{{ pwa_short_name }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
{% if pwa_has_raster_icon %}
<link rel="apple-touch-icon" href="{{ base_path }}/pwa/icon-180.png">
{% endif %}
<script nonce="{{ csp_nonce }}">
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register(
                '{{ (base_path ~ '/sw.js')|e('js') }}',
                { scope: '{{ (base_path ~ '/')|e('js') }}' }
            ).catch(function () {});
        });
    }
</script>
{% else %}
<script nonce="{{ csp_nonce }}">
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (registrations) {
            registrations.forEach(function (registration) {
                var worker = registration.active || registration.waiting || registration.installing;
                if (worker && worker.scriptURL.replace(/[?#].*$/, '').endsWith('/sw.js')) {
                    registration.unregister();
                }
            });
        }).catch(function () {});
        if (window.caches) {
            caches.keys().then(function (keys) {
                keys.filter(function (key) {
                    return key.indexOf('vale-pwa-') === 0;
                }).forEach(function (key) {
                    caches.delete(key);
                });
            }).catch(function () {});
        }
    }
</script>
{% endif %}
