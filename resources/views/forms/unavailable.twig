{% extends "layout.twig" %}

{% block title %}{{ __('Form Unavailable') }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-16 max-w-2xl">
    <div class="rounded-2xl border border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-950/30 p-8 text-center shadow-xs">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/>
            </svg>
        </div>
        <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            {{ __('This form is currently unavailable.') }}
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-400">
            {{ __('The form could not be displayed because it is not configured correctly. Please contact the site administrator.') }}
        </p>
    </div>
</div>
{% endblock %}
