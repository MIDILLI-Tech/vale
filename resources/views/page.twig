{% extends page.pageTemplate == 'none' ? 'layout_bare.twig' : 'layout.twig' %}

{% block title %}{{ page.metaTitle|default(page.title) }}{{ seo_title_separator }}{{ site_name }}{% endblock %}
{% block meta_description %}{{ page|meta_teaser(160) }}{% endblock %}
{% block meta_robots %}{% if seo is defined and seo and seo.robots %}<meta name="robots" content="{{ seo.robots }}">{% endif %}{% endblock %}
{% block canonical_url %}{{ site_url ~ (routing_page_prefix ? routing_page_prefix : '') ~ '/' ~ page.slug }}{% endblock %}
{% block og_title %}{% if seo is defined and seo %}{{ seo.effectiveOgTitle|default(page.metaTitle|default(page.title)) }}{% else %}{{ page.metaTitle|default(page.title) }}{% endif %}{% endblock %}
{% block og_description %}{% if seo is defined and seo and seo.effectiveOgDescription %}{{ seo.effectiveOgDescription }}{% else %}{{ page|meta_teaser(160) }}{% endif %}{% endblock %}

{% block content %}
{% if is_preview %}
<div class="sticky top-0 z-50 bg-amber-400 py-2 text-center text-sm font-semibold text-amber-900 shadow-sm">
  &#9888; Preview Mode &mdash; this page is not yet published.
  <a href="{{ url('/admin/pages/' ~ page.id ~ '/edit') }}" class="ml-3 underline hover:text-amber-700">Edit</a>
</div>
{% endif %}
{% include 'partials/_fallback_notice.twig' with {entity_label: 'page'} %}

{% if has_access is defined and not has_access %}
<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 {{ page.hideTitle ? 'pt-6 sm:pt-8 pb-12' : 'py-12' }}">
    <article>
        {% if not page.hideTitle or page.excerpt %}
        <header class="mb-8">
            {% if not page.hideTitle %}<h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white break-words">{{ page.title }}</h1>{% endif %}
            {% if page.excerpt %}
            <p class="mt-3 text-xl text-gray-500 dark:text-gray-400">{{ page.excerpt }}</p>
            {% endif %}
        </header>
        {% endif %}

        <div class="mt-8 rounded-3xl border border-indigo-100 bg-indigo-50/60 p-8 text-center backdrop-blur-xs shadow-xs dark:border-blue-500/20 dark:bg-slate-800/60 dark:shadow-xl">
            <p class="text-xl font-bold text-slate-900 dark:text-white mb-2">{{ __('This content is for members only.') }}</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 mb-6">{{ __('Subscribe to get full access.') }}</p>
            <a href="{{ url('/membership') }}" class="inline-block rounded-lg btn-primary px-3 py-2 text-sm font-medium text-white transition-colors">{{ __('View Membership Plans') }}</a>
        </div>
    </article>
</div>
{% else %}
{% if page.pageTemplate == 'none' %}
{{ page.body|shortcodes(page)|raw }}
{% include 'partials/_content_pagination.twig' %}
{% elseif page.pageTemplate != 'standard' %}
  {% include 'page-templates/' ~ page.pageTemplate ~ '.twig' %}
{% else %}
<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 {{ page.hideTitle ? 'pt-6 sm:pt-8 pb-12' : 'py-12' }}">
    <article>
        {% if not page.hideTitle or page.excerpt %}
        <header class="mb-8">
            {% if not page.hideTitle %}<h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">{{ page.title }}</h1>{% endif %}
            {% if page.excerpt %}
            <p class="mt-3 text-xl text-gray-500 dark:text-gray-400">{{ page.excerpt }}</p>
            {% endif %}
        </header>
        {% endif %}

        {# ── Advertisement: Above Content ── #}
        {% if advertisement_enabled == '1' and advertisement_placement == 'above_content' and advertisement_code %}
        <div class="vl-ad-above-content mb-8 flex justify-center">
            {{ advertisement_code|raw }}
        </div>
        {% endif %}

        <div class="prose dark:prose-invert max-w-none">
            {{ page.body|shortcodes(page)|raw }}
        </div>

        {% include 'partials/_content_pagination.twig' %}

        {# ── Advertisement: Below Content ── #}
        {% if advertisement_enabled == '1' and advertisement_placement == 'below_content' and advertisement_code %}
        <div class="vl-ad-below-content mt-8 flex justify-center">
            {{ advertisement_code|raw }}
        </div>
        {% endif %}
    </article>
</div>
{% endif %}
{% endif %}
{% endblock %}
