<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block WordPress probe endpoints (no such routes in Vale)
    RewriteRule ^xmlrpc\.php$ - [R=404,L]

    # Allow installer to be accessed directly
    RewriteCond %{REQUEST_URI} !install\.php$

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security: deny access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes +FollowSymLinks

# UTF-8 charset
AddDefaultCharset UTF-8

# Long-lived cache for versioned static assets (?v= cache-busting via asset())
<IfModule mod_headers.c>
    SetEnvIf Request_URI "/assets/" static_asset
    Header set Cache-Control "public, max-age=31536000, immutable" env=static_asset
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
