{# DESCRIPTION: Standard layout with full width constraints. #}
<div class="mx-auto max-w-full px-4 sm:px-6 lg:px-8 {{ page.hideTitle ? 'pt-6 sm:pt-8 pb-12' : 'py-12' }}">
    <article>
        {% if not page.hideTitle or page.excerpt %}
        <header class="mb-8">
            {% if not page.hideTitle %}<h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">{{ page.title }}</h1>{% endif %}
            {% if page.excerpt %}
            <p class="mt-3 text-xl text-gray-500 dark:text-gray-400">{{ page.excerpt }}</p>
            {% endif %}
        </header>
        {% endif %}

        <div class="prose dark:prose-invert max-w-none">
            {{ page.body|shortcodes(page)|raw }}
        </div>
    </article>
</div>
