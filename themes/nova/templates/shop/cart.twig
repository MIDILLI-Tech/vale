{% extends "layout.twig" %}

{% block title %}{{ __('Shopping Cart') }}{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
<div class="pt-32 pb-24 px-4">
<div class="mx-auto max-w-3xl" x-data="{ showRemoveModal: false, removeKey: '' }">

    <h1 class="text-2xl font-bold text-slate-100 mb-8">{{ __('Shopping Cart') }}</h1>

    {% if items|length > 0 %}
    <div class="rounded-xl border border-slate-700/50 bg-slate-800/30 shadow-xs overflow-x-auto mb-6">
        <table class="min-w-full divide-y divide-slate-700/50">
            <thead class="bg-slate-800/60">
                <tr>
                    <th class="px-2 py-3 sm:px-6 text-left text-xs font-medium uppercase tracking-wider text-slate-400">{{ __('Product') }}</th>
                    <th class="px-1.5 py-3 sm:px-6 text-center text-xs font-medium uppercase tracking-wider text-slate-400">{{ __('Qty') }}</th>
                    <th class="px-1.5 py-3 sm:px-6 text-right text-xs font-medium uppercase tracking-wider text-slate-400">{{ __('Price') }}</th>
                    <th class="px-1.5 py-3 sm:px-6 text-right text-xs font-medium uppercase tracking-wider text-slate-400">{{ __('Subtotal') }}</th>
                    <th class="px-1 py-3 sm:px-6 w-8 sm:w-10"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50">
                {% set total = 0 %}
                {% for row in items %}
                {% set price = row.price * fx_rate %}
                {% set subtotal = price * row.qty %}
                {% set total = total + subtotal %}
                <tr>
                    <td class="px-2 py-3.5 sm:px-6">
                        <a href="{{ url(routing_shop_prefix ~ '/' ~ row.product.slug ~ '') }}" class="text-xs sm:text-sm font-medium text-slate-100 hover:text-white">{{ row.product.name }}</a>
                        {% if row.variation %}
                        <div class="text-[11px] sm:text-xs text-slate-400 mt-0.5 sm:mt-1">
                            {% for attr, val in row.variation %}{% if val %}{{ attr }}: {{ val }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
                        </div>
                        {% endif %}
                        {% if row.custom_attrs|default({})|length > 0 %}
                        <div class="text-[11px] sm:text-xs text-slate-400 mt-0.5">
                            {% for attr, val in row.custom_attrs %}{{ attr }}: {{ val }}{% if not loop.last %}, {% endif %}{% endfor %}
                        </div>
                        {% endif %}
                    </td>
                    <td class="px-1.5 py-3.5 sm:px-6 text-center" x-data>
                        <form method="POST" action="{{ url('shop.cart.update') }}" class="inline-flex items-center border border-slate-600 rounded-lg overflow-hidden" x-ref="qtyForm">
                            {{ csrf_field() }}
                            <input type="hidden" name="cart_key" value="{{ row.cart_key }}">
                            <button type="button"
                                    @click="let i=$refs.qi{{ loop.index }}; i.value=Math.max(1,+i.value-1); $refs.qtyForm.submit()"
                                    class="px-1.5 sm:px-2 py-0.5 sm:py-1 text-slate-400 hover:text-slate-200 text-xs sm:text-sm font-medium hover:bg-slate-700 transition-colors">−</button>
                            <input type="number" name="qty" value="{{ row.qty }}" min="1"
                                {% if row.max_qty is defined and row.max_qty is not null %}max="{{ row.max_qty }}"{% endif %}
                                x-ref="qi{{ loop.index }}"
                                @change="$refs.qtyForm.submit()"
                                class="w-8 sm:w-14 text-center text-xs sm:text-sm border-0 bg-transparent text-slate-200 focus:ring-0 p-0.5 sm:p-1 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                                {% if row.max_qty is defined and row.max_qty is not null and row.max_qty <= 0 %}disabled{% endif %}>
                            {% if row.max_qty is defined and row.max_qty is not null and row.qty > row.max_qty and row.max_qty > 0 %}
                                <div class="text-[10px] sm:text-xs text-red-400 mt-1">{{ __('Only :count left in stock.', { ':count': row.max_qty }) }}</div>
                            {% elseif row.max_qty is defined and row.max_qty is not null and row.max_qty <= 0 %}
                                <div class="text-[10px] sm:text-xs text-red-400 mt-1">{{ __('Out of stock') }}</div>
                            {% endif %}
                            <button type="button"
                                    @click="let i=$refs.qi{{ loop.index }}; i.value=+i.value+1; $refs.qtyForm.submit()"
                                    class="px-1.5 sm:px-2 py-0.5 sm:py-1 text-slate-400 hover:text-slate-200 text-xs sm:text-sm font-medium hover:bg-slate-700 transition-colors"
                                    {% if row.max_qty is defined and row.max_qty is not null and row.max_qty <= 0 %}disabled{% endif %}>+</button>
                        </form>
                    </td>
                    <td class="px-1.5 py-3.5 sm:px-6 text-right text-xs sm:text-sm text-slate-300 whitespace-nowrap">{{ price|price(current_currency) }}</td>
                    <td class="px-1.5 py-3.5 sm:px-6 text-right text-xs sm:text-sm font-semibold text-slate-100 whitespace-nowrap">{{ subtotal|price(current_currency) }}</td>
                    <td class="px-1 py-3.5 sm:px-6 text-center">
                        <button type="button" @click="removeKey = '{{ row.cart_key }}'; showRemoveModal = true"
                                class="text-red-400 hover:text-red-300 text-sm sm:text-base font-bold p-1 transition-colors" title="{{ __('Remove') }}">&times;</button>
                    </td>
                </tr>
                {% endfor %}
                <tr class="bg-slate-800/40">
                    <td colspan="3" class="px-2 py-3.5 sm:px-6 text-right text-xs sm:text-sm font-semibold text-slate-200">{{ __('Total') }}</td>
                    <td class="px-1.5 py-3.5 sm:px-6 text-right text-sm sm:text-base font-bold text-slate-100 whitespace-nowrap">{{ total|price(current_currency) }}</td>
                    <td></td>
                </tr>
                {% if shipping_estimate is defined and shipping_estimate is not empty and (shipping_estimate.min is not null or shipping_estimate.max is not null) %}
                <tr class="bg-slate-800/40">
                    <td colspan="3" class="px-2 py-2 sm:px-6 text-right text-xs sm:text-sm text-slate-400">{{ __('Estimated Delivery') }}</td>
                    <td class="px-1.5 py-2 sm:px-6 text-right text-xs sm:text-sm text-slate-400 whitespace-nowrap">{{ __(':min–:max days', {':min': shipping_estimate.min, ':max': shipping_estimate.max}) }}</td>
                    <td></td>
                </tr>
                {% endif %}
                {% if tax_policy is defined and tax_policy.display_mode|default('incl_and_breakdown') == 'incl_and_breakdown' %}
                {% if tax_policy.regime == 'normal_vat' and tax_policy.rate > 0 %}
                <tr class="bg-slate-800/40">
                    <td colspan="3" class="px-2 pb-4 sm:px-6 text-right text-xs sm:text-sm text-slate-400">{{ __('Included VAT') }}</td>
                    <td class="px-1.5 pb-4 sm:px-6 text-right text-xs sm:text-sm text-slate-400 whitespace-nowrap">{{ cart_tax_amount|default(0)|price(current_currency) }}</td>
                    <td></td>
                </tr>
                {% elseif tax_policy.zero_reason|default('') != '' %}
                <tr class="bg-slate-800/40">
                    <td colspan="5" class="px-2 pb-4 sm:px-6 text-right text-xs text-slate-400">{{ tax_policy.zero_reason }}</td>
                </tr>
                {% endif %}
                {% endif %}
            </tbody>
        </table>
    </div>

    {# Upsells #}
    {% if upsells is defined and upsells|length > 0 %}
    <div class="mb-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">{{ __('You may also like') }}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {% for upsell in upsells %}
            <a href="{{ upsell.url }}" class="group rounded-lg border border-slate-700/50 bg-slate-800/30 p-3 hover:shadow-md hover:shadow-slate-900/50 transition-shadow">
                <div class="aspect-square rounded-md bg-slate-700/50 mb-2 overflow-hidden">
                    {% if upsell.thumbnail %}
                    <img src="{{ upsell.thumbnail }}" alt="{{ upsell.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform">
                    {% else %}
                    <div class="w-full h-full flex items-center justify-center text-slate-600">
                        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    {% endif %}
                </div>
                <h3 class="text-xs font-medium text-slate-200 truncate">{{ upsell.name }}</h3>
                <p class="text-xs font-semibold text-slate-100 mt-0.5">{{ ((upsell.sale_price ?: upsell.price) * fx_rate)|price(current_currency) }}</p>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="flex justify-between items-center">
        <a href="{{ url(routing_shop_prefix) }}" class="text-sm text-slate-400 hover:text-slate-200">← {{ __('Continue Shopping') }}</a>
        <a href="{{ url('checkout') }}" class="rounded-lg btn-neon px-5 py-2.5 sm:px-6 sm:py-3 text-sm font-medium">
            {{ __('Checkout') }} →
        </a>
    </div>

    {# Remove confirmation modal #}
    <div x-show="showRemoveModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center">
        <div class="fixed inset-0 bg-black/40" @click="showRemoveModal = false"></div>
        <div class="relative bg-slate-800 rounded-xl shadow-xl p-6 max-w-sm w-full mx-4 border border-slate-700/50">
            <p class="text-slate-200 font-medium mb-4">{{ __('Remove this item from your cart?') }}</p>
            <div class="flex justify-end gap-3">
                <button type="button" @click="showRemoveModal = false"
                        class="px-4 py-2 text-sm text-slate-300 hover:text-slate-100 rounded-lg border border-slate-600">{{ __('Cancel') }}</button>
                <form method="POST" action="{{ url('shop.cart.remove') }}">
                    {{ csrf_field() }}
                    <input type="hidden" name="cart_key" :value="removeKey">
                    <button type="submit"
                            class="px-4 py-2 text-sm text-white bg-red-600 hover:bg-red-700 rounded-lg">{{ __('Remove') }}</button>
                </form>
            </div>
        </div>
    </div>

    {% else %}
    <div class="text-center py-20 text-slate-400">
        <p class="text-xl mb-4">{{ __('Your cart is empty.') }}</p>
        <a href="{{ url(routing_shop_prefix) }}" class="text-slate-200 hover:underline">{{ __('Continue Shopping') }}</a>
    </div>
    {% endif %}
</div>
</div>
{% endblock %}
