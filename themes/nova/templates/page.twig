{% extends 'layout.twig' %}
{% set entity_label = 'page' %}

{% block content %}
{% if page.pageTemplate == 'landing-page' %}
<div class="min-h-screen pt-20">
    {% if has_access is defined and not has_access %}
    <div class="pt-12 pb-24 px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl rounded-3xl glass border border-indigo-500/20 p-8 text-center shadow-xl">
            <p class="text-2xl font-bold text-white mb-2">{{ __('This content is for members only.') }}</p>
            <p class="text-slate-400 text-sm mb-6">{{ __('Subscribe to get full access.') }}</p>
            <a href="{{ url('/membership') }}" class="btn-neon inline-block rounded-2xl font-bold text-sm px-8 py-3.5 transition-all">{{ __('View Membership Plans') }}</a>
        </div>
    </div>
    {% else %}
    {{ page.body|shortcodes(page)|raw }}
    {% include 'partials/_content_pagination.twig' %}
    {% endif %}
</div>
{% else %}
<article class="{{ page.hideTitle ? 'pt-20 sm:pt-24 pb-24' : 'pt-32 pb-24' }}">
    {% if not page.hideTitle or page.excerpt %}
    <header class="mb-12">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
            {% if not page.hideTitle %}<h1 class="text-3xl sm:text-4xl lg:text-6xl font-display font-bold text-white mb-6 leading-tight break-words">
                {{ page.title }}
            </h1>{% endif %}
            {% if page.excerpt %}
            <p class="text-slate-300 text-lg max-w-2xl mx-auto mb-6">{{ page.excerpt }}</p>
            {% endif %}
            <div class="h-1 w-20 bg-blue-600 mx-auto rounded-full"></div>
        </div>
    </header>
    {% endif %}

    <div class="mx-auto max-w-4xl px-4">
        {% if has_access is defined and not has_access %}
            <div class="mt-8 rounded-3xl glass border border-indigo-500/20 p-8 text-center shadow-xl">
                <p class="text-2xl font-bold text-white mb-2">{{ __('This content is for members only.') }}</p>
                <p class="text-slate-400 text-sm mb-6">{{ __('Subscribe to get full access.') }}</p>
                <a href="{{ url('/membership') }}" class="inline-block rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm px-8 py-3.5 transition-all shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/50 hover:scale-[1.02]">{{ __('View Membership Plans') }}</a>
            </div>
        {% else %}
            {% if page.thumbnail %}
            <div class="mb-16 rounded-[3rem] overflow-hidden">
                <img src="{{ page.thumbnail.url }}" alt="{{ page.title }}" class="w-full h-auto">
            </div>
            {% endif %}

            {# ── Advertisement: Above Content ── #}
            {% if advertisement_enabled == '1' and advertisement_placement == 'above_content' and advertisement_code %}
            <div class="vl-ad-above-content mb-8 flex justify-center">
                {{ advertisement_code|raw }}
            </div>
            {% endif %}

            <div class="prose prose-invert prose-blue mx-auto">
                {{ page.body|shortcodes(page)|raw }}
            </div>

            {% include 'partials/_content_pagination.twig' %}

            {# ── Advertisement: Below Content ── #}
            {% if advertisement_enabled == '1' and advertisement_placement == 'below_content' and advertisement_code %}
            <div class="vl-ad-below-content mt-8 flex justify-center">
                {{ advertisement_code|raw }}
            </div>
            {% endif %}
        {% endif %}
    </div>
</article>
{% endif %}
{% endblock %}
