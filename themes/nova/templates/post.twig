{% extends 'layout.twig' %}
{% set entity_label = 'post' %}

{% block title %}{{ post.metaTitle|default(post.title) }}{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
{# Hero inner (badge + title + meta) — shared by image-overlay and plain headers #}
{% set _hero_title_cls = post.thumbnail ? 'text-2xl sm:text-4xl lg:text-5xl xl:text-6xl' : 'text-3xl sm:text-4xl lg:text-6xl' %}
{% set _hero_meta_cls = post.thumbnail ? 'text-slate-200' : 'text-slate-400' %}
{% set hero_inner %}
<div class="inline-flex items-center gap-3 px-3 py-1 rounded-full glass border border-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-widest mb-8">
    {% if post.category %}
        {{ post.category.name }}
    {% else %}
        {{ __('Insight') }}
    {% endif %}
</div>
<h1 class="{{ _hero_title_cls }} font-display font-bold text-white {{ post.thumbnail ? 'mb-6 drop-shadow-lg' : 'mb-8' }} leading-tight break-words">
    {{ post.title }}
</h1>
<div class="flex items-center justify-center gap-6 {{ _hero_meta_cls }} text-sm flex-wrap">
                {% set author = authors[post.authorId]|default(post.author|default(null)) %}
                {% if show_author_on_posts|default('0') == '1' and author %}
                <div class="flex items-center gap-2">
                    <div class="h-8 w-8 rounded-full bg-blue-600 flex items-center justify-center text-xs font-bold text-white">
                        {{ author.name|slice(0,1)|upper }}
                    </div>
                    <span class="font-medium text-slate-300">{{ author.name }}</span>
                </div>
                <span class="h-1 w-1 bg-slate-700 rounded-full"></span>
                {% endif %}
                {% set pubDate = post.publishedAt|default(post.created_at|default(null)) %}
                {% if pubDate %}
                {% include 'partials/_vtime.twig' with {value: pubDate, style: 'medium', withTime: show_timestamp_on_posts|default('0') == '1'} %}
                {% endif %}
                {% if show_modification_date_on_posts|default('0') == '1' and post.updatedAt and post.updatedAt != pubDate %}
                <span class="h-1 w-1 bg-slate-700 rounded-full"></span>
                <span>{{ __('Updated') }}: {% include 'partials/_vtime.twig' with {value: post.updatedAt, style: 'medium', withTime: show_timestamp_on_posts|default('0') == '1'} %}</span>
                {% endif %}
                <span class="h-1 w-1 bg-slate-700 rounded-full"></span>
                <span>{{ ((post.body|default(post.content|default('')))|striptags|split(' ')|length / 200)|round(0, 'ceil') }} {{ __('min read') }}</span>
                {% if type is defined and type and type.slug != 'post' and type.slug != 'page' %}
                    {% set showReadCount = 'read_count' in type.supports %}
                {% else %}
                    {% set showReadCount = show_read_count_on_posts|default('0') == '1' %}
                {% endif %}
                {% if showReadCount %}
                <span class="h-1 w-1 bg-slate-700 rounded-full"></span>
                <span class="inline-flex items-center gap-1.5">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    {{ post.viewCount|default(0)|compact_count }} {{ __('views') }}
                </span>
                {% endif %}
</div>
{% endset %}

<article class="pt-32 pb-24">
    {% if post.thumbnail %}
    {# Hero Section — overlaid on featured image #}
    <header class="relative mb-16">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="relative rounded-[3rem] overflow-hidden shadow-2xl flex items-end min-h-[26rem] lg:min-h-0 lg:aspect-21/9">
                <img src="{{ post.thumbnail.url }}" alt="{{ post.title }}" class="absolute inset-0 w-full h-full object-cover">
                <div class="absolute inset-0 bg-linear-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
                <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-[3rem] pointer-events-none"></div>
                <div class="relative z-10 w-full text-center px-6 pt-12 pb-8 sm:px-10 sm:pb-10 lg:px-14 lg:pb-14">
                    {{ hero_inner }}
                </div>
            </div>
        </div>
    </header>
    {% else %}
    {# Hero Section #}
    <header class="relative mb-16">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
            {{ hero_inner }}
        </div>

        {# Blurred glow behind title #}
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2/3 h-full bg-blue-600/5 blur-[120px] -z-10"></div>
    </header>
    {% endif %}

    {# Content #}
    <div class="mx-auto max-w-3xl px-4">
        {# ── Advertisement: Above Content ── #}
        {% if advertisement_enabled == '1' and advertisement_placement == 'above_content' and advertisement_code %}
        <div class="vl-ad-above-content mb-8 flex justify-center">
            {{ advertisement_code|raw }}
        </div>
        {% endif %}

        <div class="prose prose-invert prose-blue">
            {% if has_access is defined and not has_access %}
                {% if preview_body is defined and preview_body %}
                    {{ preview_body|shortcodes(post)|raw }}
                {% endif %}
            {% else %}
                {{ post.body|shortcodes(post)|raw }}
            {% endif %}
        </div>

        {% if has_access is not defined or has_access %}
        {% include 'partials/_content_pagination.twig' %}
        {% endif %}

        {# ── Advertisement: Below Content ── #}
        {% if advertisement_enabled == '1' and advertisement_placement == 'below_content' and advertisement_code %}
        <div class="vl-ad-below-content mt-8 flex justify-center">
            {{ advertisement_code|raw }}
        </div>
        {% endif %}

        {% if has_access is defined and not has_access %}
            {% if preview_body is defined and preview_body %}
            <div class="mt-8 rounded-3xl glass border border-indigo-500/20 p-8 text-center shadow-xl">
                <p class="text-2xl font-bold text-white mb-2">{{ __('This content is for members only.') }}</p>
                <p class="text-slate-400 text-sm mb-6">{{ __('Subscribe to get full access to this and all other member-only content.') }}</p>
                <a href="{{ url('/membership') }}" class="inline-block rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm px-8 py-3.5 transition-all shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/50 hover:scale-[1.02]">{{ __('View Membership Plans') }}</a>
            </div>
            {% else %}
            <div class="mt-8 rounded-3xl glass border border-indigo-500/20 p-8 text-center shadow-xl">
                <p class="text-2xl font-bold text-white mb-2">{{ __('This content is for members only.') }}</p>
                <p class="text-slate-400 text-sm mb-6">{{ __('Subscribe to get full access.') }}</p>
                <a href="{{ url('/membership') }}" class="inline-block rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm px-8 py-3.5 transition-all shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/50 hover:scale-[1.02]">{{ __('View Membership Plans') }}</a>
            </div>
            {% endif %}
        {% endif %}

        {# Post Footer #}
        <footer class="mt-20 pt-10 border-t border-slate-900">
            <div class="flex flex-wrap items-center justify-between gap-6">
                {% if post.tags is defined and post.tags|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for tag in post.tags %}
                        <a href="{{ url(routing_blog_prefix ~ '/tag/' ~ tag.slug) }}" class="px-4 py-2 rounded-xl glass text-xs font-bold text-slate-400 hover:text-white hover:border-blue-500/30 transition-all">
                            #{{ tag.name }}
                        </a>
                    {% endfor %}
                </div>
                {% endif %}

                {# Share placeholder #}
                <div class="flex items-center gap-4">
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-500">{{ __('Share') }}</span>
                    <button class="h-10 w-10 rounded-xl glass flex items-center justify-center text-slate-400 hover:text-blue-400 transition-colors">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
                    </button>
                </div>
            </div>

            {# Author Bio #}
            <div class="mt-16 p-8 lg:p-10 rounded-[2.5rem] glass border border-blue-500/10 flex flex-col md:flex-row gap-8 items-center">
                <div class="h-24 w-24 rounded-full bg-linear-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-3xl font-bold text-white shrink-0">
                    {{ post.author.name|slice(0,1)|upper }}
                </div>
                <div class="text-center md:text-left">
                    <h4 class="text-xl font-bold text-white mb-2">{{ post.author.name }}</h4>
                    <p class="text-slate-400 leading-relaxed">
                        {{ post.author.bio|default(__('Strategist and designer at Nova, obsessed with creating digital experiences that leave a lasting impact.')) }}
                    </p>
                </div>
            </div>
        </footer>

        {% if has_access is not defined or has_access %}
        {% include 'partials/comments.twig' with {
            entity_type: type.slug|default('post'),
            entity_id: post.id,
            entity_comment_status: post.commentStatus,
            items: comments|default([]),
            type: type|default(null),
            user_comment: user_comment|default(null),
            comment_ratings: comment_ratings|default({}),
            global_comments_enabled: global_comments_enabled,
            allow_comment_editing: allow_comment_editing,
            cpage: cpage|default(1),
            comments_total_pages: comments_total_pages|default(1),
            comments_total: comments_total|default(0)
        } %}
        {% endif %}
    </div>
</article>

{# Next/Prev Post Placeholders #}
<section class="pb-24 border-t border-slate-900">
    <div class="mx-auto max-w-7xl px-4">
        {# Related / Recent can go here #}
    </div>
</section>
{% endblock %}
