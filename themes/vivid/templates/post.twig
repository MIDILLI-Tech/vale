{% extends "layout.twig" %}

{% block title %}{{ post.metaTitle|default(post.title) }}{{ seo_title_separator }}{{ site_name }}{% endblock %}

{% block content %}
{% set _ct = type is defined and type and type.slug != 'post' and type.slug != 'page' %}

{# ══════════════════════════════════════════════════════════
   HERO BANNER — gradient with title overlay
   ══════════════════════════════════════════════════════════ #}
<div class="relative overflow-hidden vl-post-gradient">
    {# decorative blobs #}
    <div class="pointer-events-none absolute -top-16 -right-16 h-80 w-80 rounded-full opacity-10 vl-radial-glow"></div>
    <div class="pointer-events-none absolute -bottom-10 -left-10 h-60 w-60 rounded-full opacity-10 vl-radial-glow"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 text-center">

        {# Back to blog pill #}
        <a href="{{ url(routing_blog_prefix) }}"
           class="mb-8 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium text-white hover:bg-white/25 transition-colors backdrop-blur-xs ring-1 ring-white/20">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ __('All posts') }}
        </a>

        {# Category badge #}
        {% if post.category is defined and post.category %}
        <div class="mb-4">
            <a href="{{ url(routing_category_prefix ~ '/' ~ post.category.slug) }}"
               class="inline-block rounded-full bg-emerald-400/30 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-100 hover:bg-emerald-400/40 transition-colors">
                {{ post.category.name }}
            </a>
        </div>
        {% endif %}

        {# Title #}
        <h1 class="font-display text-2xl sm:text-4xl lg:text-5xl font-bold text-white drop-shadow-xs leading-tight break-words">
            {{ post.title }}
        </h1>

        {# Excerpt sub-title #}
        {% if post.excerpt is defined and post.excerpt %}
        <p class="mt-5 text-lg text-emerald-100 leading-relaxed">{{ post.excerpt }}</p>
        {% endif %}

        {# Meta: author + date + reading time #}
        {% set author = authors[post.authorId]|default(null) %}
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm text-emerald-200">
            {% if show_author_on_posts|default('0') == '1' and author %}
            <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                {{ author.name }}
            </span>
            <span class="opacity-40">&middot;</span>
            {% endif %}
            {% if post.publishedAt is defined and post.publishedAt %}
            <time datetime="{{ post.publishedAt|iso_date }}" class="flex items-center gap-1.5"{% if show_visitor_timezone|default('1') == '1' %} data-vtz data-vtz-style="long"{% if show_timestamp_on_posts|default('0') == '1' %} data-vtz-time{% endif %}{% endif %}>
                <svg class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v12a2 2 0 002 2z"/>
                </svg>
                {{ post.publishedAt|local_date('long', show_timestamp_on_posts|default('0') == '1') }}
            </time>
            {% endif %}
            {% set showReadingTime = false %}
            {% if not _ct and show_reading_time_on_posts|default('0') == '1' %}
                {% set showReadingTime = true %}
            {% elseif _ct and 'read_time' in type.supports %}
                {% set showReadingTime = true %}
            {% endif %}
            {% if showReadingTime %}
            <span class="opacity-40">&middot;</span>
            <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {{ post.body|read_time }}
            </span>
            {% endif %}
            {% set showReadCount = false %}
            {% if not _ct and show_read_count_on_posts|default('0') == '1' %}
                {% set showReadCount = true %}
            {% elseif _ct and 'read_count' in type.supports %}
                {% set showReadCount = true %}
            {% endif %}
            {% if showReadCount %}
            <span class="opacity-40">&middot;</span>
            <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                {{ post.viewCount|default(0)|compact_count }} {{ __('views') }}
            </span>
            {% endif %}
            {% if show_modification_date_on_posts|default('0') == '1' and post.updatedAt and post.updatedAt != post.publishedAt %}
            <span class="opacity-40">&middot;</span>
            <span class="flex items-center gap-1.5">
                {{ __('Updated') }}: {% include 'partials/_vtime.twig' with {value: post.updatedAt, style: 'long', withTime: show_timestamp_on_posts|default('0') == '1'} %}
            </span>
            {% endif %}
        </div>

        {% if is_preview is defined and is_preview %}
        <div class="mt-6 inline-block rounded-full bg-amber-400/30 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-200 ring-1 ring-amber-300/30">
            {{ __('Preview Mode') }}
        </div>
        {% endif %}
    </div>
</div>

{# ── Advertisement: Above Content ── #}
{% if advertisement_enabled == '1' and advertisement_placement == 'above_content' and advertisement_code %}
<div class="vl-ad-above-content mx-auto max-w-2xl px-4 sm:px-6 pt-12 flex justify-center">
    {{ advertisement_code|raw }}
</div>
{% endif %}

{# ══════════════════════════════════════════════════════════
   ARTICLE CONTENT — single-column centred
   ══════════════════════════════════════════════════════════ #}
<div class="mx-auto max-w-2xl px-4 sm:px-6 py-12">

    {# Tags strip #}
    {% if post.tags is defined and post.tags|length > 0 %}
    <div class="mb-8 flex flex-wrap gap-2">
        {% for tag in post.tags %}
        <a href="{{ url(routing_tag_prefix ~ '/' ~ tag.slug) }}"
           class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
            #{{ tag.name }}
        </a>
        {% endfor %}
    </div>
    {% endif %}

    {# Prose content #}
    <div class="prose prose-emerald max-w-none
                prose-headings:font-display prose-headings:text-gray-900
                prose-a:text-emerald-600 prose-a:no-underline prose-a:hover:underline
                prose-img:rounded-2xl prose-img:shadow-md
                prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-emerald-50 prose-blockquote:px-5 prose-blockquote:py-1 prose-blockquote:rounded-r-lg
                prose-code:text-emerald-700 prose-code:bg-emerald-50 prose-code:rounded-sm prose-code:px-1">
        {% if has_access is defined and not has_access %}
            {% if preview_body is defined and preview_body %}
                {{ preview_body|shortcodes(post)|raw }}
            {% endif %}
        {% else %}
                {{ post.body|shortcodes(post)|raw }}
        {% endif %}
    </div>

    {% if has_access is not defined or has_access %}
    {% include 'partials/_content_pagination.twig' %}
    {% endif %}

    {% if has_access is defined and not has_access %}
        {% if preview_body is defined and preview_body %}
        <div class="mt-8 rounded-2xl border border-emerald-200/80 bg-emerald-50/70 p-8 text-center shadow-xs backdrop-blur-xs">
            <p class="text-xl font-bold text-emerald-950">{{ __('This content is for members only.') }}</p>
            <p class="mt-2 text-sm text-emerald-800">{{ __('Subscribe to get full access to this and all other member-only content.') }}</p>
            <a href="{{ url('/membership') }}" class="mt-5 inline-block rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 transition-all shadow-xs hover:shadow-md">{{ __('View Membership Plans') }}</a>
        </div>
        {% else %}
        <div class="mt-8 rounded-2xl border border-emerald-200/80 bg-emerald-50/70 p-8 text-center shadow-xs backdrop-blur-xs">
            <p class="text-xl font-bold text-emerald-950">{{ __('This content is for members only.') }}</p>
            <p class="mt-2 text-sm text-emerald-800">{{ __('Subscribe to get full access.') }}</p>
            <a href="{{ url('/membership') }}" class="mt-5 inline-block rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 transition-all shadow-xs hover:shadow-md">{{ __('View Membership Plans') }}</a>
        </div>
        {% endif %}
    {% endif %}

    {# ── Advertisement: Below Content ── #}
    {% if advertisement_enabled == '1' and advertisement_placement == 'below_content' and advertisement_code %}
    <div class="vl-ad-below-content mt-8 flex justify-center">
        {{ advertisement_code|raw }}
    </div>
    {% endif %}

    {# ── Author card ── #}
    {% if show_author_on_posts|default('0') == '1' and author %}
    <div class="mt-14 flex items-center gap-5 rounded-2xl bg-gray-50 ring-1 ring-gray-100 p-6">
        <div class="shrink-0 h-14 w-14 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-xl">
            {{ author.name|slice(0,1)|upper }}
        </div>
        <div>
            <p class="text-xs uppercase tracking-widest text-emerald-500 font-semibold mb-0.5">{{ __('Author') }}</p>
            <p class="font-semibold text-gray-900">{{ author.name }}</p>
            {% if author.bio is defined and author.bio %}
            <p class="text-sm text-gray-500 mt-1">{{ author.bio }}</p>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── Navigation: prev / next ── #}
    {% if post.prevPost is defined or post.nextPost is defined %}
    <div class="mt-10 grid grid-cols-2 gap-4">
        {% if post.prevPost is defined and post.prevPost %}
        <a href="{{ url(routing_blog_prefix ~ '/' ~ post.prevPost.slug) }}"
           class="group rounded-xl bg-white ring-1 ring-gray-100 p-4 hover:ring-emerald-300 transition-all text-left shadow-xs">
            <p class="text-xs text-emerald-500 font-medium mb-1">&larr; {{ __('Previous') }}</p>
            <p class="text-sm font-semibold text-gray-800 group-hover:text-emerald-700 leading-snug line-clamp-2">{{ post.prevPost.title }}</p>
        </a>
        {% else %}<div></div>{% endif %}

        {% if post.nextPost is defined and post.nextPost %}
        <a href="{{ url(routing_blog_prefix ~ '/' ~ post.nextPost.slug) }}"
           class="group rounded-xl bg-white ring-1 ring-gray-100 p-4 hover:ring-emerald-300 transition-all text-right shadow-xs">
            <p class="text-xs text-emerald-500 font-medium mb-1">{{ __('Next') }} &rarr;</p>
            <p class="text-sm font-semibold text-gray-800 group-hover:text-emerald-700 leading-snug line-clamp-2">{{ post.nextPost.title }}</p>
        </a>
        {% else %}<div></div>{% endif %}
    </div>
    {% endif %}

    {# ── Related Posts (Read Also) ── #}
    {% if related_posts is defined and related_posts|length > 0 %}
    {% set _postPrefix = type is defined and type and type.slug != 'post' and type.slug != 'page' ? type.publicBasePath : routing_blog_prefix %}
    <div class="mt-12">
        <h3 class="text-sm font-bold uppercase tracking-widest text-emerald-600 mb-4">{{ __('Read Also') }}</h3>
        <div class="grid gap-4 sm:grid-cols-3">
            {% for rp in related_posts %}
            <a href="{{ url(_postPrefix ~ '/' ~ rp.slug) }}"
               class="group rounded-xl bg-white ring-1 ring-gray-100 p-4 hover:ring-emerald-300 transition-all shadow-xs">
                {% if rp.thumbnail is defined and rp.thumbnail %}
                <img src="{{ rp.thumbnail.url }}" alt="{{ rp.title }}" class="w-full h-32 object-cover rounded-lg mb-3">
                {% endif %}
                <p class="text-sm font-semibold text-gray-800 group-hover:text-emerald-700 leading-snug line-clamp-2">{{ rp.title }}</p>
                {% if rp.publishedAt %}
                <p class="mt-2 text-xs text-gray-400">{% include 'partials/_vtime.twig' with {value: rp.publishedAt} %}</p>
                {% endif %}
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

</div>

{# ══════════════════════════════════════════════════════════
    COMMENTS
    ══════════════════════════════════════════════════════════ #}
{% set cs = post.commentStatus %}
{% set entity_comment_status = cs %}
{% set effective_on = (entity_comment_status in ['enabled', 'open']) or (entity_comment_status == 'use_global' and (global_comments_enabled ?? true)) %}
{% if effective_on and (has_access is not defined or has_access) %}
<div class="mx-auto max-w-2xl px-4 sm:px-6 pb-16">
    {% include 'partials/comments.twig' with {
        entity_type: 'post',
        entity_id: post.id,
        entity_comment_status: entity_comment_status,
        items: comments ?? [],
        user_comment: user_comment|default(null),
        comment_ratings: comment_ratings|default({}),
        global_comments_enabled: global_comments_enabled,
        allow_comment_editing: allow_comment_editing,
        comment_captcha_type: comment_captcha_type ?? 'none',
        comment_captcha_question: comment_captcha_question ?? '',
        comment_captcha_site_key: comment_captcha_site_key ?? ''
    } %}
</div>
{% endif %}

{% endblock %}
