{
    "name": "default",
    "version": "1.0.0",
    "description": "Vale default theme",
    "author": "Vale",
    "license": "MIT",
    "templates": {
        "layout": "templates/layout.twig",
        "home": "templates/home.twig",
        "post": "templates/post.twig",
        "page": "templates/page.twig",
        "archive": "templates/archive.twig"
    },
    "menus": {
        "primary": "Primary Navigation",
        "footer": "Footer Links",
        "sidebar": "Sidebar Menu"
    },
    "colors": {
        "header": "gray-50"
    },
    "tables": {
        "border": "#d1d5db",
        "header_background": "#f3f4f6"
    },
    "color_variables": {
        "--theme-primary": {
            "label": "Primary Color",
            "default": "#111827"
        },
        "--theme-primary-hover": {
            "label": "Primary Hover",
            "default": "#374151"
        },
        "--theme-secondary": {
            "label": "Secondary Color",
            "default": "#f3f4f6"
        },
        "--theme-secondary-hover": {
            "label": "Secondary Hover",
            "default": "#e5e7eb"
        },
        "--theme-bg": {
            "label": "Background Color",
            "default": "#f9fafb"
        },
        "--theme-surface": {
            "label": "Card / Container Background",
            "default": "#ffffff"
        },
        "--theme-text": {
            "label": "Text Color",
            "default": "#111827"
        },
        "--theme-text-muted": {
            "label": "Muted Text Color",
            "default": "#4b5563"
        },
        "--theme-header-bg": {
            "label": "Header Background",
            "default": "#ffffff"
        },
        "--theme-footer-bg": {
            "label": "Footer Background",
            "default": "#ffffff"
        },
        "--theme-hero-bg": {
            "label": "Hero Gradient / Background",
            "default": "#111827"
        },
        "--theme-accent": {
            "label": "Accent / Highlight Color",
            "default": "#2563eb"
        },
        "--theme-border": {
            "label": "Border / Divider Color",
            "default": "#e5e7eb"
        }
    },
    "assets": {
        "css": [],
        "js": []
    }
}
