# =============================================================================
# Vale — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Application
APP_ENV=production           # Environment: production | dev
APP_DEBUG=false              # Save detailed error info (set true only in dev)
APP_URL=http://localhost      # Required: canonical base URL incl. subfolder (must match actual domain)
APP_KEY=change-this-to-a-random-32-char-string  # Encryption key (64 hex chars); never change after install
ENCRYPT_PII=false            # Encrypt customer/order address PII at rest (true | false). Enabling it makes addresses unreadable if APP_KEY is lost/changed.
APP_LOCALE=en                # Default locale: en | tr | de | fr | es | it

# Database
DB_DRIVER=mysql              # Database driver: mysql | sqlite | pgsql
DB_HOST=127.0.0.1            # Database hostname (mysql, pgsql only, Docker compose uses "db*")
DB_PORT=3306                 # Database port (mysql or pgsql only)
DB_NAME=vale                 # Database name (mysql or pgsql) or path (sqlite, e.g. storage/database.sqlite)
DB_USER=root                 # example value: vale_user
DB_PASS=                     # Database password (used by the application and Docker Compose)
DB_ROOT_PASSWORD=root        # example value: root password for MySQL, PostgreSQL container (Docker only, --profile db, or --db-postgres)
DB_CHARSET=utf8mb4           # Database charset
DB_PREFIX=vl_                # Database table prefix

# Assets
ASSETS_USE_CDN=false          # Set true to load assets from CDN instead of local build

# Session
SESSION_LIFETIME=120         # Session lifetime in minutes (120 = 2 hours). When "Remember Me" is checked,
                             # session extends to 30 days automatically (configured in config/auth.php).
                             # Increase this value to keep sessions alive longer without "Remember Me".
SESSION_SECURE=true          # Send cookie only over HTTPS (default). Set false only for local plain-HTTP development.
SESSION_HTTPONLY=true        # Block JavaScript access to session cookie (XSS protection)
SESSION_SAMESITE=Lax         # SameSite policy: Lax | Strict | None (CSRF protection)

# Storage
STORAGE_DRIVER=local         # Storage driver: local (only local supported currently)

# Cache
CACHE_DRIVER=file            # Cache driver: file (only file supported currently)
CACHE_TTL=3600               # Data cache TTL in seconds (default 3600 = 1 hour)
PAGE_CACHE_ENABLED=true      # Enable full-page HTML cache for guest visitors
PAGE_CACHE_TTL=86400         # Page cache TTL in seconds (default 86400 = 24h; falls back to CACHE_TTL)

# Rate Limiting
RATE_LIMIT_LOGIN=5           # Max login attempts per minute per IP (brute force protection)
RATE_LIMIT_FORM=3            # Max form submissions per minute per IP (spam protection)
RATE_LIMIT_API=60            # Max API requests per minute per IP (abuse protection)
RATE_LIMIT_PROBE=60          # Max error responses (404/405) per window per IP before throttling (scanner noise; logged-in sessions are exempt)
RATE_LIMIT_PROBE_WINDOW=600  # Probe window in seconds (10 min lockout after RATE_LIMIT_PROBE error responses)
VLE_SKIP_RATE_LIMIT=false    # Disable scanner/probe throttling only (test suites that expect many 404s — never in production)
HEALTH_DEEP_LIMIT=30         # Max ?deep=1 health checks per window per IP (external monitor throttling)
HEALTH_DEEP_WINDOW=60        # Deep health window in seconds
TRUSTED_PROXIES=             # Trusted proxy IPs for correct client detection (e.g. behind Cloudflare, Nginx). Leave empty to use REMOTE_ADDR.

# Listings & Search
CLIENT_SIDE_SEARCH_FETCH_LIMIT=100  # Max records loaded into the browser for client-side search before switching to server-side queries (admin lists, editor pickers, account orders)
SHOP_BUFFER_SIZE=50                 # How many products the storefront pager fetches per server round-trip

# Update Checker
UPDATE_MANIFEST_URL=https://github.com/MIDILLI-Tech/vale/releases/latest/download/manifest.json  # URL for the release manifest JSON
UPDATE_REQUIRE_SIGNATURE=true   # Require signature for updates: true (recommended) | false (legacy/insecure)
UPDATE_PUBLIC_KEY_ED25519=JOVBRKCK2mIIDwY5FgkAwMmHSo1lTNo/V1EjqGicQxQ=   # Base64-encoded Ed25519 public key for release signature verification
UPDATE_PUBLIC_KEY_GPG=       # ASCII-armored GPG public key for release signature verification (optional)

# Plugins
DISABLE_PLUGINS=false        # Emergency brake: load no plugins or mu-plugins at all (same as content/plugins/.disabled)

# Emergency Password Reset
# Set this to a random token to enable the emergency password reset endpoint at /emergency-reset/<token>
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# EMERGENCY_RESET_TOKEN=
